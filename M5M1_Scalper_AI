//==================================================================
// CALCULATE LOT SIZE
//==================================================================

double CalculateLotSize()
{
   double lot = FixedLotSize;

   if(UseAutomaticLot)
   {
      double balance = AccountInfoDouble(ACCOUNT_BALANCE);

      lot = balance * LotPerBalance;
   }

   return NormalizeLotSize(lot);
}

//==================================================================
// NORMALIZE LOT SIZE
//==================================================================

double NormalizeLotSize(double lot)
{
   double minimumLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   double maximumLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   double lotStep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);

   if(minimumLot <= 0.0)
      minimumLot = 0.01;

   if(maximumLot <= 0.0)
      maximumLot = 100.0;

   if(lotStep <= 0.0)
      lotStep = minimumLot;

   if(lot < minimumLot)
      lot = minimumLot;

   if(lot > maximumLot)
      lot = maximumLot;

   lot = MathFloor(lot / lotStep) * lotStep;

   if(lot < minimumLot)
      lot = minimumLot;

   return NormalizeDouble(lot, 8);
}

//==================================================================
// BUY STOP LOSS
//==================================================================

double GetBuyStopLoss(double entryPrice)
{
   if(!UseStopLoss)
      return 0.0;

   double stopLoss = entryPrice - (StopLossPoints * _Point);

   return NormalizeDouble(stopLoss, _Digits);
}

//==================================================================
// BUY TAKE PROFIT
//==================================================================

double GetBuyTakeProfit(double entryPrice)
{
   if(!UseTakeProfit)
      return 0.0;

   double takeProfit = entryPrice + (TakeProfitPoints * _Point);

   return NormalizeDouble(takeProfit, _Digits);
}

//==================================================================
// SELL STOP LOSS
//==================================================================

double GetSellStopLoss(double entryPrice)
{
   if(!UseStopLoss)
      return 0.0;

   double stopLoss = entryPrice + (StopLossPoints * _Point);

   return NormalizeDouble(stopLoss, _Digits);
}

//==================================================================
// SELL TAKE PROFIT
//==================================================================

double GetSellTakeProfit(double entryPrice)
{
   if(!UseTakeProfit)
      return 0.0;

   double takeProfit = entryPrice - (TakeProfitPoints * _Point);

   return NormalizeDouble(takeProfit, _Digits);
}

//==================================================================
// CHECK STOP LEVEL DISTANCE
//==================================================================

bool StopsAreValid(
   ENUM_ORDER_TYPE orderType,
   double entryPrice,
   double stopLoss,
   double takeProfit
)
{
   long stopsLevel = SymbolInfoInteger(
      _Symbol,
      SYMBOL_TRADE_STOPS_LEVEL
   );

   double minimumDistance = stopsLevel * _Point;

   if(orderType == ORDER_TYPE_BUY)
   {
      if(stopLoss > 0.0)
      {
         if(entryPrice - stopLoss < minimumDistance)
            return false;
      }

      if(takeProfit > 0.0)
      {
         if(takeProfit - entryPrice < minimumDistance)
            return false;
      }
   }

   if(orderType == ORDER_TYPE_SELL)
   {
      if(stopLoss > 0.0)
      {
         if(stopLoss - entryPrice < minimumDistance)
            return false;
      }

      if(takeProfit > 0.0)
      {
         if(entryPrice - takeProfit < minimumDistance)
            return false;
      }
   }

   return true;
}

//==================================================================
// OPEN BUY
//==================================================================

void OpenBuy()
{
   if(CountOurPositions() >= MaximumOpenPositions)
      return;

   MqlTick tick;

   if(!SymbolInfoTick(_Symbol, tick))
   {
      Print("BUY cancelled: market price unavailable.");
      return;
   }

   double lot = CalculateLotSize();

   if(lot <= 0.0)
   {
      Print("BUY cancelled: invalid lot size.");
      return;
   }

   double entryPrice = tick.ask;

   double stopLoss = GetBuyStopLoss(entryPrice);

   double takeProfit = GetBuyTakeProfit(entryPrice);

   if(!StopsAreValid(
      ORDER_TYPE_BUY,
      entryPrice,
      stopLoss,
      takeProfit))
   {
      Print("BUY cancelled: SL/TP is too close to current price.");
      return;
   }

   ResetLastError();

   bool result = trade.Buy(
      lot,
      _Symbol,
      0.0,
      stopLoss,
      takeProfit,
      "M5M1 Scalper AI BUY"
   );

   if(result)
   {
      Print(
         "BUY opened | Lot=",
         DoubleToString(lot, 2),
         " | Price=",
         DoubleToString(entryPrice, _Digits),
         " | SL=",
         DoubleToString(stopLoss, _Digits),
         " | TP=",
         DoubleToString(takeProfit, _Digits)
      );
   }
   else
   {
      Print(
         "BUY failed | Retcode=",
         IntegerToString((int)trade.ResultRetcode()),
         " | ",
         trade.ResultRetcodeDescription(),
         " | Error=",
         IntegerToString(GetLastError())
      );
   }
}

//==================================================================
// OPEN SELL
//==================================================================

void OpenSell()
{
   if(CountOurPositions() >= MaximumOpenPositions)
      return;

   MqlTick tick;

   if(!SymbolInfoTick(_Symbol, tick))
   {
      Print("SELL cancelled: market price unavailable.");
      return;
   }

   double lot = CalculateLotSize();

   if(lot <= 0.0)
   {
      Print("SELL cancelled: invalid lot size.");
      return;
   }

   double entryPrice = tick.bid;

   double stopLoss = GetSellStopLoss(entryPrice);

   double takeProfit = GetSellTakeProfit(entryPrice);

   if(!StopsAreValid(
      ORDER_TYPE_SELL,
      entryPrice,
      stopLoss,
      takeProfit))
   {
      Print("SELL cancelled: SL/TP is too close to current price.");
      return;
   }

   ResetLastError();

   bool result = trade.Sell(
      lot,
      _Symbol,
      0.0,
      stopLoss,
      takeProfit,
      "M5M1 Scalper AI SELL"
   );

   if(result)
   {
      Print(
         "SELL opened | Lot=",
         DoubleToString(lot, 2),
         " | Price=",
         DoubleToString(entryPrice, _Digits),
         " | SL=",
         DoubleToString(stopLoss, _Digits),
         " | TP=",
         DoubleToString(takeProfit, _Digits)
      );
   }
   else
   {
      Print(
         "SELL failed | Retcode=",
         IntegerToString((int)trade.ResultRetcode()),
         " | ",
         trade.ResultRetcodeDescription(),
         " | Error=",
         IntegerToString(GetLastError())
      );
   }
}

//==================================================================
// CONVERT DIRECTION TO TEXT
//==================================================================

string DirectionText()
{
   if(currentM5Direction == 1)
      return "BULLISH";

   if(currentM5Direction == -1)
      return "BEARISH";

   return "NEUTRAL";
}

//==================================================================
// SHOW EA STATUS ON CHART
//==================================================================

void ShowStatus()
{
   string tradingText = "STOPPED";

   if(TradingEnabled)
      tradingText = "RUNNING";

   string status =
      "M5M1 SCALPER AI\n"
      "------------------------------\n"
      "Symbol: " + _Symbol + "\n"
      "Status: " + tradingText + "\n"
      "M5 Direction: " + DirectionText() + "\n"
      "M5 Support: " +
      DoubleToString(currentSupport, _Digits) + "\n"
      "M5 Resistance: " +
      DoubleToString(currentResistance, _Digits) + "\n"
      "Open Positions: " +
      IntegerToString(CountOurPositions()) + "\n"
      "Lot Size: " +
      DoubleToString(CalculateLotSize(), 2);

   Comment(status);
}

