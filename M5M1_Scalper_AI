#property copyright "M5M1 Scalper AI"
#property version   "1.00"
#property strict

#include <Trade/Trade.mqh>

CTrade trade;

//==================================================================
// INPUTS
//==================================================================

//--- Main trading control
input bool   TradingEnabled       = true;
input ulong  MagicNumber          = 51001001;
input int    MaximumOpenPositions = 1;

//--- Lot sizing
input bool   UseAutomaticLot      = false;
input double FixedLotSize         = 0.01;
input double LotPerBalance        = 0.001;

//--- Timeframes
input ENUM_TIMEFRAMES TrendTimeframe = PERIOD_M5;
input ENUM_TIMEFRAMES EntryTimeframe = PERIOD_M1;

//--- M5 structure
input int    StructureLookback    = 50;

//--- Support and resistance
input int    SRLookback           = 50;
input double SRTolerancePoints    = 100.0;

//--- M1 confirmation
input int    ConfirmationCandles  = 2;

//--- Breakout
input bool   UseBreakout          = true;
input double BreakoutBufferPoints = 20.0;

//--- Stop Loss
input bool   UseStopLoss          = true;
input double StopLossPoints       = 300.0;

//--- Take Profit
input bool   UseTakeProfit        = true;
input double TakeProfitPoints     = 600.0;

//--- Spread protection
input bool   UseSpreadFilter      = true;
input double MaximumSpreadPoints  = 50.0;

//--- Execution
input int    SlippagePoints       = 20;

//==================================================================
// GLOBAL VARIABLES
//==================================================================

datetime lastEntryBar = 0;

double currentSupport    = 0.0;
double currentResistance = 0.0;

int currentM5Direction = 0;

//  1  = bullish
// -1  = bearish
//  0  = neutral

//==================================================================
// INITIALIZATION
//==================================================================

int OnInit()
{
   trade.SetExpertMagicNumber(MagicNumber);
   trade.SetDeviationInPoints(SlippagePoints);

   EventSetTimer(1);

   Print("========================================");
   Print("M5M1 Scalper AI initialized");
   Print("Symbol: ", _Symbol);
   Print("Trend timeframe: M5");
   Print("Entry timeframe: M1");
   Print("========================================");

   return(INIT_SUCCEEDED);
}

//==================================================================
// DEINITIALIZATION
//==================================================================

void OnDeinit(const int reason)
{
   EventKillTimer();

   Comment("");

   Print("M5M1 Scalper AI stopped.");
}

//==================================================================
// MAIN TICK FUNCTION
//==================================================================

void OnTick()
{
   UpdateMarketLevels();

   currentM5Direction = GetM5Direction();

   if(!TradingEnabled)
      return;

   if(!TerminalInfoInteger(TERMINAL_TRADE_ALLOWED))
      return;

   if(!MQLInfoInteger(MQL_TRADE_ALLOWED))
      return;

   if(!IsSpreadAcceptable())
      return;

   if(currentM5Direction == 0)
      return;

   if(CountOurPositions() >= MaximumOpenPositions)
      return;

   if(!IsNewEntryBar())
      return;

   if(currentM5Direction == 1)
   {
      if(IsBuyConfirmation())
         OpenBuy();
   }
   else if(currentM5Direction == -1)
   {
      if(IsSellConfirmation())
         OpenSell();
   }
}

//==================================================================
// TIMER
//==================================================================

void OnTimer()
{
   UpdateMarketLevels();

   currentM5Direction = GetM5Direction();

   ShowStatus();
}

//==================================================================
// END OF PART 1
//==================================================================//+------------------------------------------------------------------+
//| PART 2 - MARKET ANALYSIS                                         |
//+------------------------------------------------------------------+

//==================================================================
// SPREAD CHECK
//==================================================================

bool IsSpreadAcceptable()
{
   if(!UseSpreadFilter)
      return true;

   MqlTick tick;

   if(!SymbolInfoTick(_Symbol, tick))
      return false;

   double spreadPoints = (tick.ask - tick.bid) / _Point;

   if(spreadPoints > MaximumSpreadPoints)
      return false;

   return true;
}

//==================================================================
// COUNT EA POSITIONS
//==================================================================

int CountOurPositions()
{
   int count = 0;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol = PositionGetString(POSITION_SYMBOL);
      long magic = PositionGetInteger(POSITION_MAGIC);

      if(symbol == _Symbol && (ulong)magic == MagicNumber)
         count++;
   }

   return count;
}

//==================================================================
// CHECK FOR NEW M1 BAR
//==================================================================

bool IsNewEntryBar()
{
   datetime barTime = iTime(_Symbol, EntryTimeframe, 0);

   if(barTime <= 0)
      return false;

   if(barTime != lastEntryBar)
   {
      lastEntryBar = barTime;
      return true;
   }

   return false;
}

//==================================================================
// DETERMINE M5 DIRECTION
//==================================================================

int GetM5Direction()
{
   int requiredBars = StructureLookback + 10;

   if(Bars(_Symbol, TrendTimeframe) < requiredBars)
      return 0;

   int half = StructureLookback / 2;

   if(half < 5)
      half = 5;

   double recentHigh = -DBL_MAX;
   double recentLow = DBL_MAX;

   double olderHigh = -DBL_MAX;
   double olderLow = DBL_MAX;

   //--- Recent section
   for(int i = 1; i <= half; i++)
   {
      double highValue = iHigh(_Symbol, TrendTimeframe, i);
      double lowValue = iLow(_Symbol, TrendTimeframe, i);

      if(highValue > recentHigh)
         recentHigh = highValue;

      if(lowValue < recentLow)
         recentLow = lowValue;
   }

   //--- Older section
   for(int i = half + 1; i <= StructureLookback; i++)
   {
      double highValue = iHigh(_Symbol, TrendTimeframe, i);
      double lowValue = iLow(_Symbol, TrendTimeframe, i);

      if(highValue > olderHigh)
         olderHigh = highValue;

      if(lowValue < olderLow)
         olderLow = lowValue;
   }

   //--- Bullish structure
   if(recentHigh > olderHigh && recentLow > olderLow)
      return 1;

   //--- Bearish structure
   if(recentHigh < olderHigh && recentLow < olderLow)
      return -1;

   return 0;
}

//==================================================================
// UPDATE SUPPORT AND RESISTANCE
//==================================================================

void UpdateMarketLevels()
{
   currentSupport = 0.0;
   currentResistance = 0.0;

   int availableBars = Bars(_Symbol, TrendTimeframe);

   if(availableBars < 10)
      return;

   int lookback = SRLookback;

   if(lookback > availableBars - 1)
      lookback = availableBars - 1;

   double lowestPrice = DBL_MAX;
   double highestPrice = -DBL_MAX;

   for(int i = 1; i <= lookback; i++)
   {
      double highValue = iHigh(_Symbol, TrendTimeframe, i);
      double lowValue = iLow(_Symbol, TrendTimeframe, i);

      if(highValue > highestPrice)
         highestPrice = highValue;

      if(lowValue < lowestPrice)
         lowestPrice = lowValue;
   }

   if(lowestPrice != DBL_MAX)
      currentSupport = lowestPrice;

   if(highestPrice != -DBL_MAX)
      currentResistance = highestPrice;
}

//==================================================================
// CHECK NEAR SUPPORT
//==================================================================

bool IsNearSupport()
{
   if(currentSupport <= 0.0)
      return false;

   MqlTick tick;

   if(!SymbolInfoTick(_Symbol, tick))
      return false;

   double distance = MathAbs(tick.bid - currentSupport);

   if(distance <= SRTolerancePoints * _Point)
      return true;

   return false;
}

//==================================================================
// CHECK NEAR RESISTANCE
//==================================================================

bool IsNearResistance()
{
   if(currentResistance <= 0.0)
      return false;

   MqlTick tick;

   if(!SymbolInfoTick(_Symbol, tick))
      return false;

   double distance = MathAbs(tick.ask - currentResistance);

   if(distance <= SRTolerancePoints * _Point)
      return true;

   return false;
}

//==================================================================
// M1 BUY CONFIRMATION
//==================================================================

bool IsBuyConfirmation()
{
   if(ConfirmationCandles < 1)
      return false;

   int requiredBars = ConfirmationCandles + 5;

   if(Bars(_Symbol, EntryTimeframe) < requiredBars)
      return false;

   //--- Two closed M1 candles
   double open1 = iOpen(_Symbol, EntryTimeframe, 1);
   double close1 = iClose(_Symbol, EntryTimeframe, 1);

   double open2 = iOpen(_Symbol, EntryTimeframe, 2);
   double close2 = iClose(_Symbol, EntryTimeframe, 2);

   if(open1 <= 0.0 || close1 <= 0.0)
      return false;

   bool candle1Bullish = close1 > open1;

   bool candle2Bullish = close2 > open2;

   //--- Standard bullish confirmation
   if(ConfirmationCandles >= 2)
   {
      if(candle1Bullish && candle2Bullish)
         return true;
   }
   else
   {
      if(candle1Bullish)
         return true;
   }

   //--- Support confirmation
   if(IsNearSupport() && candle1Bullish)
      return true;

   //--- Breakout confirmation
   if(UseBreakout)
   {
      double previousHigh = iHigh(_Symbol, EntryTimeframe, 2);

      if(previousHigh > 0.0)
      {
         if(close1 > previousHigh + BreakoutBufferPoints * _Point)
            return true;
      }
   }

   return false;
}

//==================================================================
// M1 SELL CONFIRMATION
//==================================================================

bool IsSellConfirmation()
{
   if(ConfirmationCandles < 1)
      return false;

   int requiredBars = ConfirmationCandles + 5;

   if(Bars(_Symbol, EntryTimeframe) < requiredBars)
      return false;

   //--- Two closed M1 candles
   double open1 = iOpen(_Symbol, EntryTimeframe, 1);
   double close1 = iClose(_Symbol, EntryTimeframe, 1);

   double open2 = iOpen(_Symbol, EntryTimeframe, 2);
   double close2 = iClose(_Symbol, EntryTimeframe, 2);

   if(open1 <= 0.0 || close1 <= 0.0)
      return false;

   bool candle1Bearish = close1 < open1;

   bool candle2Bearish = close2 < open2;

   //--- Standard bearish confirmation
   if(ConfirmationCandles >= 2)
   {
      if(candle1Bearish && candle2Bearish)
         return true;
   }
   else
   {
      if(candle1Bearish)
         return true;
   }

   //--- Resistance confirmation
   if(IsNearResistance() && candle1Bearish)
      return true;

   //--- Breakdown confirmation
   if(UseBreakout)
   {
      double previousLow = iLow(_Symbol, EntryTimeframe, 2);

      if(previousLow > 0.0)
      {
         if(close1 < previousLow - BreakoutBufferPoints * _Point)
            return true;
      }
   }

   return false;
}

