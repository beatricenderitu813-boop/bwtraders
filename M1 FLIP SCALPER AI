#property strict
#property version   "2.00"
#property description "M1-only confirmation scalper with broker-side SL and TP."

#include <Trade/Trade.mqh>

CTrade trade;

//====================================================================
// INPUTS
//====================================================================

//--- Trading control
input bool   StartTradingOnAttach = false;
input ulong  MagicNumber = 26092026;

//--- Signal
input int    SignalThreshold = 70;

//--- Dynamic lot sizing
input double LotMultiplier = 0.001;
input double MaximumLotSize = 10.0;

//--- SL / TP
input int    StopLossPoints = 100;
input int    TakeProfitPoints = 150;

//--- Position control
input int    MaximumOpenPositions = 1;
input double MaximumEAExposureLots = 10.0;

//--- M1 strategy
input int    StructureLookback = 5;
input int    BreakoutLookback = 5;
input double MinimumBodyPercent = 55.0;

//--- Protection
input double DailyLossLimitPercent = 2.0;
input double MaximumDrawdownPercent = 5.0;
input int    MaximumConsecutiveLosses = 3;

//--- Execution
input int    SlippagePoints = 20;

//====================================================================
// GLOBAL VARIABLES
//====================================================================

bool TradingEnabled = false;

double DayStartBalance = 0.0;
double PeakEquity = 0.0;

int ConsecutiveLosses = 0;

int LastTradingDay = -1;

//====================================================================
// FUNCTION DECLARATIONS
//====================================================================

void CreateControlButtons();
void DeleteControlButtons();
void UpdateButtonState();

void UpdateDailyStatistics();
void ResetDailyStatisticsIfNeeded();

bool DailyLossProtection();
bool DrawdownProtection();
bool ConsecutiveLossProtection();
bool CanTrade();

double NormalizeLot(double lot);
double CalculateDynamicLot();

int CountEAOpenPositions();
double GetEAExposureLots();

double GetHighestHigh(int startShift,int count);
double GetLowestLow(int startShift,int count);

bool IsBullishStructure();
bool IsBearishStructure();

bool BullishMomentum();
bool BearishMomentum();

bool BullishBreakout();
bool BearishBreakout();

bool GetCurrentSignal(int &signal,
                      double &buyScore,
                      double &sellScore);

bool OpenBuy();
bool OpenSell();

void CheckForNewEntry();

void UpdateConsecutiveLossesFromDeal(
   ulong dealTicket);

void ShowStatus();

string SignalText(int signal);

//====================================================================
// INITIALIZATION
//====================================================================

int OnInit()
{
   trade.SetExpertMagicNumber(MagicNumber);
   trade.SetDeviationInPoints(SlippagePoints);

   DayStartBalance =
      AccountInfoDouble(ACCOUNT_BALANCE);

   PeakEquity =
      AccountInfoDouble(ACCOUNT_EQUITY);

   ConsecutiveLosses = 0;

   MqlDateTime currentTime;
   TimeToStruct(TimeCurrent(),currentTime);

   LastTradingDay = currentTime.day;

   TradingEnabled = StartTradingOnAttach;

   CreateControlButtons();
   UpdateButtonState();

   Print("========================================");
   Print("M1 CONFIRM SCALPER AI v2.00");
   Print("Symbol: ",_Symbol);
   Print("Timeframe: M1 ONLY");
   Print("Trading: ",
         TradingEnabled ? "STARTED" : "STOPPED");
   Print("One trade at a time.");
   Print("SL and TP are attached to every entry.");
   Print("No automatic flipping.");
   Print("========================================");

   return(INIT_SUCCEEDED);
}

//====================================================================
// DEINITIALIZATION
//====================================================================

void OnDeinit(const int reason)
{
   DeleteControlButtons();
   Comment("");
}

//====================================================================
// MAIN TICK
//====================================================================

void OnTick()
{
   UpdateDailyStatistics();
   ResetDailyStatisticsIfNeeded();

   ShowStatus();

   if(!TradingEnabled)
      return;

   // Existing positions are NOT modified here.
   // They remain open until broker-side SL or TP.
   CheckForNewEntry();
}

//====================================================================
// TRADE TRANSACTION
//====================================================================

void OnTradeTransaction(
   const MqlTradeTransaction &trans,
   const MqlTradeRequest &request,
   const MqlTradeResult &result)
{
   if(trans.type != TRADE_TRANSACTION_DEAL_ADD)
      return;

   if(trans.deal == 0)
      return;

   UpdateConsecutiveLossesFromDeal(trans.deal);
}

//====================================================================
// CHART BUTTON EVENTS
//====================================================================

void OnChartEvent(
   const int id,
   const long &lparam,
   const double &dparam,
   const string &sparam)
{
   if(id != CHARTEVENT_OBJECT_CLICK)
      return;

   if(sparam == "M1CS_START")
   {
      TradingEnabled = true;

      UpdateButtonState();

      Print("M1 CONFIRM SCALPER: STARTED.");
   }

   if(sparam == "M1CS_STOP")
   {
      TradingEnabled = false;

      UpdateButtonState();

      Print("M1 CONFIRM SCALPER: NEW ENTRIES STOPPED.");
   }
}

