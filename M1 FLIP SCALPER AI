   return "NONE";
}//====================================================================
// DAILY STATISTICS
//====================================================================

void UpdateDailyStatistics()
{
   double equity = AccountInfoDouble(ACCOUNT_EQUITY);

   if(equity > PeakEquity)
      PeakEquity = equity;
}

//====================================================================
// RESET DAILY STATISTICS
//====================================================================

void ResetDailyStatisticsIfNeeded()
{
   static int savedDay = -1;

   MqlDateTime currentTime;
   TimeToStruct(TimeCurrent(),currentTime);

   if(savedDay == -1)
   {
      savedDay = currentTime.day;
      return;
   }

   if(currentTime.day != savedDay)
   {
      savedDay = currentTime.day;

      DayStartBalance =
         AccountInfoDouble(ACCOUNT_BALANCE);

      PeakEquity =
         AccountInfoDouble(ACCOUNT_EQUITY);

      ConsecutiveLosses = 0;

      Print("New trading day.");
      Print("Daily statistics reset.");
   }
}

//====================================================================
// DAILY LOSS PROTECTION
//====================================================================

bool DailyLossProtection()
{
   if(DailyLossLimitPercent <= 0.0)
      return true;

   if(DayStartBalance <= 0.0)
      return true;

   double equity =
      AccountInfoDouble(ACCOUNT_EQUITY);

   double lossPercent =
      ((DayStartBalance - equity) /
       DayStartBalance) * 100.0;

   if(lossPercent >= DailyLossLimitPercent)
   {
      Print("Daily loss protection BLOCKED trading.");

      return false;
   }

   return true;
}

//====================================================================
// MAXIMUM DRAWDOWN PROTECTION
//====================================================================

bool DrawdownProtection()
{
   if(MaximumDrawdownPercent <= 0.0)
      return true;

   if(PeakEquity <= 0.0)
      return true;

   double equity =
      AccountInfoDouble(ACCOUNT_EQUITY);

   double drawdownPercent =
      ((PeakEquity - equity) /
       PeakEquity) * 100.0;

   if(drawdownPercent >= MaximumDrawdownPercent)
   {
      Print("Maximum drawdown protection BLOCKED trading.");

      return false;
   }

   return true;
}

//====================================================================
// CONSECUTIVE LOSS PROTECTION
//====================================================================

bool ConsecutiveLossProtection()
{
   if(MaximumConsecutiveLosses <= 0)
      return true;

   if(ConsecutiveLosses >= MaximumConsecutiveLosses)
   {
      Print("Maximum consecutive losses reached: ",
            ConsecutiveLosses);

      return false;
   }

   return true;
}

//====================================================================
// GENERAL TRADE PERMISSION
//====================================================================

bool CanTrade()
{
   if(!TerminalInfoInteger(TERMINAL_TRADE_ALLOWED))
      return false;

   if(!MQLInfoInteger(MQL_TRADE_ALLOWED))
      return false;

   if(!DailyLossProtection())
      return false;

   if(!DrawdownProtection())
      return false;

   if(!ConsecutiveLossProtection())
      return false;

   return true;
}

//====================================================================
// LOT NORMALIZATION
//====================================================================

double NormalizeLot(double lot)
{
   double minimumLot =
      SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MIN);

   double maximumLot =
      SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MAX);

   double step =
      SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_STEP);

   if(step <= 0.0)
      step = 0.01;

   if(lot < minimumLot)
      lot = minimumLot;

   if(lot > maximumLot)
      lot = maximumLot;

   if(lot > MaximumLotSize)
      lot = MaximumLotSize;

   lot = MathFloor(lot / step) * step;

   if(lot < minimumLot)
      lot = minimumLot;

   return NormalizeDouble(lot,2);
}

//====================================================================
// DYNAMIC LOT
//====================================================================

double CalculateDynamicLot()
{
   double balance =
      AccountInfoDouble(ACCOUNT_BALANCE);

   double lot =
      balance * LotMultiplier;

   return NormalizeLot(lot);
}

//====================================================================
// COUNT EA POSITIONS
//====================================================================

int CountEAOpenPositions()
{
   int count = 0;

   int total = PositionsTotal();

   for(int i = total - 1; i >= 0; i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol =
         PositionGetString(POSITION_SYMBOL);

      long magic =
         PositionGetInteger(POSITION_MAGIC);

      if(symbol == _Symbol &&
         (ulong)magic == MagicNumber)
      {
         count++;
      }
   }

   return count;
}

//====================================================================
// EA EXPOSURE
//====================================================================

double GetEAExposureLots()
{
   double exposure = 0.0;

   int total = PositionsTotal();

   for(int i = total - 1; i >= 0; i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol =
         PositionGetString(POSITION_SYMBOL);

      long magic =
         PositionGetInteger(POSITION_MAGIC);

      if(symbol == _Symbol &&
         (ulong)magic == MagicNumber)
      {
         exposure +=
            PositionGetDouble(POSITION_VOLUME);
      }
   }

   return exposure;
}

//====================================================================
// HIGHEST HIGH
//====================================================================

double GetHighestHigh(int startShift,int count)
{
   double highest = -DBL_MAX;

   for(int i = startShift;
       i < startShift + count;
       i++)
   {
      double high =
         iHigh(_Symbol,PERIOD_M1,i);

      if(high > highest)
         highest = high;
   }

   return highest;
}

//====================================================================
// LOWEST LOW
//====================================================================

double GetLowestLow(int startShift,int count)
{
   double lowest = DBL_MAX;

   for(int i = startShift;
       i < startShift + count;
       i++)
   {
      double low =
         iLow(_Symbol,PERIOD_M1,i);

      if(low < lowest)
         lowest = low;
   }

   return lowest;
}

//====================================================================
// BULLISH STRUCTURE
//====================================================================

bool IsBullishStructure()
{
   if(Bars(_Symbol,PERIOD_M1) < 20)
      return false;

   double high1 = iHigh(_Symbol,PERIOD_M1,1);
   double high2 = iHigh(_Symbol,PERIOD_M1,2);

   double low1 = iLow(_Symbol,PERIOD_M1,1);
   double low2 = iLow(_Symbol,PERIOD_M1,2);

   return(high1 > high2 &&
          low1 > low2);
}

//====================================================================
// BEARISH STRUCTURE
//====================================================================

bool IsBearishStructure()
{
   if(Bars(_Symbol,PERIOD_M1) < 20)
      return false;

   double high1 = iHigh(_Symbol,PERIOD_M1,1);
   double high2 = iHigh(_Symbol,PERIOD_M1,2);

   double low1 = iLow(_Symbol,PERIOD_M1,1);
   double low2 = iLow(_Symbol,PERIOD_M1,2);

   return(high1 < high2 &&
          low1 < low2);
}

//====================================================================
// BULLISH CURRENT CANDLE MOMENTUM
//====================================================================

bool BullishMomentum()
{
   double open =
      iOpen(_Symbol,PERIOD_M1,0);

   double high =
      iHigh(_Symbol,PERIOD_M1,0);

   double low =
      iLow(_Symbol,PERIOD_M1,0);

   double bid =
      SymbolInfoDouble(_Symbol,SYMBOL_BID);

   double range = high - low;

   if(range <= 0.0)
      return false;

   if(bid <= open)
      return false;

   double body =
      MathAbs(bid - open);

   double bodyPercent =
      (body / range) * 100.0;

   return(bodyPercent >= MinimumBodyPercent);
}

//====================================================================
// BEARISH CURRENT CANDLE MOMENTUM
//====================================================================

bool BearishMomentum()
{
   double open =
      iOpen(_Symbol,PERIOD_M1,0);

   double high =
      iHigh(_Symbol,PERIOD_M1,0);

   double low =
      iLow(_Symbol,PERIOD_M1,0);

   double ask =
      SymbolInfoDouble(_Symbol,SYMBOL_ASK);

   double range = high - low;

   if(range <= 0.0)
      return false;

   if(ask >= open)
      return false;

   double body =
      MathAbs(ask - open);

   double bodyPercent =
      (body / range) * 100.0;

   return(bodyPercent >= MinimumBodyPercent);
}

//====================================================================
// BULLISH BREAKOUT
//====================================================================

bool BullishBreakout()
{
   double ask =
      SymbolInfoDouble(_Symbol,SYMBOL_ASK);

   double previousHigh =
      GetHighestHigh(1,BreakoutLookback);

   return(ask > previousHigh);
}

//====================================================================
// BEARISH BREAKOUT
//====================================================================

bool BearishBreakout()
{
   double bid =
      SymbolInfoDouble(_Symbol,SYMBOL_BID);

   double previousLow =
      GetLowestLow(1,BreakoutLookback);

   return(bid < previousLow);
}//====================================================================
// AI-STYLE M1 SIGNAL SCORE
//====================================================================

bool GetCurrentSignal(int &signal,
                      double &buyScore,
                      double &sellScore)
{
   signal = 0;
   buyScore = 0.0;
   sellScore = 0.0;

   if(Bars(_Symbol,PERIOD_M1) < 20)
      return false;

   //===============================================================
   // BUY SCORE
   //===============================================================

   if(IsBullishStructure())
      buyScore += 30.0;

   if(BullishMomentum())
      buyScore += 30.0;

   if(BullishBreakout())
      buyScore += 25.0;

   double bid =
      SymbolInfoDouble(_Symbol,SYMBOL_BID);

   double open =
      iOpen(_Symbol,PERIOD_M1,0);

   if(bid > open)
      buyScore += 15.0;

   //===============================================================
   // SELL SCORE
   //===============================================================

   if(IsBearishStructure())
      sellScore += 30.0;

   if(BearishMomentum())
      sellScore += 30.0;

   if(BearishBreakout())
      sellScore += 25.0;

   double ask =
      SymbolInfoDouble(_Symbol,SYMBOL_ASK);

   if(ask < open)
      sellScore += 15.0;

   //===============================================================
   // FINAL DECISION
   //===============================================================

   if(buyScore >= SignalThreshold &&
      buyScore > sellScore)
   {
      signal = 1;
      return true;
   }

   if(sellScore >= SignalThreshold &&
      sellScore > buyScore)
   {
      signal = -1;
      return true;
   }

   return false;
}

//====================================================================
// OPEN BUY
//====================================================================

bool OpenBuy()
{
   if(!CanTrade())
      return false;

   if(CountEAOpenPositions() >=
      MaximumOpenPositions)
      return false;

   double lot =
      CalculateDynamicLot();

   if(lot <= 0.0)
      return false;

   if(MaximumEAExposureLots > 0.0)
   {
      double exposure =
         GetEAExposureLots();

      if(exposure + lot >
         MaximumEAExposureLots)
      {
         Print("BUY blocked by exposure limit.");
         return false;
      }
   }

   bool result =
      trade.Buy(
         lot,
         _Symbol,
         0.0,
         0.0,
         0.0,
         "M1 FLIP BUY"
      );

   if(result)
   {
      Print("BUY OPENED. Lot = ",
            DoubleToString(lot,2));

      return true;
   }

   Print("BUY failed: ",
         trade.ResultRetcodeDescription());

   return false;
}

//====================================================================
// OPEN SELL
//====================================================================

bool OpenSell()
{
   if(!CanTrade())
      return false;

   if(CountEAOpenPositions() >=
      MaximumOpenPositions)
      return false;

   double lot =
      CalculateDynamicLot();

   if(lot <= 0.0)
      return false;

   if(MaximumEAExposureLots > 0.0)
   {
      double exposure =
         GetEAExposureLots();

      if(exposure + lot >
         MaximumEAExposureLots)
      {
         Print("SELL blocked by exposure limit.");
         return false;
      }
   }

   bool result =
      trade.Sell(
         lot,
         _Symbol,
         0.0,
         0.0,
         0.0,
         "M1 FLIP SELL"
      );

   if(result)
   {
      Print("SELL OPENED. Lot = ",
            DoubleToString(lot,2));

      return true;
   }

   Print("SELL failed: ",
         trade.ResultRetcodeDescription());

   return false;
}

//====================================================================
// CLOSE POSITION
//====================================================================

bool ClosePositionByTicket(ulong ticket)
{
   if(!PositionSelectByTicket(ticket))
      return false;

   bool result =
      trade.PositionClose(ticket);

   if(!result)
   {
      Print("Close failed. Ticket ",
            ticket,
            " : ",
            trade.ResultRetcodeDescription());

      return false;
   }

   return true;
}

//====================================================================
// CHECK POSITIONS AND FLIP
//====================================================================

void CheckPositionsAndFlip()
{
   int signal;

   double buyScore;
   double sellScore;

   if(!GetCurrentSignal(
         signal,
         buyScore,
         sellScore))
   {
      return;
   }

   int total =
      PositionsTotal();

   for(int i = total - 1;
       i >= 0;
       i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol =
         PositionGetString(POSITION_SYMBOL);

      long magic =
         PositionGetInteger(POSITION_MAGIC);

      if(symbol != _Symbol ||
         (ulong)magic != MagicNumber)
         continue;

      ENUM_POSITION_TYPE type =
         (ENUM_POSITION_TYPE)
         PositionGetInteger(POSITION_TYPE);

      //============================================================
      // BUY -> SELL
      //============================================================

      if(type == POSITION_TYPE_BUY &&
         signal == -1 &&
         sellScore >= ReversalThreshold)
      {
         Print("SELL reversal detected.");
         Print("BUY score = ",
               DoubleToString(buyScore,1),
               " | SELL score = ",
               DoubleToString(sellScore,1));

         if(ClosePositionByTicket(ticket))
         {
            if(CountEAOpenPositions() == 0)
               OpenSell();
         }

         continue;
      }

      //============================================================
      // SELL -> BUY
      //============================================================

      if(type == POSITION_TYPE_SELL &&
         signal == 1 &&
         buyScore >= ReversalThreshold)
      {
         Print("BUY reversal detected.");
         Print("BUY score = ",
               DoubleToString(buyScore,1),
               " | SELL score = ",
               DoubleToString(sellScore,1));

         if(ClosePositionByTicket(ticket))
         {
            if(CountEAOpenPositions() == 0)
               OpenBuy();
         }

         continue;
      }
   }
}

//====================================================================
// CHECK NEW ENTRY
//====================================================================

void CheckForNewEntry()
{
   if(CountEAOpenPositions() > 0)
      return;

   if(!CanTrade())
      return;

   int signal;

   double buyScore;
   double sellScore;

   if(!GetCurrentSignal(
         signal,
         buyScore,
         sellScore))
   {
      return;
   }

   if(signal == 1 &&
      buyScore >= SignalThreshold)
   {
      OpenBuy();
      return;
   }

   if(signal == -1 &&
      sellScore >= SignalThreshold)
   {
      OpenSell();
      return;
   }
}

//====================================================================
// INITIALIZE HISTORY TRACKER
//====================================================================

void InitializeHistoryTracker()
{
   LastProcessedDealTicket = 0;

   datetime fromTime =
      TimeCurrent() - 86400;

   datetime toTime =
      TimeCurrent();

   if(!HistorySelect(fromTime,toTime))
      return;

   int total =
      HistoryDealsTotal();

   for(int i = total - 1;
       i >= 0;
       i--)
   {
      ulong ticket =
         HistoryDealGetTicket(i);

      if(ticket == 0)
         continue;

      string symbol =
         HistoryDealGetString(
            ticket,
            DEAL_SYMBOL
         );

      long magic =
         HistoryDealGetInteger(
            ticket,
            DEAL_MAGIC
         );

      long entry =
         HistoryDealGetInteger(
            ticket,
            DEAL_ENTRY
         );

      if(symbol == _Symbol &&
         (ulong)magic == MagicNumber &&
         (entry == DEAL_ENTRY_OUT ||
          entry == DEAL_ENTRY_OUT_BY))
      {
         LastProcessedDealTicket =
            ticket;

         return;
      }
   }
}

//====================================================================
// UPDATE CONSECUTIVE LOSSES
//====================================================================

void UpdateConsecutiveLosses()
{
   datetime fromTime =
      TimeCurrent() - 86400;

   datetime toTime =
      TimeCurrent();

   if(!HistorySelect(fromTime,toTime))
      return;

   int total =
      HistoryDealsTotal();

   for(int i = 0;
       i < total;
       i++)
   {
      ulong ticket =
         HistoryDealGetTicket(i);

      if(ticket == 0)
         continue;

      if(ticket <= LastProcessedDealTicket)
         continue;

      string symbol =
         HistoryDealGetString(
            ticket,
            DEAL_SYMBOL
         );

      long magic =
         HistoryDealGetInteger(
            ticket,
            DEAL_MAGIC
         );

      if(symbol != _Symbol ||
         (ulong)magic != MagicNumber)
         continue;

      long entry =
         HistoryDealGetInteger(
            ticket,
            DEAL_ENTRY
         );

      if(entry != DEAL_ENTRY_OUT &&
         entry != DEAL_ENTRY_OUT_BY)
         continue;

      double profit =
         HistoryDealGetDouble(
            ticket,
            DEAL_PROFIT
         );

      double swap =
         HistoryDealGetDouble(
            ticket,
            DEAL_SWAP
         );

      double commission =
         HistoryDealGetDouble(
            ticket,
            DEAL_COMMISSION
         );

      double netResult =
         profit + swap + commission;

      if(netResult < 0.0)
      {
         ConsecutiveLosses++;

         Print(
            "LOSS recorded. Consecutive losses = ",
            ConsecutiveLosses
         );
      }
      else if(netResult > 0.0)
      {
         ConsecutiveLosses = 0;

         Print(
            "PROFIT recorded. Consecutive losses reset."
         );
      }

      LastProcessedDealTicket = ticket;
   }

   UpdateButtonState();
}

