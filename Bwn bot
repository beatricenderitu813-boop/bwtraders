      DoubleToString(
         BuyPercent,1) +
      "%");

   SetLabelText(
      "BWN_SELL",
      "SELL: " +
      DoubleToString(
         SellPercent,1) +
      "%");

   SetLabelText(
      "BWN_STATUS",
      status);

   SetLabelText(
      "BWN_TF",
      "TIMEFRAME: " +
      TimeframeToString(
         TradingTimeframe));

   SetLabelText(
      "BWN_TRADES",
      "TRADES: " +
      IntegerToString(trades) +
      "/2  ADD MAX: 3");

   SetLabelText(
      "BWN_BASKET",
      "BASKET: $" +
      DoubleToString(
         basketProfit,2));

   SetLabelText(
