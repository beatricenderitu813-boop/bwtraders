#include <Trade/Trade.mqh>

CTrade trade;

//--- Trading direction
enum BWN_DIRECTION
{
   DIR_NONE = 0,
   DIR_BUY  = 1,
   DIR_SELL = -1
};

//--- Inputs
input group "=== BWN GENERAL SETTINGS ==="
input ENUM_TIMEFRAMES SignalTimeframe = PERIOD_M1;
input double EntryStrength = 55.0;
input double ReversalStrength = 65.0;
input double ProfitRetracePercent = 2.0;
input double SessionProfitTarget = 1000.0;

input group "=== LOT SIZE SETTINGS ==="
input bool UseAutomaticLot = true;
input double ManualLotSize = 0.01;
input double BalanceStep = 10.0;
input double LotStepPerBalance = 0.01;
input double MaximumLotSize = 10.0;

input group "=== ACCOUNT EXPOSURE ==="
input double MaximumMarginPercent = 50.0;
input int MaximumOpenTrades = 100;

input group "=== PROTECTION ==="
input double DailyLossLimitPercent = 2.0;
input double MaximumDrawdownPercent = 5.0;
input int MaximumConsecutiveLosses = 3;
input double MaximumSpreadPips = 5.0;
input int SlippagePoints = 20;

input group "=== IDENTIFICATION ==="
input ulong MagicNumber = 26090801;

input group "=== STARTUP ==="
input bool StartTradingOnAttach = false;

//--- Global state
bool g_trading_enabled = false;
bool g_session_finished = false;

double g_session_start_balance = 0.0;
double g_session_start_equity  = 0.0;
double g_peak_basket_profit    = 0.0;

int g_current_direction = DIR_NONE;
int g_consecutive_losses = 0;

datetime g_session_start_time = 0;

//--- Button names
string BTN_START     = "BWN_START_BUTTON";
string BTN_STOP      = "BWN_STOP_BUTTON";
string BTN_EMERGENCY = "BWN_EMERGENCY_BUTTON";
string LBL_STATUS    = "BWN_STATUS_LABEL";

