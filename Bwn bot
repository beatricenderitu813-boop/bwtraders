//====================================================================
// CAN OPEN TRADE
//====================================================================

bool CanOpenTrade(
   int direction,
   double lot)
{
   if(direction != BWN_BUY &&
      direction != BWN_SELL)
   {
      return false;
   }

   if(lot <= 0.0)
      return false;

   if(CountBWNPositions() >=
      MaximumOpenTrades)
   {
      return false;
   }

   double equity =
      AccountInfoDouble(
         ACCOUNT_EQUITY);

   double current_margin =
      AccountInfoDouble(
         ACCOUNT_MARGIN);

   double free_margin =
      AccountInfoDouble(
         ACCOUNT_MARGIN_FREE);

   if(equity <= 0.0)
      return false;

   if(free_margin <= 0.0)
      return false;

   double maximum_margin =
      equity *
      MaximumMarginPercent /
      100.0;

   if(current_margin >=
      maximum_margin)
   {
      return false;
   }

   ENUM_ORDER_TYPE order_type =
      ORDER_TYPE_BUY;

   double price =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_ASK);

   if(direction == BWN_SELL)
   {
      order_type =
         ORDER_TYPE_SELL;

      price =
         SymbolInfoDouble(
            _Symbol,
            SYMBOL_BID);
   }

   if(price <= 0.0)
      return false;

   double required_margin =
      0.0;

   if(!OrderCalcMargin(
         order_type,
         _Symbol,
         lot,
         price,
         required_margin))
   {
      Print(
         "BWN OrderCalcMargin failed. Error=",
         GetLastError());

      return false;
   }

   if(required_margin <= 0.0)
      return false;

   if(required_margin >
      free_margin)
   {
      return false;
   }

   if(current_margin +
      required_margin >
      maximum_margin)
   {
      return false;
   }

   return true;
}

//====================================================================
// OPEN ONE TRADE
//====================================================================

bool OpenOneTrade(
   int direction,
   double lot)
{
   bool result = false;

   ResetLastError();

   if(direction == BWN_BUY)
   {
      result =
         trade.Buy(
            lot,
            _Symbol,
            0.0,
            0.0,
            0.0,
            "BWN BUY");
   }
   else if(direction == BWN_SELL)
   {
      result =
         trade.Sell(
            lot,
            _Symbol,
            0.0,
            0.0,
            0.0,
            "BWN SELL");
   }

   if(!result)
   {
      Print(
         "BWN ORDER FAILED | Retcode=",
         trade.ResultRetcode(),
         " | ",
         trade.ResultRetcodeDescription(),
         " | Error=",
         GetLastError());

      return false;
   }

   Print(
      "BWN ORDER OPENED | Direction=",
      direction == BWN_BUY ? "BUY" : "SELL",
      " | Lot=",
      DoubleToString(
         lot,
         GetVolumeDigits()),
      " | Ticket=",
      trade.ResultOrder());

   return true;
}

//====================================================================
// OPEN MULTIPLE TRADES
//====================================================================

int OpenMultipleTrades(
   int direction)
{
   if(direction != BWN_BUY &&
      direction != BWN_SELL)
   {
      return 0;
   }

   double lot =
      GetBWNLot();

   if(lot <= 0.0)
      return 0;

   int opened = 0;

   BWN_Direction =
      direction;

   for(int i = 0;
       i < MaximumOpenTrades;
       i++)
   {
      if(!BWN_Running)
         break;

      if(CountBWNPositions() >=
         MaximumOpenTrades)
      {
         break;
      }

      // Check CURRENT M1 direction before each order.
      int live_direction =
         GetLiveDirection();

      if(live_direction !=
         direction)
      {
         break;
      }

      // Strong reversal protection.
      double buy =
         GetBuyStrength();

      double sell =
         GetSellStrength();

      if(direction == BWN_BUY &&
         sell >= ReversalStrengthPercent)
      {
         break;
      }

      if(direction == BWN_SELL &&
         buy >= ReversalStrengthPercent)
      {
         break;
      }

      if(!CanOpenTrade(
            direction,
            lot))
      {
         break;
      }

      if(OpenOneTrade(
            direction,
            lot))
      {
         opened++;
      }
      else
      {
         break;
      }
   }

   if(opened > 0)
   {
      BWN_PeakProfit =
         0.0;

      Print(
         "BWN opened ",
         opened,
         " position(s).");
   }

   return opened;
}

//====================================================================
// IMMEDIATE CURRENT-CANDLE SCAN
//====================================================================

void ImmediateRescanAndOpen()
{
   if(!BWN_Running)
      return;

   if(BWN_TargetReached)
      return;

   if(BWN_ProtectionStop)
      return;

   // Read CURRENT M1 candle.
   double buy =
      GetBuyStrength();

   double sell =
      GetSellStrength();

   int direction =
      GetLiveDirection();

   Print(
      "BWN LIVE SCAN | BUY=",
      DoubleToString(
         buy,
         2),
      "% | SELL=",
      DoubleToString(
         sell,
         2),
      "%");

   if(direction == BWN_NONE)
      return;

   OpenMultipleTrades(
      direction);
}

//====================================================================
// PROFIT RETRACEMENT
//
// Example:
// Peak = $100
// 2% = $2
// Close when basket falls to $98.
//====================================================================

void ManageProfitRetracement()
{
   double profit =
      GetBWNFloatProfit();

   // We only protect a basket once it is profitable.
   if(profit <= 0.0)
      return;

   if(profit >
      BWN_PeakProfit)
   {
      BWN_PeakProfit =
         profit;
   }

   if(BWN_PeakProfit <= 0.0)
      return;

   double retracement =
      BWN_PeakProfit *
      ProfitRetracePercent /
      100.0;

   double close_level =
      BWN_PeakProfit -
      retracement;

   if(profit <=
      close_level)
   {
      Print(
         "BWN PROFIT RETRACEMENT | Peak=$",
         DoubleToString(
            BWN_PeakProfit,
            2),
         " | Current=$",
         DoubleToString(
            profit,
            2),
         " | Retracement=",
         DoubleToString(
            ProfitRetracePercent,
            2),
         "%");

      CloseAllBWNPositions();

      ResetBasket();

      // IMPORTANT:
      // NO WAIT FOR CANDLE CLOSE.
      // Immediately scan the same live M1 candle.
      if(BWN_Running)
      {
         ImmediateRescanAndOpen();
      }
   }
}

//====================================================================
// STRONG REVERSAL
//====================================================================

void ManageStrongReversal()
{
   if(CountBWNPositions() <= 0)
      return;

   double buy =
      GetBuyStrength();

   double sell =
      GetSellStrength();

   //===============================================================
   // BUY -> SELL
   //===============================================================

   if(BWN_Direction == BWN_BUY &&
      sell >= ReversalStrengthPercent)
   {
      Print(
         "BWN STRONG REVERSAL BUY -> SELL | SELL=",
         DoubleToString(
            sell,
            2),
         "%");

      CloseAllBWNPositions();

      ResetBasket();

      // Immediately re-check CURRENT M1 candle.
      buy =
         GetBuyStrength();

      sell =
         GetSellStrength();

      if(sell >=
         ReversalStrengthPercent &&
         sell > buy)
      {
         OpenMultipleTrades(
            BWN_SELL);
      }

      return;
   }

   //===============================================================
   // SELL -> BUY
   //===============================================================

   if(BWN_Direction == BWN_SELL &&
      buy >= ReversalStrengthPercent)
   {
      Print(
         "BWN STRONG REVERSAL SELL -> BUY | BUY=",
         DoubleToString(
            buy,
            2),
         "%");

      CloseAllBWNPositions();

      ResetBasket();

      // Immediately re-check CURRENT M1 candle.
      buy =
         GetBuyStrength();

      sell =
         GetSellStrength();

      if(buy >=
         ReversalStrengthPercent &&
         buy > sell)
      {
         OpenMultipleTrades(
            BWN_BUY);
      }

      return;
   }
}

//====================================================================
// MAINTAIN / REPLACE POSITIONS
//====================================================================

void MaintainTrades()
{
   if(!BWN_Running)
      return;

   int live_direction =
      GetLiveDirection();

   if(live_direction == BWN_NONE)
      return;

   double buy =
      GetBuyStrength();

   double sell =
      GetSellStrength();

   //===============================================================
   // Strong reversal is handled separately.
   //===============================================================

   if(BWN_Direction == BWN_BUY &&
      sell >= ReversalStrengthPercent)
   {
      return;
   }

   if(BWN_Direction == BWN_SELL &&
      buy >= ReversalStrengthPercent)
   {
      return;
   }

   //===============================================================
   // SAME DIRECTION
   //
   // If some trades closed, immediately replace them.
   //===============================================================

   if(live_direction ==
      BWN_Direction)
   {
      double lot =
         GetBWNLot();

      while(
         CountBWNPositions() <
         MaximumOpenTrades)
      {
         if(!BWN_Running)
            break;

         // Re-read CURRENT M1 candle.
         int current_direction =
            GetLiveDirection();

         if(current_direction !=
            live_direction)
         {
            break;
         }

         buy =
            GetBuyStrength();

         sell =
            GetSellStrength();

         if(live_direction == BWN_BUY &&
            sell >= ReversalStrengthPercent)
         {
            break;
         }

         if(live_direction == BWN_SELL &&
            buy >= ReversalStrengthPercent)
         {
            break;
         }

         if(!CanOpenTrade(
               live_direction,
               lot))
         {
            break;
         }

         if(!OpenOneTrade(
               live_direction,
               lot))
         {
            break;
         }
      }
   }
}
//====================================================================
// CLOSE ALL BWN POSITIONS
//====================================================================

bool CloseAllBWNPositions()
{
   bool success = true;

   for(int i =
       PositionsTotal() - 1;
       i >= 0;
       i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      ulong magic =
         (ulong)PositionGetInteger(
            POSITION_MAGIC);

      string symbol =
         PositionGetString(
            POSITION_SYMBOL);

      if(magic != MagicNumber ||
         symbol != _Symbol)
      {
         continue;
      }

      ResetLastError();

      if(!trade.PositionClose(
            ticket))
      {
         success = false;

         Print(
            "BWN CLOSE FAILED | Ticket=",
            ticket,
            " | Retcode=",
            trade.ResultRetcode(),
            " | ",
            trade.ResultRetcodeDescription(),
            " | Error=",
            GetLastError());
      }
      else
      {
         Print(
            "BWN POSITION CLOSED | Ticket=",
            ticket);
      }
   }

   return success;
}

//====================================================================
// RESET BASKET
//====================================================================

void ResetBasket()
{
   BWN_PeakProfit =
      0.0;

   BWN_Direction =
      BWN_NONE;
}

//====================================================================
// CLOSED SESSION PROFIT
//====================================================================

double GetClosedSessionProfit()
{
   if(!HistorySelect(
         BWN_StartTime,
         TimeCurrent()))
   {
      return 0.0;
   }

   double total = 0.0;

   int deals =
      HistoryDealsTotal();

   for(int i = 0;
       i < deals;
       i++)
   {
      ulong ticket =
         HistoryDealGetTicket(i);

      if(ticket == 0)
         continue;

      ulong magic =
         (ulong)HistoryDealGetInteger(
            ticket,
            DEAL_MAGIC);

      string symbol =
         HistoryDealGetString(
            ticket,
            DEAL_SYMBOL);

      if(magic != MagicNumber ||
         symbol != _Symbol)
      {
         continue;
      }

      long entry =
         HistoryDealGetInteger(
            ticket,
            DEAL_ENTRY);

      if(entry != DEAL_ENTRY_OUT &&
         entry != DEAL_ENTRY_OUT_BY)
      {
         continue;
      }

      total +=
         HistoryDealGetDouble(
            ticket,
            DEAL_PROFIT);

      total +=
         HistoryDealGetDouble(
            ticket,
            DEAL_SWAP);

      total +=
         HistoryDealGetDouble(
            ticket,
            DEAL_COMMISSION);
   }

   return total;
}

//====================================================================
// TOTAL SESSION PROFIT
//====================================================================

double GetSessionProfit()
{
   return
      GetClosedSessionProfit()
      +
      GetBWNFloatProfit();
}

