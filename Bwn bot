//====================================================================
// ON INIT
//====================================================================

int OnInit()
{
   trade.SetExpertMagicNumber(MagicNumber);
   trade.SetDeviationInPoints(SlippagePoints);

   // Let MT5 choose the correct filling mode for the symbol.
   trade.SetTypeFillingBySymbol(_Symbol);

   // Use the broker/account margin mode.
   trade.SetMarginMode();

   SessionStartBalance = AccountInfoDouble(ACCOUNT_BALANCE);
   SessionStartTime = TimeCurrent();

   BasketPeakProfit = 0.0;

   BotRunning = false;
   EmergencyMode = false;

   CurrentDirection = 0;

   CreateInterface();
   UpdateScanner();
   UpdateInterface();

   EventSetTimer(1);

   Print("BWN Bot initialized successfully.");
   Print("Symbol: ", _Symbol);
   Print("Trading timeframe: ", TimeframeToString(TradingTimeframe));

   return(INIT_SUCCEEDED);
}

//====================================================================
// ON DEINIT
//====================================================================

void OnDeinit(const int reason)
{
   EventKillTimer();
   DeleteInterface();

   Print("BWN Bot deinitialized. Reason: ", reason);
}

//====================================================================
// ON TICK
//====================================================================

void OnTick()
{
   UpdateScanner();

   // Emergency mode prevents new trading.
   if(EmergencyMode)
   {
      ManageBasket();
      UpdateInterface();
      return;
   }

   // Basket management continues while the bot is running.
   if(BotRunning)
   {
      ManageBasket();

      CheckSessionTarget();

      if(BotRunning && !EmergencyMode)
         TradingLogic();
   }

   UpdateInterface();
}

//====================================================================
// ON TIMER
//====================================================================

void OnTimer()
{
   UpdateScanner();

   if(BotRunning && !EmergencyMode)
   {
      ManageBasket();
      CheckSessionTarget();
   }

   UpdateInterface();
}

//====================================================================
// CHART EVENTS
//====================================================================

void OnChartEvent(const int id,
                  const long &lparam,
                  const double &dparam,
                  const string &sparam)
{
   if(id != CHARTEVENT_OBJECT_CLICK)
      return;

   //===============================================================
   // START
   //===============================================================

   if(sparam == "BWN_START")
   {
      EmergencyMode = false;
      BotRunning = true;

      // Starting manually creates a fresh session target.
      SessionStartBalance = AccountInfoDouble(ACCOUNT_BALANCE);
      SessionStartTime = TimeCurrent();

      BasketPeakProfit = 0.0;

      Print("BWN Bot STARTED. New session target: ",
            DoubleToString(SessionTargetMoney,2));

      UpdateScanner();
      TradingLogic();
      UpdateInterface();

      return;
   }

   //===============================================================
   // STOP
   //===============================================================

   if(sparam == "BWN_STOP")
   {
      BotRunning = false;

      Print("BWN Bot STOPPED. Existing positions remain open.");

      UpdateInterface();
      return;
   }

   //===============================================================
   // EMERGENCY
   //===============================================================

   if(sparam == "BWN_EMERGENCY")
   {
      EmergencyMode = true;
      BotRunning = false;

      Print("BWN BOT EMERGENCY MODE ACTIVATED.");

      // Emergency means close this EA's positions.
      CloseAllBotPositions();

      BasketPeakProfit = 0.0;

      UpdateInterface();
      return;
   }
}

//====================================================================
// UPDATE CURRENT FORMING CANDLE SCANNER
//====================================================================

void UpdateScanner()
{
   MqlRates candle[];

   ArraySetAsSeries(candle,true);

   int copied = CopyRates(_Symbol,
                          TradingTimeframe,
                          0,
                          1,
                          candle);

   if(copied < 1)
   {
      BuyPercent = 50.0;
      SellPercent = 50.0;
      CurrentDirection = 0;
      return;
   }

   // IMPORTANT:
   // candle[0] is the CURRENT FORMING CANDLE.
   double openPrice = candle[0].open;
   double highPrice = candle[0].high;
   double lowPrice  = candle[0].low;

   double bid = SymbolInfoDouble(_Symbol,SYMBOL_BID);

   if(bid <= 0.0)
      return;

   double range = highPrice - lowPrice;

   if(range <= 0.0)
   {
      BuyPercent = 50.0;
      SellPercent = 50.0;
      CurrentDirection = 0;
      return;
   }

   // Position of current price inside the current candle.
   double positionPercent =
      ((bid - lowPrice) / range) * 100.0;

   if(positionPercent < 0.0)
      positionPercent = 0.0;

   if(positionPercent > 100.0)
      positionPercent = 100.0;

   //===============================================================
   // BULLISH CURRENT CANDLE
   //===============================================================

   if(bid > openPrice)
   {
      BuyPercent = 50.0 + (positionPercent * 0.50);
      SellPercent = 100.0 - BuyPercent;

      CurrentDirection = 1;
   }

   //===============================================================
   // BEARISH CURRENT CANDLE
   //===============================================================

   else if(bid < openPrice)
   {
      SellPercent = 50.0 + ((100.0 - positionPercent) * 0.50);
      BuyPercent = 100.0 - SellPercent;

      CurrentDirection = -1;
   }

   //===============================================================
   // PRICE AT OPEN
   //===============================================================

   else
   {
      BuyPercent = 50.0;
      SellPercent = 50.0;
      CurrentDirection = 0;
   }

   if(BuyPercent < 0.0)
      BuyPercent = 0.0;

   if(BuyPercent > 100.0)
      BuyPercent = 100.0;

   if(SellPercent < 0.0)
      SellPercent = 0.0;

   if(SellPercent > 100.0)
      SellPercent = 100.0;
}

//====================================================================
// TRADING LOGIC
//====================================================================

void TradingLogic()
{
   if(!BotRunning || EmergencyMode)
      return;

   if(!TradingAllowed())
      return;

   UpdateScanner();

   int totalPositions = CountBotPositions();

   //===============================================================
   // NO POSITIONS
   //===============================================================

   if(totalPositions == 0)
   {
      BasketPeakProfit = 0.0;

      if(BuyPercent >= EntryStrengthPercent &&
         BuyPercent >= SellPercent)
      {
         OpenBuy();
         return;
      }

      if(SellPercent >= EntryStrengthPercent &&
         SellPercent > BuyPercent)
      {
         OpenSell();
         return;
      }

      return;
   }

   //===============================================================
   // EXISTING BUY POSITIONS
   //===============================================================

   int buyPositions = CountBotPositionsByType(POSITION_TYPE_BUY);
   int sellPositions = CountBotPositionsByType(POSITION_TYPE_SELL);

   // Immediate reversal:
   // SELL reaches 65% while BUY positions exist.
   if(buyPositions > 0 &&
      SellPercent >= ReverseStrengthPercent)
   {
      Print("SELL reversal signal detected at ",
            DoubleToString(SellPercent,1), "%.");

      if(CloseDirection(POSITION_TYPE_BUY))
      {
         if(CountBotPositionsByType(POSITION_TYPE_BUY) == 0)
            OpenSell();
      }

      return;
   }

   //===============================================================
   // EXISTING SELL POSITIONS
   //===============================================================

   // Immediate reversal:
   // BUY reaches 65% while SELL positions exist.
   if(sellPositions > 0 &&
      BuyPercent >= ReverseStrengthPercent)
   {
      Print("BUY reversal signal detected at ",
            DoubleToString(BuyPercent,1), "%.");

      if(CloseDirection(POSITION_TYPE_SELL))
      {
         if(CountBotPositionsByType(POSITION_TYPE_SELL) == 0)
            OpenBuy();
      }

      return;
   }

   //===============================================================
   // NORMAL SECOND POSITION
   //===============================================================

   if(totalPositions < NormalMaximumPositions)
   {
      if(BuyPositionsDirectionValid())
      {
         OpenBuy();
         return;
      }

      if(SellPositionsDirectionValid())
      {
         OpenSell();
         return;
      }
   }

   //===============================================================
   // NEW SPECIAL RULE
   //
   // Exactly 2 positions are open.
   // BOTH are losing.
   // Allow ONE additional position in current candle direction.
   // Maximum becomes 3.
   //===============================================================

   if(totalPositions == NormalMaximumPositions)
   {
      if(AllTwoPositionsAreLosing())
      {
         Print("Both normal positions are losing.");

         if(CurrentDirection == 1 &&
            BuyPercent >= EntryStrengthPercent)
         {
            Print("Adding one BUY position because both positions are losing.");
            OpenBuy();
            return;
         }

         if(CurrentDirection == -1 &&
            SellPercent >= EntryStrengthPercent)
         {
            Print("Adding one SELL position because both positions are losing.");
            OpenSell();
            return;
         }
      }
   }

   // If 3 positions are open, no further additions.
}

//====================================================================
// HELPER: VALID BUY DIRECTION
//====================================================================

bool BuyPositionsDirectionValid()
{
   if(BuyPercent >= EntryStrengthPercent &&
      BuyPercent >= SellPercent)
      return true;

   return false;
}

//====================================================================
// HELPER: VALID SELL DIRECTION
//====================================================================

bool SellPositionsDirectionValid()
{
   if(SellPercent >= EntryStrengthPercent &&
      SellPercent > BuyPercent)
      return true;

   return false;
}

