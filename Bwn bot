void UpdateInterface()
{
   double basketProfit = GetBasketProfit();

   int totalTrades = CountBotPositions();

   double balance = AccountInfoDouble(ACCOUNT_BALANCE);

   double sessionProfit =
      (balance - SessionStartBalance) +
      basketProfit;

   string status;

   if(EmergencyMode)
      status = "STATUS: EMERGENCY";
   else if(BotRunning)
      status = "STATUS: RUNNING";
   else
      status = "STATUS: STOPPED";

   SetLabelText("BWN_BUY",
                "BUY: " +
                DoubleToString(BuyPercent,1) +
                "%");

   SetLabelText("BWN_SELL",
                "SELL: " +
                DoubleToString(SellPercent,1) +
                "%");

   SetLabelText("BWN_STATUS",
                status);

   SetLabelText("BWN_TF",
                "TIMEFRAME: " +
                TimeframeToString(TradingTimeframe));

   SetLabelText("BWN_TRADES",
                "TRADES: " +
                IntegerToString(totalTrades) +
                "/" +
                IntegerToString(NormalMaximumPositions) +
                "  ADD MAX: " +
                IntegerToString(MaximumPositionsWithAdd));

   SetLabelText("BWN_BASKET",
                "BASKET: $" +
                DoubleToString(basketProfit,2));

   SetLabelText("BWN_PEAK",
                "PEAK: $" +
                DoubleToString(BasketPeakProfit,2));

   SetLabelText("BWN_TARGET",
                "TARGET: $" +
                DoubleToString(sessionProfit,2) +
                " / $" +
                DoubleToString(SessionTargetMoney,2));

   SetLabelText("BWN_DIRECTION",
                "DIRECTION: " +
                DirectionToString(CurrentDirection));
}

//====================================================================
// CREATE LABEL
//====================================================================

void CreateLabel(string name,
                 string text,
                 int x,
                 int y,
                 int fontSize)
{
   if(ObjectFind(0,name) >= 0)
      ObjectDelete(0,name);

   if(!ObjectCreate(0,
                    name,
                    OBJ_LABEL,
                    0,
                    0,
                    0))
   {
      Print("Failed to create label: ",name);
      return;
   }

   ObjectSetInteger(0,name,OBJPROP_CORNER,CORNER_LEFT_UPPER);
   ObjectSetInteger(0,name,OBJPROP_XDISTANCE,x);
   ObjectSetInteger(0,name,OBJPROP_YDISTANCE,y);
   ObjectSetInteger(0,name,OBJPROP_FONTSIZE,fontSize);
   ObjectSetString(0,name,OBJPROP_FONT,"Arial");
   ObjectSetString(0,name,OBJPROP_TEXT,text);

   ObjectSetInteger(0,name,
                    OBJPROP_SELECTABLE,false);

   ObjectSetInteger(0,name,
                    OBJPROP_HIDDEN,true);
}

