//====================================================================
// LIVE DIRECTION
//====================================================================

int GetLiveDirection()
{
   double buy =
      GetBuyStrength();

   double sell =
      GetSellStrength();

   if(buy >= EntryStrengthPercent &&
      buy > sell)
   {
      return(BWN_BUY);
   }

   if(sell >= EntryStrengthPercent &&
      sell > buy)
   {
      return(BWN_SELL);
   }

   return(BWN_NONE);
}

//====================================================================
// VOLUME DIGITS
//====================================================================

int GetVolumeDigits()
{
   double step =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_VOLUME_STEP);

   if(step >= 1.0)
      return(0);

   if(step >= 0.1)
      return(1);

   if(step >= 0.01)
      return(2);

   return(3);
}

//====================================================================
// NORMALIZE LOT
//====================================================================

double NormalizeBWNLot(double lot)
{
   double min_lot =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_VOLUME_MIN);

   double max_lot =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_VOLUME_MAX);

   double step =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_VOLUME_STEP);

   if(step <= 0.0)
      step = 0.01;

   if(lot < min_lot)
      lot = min_lot;

   if(lot > max_lot)
      lot = max_lot;

   if(lot > MaximumLotSize)
      lot = MaximumLotSize;

   lot =
      MathFloor(
         lot / step + 0.0000001)
      * step;

   if(lot < min_lot)
      lot = min_lot;

   return(
      NormalizeDouble(
         lot,
         GetVolumeDigits()));
}

//====================================================================
// AUTOMATIC LOT
//
// $0-$9.99       = 0.01
// $10-$19.99     = 0.02
// $20-$29.99     = 0.03
// $30-$39.99     = 0.04
// etc.
//====================================================================

double GetBWNLot()
{
   if(!UseAutomaticLot)
   {
      return(
         NormalizeBWNLot(
            ManualLotSize));
   }

   double balance =
      AccountInfoDouble(
         ACCOUNT_BALANCE);

   if(balance < 0.0)
      balance = 0.0;

   if(BalanceStepUSD <= 0.0)
   {
      return(
         NormalizeBWNLot(
            LotPerBalanceStep));
   }

   int steps =
      (int)MathFloor(
         balance / BalanceStepUSD);

   double lot =
      LotPerBalanceStep *
      (steps + 1);

   if(lot > MaximumLotSize)
      lot = MaximumLotSize;

   return(
      NormalizeBWNLot(lot));
}

//====================================================================
// SPREAD CHECK
//====================================================================

bool SpreadOK()
{
   double bid =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_BID);

   double ask =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_ASK);

   if(bid <= 0.0 ||
      ask <= 0.0)
   {
      return(false);
   }

   double spread_points =
      (ask - bid) / _Point;

   double points_per_pip = 1.0;

   if(_Digits == 3 ||
      _Digits == 5)
   {
      points_per_pip = 10.0;
   }

   double spread_pips =
      spread_points /
      points_per_pip;

   if(spread_pips >
      MaximumSpreadPips)
   {
      return(false);
   }

   return(true);
}//====================================================================
// COUNT BWN POSITIONS
//====================================================================

int CountBWNPositions()
{
   int count = 0;

   for(int i = PositionsTotal() - 1;
       i >= 0;
       i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      ulong magic =
         (ulong)PositionGetInteger(
            POSITION_MAGIC);

      string symbol =
         PositionGetString(
            POSITION_SYMBOL);

      if(magic == MagicNumber &&
         symbol == _Symbol)
      {
         count++;
      }
   }

   return(count);
}

//====================================================================
// FLOATING BASKET PROFIT
//====================================================================

double GetBWNFloatProfit()
{
   double total = 0.0;

   for(int i = PositionsTotal() - 1;
       i >= 0;
       i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      ulong magic =
         (ulong)PositionGetInteger(
            POSITION_MAGIC);

      string symbol =
         PositionGetString(
            POSITION_SYMBOL);

      if(magic != MagicNumber ||
         symbol != _Symbol)
      {
         continue;
      }

      total +=
         PositionGetDouble(
            POSITION_PROFIT);

      total +=
         PositionGetDouble(
            POSITION_SWAP);
   }

   return(total);
}

//====================================================================
// CAN OPEN TRADE
//====================================================================

bool CanOpenTrade(
   int direction,
   double lot)
{
   if(direction != BWN_BUY &&
      direction != BWN_SELL)
   {
      return(false);
   }

   if(lot <= 0.0)
      return(false);

   if(MaximumOpenTrades <= 0)
      return(false);

   if(CountBWNPositions() >=
      MaximumOpenTrades)
   {
      return(false);
   }

   double equity =
      AccountInfoDouble(
         ACCOUNT_EQUITY);

   double margin =
      AccountInfoDouble(
         ACCOUNT_MARGIN);

   double free_margin =
      AccountInfoDouble(
         ACCOUNT_MARGIN_FREE);

   if(equity <= 0.0 ||
      free_margin <= 0.0)
   {
      return(false);
   }

   double maximum_margin =
      equity *
      MaximumMarginPercent /
      100.0;

   if(maximum_margin <= 0.0)
      return(false);

   if(margin >= maximum_margin)
      return(false);

   ENUM_ORDER_TYPE order_type =
      ORDER_TYPE_BUY;

   double price =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_ASK);

   if(direction == BWN_SELL)
   {
      order_type = ORDER_TYPE_SELL;

      price =
         SymbolInfoDouble(
            _Symbol,
            SYMBOL_BID);
   }

   if(price <= 0.0)
      return(false);

   double required_margin = 0.0;

   ResetLastError();

   if(!OrderCalcMargin(
         order_type,
         _Symbol,
         lot,
         price,
         required_margin))
   {
      Print(
         "BWN OrderCalcMargin failed. Error=",
         GetLastError());

      return(false);
   }

   if(required_margin <= 0.0)
      return(false);

   if(required_margin >
      free_margin)
   {
      return(false);
   }

   if((margin + required_margin) >
      maximum_margin)
   {
      return(false);
   }

   return(true);
}

//====================================================================
// OPEN ONE TRADE
//====================================================================

bool OpenOneTrade(
   int direction,
   double lot)
{
   if(!SpreadOK())
      return(false);

   bool result = false;

   ResetLastError();

   if(direction == BWN_BUY)
   {
      result =
         trade.Buy(
            lot,
            _Symbol,
            0.0,
            0.0,
            0.0,
            "BWN BUY");
   }
   else
   if(direction == BWN_SELL)
   {
      result =
         trade.Sell(
            lot,
            _Symbol,
            0.0,
            0.0,
            0.0,
            "BWN SELL");
   }
   else
   {
      return(false);
   }

   if(!result)
   {
      Print(
         "BWN ORDER FAILED | Retcode=",
         trade.ResultRetcode(),
         " | ",
         trade.ResultRetcodeDescription(),
         " | Error=",
         GetLastError());

      return(false);
   }

   Print(
      "BWN ORDER OPENED | ",
      direction == BWN_BUY ? "BUY" : "SELL",
      " | LOT=",
      DoubleToString(
         lot,
         GetVolumeDigits()));

   return(true);
}

//====================================================================
// OPEN MULTIPLE TRADES
//====================================================================

int OpenMultipleTrades(
   int direction)
{
   if(direction != BWN_BUY &&
      direction != BWN_SELL)
   {
      return(0);
   }

   if(!BWN_Running)
      return(0);

   double lot =
      GetBWNLot();

   if(lot <= 0.0)
      return(0);

   int opened = 0;

   BWN_Direction =
      direction;

   for(int i = 0;
       i < MaximumOpenTrades;
       i++)
   {
      if(!BWN_Running)
         break;

      if(CountBWNPositions() >=
         MaximumOpenTrades)
      {
         break;
      }

      // Re-scan the CURRENT FORMING M1 CANDLE
      // before every additional order.
      int current_direction =
         GetLiveDirection();

      if(current_direction !=
         direction)
      {
         break;
      }

      double buy =
         GetBuyStrength();

      double sell =
         GetSellStrength();

      // Strong opposite direction stops adding.
      if(direction == BWN_BUY &&
         sell >= ReversalStrengthPercent &&
         sell > buy)
      {
         break;
      }

      if(direction == BWN_SELL &&
         buy >= ReversalStrengthPercent &&
         buy > sell)
      {
         break;
      }

      if(!CanOpenTrade(
            direction,
            lot))
      {
         break;
      }

      if(OpenOneTrade(
            direction,
            lot))
      {
         opened++;
      }
      else
      {
         break;
      }
   }

   if(opened > 0)
   {
      if(BWN_PeakProfit < 0.0)
         BWN_PeakProfit = 0.0;

      Print(
         "BWN OPENED ",
         opened,
         " TRADE(S) | DIRECTION=",
         direction == BWN_BUY ? "BUY" : "SELL",
         " | LOT=",
         DoubleToString(
            lot,
            GetVolumeDigits()));
   }

   return(opened);
}

//====================================================================
// IMMEDIATE RESCAN AND OPEN
//====================================================================

void ImmediateRescanAndOpen()
{
   if(!BWN_Running)
      return;

   if(BWN_TargetReached ||
      BWN_ProtectionStop)
   {
      return;
   }

   if(!SpreadOK())
      return;

   double buy =
      GetBuyStrength();

   double sell =
      GetSellStrength();

   int direction =
      BWN_NONE;

   if(buy >= EntryStrengthPercent &&
      buy > sell)
   {
      direction = BWN_BUY;
   }
   else
   if(sell >= EntryStrengthPercent &&
      sell > buy)
   {
      direction = BWN_SELL;
   }

   Print(
      "BWN LIVE M1 SCAN | BUY=",
      DoubleToString(buy,1),
      "% | SELL=",
      DoubleToString(sell,1),
      "%");

   if(direction == BWN_NONE)
      return;

   OpenMultipleTrades(
      direction);
}

//====================================================================
// CLOSE ALL BWN POSITIONS
//====================================================================

bool CloseAllBWNPositions()
{
   bool success = true;

   for(int i = PositionsTotal() - 1;
       i >= 0;
       i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      ulong magic =
         (ulong)PositionGetInteger(
            POSITION_MAGIC);

      string symbol =
         PositionGetString(
            POSITION_SYMBOL);

      if(magic != MagicNumber ||
         symbol != _Symbol)
      {
         continue;
      }

      ResetLastError();

      if(!trade.PositionClose(ticket))
      {
         success = false;

         Print(
            "BWN CLOSE FAILED | Ticket=",
            ticket,
            " | Retcode=",
            trade.ResultRetcode(),
            " | ",
            trade.ResultRetcodeDescription(),
            " | Error=",
            GetLastError());
      }
      else
      {
         Print(
            "BWN POSITION CLOSED | Ticket=",
            ticket);
      }
   }

   return(success);
}

