//====================================================================
// INITIALIZATION
//====================================================================

int OnInit()
{
   trade.SetExpertMagicNumber(MagicNumber);
   trade.SetDeviationInPoints(SlippagePoints);
   trade.SetAsyncMode(false);

   BWN_StartBalance =
      AccountInfoDouble(ACCOUNT_BALANCE);

   BWN_StartEquity =
      AccountInfoDouble(ACCOUNT_EQUITY);

   BWN_StartTime =
      TimeCurrent();

   BWN_PeakProfit = 0.0;
   BWN_Direction = BWN_NONE;
   BWN_LossStreak = 0;
   BWN_TargetReached = false;
   BWN_ProtectionStop = false;

   CreateBWNInterface();

   if(StartTradingOnAttach)
      BWNStart();
   else
      BWNStop();

   Print("==========================================");
   Print("BWN BOT v6.00 INITIALIZED");
   Print("SYMBOL: ",_Symbol);
   Print("TIMEFRAME: CURRENT FORMING M1 CANDLE");
   Print("ENTRY: ",EntryStrengthPercent,"%");
   Print("REVERSAL: ",ReversalStrengthPercent,"%");
   Print("PROFIT RETRACE: ",ProfitRetracePercent,"%");
   Print("TARGET: $",TargetProfitUSD);
   Print("==========================================");

   return(INIT_SUCCEEDED);
}

//====================================================================
// DEINITIALIZATION
//====================================================================

void OnDeinit(const int reason)
{
   DeleteBWNInterface();

   Print("BWN BOT DEINITIALIZED. Reason=",reason);
}

//====================================================================
// MAIN TICK
//====================================================================

void OnTick()
{
   UpdateBWNInterface();

   if(!BWN_Running)
      return;

   if(BWN_TargetReached)
      return;

   if(BWN_ProtectionStop)
      return;

   ManageBWN();
}

//====================================================================
// LIVE CURRENT M1 CANDLE
//====================================================================

bool GetCurrentM1Candle(
   MqlRates &candle)
{
   MqlRates data[1];

   ArraySetAsSeries(data,true);

   int copied =
      CopyRates(
         _Symbol,
         PERIOD_M1,
         0,
         1,
         data);

   if(copied != 1)
      return(false);

   candle = data[0];

   return(true);
}

//====================================================================
// BUY STRENGTH
//
// Uses ONLY the currently forming M1 candle.
// Candle index = 0.
// No closed candle is used.
//====================================================================

double GetBuyStrength()
{
   MqlRates candle;

   if(!GetCurrentM1Candle(candle))
      return(50.0);

   double bid =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_BID);

   double ask =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_ASK);

   double open_price = candle.open;
   double high_price = candle.high;
   double low_price  = candle.low;

   if(bid <= 0.0 ||
      ask <= 0.0 ||
      open_price <= 0.0)
   {
      return(50.0);
   }

   double range =
      high_price - low_price;

   // When candle has almost no range,
   // use direction of live price versus open.
   if(range <= (_Point * 2.0))
   {
      if(bid > open_price)
         return(51.0);

      if(bid < open_price)
         return(49.0);

      return(50.0);
   }

   double position =
      (bid - low_price) / range;

   if(position < 0.0)
      position = 0.0;

   if(position > 1.0)
      position = 1.0;

   double movement =
      (bid - open_price) / range;

   if(movement < -1.0)
      movement = -1.0;

   if(movement > 1.0)
      movement = 1.0;

   double buy_strength =
      (position * 75.0)
      +
      ((movement + 1.0) * 12.5);

   if(buy_strength < 0.0)
      buy_strength = 0.0;

   if(buy_strength > 100.0)
      buy_strength = 100.0;

   return(buy_strength);
}

//====================================================================
// SELL STRENGTH
//====================================================================

double GetSellStrength()
{
   MqlRates candle;

   if(!GetCurrentM1Candle(candle))
      return(50.0);

   double bid =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_BID);

   double ask =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_ASK);

   double open_price = candle.open;
   double high_price = candle.high;
   double low_price  = candle.low;

   if(bid <= 0.0 ||
      ask <= 0.0 ||
      open_price <= 0.0)
   {
      return(50.0);
   }

   double range =
      high_price - low_price;

   if(range <= (_Point * 2.0))
   {
      if(bid < open_price)
         return(51.0);

      if(bid > open_price)
         return(49.0);

      return(50.0);
   }

   double position =
      (bid - low_price) / range;

   if(position < 0.0)
      position = 0.0;

   if(position > 1.0)
      position = 1.0;

   double movement =
      (open_price - bid) / range;

   if(movement < -1.0)
      movement = -1.0;

   if(movement > 1.0)
      movement = 1.0;

   double sell_strength =
      ((1.0 - position) * 75.0)
      +
      ((movement + 1.0) * 12.5);

   if(sell_strength < 0.0)
      sell_strength = 0.0;

   if(sell_strength > 100.0)
      sell_strength = 100.0;

   return(sell_strength);
}

//====================================================================
// LIVE DIRECTION
//====================================================================

int GetLiveDirection()
{
   double buy =
      GetBuyStrength();

   double sell =
      GetSellStrength();

   if(buy >= EntryStrengthPercent &&
      buy > sell)
   {
      return(BWN_BUY);
   }

   if(sell >= EntryStrengthPercent &&
      sell > buy)
   {
      return(BWN_SELL);
   }

   return(BWN_NONE);
}

//====================================================================
// VOLUME DIGITS
//====================================================================

int GetVolumeDigits()
{
   double step =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_VOLUME_STEP);

   if(step >= 1.0)
      return(0);

   if(step >= 0.1)
      return(1);

   if(step >= 0.01)
      return(2);

   return(3);
}

//====================================================================
// NORMALIZE LOT
//====================================================================

double NormalizeBWNLot(double lot)
{
   double min_lot =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_VOLUME_MIN);

   double max_lot =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_VOLUME_MAX);

   double step =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_VOLUME_STEP);

   if(step <= 0.0)
      step = 0.01;

   if(lot < min_lot)
      lot = min_lot;

   if(lot > max_lot)
      lot = max_lot;

   if(lot > MaximumLotSize)
      lot = MaximumLotSize;

   lot =
      MathFloor(
         lot / step + 0.0000001)
      * step;

   if(lot < min_lot)
      lot = min_lot;

   return(
      NormalizeDouble(
         lot,
         GetVolumeDigits()));
}

//====================================================================
// AUTOMATIC LOT
//
// $0-$9.99     = 0.01
// $10-$19.99   = 0.02
// $20-$29.99   = 0.03
// $30-$39.99   = 0.04
// etc.
//====================================================================

double GetBWNLot()
{
   if(!UseAutomaticLot)
   {
      return(
         NormalizeBWNLot(
            ManualLotSize));
   }

   double balance =
      AccountInfoDouble(
         ACCOUNT_BALANCE);

   if(balance < 0.0)
      balance = 0.0;

   if(BalanceStepUSD <= 0.0)
   {
      return(
         NormalizeBWNLot(
            LotPerBalanceStep));
   }

   int steps =
      (int)MathFloor(
         balance /
         BalanceStepUSD);

   double lot =
      LotPerBalanceStep *
      (steps + 1);

   if(lot > MaximumLotSize)
      lot = MaximumLotSize;

   return(
      NormalizeBWNLot(lot));
}

//====================================================================
// SPREAD CHECK
//====================================================================

bool SpreadOK()
{
   double bid =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_BID);

   double ask =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_ASK);

   if(bid <= 0.0 ||
      ask <= 0.0)
   {
      return(false);
   }

   double spread_points =
      (ask - bid) / _Point;

   double points_per_pip = 1.0;

   if(_Digits == 3 ||
      _Digits == 5)
   {
      points_per_pip = 10.0;
   }

   double spread_pips =
      spread_points /
      points_per_pip;

   if(spread_pips >
      MaximumSpreadPips)
   {
      return(false);
   }

   return(true);
}

//====================================================================
// COUNT BWN POSITIONS
//====================================================================

int CountBWNPositions()
{
   int count = 0;

   for(int i = PositionsTotal() - 1;
       i >= 0;
       i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      ulong magic =
         (ulong)PositionGetInteger(
            POSITION_MAGIC);

      string symbol =
         PositionGetString(
            POSITION_SYMBOL);

      if(magic == MagicNumber &&
         symbol == _Symbol)
      {
         count++;
      }
   }

   return(count);
}

//====================================================================
// FLOATING BASKET PROFIT
//====================================================================

double GetBWNFloatProfit()
{
   double total = 0.0;

   for(int i = PositionsTotal() - 1;
       i >= 0;
       i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      ulong magic =
         (ulong)PositionGetInteger(
            POSITION_MAGIC);

      string symbol =
         PositionGetString(
            POSITION_SYMBOL);

      if(magic != MagicNumber ||
         symbol != _Symbol)
      {
         continue;
      }

      total +=
         PositionGetDouble(
            POSITION_PROFIT);

      total +=
         PositionGetDouble(
            POSITION_SWAP);
   }

   return(total);
}//====================================================================
// CAN OPEN TRADE
//====================================================================

bool CanOpenTrade(
   int direction,
   double lot)
{
   if(direction != BWN_BUY &&
      direction != BWN_SELL)
   {
      return(false);
   }

   if(lot <= 0.0)
      return(false);

   if(CountBWNPositions() >=
      MaximumOpenTrades)
   {
      return(false);
   }

   if(!SpreadOK())
      return(false);

   double equity =
      AccountInfoDouble(
         ACCOUNT_EQUITY);

   double free_margin =
      AccountInfoDouble(
         ACCOUNT_MARGIN_FREE);

   double current_margin =
      AccountInfoDouble(
         ACCOUNT_MARGIN);

   if(equity <= 0.0 ||
      free_margin <= 0.0)
   {
      return(false);
   }

   double maximum_margin =
      equity *
      MaximumMarginPercent /
      100.0;

   ENUM_ORDER_TYPE order_type =
      ORDER_TYPE_BUY;

   double price =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_ASK);

   if(direction == BWN_SELL)
   {
      order_type =
         ORDER_TYPE_SELL;

      price =
         SymbolInfoDouble(
            _Symbol,
            SYMBOL_BID);
   }

   if(price <= 0.0)
      return(false);

   double required_margin = 0.0;

   ResetLastError();

   if(!OrderCalcMargin(
         order_type,
         _Symbol,
         lot,
         price,
         required_margin))
   {
      Print(
         "BWN: OrderCalcMargin failed. Error=",
         GetLastError());

      return(false);
   }

   if(required_margin <= 0.0)
      return(false);

   if(required_margin >
      free_margin)
   {
      return(false);
   }

   if(current_margin +
      required_margin >
      maximum_margin)
   {
      return(false);
   }

   return(true);
}

//====================================================================
// OPEN ONE TRADE
//====================================================================

bool OpenOneTrade(
   int direction,
   double lot)
{
   if(!CanOpenTrade(
         direction,
         lot))
   {
      return(false);
   }

   bool result = false;

   ResetLastError();

   if(direction == BWN_BUY)
   {
      result =
         trade.Buy(
            lot,
            _Symbol,
            0.0,
            0.0,
            0.0,
            "BWN BUY");
   }
   else
   if(direction == BWN_SELL)
   {
      result =
         trade.Sell(
            lot,
            _Symbol,
            0.0,
            0.0,
            0.0,
            "BWN SELL");
   }

   if(!result)
   {
      Print(
         "BWN ORDER FAILED | Retcode=",
         trade.ResultRetcode(),
         " | ",
         trade.ResultRetcodeDescription(),
         " | Error=",
         GetLastError());

      return(false);
   }

   Print(
      "BWN ORDER OPENED | ",
      direction == BWN_BUY
         ? "BUY"
         : "SELL",
      " | LOT=",
      DoubleToString(
         lot,
         GetVolumeDigits()));

   return(true);
}

//====================================================================
// OPEN MULTIPLE TRADES
//====================================================================

int OpenMultipleTrades(
   int direction)
{
   if(direction != BWN_BUY &&
      direction != BWN_SELL)
   {
      return(0);
   }

   double lot =
      GetBWNLot();

   if(lot <= 0.0)
      return(0);

   int opened = 0;

   BWN_Direction =
      direction;

   for(int i = 0;
       i < MaximumOpenTrades;
       i++)
   {
      if(!BWN_Running)
         break;

      if(CountBWNPositions() >=
         MaximumOpenTrades)
      {
         break;
      }

      double buy =
         GetBuyStrength();

      double sell =
         GetSellStrength();

      //=============================================================
      // LIVE REVERSAL CHECK BEFORE EACH NEW ORDER
      //=============================================================

      if(direction == BWN_BUY &&
         sell >= ReversalStrengthPercent &&
         sell > buy)
      {
         break;
      }

      if(direction == BWN_SELL &&
         buy >= ReversalStrengthPercent &&
         buy > sell)
      {
         break;
      }

      int current_direction =
         GetLiveDirection();

      if(current_direction !=
         direction)
      {
         break;
      }

      if(!CanOpenTrade(
            direction,
            lot))
      {
         break;
      }

      if(OpenOneTrade(
            direction,
            lot))
      {
         opened++;
      }
      else
      {
         break;
      }
   }

   if(opened > 0)
   {
      BWN_PeakProfit = 0.0;

      Print(
         "BWN opened ",
         opened,
         " trade(s) in ",
         direction == BWN_BUY
            ? "BUY"
            : "SELL",
         " direction.");
   }

   return(opened);
}

//====================================================================
// IMMEDIATE RESCAN AND OPEN
//====================================================================

void ImmediateRescanAndOpen()
{
   if(!BWN_Running)
      return;

   if(BWN_TargetReached ||
      BWN_ProtectionStop)
   {
      return;
   }

   double buy =
      GetBuyStrength();

   double sell =
      GetSellStrength();

   Print(
      "BWN LIVE M1 SCAN | BUY=",
      DoubleToString(buy,1),
      "% | SELL=",
      DoubleToString(sell,1),
      "%");

   int direction =
      BWN_NONE;

   if(buy >= EntryStrengthPercent &&
      buy > sell)
   {
      direction = BWN_BUY;
   }
   else
   if(sell >= EntryStrengthPercent &&
      sell > buy)
   {
      direction = BWN_SELL;
   }

   if(direction == BWN_NONE)
      return;

   OpenMultipleTrades(
      direction);
}

//====================================================================
// CLOSE ALL BWN POSITIONS
//====================================================================

bool CloseAllBWNPositions()
{
   bool success = true;

   for(int i = PositionsTotal() - 1;
       i >= 0;
       i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      ulong magic =
         (ulong)PositionGetInteger(
            POSITION_MAGIC);

      string symbol =
         PositionGetString(
            POSITION_SYMBOL);

      if(magic != MagicNumber ||
         symbol != _Symbol)
      {
         continue;
      }

      ResetLastError();

      if(!trade.PositionClose(ticket))
      {
         success = false;

         Print(
            "BWN CLOSE FAILED | Ticket=",
            ticket,
            " | Retcode=",
            trade.ResultRetcode(),
            " | ",
            trade.ResultRetcodeDescription(),
            " | Error=",
            GetLastError());
      }
      else
      {
         Print(
            "BWN POSITION CLOSED | Ticket=",
            ticket);
      }
   }

   return(success);
}

//====================================================================
// RESET BASKET
//====================================================================

void ResetBasket()
{
   BWN_PeakProfit = 0.0;
   BWN_Direction = BWN_NONE;
}

//====================================================================
// PROFIT RETRACEMENT
//
// Example:
// Peak profit = $100
// 2% retracement = $2
// Protected level = $98
//
// When floating basket profit falls to $98,
// the basket is closed and immediately rescanned.
//====================================================================

void ManageProfitRetracement()
{
   double profit =
      GetBWNFloatProfit();

   if(profit <= 0.0)
      return;

   if(profit >
      BWN_PeakProfit)
   {
      BWN_PeakProfit =
         profit;
   }

   if(BWN_PeakProfit <= 0.0)
      return;

   double retracement =
      BWN_PeakProfit *
      ProfitRetracePercent /
      100.0;

   double protected_level =
      BWN_PeakProfit -
      retracement;

   if(profit <=
      protected_level)
   {
      Print(
         "BWN PROFIT RETRACEMENT DETECTED | ",
         "Peak=$",
         DoubleToString(
            BWN_PeakProfit,
            2),
         " Current=$",
         DoubleToString(
            profit,
            2),
         " Retrace=",
         DoubleToString(
            ProfitRetracePercent,
            2),
         "%");

      CloseAllBWNPositions();

      ResetBasket();

      //=============================================================
      // IMMEDIATE RE-ENTRY
      // NO CANDLE CLOSE WAITING
      //=============================================================

      if(BWN_Running &&
         !BWN_TargetReached &&
         !BWN_ProtectionStop)
      {
         ImmediateRescanAndOpen();
      }
   }
}

//====================================================================
// STRONG REVERSAL
//====================================================================

void ManageStrongReversal()
{
   if(CountBWNPositions() <= 0)
      return;

   double buy =
      GetBuyStrength();

   double sell =
      GetSellStrength();

   //===============================================================
   // BUY -> SELL
   //===============================================================

   if(BWN_Direction == BWN_BUY &&
      sell >= ReversalStrengthPercent &&
      sell > buy)
   {
      Print(
         "BWN STRONG REVERSAL BUY -> SELL | ",
         "BUY=",
         DoubleToString(buy,1),
         "% SELL=",
         DoubleToString(sell,1),
         "%");

      CloseAllBWNPositions();

      ResetBasket();

      if(BWN_Running)
      {
         buy =
            GetBuyStrength();

         sell =
            GetSellStrength();

         if(sell >= ReversalStrengthPercent &&
            sell > buy)
         {
            OpenMultipleTrades(
               BWN_SELL);
         }
         else
         {
            ImmediateRescanAndOpen();
         }
      }

      return;
   }

   //===============================================================
   // SELL -> BUY
   //===============================================================

   if(BWN_Direction == BWN_SELL &&
      buy >= ReversalStrengthPercent &&
      buy > sell)
   {
      Print(
         "BWN STRONG REVERSAL SELL -> BUY | ",
         "BUY=",
         DoubleToString(buy,1),
         "% SELL=",
         DoubleToString(sell,1),
         "%");

      CloseAllBWNPositions();

      ResetBasket();

      if(BWN_Running)
      {
         buy =
            GetBuyStrength();

         sell =
            GetSellStrength();

         if(buy >= ReversalStrengthPercent &&
            buy > sell)
         {
            OpenMultipleTrades(
               BWN_BUY);
         }
         else
         {
            ImmediateRescanAndOpen();
         }
      }

      return;
   }
}

//====================================================================
// MAINTAIN TRADES
//====================================================================

void MaintainTrades()
{
   if(!BWN_Running)
      return;

   if(CountBWNPositions() <= 0)
      return;

   int live_direction =
      GetLiveDirection();

   double buy =
      GetBuyStrength();

   double sell =
      GetSellStrength();

   //===============================================================
   // DO NOT ADD IN THE OPPOSITE STRONG DIRECTION
   //===============================================================

   if(BWN_Direction == BWN_BUY &&
      sell >= ReversalStrengthPercent &&
      sell > buy)
   {
      return;
   }

   if(BWN_Direction == BWN_SELL &&
      buy >= ReversalStrengthPercent &&
      buy > sell)
   {
      return;
   }

   //===============================================================
   // SAME LIVE DIRECTION
   //===============================================================

   if(live_direction ==
      BWN_Direction)
   {
      double lot =
         GetBWNLot();

      while(
         CountBWNPositions() <
         MaximumOpenTrades)
      {
         if(!BWN_Running)
            break;

         buy =
            GetBuyStrength();

         sell =
            GetSellStrength();

         if(BWN_Direction == BWN_BUY &&
            sell >= ReversalStrengthPercent &&
            sell > buy)
         {
            break;
         }

         if(BWN_Direction == BWN_SELL &&
            buy >= ReversalStrengthPercent &&
            buy > sell)
         {
            break;
         }

         int current_direction =
            GetLiveDirection();

         if(current_direction !=
            BWN_Direction)
         {
            break;
         }

         if(!CanOpenTrade(
               BWN_Direction,
               lot))
         {
            break;
         }

         if(!OpenOneTrade(
               BWN_Direction,
               lot))
         {
            break;
         }
      }
   }
}

//====================================================================
// CLOSED SESSION PROFIT
//====================================================================

double GetClosedSessionProfit()
{
   if(!HistorySelect(
         BWN_StartTime,
         TimeCurrent()))
   {
      return(0.0);
   }

   double total = 0.0;

   int deals =
      HistoryDealsTotal();

   for(int i = 0;
       i < deals;
       i++)
   {
      ulong ticket =
         HistoryDealGetTicket(i);

      if(ticket == 0)
         continue;

      ulong magic =
         (ulong)HistoryDealGetInteger(
            ticket,
            DEAL_MAGIC);

      string symbol =
         HistoryDealGetString(
            ticket,
            DEAL_SYMBOL);

      if(magic != MagicNumber ||
         symbol != _Symbol)
      {
         continue;
      }

      long entry =
         HistoryDealGetInteger(
            ticket,
            DEAL_ENTRY);

      if(entry != DEAL_ENTRY_OUT &&
         entry != DEAL_ENTRY_OUT_BY)
      {
         continue;
      }

      total +=
         HistoryDealGetDouble(
            ticket,
            DEAL_PROFIT);

      total +=
         HistoryDealGetDouble(
            ticket,
            DEAL_SWAP);

      total +=
         HistoryDealGetDouble(
            ticket,
            DEAL_COMMISSION);
   }

   return(total);
}

//====================================================================
// TOTAL SESSION PROFIT
//====================================================================

double GetSessionProfit()
{
   return(
      GetClosedSessionProfit()
      +
      GetBWNFloatProfit());
}

//====================================================================
// TARGET CHECK
//====================================================================

bool SessionTargetHit()
{
   double session_profit =
      GetSessionProfit();

   if(session_profit >=
      TargetProfitUSD)
   {
      return(true);
   }

   return(false);
}

//====================================================================
// DRAWDOWN
//====================================================================

double GetDrawdownPercent()
{
   if(BWN_StartEquity <= 0.0)
      return(0.0);

   double equity =
      AccountInfoDouble(
         ACCOUNT_EQUITY);

   if(equity >=
      BWN_StartEquity)
   {
      return(0.0);
   }

   return(
      ((BWN_StartEquity - equity)
      / BWN_StartEquity)
      * 100.0);
}

//====================================================================
// OPTIONAL PROTECTION
//====================================================================

bool CheckProtection()
{
   //===============================================================
   // DAILY LOSS
   //===============================================================

   if(UseDailyLossProtection)
   {
      double drawdown =
         GetDrawdownPercent();

      if(drawdown >=
         DailyLossLimitPercent)
      {
         Print(
            "BWN DAILY LOSS PROTECTION: ",
            DoubleToString(
               drawdown,
               2),
            "%");

         return(true);
      }
   }

   //===============================================================
   // MAXIMUM DRAWDOWN
   //===============================================================

   if(UseMaximumDrawdownProtection)
   {
      double drawdown =
         GetDrawdownPercent();

      if(drawdown >=
         MaximumDrawdownPercent)
      {
         Print(
            "BWN MAXIMUM DRAWDOWN PROTECTION: ",
            DoubleToString(
               drawdown,
               2),
            "%");

         return(true);
      }
   }

   //===============================================================
   // LOSS STREAK
   //===============================================================

   if(UseLossStreakProtection)
   {
      if(BWN_LossStreak >=
         MaximumConsecutiveLosses)
      {
         Print(
            "BWN LOSS STREAK PROTECTION.");

         return(true);
      }
   }

   return(false);
}

//====================================================================
// MAIN MANAGEMENT
//====================================================================

void ManageBWN()
{
   //===============================================================
   // FIRST: CHECK $1,000 TARGET
   //===============================================================

   if(SessionTargetHit())
   {
      double final_profit =
         GetSessionProfit();

      Print(
         "==========================================");

      Print(
         "BWN TARGET REACHED: $",
         DoubleToString(
            final_profit,
            2));

      Print(
         "BWN WILL STOP UNTIL START IS PRESSED.");

      Print(
         "==========================================");

      CloseAllBWNPositions();

      ResetBasket();

      BWN_TargetReached = true;
      BWN_Running = false;

      UpdateBWNInterface();

      return;
   }

   //===============================================================
   // OPTIONAL PROTECTION
   //
   // OFF BY DEFAULT.
   //===============================================================

   if(CheckProtection())
   {
      CloseAllBWNPositions();

      ResetBasket();

      BWN_ProtectionStop = true;
      BWN_Running = false;

      UpdateBWNInterface();

      return;
   }

   //===============================================================
   // SPREAD
   //===============================================================

   if(!SpreadOK())
      return;

   //===============================================================
   // NO POSITIONS
   //===============================================================

   if(CountBWNPositions() == 0)
   {
      ResetBasket();

      // Immediate live M1 scan.
      ImmediateRescanAndOpen();

      return;
   }

   //===============================================================
   // PROFIT PROTECTION
   //===============================================================

   ManageProfitRetracement();

   if(CountBWNPositions() == 0)
      return;

   //===============================================================
   // STRONG REVERSAL
   //===============================================================

   ManageStrongReversal();

   if(CountBWNPositions() == 0)
      return;

   //===============================================================
   // MAINTAIN / ADD TRADES
   //===============================================================

   MaintainTrades();
}//====================================================================
// START
//====================================================================

void BWNStart()
{
   BWN_Running = true;

   BWN_TargetReached = false;
   BWN_ProtectionStop = false;

   BWN_StartBalance =
      AccountInfoDouble(
         ACCOUNT_BALANCE);

   BWN_StartEquity =
      AccountInfoDouble(
         ACCOUNT_EQUITY);

   BWN_StartTime =
      TimeCurrent();

   BWN_PeakProfit = 0.0;
   BWN_LossStreak = 0;
   BWN_Direction = BWN_NONE;

   Print("==========================================");
   Print("BWN STARTED");
   Print("CURRENT FORMING M1 CANDLE");
   Print("LIVE SCANNING");
   Print("NO CANDLE CLOSE REQUIRED");
   Print("ENTRY = ",EntryStrengthPercent,"%");
   Print("REVERSAL = ",ReversalStrengthPercent,"%");
   Print("PROFIT RETRACE = ",ProfitRetracePercent,"%");
   Print("TARGET = $",TargetProfitUSD);
   Print("==========================================");

   //===============================================================
   // IMMEDIATE FIRST SCAN
   //===============================================================

   ImmediateRescanAndOpen();

   UpdateBWNInterface();
}

//====================================================================
// STOP
//====================================================================

void BWNStop()
{
   BWN_Running = false;

   Print(
      "BWN STOPPED.");

   Print(
      "Existing BWN positions remain open.");

   UpdateBWNInterface();
}

//====================================================================
// EMERGENCY
//====================================================================

void BWNEmergency()
{
   BWN_Running = false;

   CloseAllBWNPositions();

   ResetBasket();

   BWN_TargetReached = false;
   BWN_ProtectionStop = true;

   Print(
      "BWN EMERGENCY STOP ACTIVATED.");

   UpdateBWNInterface();
}

//====================================================================
// CHART EVENTS
//====================================================================

void OnChartEvent(
   const int id,
   const long &lparam,
   const double &dparam,
   const string &sparam)
{
   if(id != CHARTEVENT_OBJECT_CLICK)
      return;

   if(sparam == BWN_START)
   {
      BWNStart();
   }
   else
   if(sparam == BWN_STOP)
   {
      BWNStop();
   }
   else
   if(sparam == BWN_EMERGENCY)
   {
      BWNEmergency();
   }
}

//====================================================================
// TRADE TRANSACTION
//====================================================================

void OnTradeTransaction(
   const MqlTradeTransaction &trans,
   const MqlTradeRequest &request,
   const MqlTradeResult &result)
{
   if(trans.type !=
      TRADE_TRANSACTION_DEAL_ADD)
   {
      return;
   }

   if(trans.deal == 0)
      return;

   if(!HistoryDealSelect(
         trans.deal))
   {
      return;
   }

   ulong magic =
      (ulong)HistoryDealGetInteger(
         trans.deal,
         DEAL_MAGIC);

   string symbol =
      HistoryDealGetString(
         trans.deal,
         DEAL_SYMBOL);

   if(magic != MagicNumber ||
      symbol != _Symbol)
   {
      return;
   }

   long entry =
      HistoryDealGetInteger(
         trans.deal,
         DEAL_ENTRY);

   if(entry == DEAL_ENTRY_OUT ||
      entry == DEAL_ENTRY_OUT_BY)
   {
      double profit =
         HistoryDealGetDouble(
            trans.deal,
            DEAL_PROFIT);

      if(profit < 0.0)
      {
         BWN_LossStreak++;
      }
      else
      if(profit > 0.0)
      {
         BWN_LossStreak = 0;
      }
   }
}

