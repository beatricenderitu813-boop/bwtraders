void ResetBasket()
{
   BWN_PeakProfit = 0.0;
   BWN_Direction = BWN_NONE;
}

//====================================================================
// PROFIT RETRACEMENT
//
// Example:
// Peak profit = $100
// 2% retracement = $2
// Protected level = $98
// Basket closes when profit reaches $98 or lower.
//====================================================================

void ManageProfitRetracement()
{
   double profit =
      GetBWNFloatProfit();

   if(profit <= 0.0)
      return;

   if(profit >
      BWN_PeakProfit)
   {
      BWN_PeakProfit =
         profit;
   }

   if(BWN_PeakProfit <= 0.0)
      return;

   double retracement =
      BWN_PeakProfit *
      ProfitRetracePercent /
      100.0;

   double protected_level =
      BWN_PeakProfit -
      retracement;

   if(profit <=
      protected_level)
   {
      Print(
         "BWN PROFIT RETRACEMENT | Peak=$",
         DoubleToString(
            BWN_PeakProfit,
            2),
         " Current=$",
         DoubleToString(
            profit,
            2),
         " Retrace=",
         DoubleToString(
            ProfitRetracePercent,
            2),
         "%");

      bool closed =
         CloseAllBWNPositions();

      if(!closed)
      {
         Print(
            "BWN: Some positions could not be closed.");
         return;
      }

      if(CountBWNPositions() > 0)
         return;

      ResetBasket();

      // Immediate new scan.
      // No candle-close waiting.
      if(BWN_Running)
      {
         ImmediateRescanAndOpen();
      }
   }
}

//====================================================================
// STRONG REVERSAL
//====================================================================

void ManageStrongReversal()
{
   if(CountBWNPositions() <= 0)
      return;

   double buy =
      GetBuyStrength();

   double sell =
      GetSellStrength();

   //===============================================================
   // BUY -> SELL
   //===============================================================

   if(BWN_Direction == BWN_BUY &&
      sell >= ReversalStrengthPercent &&
      sell > buy)
   {
      Print(
         "BWN STRONG REVERSAL BUY -> SELL | SELL=",
         DoubleToString(
            sell,
            1),
         "%");

      bool closed =
         CloseAllBWNPositions();

      if(!closed)
         return;

      if(CountBWNPositions() > 0)
         return;

      ResetBasket();

      // Immediately read current forming M1 candle again.
      buy = GetBuyStrength();
      sell = GetSellStrength();

      if(sell >= ReversalStrengthPercent &&
         sell > buy)
      {
         OpenMultipleTrades(
            BWN_SELL);
      }

      return;
   }

   //===============================================================
   // SELL -> BUY
   //===============================================================

   if(BWN_Direction == BWN_SELL &&
      buy >= ReversalStrengthPercent &&
      buy > sell)
   {
      Print(
         "BWN STRONG REVERSAL SELL -> BUY | BUY=",
         DoubleToString(
            buy,
            1),
         "%");

      bool closed =
         CloseAllBWNPositions();

      if(!closed)
         return;

      if(CountBWNPositions() > 0)
         return;

      ResetBasket();

      // Immediately read current forming M1 candle again.
      buy = GetBuyStrength();
      sell = GetSellStrength();

      if(buy >= ReversalStrengthPercent &&
         buy > sell)
      {
         OpenMultipleTrades(
            BWN_BUY);
      }

      return;
   }
}

//====================================================================
// MAINTAIN / ADD TRADES
//====================================================================

void MaintainTrades()
{
   if(!BWN_Running)
      return;

   if(BWN_Direction == BWN_NONE)
      return;

   int live_direction =
      GetLiveDirection();

   if(live_direction == BWN_NONE)
      return;

   double buy =
      GetBuyStrength();

   double sell =
      GetSellStrength();

   //===============================================================
   // DO NOT ADD TO OLD DIRECTION DURING STRONG REVERSAL
   //===============================================================

   if(BWN_Direction == BWN_BUY &&
      sell >= ReversalStrengthPercent &&
      sell > buy)
   {
      return;
   }

   if(BWN_Direction == BWN_SELL &&
      buy >= ReversalStrengthPercent &&
      buy > sell)
   {
      return;
   }

   //===============================================================
   // SAME DIRECTION - ADD TRADES
   //===============================================================

   if(live_direction ==
      BWN_Direction)
   {
      double lot =
         GetBWNLot();

      while(
         CountBWNPositions() <
         MaximumOpenTrades)
      {
         if(!BWN_Running)
            break;

         int current_direction =
            GetLiveDirection();

         if(current_direction !=
            live_direction)
         {
            break;
         }

         buy =
            GetBuyStrength();

         sell =
            GetSellStrength();

         if(live_direction == BWN_BUY &&
            sell >= ReversalStrengthPercent &&
            sell > buy)
         {
            break;
         }

         if(live_direction == BWN_SELL &&
            buy >= ReversalStrengthPercent &&
            buy > sell)
         {
            break;
         }

         if(!CanOpenTrade(
               live_direction,
               lot))
         {
            break;
         }

         if(!OpenOneTrade(
               live_direction,
               lot))
         {
            break;
         }
      }
   }
}

//====================================================================
// CLOSED SESSION PROFIT
//====================================================================

double GetClosedSessionProfit()
{
   if(!HistorySelect(
         BWN_StartTime,
         TimeCurrent()))
   {
      return(0.0);
   }

   double total = 0.0;

   int deals =
      HistoryDealsTotal();

   for(int i = 0;
       i < deals;
       i++)
   {
      ulong ticket =
         HistoryDealGetTicket(i);

      if(ticket == 0)
         continue;

      ulong magic =
         (ulong)HistoryDealGetInteger(
            ticket,
            DEAL_MAGIC);

      string symbol =
         HistoryDealGetString(
            ticket,
            DEAL_SYMBOL);

      if(magic != MagicNumber ||
         symbol != _Symbol)
      {
         continue;
      }

      long entry =
         HistoryDealGetInteger(
            ticket,
            DEAL_ENTRY);

      if(entry != DEAL_ENTRY_OUT &&
         entry != DEAL_ENTRY_OUT_BY)
      {
         continue;
      }

      total +=
         HistoryDealGetDouble(
            ticket,
            DEAL_PROFIT);

      total +=
         HistoryDealGetDouble(
            ticket,
            DEAL_SWAP);

      total +=
         HistoryDealGetDouble(
            ticket,
            DEAL_COMMISSION);
   }

   return(total);
}

//====================================================================
// TOTAL SESSION PROFIT
//====================================================================

double GetSessionProfit()
{
   return(
      GetClosedSessionProfit()
      +
      GetBWNFloatProfit());
}

//====================================================================
// TARGET CHECK
//====================================================================

bool SessionTargetHit()
{
   double session_profit =
      GetSessionProfit();

   if(session_profit >=
      TargetProfitUSD)
   {
      return(true);
   }

   return(false);
}

//====================================================================
// DRAWDOWN
//====================================================================

double GetDrawdownPercent()
{
   if(BWN_StartEquity <= 0.0)
      return(0.0);

   double equity =
      AccountInfoDouble(
         ACCOUNT_EQUITY);

   if(equity >=
      BWN_StartEquity)
   {
      return(0.0);
   }

   return(
      ((BWN_StartEquity - equity)
      / BWN_StartEquity)
      * 100.0);
}

//====================================================================
// LOSS PERCENT
//====================================================================

double GetLossPercent()
{
   return(
      GetDrawdownPercent());
}

//====================================================================
// OPTIONAL PROTECTION
//====================================================================

bool CheckProtection()
{
   //===============================================================
   // OPTIONAL DRAWDOWN PROTECTION
   // DEFAULT = FALSE
   //===============================================================

   if(UseDrawdownProtection)
   {
      double drawdown =
         GetDrawdownPercent();

      if(drawdown >=
         MaximumDrawdownPercent)
      {
         Print(
            "BWN MAX DRAWDOWN PROTECTION: ",
            DoubleToString(
               drawdown,
               2),
            "%");

         return(true);
      }
   }

   //===============================================================
   // OPTIONAL DAILY LOSS PROTECTION
   // DEFAULT = FALSE
   //===============================================================

   if(UseDailyLossProtection)
   {
      double loss =
         GetLossPercent();

      if(loss >=
         DailyLossLimitPercent)
      {
         Print(
            "BWN DAILY LOSS PROTECTION: ",
            DoubleToString(
               loss,
               2),
            "%");

         return(true);
      }
   }

   //===============================================================
   // OPTIONAL LOSS STREAK PROTECTION
   // DEFAULT = FALSE
   //===============================================================

   if(UseLossStreakProtection)
   {
      if(BWN_LossStreak >=
         MaximumConsecutiveLosses)
      {
         Print(
            "BWN LOSS STREAK PROTECTION: ",
            BWN_LossStreak);

         return(true);
      }
   }

   return(false);
}

//====================================================================
// MAIN MANAGEMENT
//====================================================================

void ManageBWN()
{
   //===============================================================
   // $1,000 SESSION TARGET
   //===============================================================

   if(SessionTargetHit())
   {
      Print(
         "BWN TARGET REACHED: $",
         DoubleToString(
            GetSessionProfit(),
            2));

      CloseAllBWNPositions();

      if(CountBWNPositions() == 0)
      {
         ResetBasket();

         BWN_TargetReached = true;
         BWN_Running = false;
      }

      return;
   }

   //===============================================================
   // OPTIONAL PROTECTION
   //===============================================================

   if(CheckProtection())
   {
      CloseAllBWNPositions();

      if(CountBWNPositions() == 0)
      {
         ResetBasket();

         BWN_ProtectionStop = true;
         BWN_Running = false;
      }

      return;
   }

   //===============================================================
   // SPREAD
   //==========================================================if(!SpreadOK())
      return;

   //===============================================================
   // NO POSITIONS
   //===============================================================

   if(CountBWNPositions() == 0)
   {
      ResetBasket();

      // Scan current forming M1 immediately.
      ImmediateRescanAndOpen();

      return;
   }

   //===============================================================
   // PROFIT PROTECTION
   //===============================================================

   ManageProfitRetracement();

   if(CountBWNPositions() == 0)
      return;

   //===============================================================
   // STRONG REVERSAL
   //===============================================================

   ManageStrongReversal();

   if(CountBWNPositions() == 0)
      return;

   //===============================================================
   // MAINTAIN / ADD
   //===============================================================

   MaintainTrades();
}//====================================================================
// START BWN
//====================================================================

void BWNStart()
{
   BWN_Running = true;

   BWN_TargetReached  = false;
   BWN_ProtectionStop = false;

   BWN_StartBalance =
      AccountInfoDouble(
         ACCOUNT_BALANCE);

   BWN_StartEquity =
      AccountInfoDouble(
         ACCOUNT_EQUITY);

   BWN_StartTime =
      TimeCurrent();

   BWN_PeakProfit = 0.0;
   BWN_Direction = BWN_NONE;
   BWN_LossStreak = 0;

   Print("==========================================");
   Print("BWN BOT STARTED");
   Print("CURRENT FORMING M1 CANDLE");
   Print("NO CANDLE CLOSE WAIT");
   Print("ENTRY = ",
         EntryStrengthPercent,
         "%");
   Print("REVERSAL = ",
         ReversalStrengthPercent,
         "%");
   Print("PROFIT RETRACE = ",
         ProfitRetracePercent,
         "%");
   Print("TARGET = $",
         TargetProfitUSD);
   Print("==========================================");

   // Immediate scan.
   // Does NOT wait for candle close.
   ImmediateRescanAndOpen();

   UpdateBWNInterface();
}

//====================================================================
// STOP BWN
//====================================================================

void BWNStop()
{
   BWN_Running = false;

   Print(
      "BWN STOPPED.");
   Print(
      "Existing BWN positions remain open.");

   UpdateBWNInterface();
}

//====================================================================
// EMERGENCY STOP
//====================================================================

void BWNEmergency()
{
   BWN_Running = false;

   Print(
      "BWN EMERGENCY STOP ACTIVATED.");

   CloseAllBWNPositions();

   ResetBasket();

   BWN_TargetReached = false;
   BWN_ProtectionStop = true;

   UpdateBWNInterface();
}

//====================================================================
// CHART EVENTS
//====================================================================

void OnChartEvent(
   const int id,
   const long &lparam,
   const double &dparam,
   const string &sparam)
{
   if(id !=
      CHARTEVENT_OBJECT_CLICK)
   {
      return;
   }

   if(sparam == BWN_START)
   {
      BWNStart();
   }
   else
   if(sparam == BWN_STOP)
   {
      BWNStop();
   }
   else
   if(sparam == BWN_EMERGENCY)
   {
      BWNEmergency();
   }
}

//====================================================================
// TRADE TRANSACTION
//====================================================================

void OnTradeTransaction(
   const MqlTradeTransaction &trans,
   const MqlTradeRequest &request,
   const MqlTradeResult &result)
{
   if(trans.type !=
      TRADE_TRANSACTION_DEAL_ADD)
   {
      return;
   }

   if(trans.deal == 0)
      return;

   if(!HistoryDealSelect(
         trans.deal))
   {
      return;
   }

   ulong magic =
      (ulong)HistoryDealGetInteger(
         trans.deal,
         DEAL_MAGIC);

   string symbol =
      HistoryDealGetString(
         trans.deal,
         DEAL_SYMBOL);

   if(magic != MagicNumber ||
      symbol != _Symbol)
   {
      return;
   }

   long entry =
      HistoryDealGetInteger(
         trans.deal,
         DEAL_ENTRY);

   if(entry == DEAL_ENTRY_OUT ||
      entry == DEAL_ENTRY_OUT_BY)
   {
      double profit =
         HistoryDealGetDouble(
            trans.deal,
            DEAL_PROFIT);

      if(profit < 0.0)
      {
         BWN_LossStreak++;
      }
      else
      if(profit > 0.0)
      {
         BWN_LossStreak = 0;
      }
   }
}

