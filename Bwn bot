//+------------------------------------------------------------------+
//| Expert initialization                                            |
//+------------------------------------------------------------------+
int OnInit()
{
   trade.SetExpertMagicNumber(MagicNumber);
   trade.SetDeviationInPoints(SlippagePoints);
   trade.SetAsyncMode(false);

   g_session_start_balance = AccountInfoDouble(ACCOUNT_BALANCE);
   g_session_start_equity  = AccountInfoDouble(ACCOUNT_EQUITY);
   g_session_start_time    = TimeCurrent();

   g_peak_basket_profit = 0.0;
   g_current_direction  = DIR_NONE;
   g_consecutive_losses = 0;

   CreateControlPanel();

   if(StartTradingOnAttach)
      StartBWN();
   else
      StopBWN();

   Print("BWN Bot initialized successfully.");
   return(INIT_SUCCEEDED);
}

//+------------------------------------------------------------------+
//| Expert deinitialization                                          |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
   DeleteControlPanel();
}

//+------------------------------------------------------------------+
//| Expert tick                                                      |
//+------------------------------------------------------------------+
void OnTick()
{
   UpdateControlPanel();

   RegisterClosedLosses();

   if(!g_trading_enabled)
      return;

   if(g_session_finished)
      return;

   ManageTrading();
}

//+------------------------------------------------------------------+
//| Chart event                                                      |
//+------------------------------------------------------------------+
void OnChartEvent(const int id,
                  const long &lparam,
                  const double &dparam,
                  const string &sparam)
{
   if(id != CHARTEVENT_OBJECT_CLICK)
      return;

   if(sparam == BTN_START)
   {
      StartBWN();
   }
   else if(sparam == BTN_STOP)
   {
      StopBWN();
   }
   else if(sparam == BTN_EMERGENCY)
   {
      EmergencyStopBWN();
   }
}

//+------------------------------------------------------------------+
//| Start BWN                                                        |
//+------------------------------------------------------------------+
void StartBWN()
{
   g_trading_enabled = true;
   g_session_finished = false;

   g_session_start_balance = AccountInfoDouble(ACCOUNT_BALANCE);
   g_session_start_equity  = AccountInfoDouble(ACCOUNT_EQUITY);
   g_session_start_time    = TimeCurrent();

   g_peak_basket_profit = 0.0;
   g_current_direction  = DIR_NONE;
   g_consecutive_losses = 0;

   Print("BWN Bot STARTED.");
}

//+------------------------------------------------------------------+
//| Stop BWN                                                         |
//+------------------------------------------------------------------+
void StopBWN()
{
   g_trading_enabled = false;

   Print("BWN Bot STOPPED. Existing BWN positions remain under management.");
}

//+------------------------------------------------------------------+
//| Emergency stop                                                   |
//+------------------------------------------------------------------+
void EmergencyStopBWN()
{
   g_trading_enabled = false;
   CloseAllManagedPositions();

   Print("BWN EMERGENCY STOP activated.");
}

//+------------------------------------------------------------------+
//| Main trading manager                                             |
//+------------------------------------------------------------------+
void ManageTrading()
{
   if(SessionTargetReached())
   {
      CloseAllManagedPositions();
      g_session_finished = true;
      g_trading_enabled = false;

      Print("BWN $", DoubleToString(SessionProfitTarget,2),
            " session target reached. Trading stopped.");
      return;
   }

   if(RiskProtectionTriggered())
   {
      CloseAllManagedPositions();
      g_trading_enabled = false;

      Print("BWN risk protection triggered. Trading stopped.");
      return;
   }

   if(!IsSpreadAcceptable())
      return;

   if(CountManagedPositions() > 0)
   {
      ManageOpenBasket();
      CheckForStrongReversal();
   }
   else
   {
      ResetBasketTracking();
      CheckForNewEntry();
   }
}

