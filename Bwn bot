void CreateLabel(
   string name,
   string text,
   int x,
   int y,
   int fontSize)
{
   // Remove existing object first
   if(ObjectFind(
      0,
      name) >= 0)
   {
      ObjectDelete(
         0,
         name
      );
   }

   if(!ObjectCreate(
      0,
      name,
      OBJ_LABEL,
      0,
      0,
      0))
   {
      Print(
         "BWN: Failed to create label ",
         name
      );

      return;
   }

   ObjectSetInteger(
      0,
      name,
      OBJPROP_CORNER,
      CORNER_LEFT_UPPER
   );

   ObjectSetInteger(
      0,
      name,
      OBJPROP_XDISTANCE,
      x
   );

   ObjectSetInteger(
      0,
      name,
      OBJPROP_YDISTANCE,
      y
   );

   ObjectSetInteger(
      0,
      name,
      OBJPROP_FONTSIZE,
      fontSize
   );

   ObjectSetInteger(
      0,
      name,
      OBJPROP_SELECTABLE,
      false
   );

   ObjectSetInteger(
      0,
      name,
      OBJPROP_SELECTED,
      false
   );

   ObjectSetInteger(
      0,
      name,
      OBJPROP_HIDDEN,
      true
   );

   ObjectSetString(
      0,
      name,
      OBJPROP_FONT,
      "Arial"
   );

   ObjectSetString(
      0,
      name,
      OBJPROP_TEXT,
      text
   );
}

