      SessionTargetUSD)
   {
      return true;
   }

   return false;
}

//====================================================================
// DRAWDOWN
//====================================================================

double GetDrawdownPercent()
{
   if(BWN_StartEquity <= 0.0)
      return 0.0;

   double equity =
      AccountInfoDouble(
         ACCOUNT_EQUITY);

   if(equity >=
      BWN_StartEquity)
   {
      return 0.0;
   }

   return
      ((BWN_StartEquity - equity)
      / BWN_StartEquity)
      * 100.0;
}

//====================================================================
// LOSS PERCENT
//====================================================================

double GetLossPercent()
{
   if(BWN_StartEquity <= 0.0)
      return 0.0;

   double equity =
      AccountInfoDouble(
         ACCOUNT_EQUITY);

   if(equity >=
      BWN_StartEquity)
   {
      return 0.0;
   }

   return
      ((BWN_StartEquity - equity)
      / BWN_StartEquity)
      * 100.0;
}

//====================================================================
// PROTECTION
//====================================================================

bool CheckProtection()
{
   double drawdown =
      GetDrawdownPercent();

   if(drawdown >=
      MaximumDrawdownPercent)
   {
      Print(
         "BWN MAX DRAWDOWN REACHED: ",
         DoubleToString(
            drawdown,
            2),
         "%");

      return true;
   }

   double loss =
      GetLossPercent();

   if(loss >=
      DailyLossLimitPercent)
   {
      Print(
         "BWN LOSS LIMIT REACHED: ",
         DoubleToString(
            loss,
            2),
         "%");

      return true;
   }

   if(BWN_LossStreak >=
      MaximumConsecutiveLosses)
   {
      Print(
         "BWN CONSECUTIVE LOSS LIMIT REACHED.");

      return true;
   }

   return false;
}

