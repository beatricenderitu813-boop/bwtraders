//==================================================================
// UPDATE UI
//==================================================================

void UpdateBWNInterface()
{
   // These are calculated from CURRENT M1 candle only.
   double buy =
      GetBuyStrength();

   double sell =
      GetSellStrength();

   string direction =
      "WAIT";

   if(buy >=
      EntryStrengthPercent &&
      buy > sell)
   {
      direction = "BUY";
   }
   else if(sell >=
           EntryStrengthPercent &&
           sell > buy)
   {
      direction = "SELL";
   }

   string status =
      "STOPPED";

   if(BWN_Running)
      status = "RUNNING";

   if(BWN_TargetReached)
      status = "TARGET REACHED";

   double basket =
      GetBWNFloatProfit();

   double session =
      GetSessionProfit();

   string info =
      "BWN BOT v3.00\n"
      "STATUS: " + status + "\n"
      "CURRENT M1 CANDLE\n"
      "BUY: " +
      DoubleToString(buy,1) +
      "%\n"
      "SELL: " +
      DoubleToString(sell,1) +
      "%\n"
      "ENTRY: " +
      DoubleToString(
         EntryStrengthPercent,1) +
      "%\n"
      "REVERSAL: " +
      DoubleToString(
         ReversalStrengthPercent,1) +
      "%\n"
      "DIRECTION: " +
      direction + "\n"
      "LOT: " +
      DoubleToString(
         GetBWNLot(),2) +
      "\n"
      "OPEN TRADES: " +
      IntegerToString(
         CountBWNPositions()) +
      "\n"
      "BASKET: $" +
      DoubleToString(
         basket,2) +
      "\n"
      "PEAK: $" +
      DoubleToString(
         BWN_PeakProfit,2) +
      "\n"
      "SESSION: $" +
      DoubleToString(
         session,2) +
      "\n"
      "TARGET: $" +
      DoubleToString(
         SessionTargetUSD,2);

   ObjectSetString(
      0,
      OBJ_INFO,
      OBJPROP_TEXT,
      info);

   ChartRedraw();
}

