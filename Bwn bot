//+------------------------------------------------------------------+
//|                    BWN BOT - LIVE CANDLE                         |
//| Uses CURRENT FORMING candle only - NEVER candle close            |
//+------------------------------------------------------------------+
#property strict
#property version   "1.00"
#property description "BWN Bot - selectable timeframe, live candle scanner"
#property description "Maximum 2 trades, 55% entry, 65% reversal"
#property description "No hard stop loss"

#include <Trade/Trade.mqh>

CTrade trade;

//==================================================================
// INPUTS
//==================================================================

input ENUM_TIMEFRAMES TradingTimeframe = PERIOD_M1;

input double EntryStrengthPercent   = 55.0;
input double ReverseStrengthPercent = 65.0;

input int MaximumOpenTrades = 2;

input double BasketRetracePercent = 2.0;

input double SessionTargetMoney = 1000.0;

input double MaximumSpreadPips = 5.0;

input double MinimumFreeMarginPercent = 10.0;

input int SlippagePoints = 20;

input long MagicNumber = 26090826;

input bool UseAutomaticLot = true;

input double ManualLotSize = 0.01;

//==================================================================
// GLOBAL VARIABLES
//==================================================================

bool BotRunning = false;
bool EmergencyMode = false;

double SessionStartBalance = 0.0;
double SessionProfit = 0.0;

double BasketPeakProfit = 0.0;

double BuyPercent = 50.0;
double SellPercent = 50.0;

int CurrentDirection = 0;

// Button names
string BTN_START = "BWN_START";
string BTN_STOP = "BWN_STOP";
string BTN_EMERGENCY = "BWN_EMERGENCY";

// Scanner objects
string TXT_TITLE = "BWN_TITLE";
string TXT_BUY = "BWN_BUY";
string TXT_SELL = "BWN_SELL";
string TXT_STATUS = "BWN_STATUS";
string TXT_TF = "BWN_TF";
string TXT_TRADES = "BWN_TRADES";
string TXT_BASKET = "BWN_BASKET";
string TXT_TARGET = "BWN_TARGET";

//==================================================================
// INITIALIZATION
//==================================================================

int OnInit()
{
   trade.SetExpertMagicNumber(MagicNumber);
   trade.SetDeviationInPoints(SlippagePoints);

   SessionStartBalance = AccountInfoDouble(ACCOUNT_BALANCE);
   SessionProfit = 0.0;
   BasketPeakProfit = 0.0;

   CreateInterface();

   EventSetTimer(1);

   UpdateScanner();

   return(INIT_SUCCEEDED);
}

//==================================================================
// DEINITIALIZATION
//==================================================================

void OnDeinit(const int reason)
{
   EventKillTimer();

   DeleteInterface();
}

//==================================================================
// TICK
//==================================================================

void OnTick()
{
   UpdateScanner();

   if(EmergencyMode)
      return;

   ManageBasket();

   if(!BotRunning)
      return;

   CheckSessionTarget();

   if(!BotRunning)
      return;

   TradingLogic();
}

//==================================================================
// TIMER
//==================================================================

void OnTimer()
{
   UpdateScanner();

   if(EmergencyMode)
      return;

   ManageBasket();

   if(BotRunning)
   {
      CheckSessionTarget();

      if(BotRunning)
         TradingLogic();
   }
}

//==================================================================
// CHART EVENTS - BUTTONS
//==================================================================

void OnChartEvent(
   const int id,
   const long &lparam,
   const double &dparam,
   const string &sparam)
{
   if(id != CHARTEVENT_OBJECT_CLICK)
      return;

   if(sparam == BTN_START)
   {
      EmergencyMode = false;
      BotRunning = true;

      BasketPeakProfit = GetBasketProfit();

      UpdateInterface();
   }

   if(sparam == BTN_STOP)
   {
      BotRunning = false;

      UpdateInterface();
   }

   if(sparam == BTN_EMERGENCY)
   {
      EmergencyMode = true;
      BotRunning = false;

      CloseAllBotPositions();

      BasketPeakProfit = 0.0;

      UpdateInterface();
   }
}

//==================================================================
// LIVE CANDLE SCANNER
//==================================================================

void UpdateScanner()
{
   MqlRates rates[1];

   // SHIFT 0 = CURRENT FORMING CANDLE
   int copied = CopyRates(
      _Symbol,
      TradingTimeframe,
      0,
      1,
      rates
   );

   if(copied != 1)
      return;

   double candleOpen = rates[0].open;
   double candleHigh = rates[0].high;
   double candleLow = rates[0].low;

   double bid = SymbolInfoDouble(
      _Symbol,
      SYMBOL_BID
   );

   if(candleOpen <= 0.0 || bid <= 0.0)
      return;

   double range = candleHigh - candleLow;

   if(range <= 0.0)
      range = SymbolInfoDouble(
         _Symbol,
         SYMBOL_POINT
      );

   //==============================================================
   // CURRENT FORMING CANDLE ONLY
   //==============================================================

   double positionPercent =
      ((bid - candleLow) / range) * 100.0;

   if(positionPercent < 0.0)
      positionPercent = 0.0;

   if(positionPercent > 100.0)
      positionPercent = 100.0;

   if(bid > candleOpen)
   {
      BuyPercent =
         50.0 + (positionPercent / 2.0);

      SellPercent =
         100.0 - BuyPercent;
   }
   else
   if(bid < candleOpen)
   {
      SellPercent =
         50.0 + ((100.0 - positionPercent) / 2.0);

      BuyPercent =
         100.0 - SellPercent;
   }
   else
   {
      BuyPercent = 50.0;
      SellPercent = 50.0;
   }

   UpdateInterface();
}

//==================================================================
// MAIN TRADING LOGIC
//==================================================================//==================================================================
// MAIN TRADING LOGIC
//==================================================================

void TradingLogic()
{
   if(!BotRunning || EmergencyMode)
      return;

   if(!TradingAllowed())
      return;

   int buyTrades  = CountBotPositions(POSITION_TYPE_BUY);
   int sellTrades = CountBotPositions(POSITION_TYPE_SELL);
   int totalTrades = buyTrades + sellTrades;

   //==============================================================
   // IMMEDIATE REVERSAL
   //==============================================================

   if(CurrentDirection == 1)
   {
      if(SellPercent >= ReverseStrengthPercent)
      {
         CloseDirection(POSITION_TYPE_BUY);

         CurrentDirection = -1;

         OpenAvailableTrades(ORDER_TYPE_SELL);

         return;
      }
   }

   if(CurrentDirection == -1)
   {
      if(BuyPercent >= ReverseStrengthPercent)
      {
         CloseDirection(POSITION_TYPE_SELL);

         CurrentDirection = 1;

         OpenAvailableTrades(ORDER_TYPE_BUY);

         return;
      }
   }

   //==============================================================
   // FIRST ENTRY
   //==============================================================

   if(totalTrades == 0)
   {
      if(BuyPercent >= EntryStrengthPercent &&
         BuyPercent > SellPercent)
      {
         CurrentDirection = 1;

         OpenAvailableTrades(ORDER_TYPE_BUY);

         return;
      }

      if(SellPercent >= EntryStrengthPercent &&
         SellPercent > BuyPercent)
      {
         CurrentDirection = -1;

         OpenAvailableTrades(ORDER_TYPE_SELL);

         return;
      }
   }

   //==============================================================
   // SECOND TRADE
   // Maximum is always 2
   //==============================================================

   totalTrades = CountBotPositions(-1);

   if(totalTrades < 2)
   {
      if(CurrentDirection == 1 &&
         BuyPercent >= EntryStrengthPercent &&
         BuyPercent > SellPercent)
      {
         OpenAvailableTrades(ORDER_TYPE_BUY);
      }

      if(CurrentDirection == -1 &&
         SellPercent >= EntryStrengthPercent &&
         SellPercent > BuyPercent)
      {
         OpenAvailableTrades(ORDER_TYPE_SELL);
      }
   }
}

//==================================================================
// OPEN AVAILABLE TRADES
//==================================================================

void OpenAvailableTrades(ENUM_ORDER_TYPE orderType)
{
   int currentTrades = CountBotPositions(-1);

   // HARD MAXIMUM = 2
   int maximumTrades = 2;

   if(currentTrades >= maximumTrades)
      return;

   double lot = CalculateAutomaticLot();

   if(lot <= 0.0)
      return;

   int slots = maximumTrades - currentTrades;

   for(int i = 0; i < slots; i++)
   {
      if(!TradingAllowed())
         break;

      if(!HasEnoughMargin(orderType, lot))
         break;

      bool result = false;

      if(orderType == ORDER_TYPE_BUY)
      {
         result = trade.Buy(
            lot,
            _Symbol,
            0.0,
            0.0,
            0.0,
            "BWN BUY"
         );
      }
      else
      if(orderType == ORDER_TYPE_SELL)
      {
         result = trade.Sell(
            lot,
            _Symbol,
            0.0,
            0.0,
            0.0,
            "BWN SELL"
         );
      }

      if(!result)
      {
         Print(
            "BWN order failed. Retcode: ",
            trade.ResultRetcode(),
            " - ",
            trade.ResultRetcodeDescription()
         );

         break;
      }
   }

   BasketPeakProfit = GetBasketProfit();
}

//==================================================================
// AUTOMATIC LOT SIZE
//==================================================================
//
// $0.00 - $9.99   = 0.01
// $10.00 - $19.99 = 0.02
// $20.00 - $29.99 = 0.03
// etc.
//
// Based on ACCOUNT BALANCE.
//==================================================================

double CalculateAutomaticLot()
{
   if(!UseAutomaticLot)
      return NormalizeLot(ManualLotSize);

   double balance =
      AccountInfoDouble(ACCOUNT_BALANCE);

   if(balance < 0.0)
      balance = 0.0;

   int tier =
      (int)MathFloor(balance / 10.0);

   double lot =
      0.01 * (tier + 1);

   double maxLot =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_VOLUME_MAX
      );

   if(lot > maxLot)
      lot = maxLot;

   return NormalizeLot(lot);
}

//==================================================================
// NORMALIZE LOT
//==================================================================

double NormalizeLot(double lot)
{
   double minLot =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_VOLUME_MIN
      );

   double maxLot =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_VOLUME_MAX
      );

   double step =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_VOLUME_STEP
      );

   if(step <= 0.0)
      step = 0.01;

   if(lot < minLot)
      lot = minLot;

   if(lot > maxLot)
      lot = maxLot;

   lot =
      MathFloor(lot / step) * step;

   int digits =
      VolumeDigits(step);

   return NormalizeDouble(
      lot,
      digits
   );
}

//==================================================================
// VOLUME DIGITS
//==================================================================

int VolumeDigits(double step)
{
   int digits = 0;

   while(step < 1.0 && digits < 8)
   {
      step *= 10.0;
      digits++;
   }

   return digits;
}

//==================================================================
// MARGIN CHECK
//==================================================================

bool HasEnoughMargin(
   ENUM_ORDER_TYPE orderType,
   double lot)
{
   double price;

   if(orderType == ORDER_TYPE_BUY)
   {
      price =
         SymbolInfoDouble(
            _Symbol,
            SYMBOL_ASK
         );
   }
   else
   {
      price =
         SymbolInfoDouble(
            _Symbol,
            SYMBOL_BID
         );
   }

   if(price <= 0.0)
      return false;

   double marginRequired = 0.0;

   if(!OrderCalcMargin(
      orderType,
      _Symbol,
      lot,
      price,
      marginRequired))
   {
      return false;
   }

   double freeMargin =
      AccountInfoDouble(
         ACCOUNT_MARGIN_FREE
      );

   if(freeMargin <= 0.0)
      return false;

   double afterMargin =
      freeMargin - marginRequired;

   double equity =
      AccountInfoDouble(
         ACCOUNT_EQUITY
      );

   if(equity <= 0.0)
      return false;

   double remainingPercent =
      (afterMargin / equity) * 100.0;

   if(remainingPercent <
      MinimumFreeMarginPercent)
   {
      return false;
   }

   return true;
}

//==================================================================
// SPREAD CHECK
//==================================================================

bool SpreadOK()
{
   double ask =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_ASK
      );

   double bid =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_BID
      );

   double point =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_POINT
      );

   int digits =
      (int)SymbolInfoInteger(
         _Symbol,
         SYMBOL_DIGITS
      );

   if(ask <= 0.0 ||
      bid <= 0.0 ||
      point <= 0.0)
   {
      return false;
   }

   double pipSize = point;

   if(digits == 3 || digits == 5)
      pipSize = point * 10.0;

   double spreadPips =
      (ask - bid) / pipSize;

   if(spreadPips >
      MaximumSpreadPips)
   {
      return false;
   }

   return true;
}

//==================================================================
// GENERAL TRADING CHECK
//==================================================================

bool TradingAllowed()
{
   if(EmergencyMode)
      return false;

   if(!TerminalInfoInteger(
      TERMINAL_TRADE_ALLOWED))
   {
      return false;
   }

   if(!MQLInfoInteger(
      MQL_TRADE_ALLOWED))
   {
      return false;
   }

   if(!SpreadOK())
      return false;

   double margin =
      AccountInfoDouble(
         ACCOUNT_MARGIN_FREE
      );

   if(margin <= 0.0)
      return false;

   return true;
}

//==================================================================
// COUNT BOT POSITIONS
//==================================================================
//
// -1 = all bot positions
// POSITION_TYPE_BUY
// POSITION_TYPE_SELL
//==================================================================

int CountBotPositions(int type)
{
   int count = 0;

   int total =
      PositionsTotal();

   for(int i = 0; i < total; i++)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol =
         PositionGetString(
            POSITION_SYMBOL
         );

      long magic =
         PositionGetInteger(
            POSITION_MAGIC
         );

      long positionType =
         PositionGetInteger(
            POSITION_TYPE
         );

      if(symbol != _Symbol)
         continue;

      if(magic != MagicNumber)
         continue;

      if(type == -1 ||
         positionType == type)
      {
         count++;
      }
   }

   return count;
}

//==================================================================
// GET CURRENT BASKET PROFIT
//==================================================================

double GetBasketProfit()
{
   double profit = 0.0;

   int total =
      PositionsTotal();

   for(int i = 0; i < total; i++)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      if(PositionGetString(
         POSITION_SYMBOL) != _Symbol)
      {
         continue;
      }

      if(PositionGetInteger(
         POSITION_MAGIC) != MagicNumber)
      {
         continue;
      }

      profit +=
         PositionGetDouble(
            POSITION_PROFIT
         );

      profit +=
         PositionGetDouble(
            POSITION_SWAP
         );
   }

   return profit;
}

//==================================================================
// BASKET MANAGEMENT
//==================================================================

void ManageBasket()
{
   double basketProfit =
      GetBasketProfit();

   int positions =
      CountBotPositions(-1);

   if(positions <= 0)
   {
      BasketPeakProfit = 0.0;
      return;
   }

   //==============================================================
   // RECORD HIGHEST BASKET PROFIT
   //==============================================================

   if(basketProfit >
      BasketPeakProfit)
   {
      BasketPeakProfit =
         basketProfit;
   }

   //==============================================================
   // 2% RETRACEMENT FROM PEAK
   //==============================================================

   if(BasketPeakProfit > 0.0)
   {
      double retraceAmount =
         BasketPeakProfit *
         (BasketRetracePercent / 100.0);

      double protectedProfit =
         BasketPeakProfit -
         retraceAmount;

      if(basketProfit <=
         protectedProfit)
      {
         CloseAllBotPositions();

         BasketPeakProfit = 0.0;

         // Immediately rescan
         if(BotRunning &&
            !EmergencyMode)
         {
            TradingLogic();
         }

         return;
      }
   }
}

//==================================================================
// CLOSE ALL BOT POSITIONS
//==================================================================

void CloseAllBotPositions()
{
   int total =
      PositionsTotal();

   for(int i = total - 1;
       i >= 0;
       i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      if(PositionGetString(
         POSITION_SYMBOL) != _Symbol)
      {
         continue;
      }

      if(PositionGetInteger(
         POSITION_MAGIC) != MagicNumber)
      {
         continue;
      }

      if(!trade.PositionClose(ticket))
      {
         Print(
            "BWN close failed. Ticket: ",
            ticket,
            " Retcode: ",
            trade.ResultRetcode(),
            " - ",
            trade.ResultRetcodeDescription()
         );
      }
   }

   CurrentDirection = 0;
}

//==================================================================
// CLOSE ONE DIRECTION
//==================================================================

void CloseDirection(long positionType)
{
   int total =
      PositionsTotal();

   for(int i = total - 1;
       i >= 0;
       i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      if(PositionGetString(
         POSITION_SYMBOL) != _Symbol)
      {
         continue;
      }

      if(PositionGetInteger(
         POSITION_MAGIC) != MagicNumber)
      {
         continue;
      }

      if(PositionGetInteger(
         POSITION_TYPE) != positionType)
      {
         continue;
      }

      if(!trade.PositionClose(ticket))
      {
         Print(
            "BWN direction close failed. Ticket: ",
            ticket,
            " Retcode: ",
            trade.ResultRetcode(),
            " - ",
            trade.ResultRetcodeDescription()
         );
      }
   }
}

//==================================================================
// SESSION TARGET
//==================================================================

void CheckSessionTarget()
{
   if(SessionTargetMoney <= 0.0)
      return;

   double currentBalance =
      AccountInfoDouble(
         ACCOUNT_BALANCE
      );

   SessionProfit =
      currentBalance -
      SessionStartBalance;

   if(SessionProfit >=
      SessionTargetMoney)
   {
      CloseAllBotPositions();

      BotRunning = false;

      BasketPeakProfit = 0.0;

      UpdateInterface();

      Print(
         "BWN SESSION TARGET REACHED: $",
         DoubleToString(
            SessionProfit,
            2
         ),
         ". Bot stopped. Press START for a new session."
      );
   }
}

