//==================================================================
// UPDATE INTERFACE
//==================================================================

void UpdateInterface()
{
   //===============================================================
   // BUY
   //===============================================================

   if(ObjectFind(
      0,
      TXT_BUY) >= 0)
   {
      ObjectSetString(
         0,
         TXT_BUY,
         OBJPROP_TEXT,
         "BUY: " +
         DoubleToString(
            BuyPercent,
            1
         ) +
         "%"
      );
   }

   //===============================================================
   // SELL
   //===============================================================

   if(ObjectFind(
      0,
      TXT_SELL) >= 0)
   {
      ObjectSetString(
         0,
         TXT_SELL,
         OBJPROP_TEXT,
         "SELL: " +
         DoubleToString(
            SellPercent,
            1
         ) +
         "%"
      );
   }

   //===============================================================
   // STATUS
   //===============================================================

   string statusText = "STATUS: STOPPED";

   if(EmergencyMode)
   {
      statusText =
         "STATUS: EMERGENCY";
   }
   else
   if(BotRunning)
   {
      statusText =
         "STATUS: RUNNING";
   }

   if(ObjectFind(
      0,
      TXT_STATUS) >= 0)
   {
      ObjectSetString(
         0,
         TXT_STATUS,
         OBJPROP_TEXT,
         statusText
      );
   }

   //===============================================================
   // TIMEFRAME
   //===============================================================

   string timeframeText =
      EnumToString(
         TradingTimeframe
      );

   if(ObjectFind(
      0,
      TXT_TF) >= 0)
   {
      ObjectSetString(
         0,
         TXT_TF,
         OBJPROP_TEXT,
         "TIMEFRAME: " +
         timeframeText
      );
   }

   //===============================================================
   // OPEN TRADES
   //===============================================================

   int openTrades =
      CountBotPositions(-1);

   if(ObjectFind(
      0,
      TXT_TRADES) >= 0)
   {
      ObjectSetString(
         0,
         TXT_TRADES,
         OBJPROP_TEXT,
         "OPEN TRADES: " +
         IntegerToString(
            openTrades
         ) +
         " / 2"
      );
   }

   //===============================================================
   // BASKET PROFIT
   //===============================================================

   double basketProfit =
      GetBasketProfit();

   if(ObjectFind(
      0,
      TXT_BASKET) >= 0)
   {
      ObjectSetString(
         0,
         TXT_BASKET,
         OBJPROP_TEXT,
         "BASKET PROFIT: " +
         DoubleToString(
            basketProfit,
            2
         )
      );
   }

   //===============================================================
   // SESSION PROFIT
   //===============================================================

   double currentBalance =
      AccountInfoDouble(
         ACCOUNT_BALANCE
      );

   SessionProfit =
      currentBalance -
      SessionStartBalance;

   if(ObjectFind(
      0,
      TXT_TARGET) >= 0)
   {
      ObjectSetString(
         0,
         TXT_TARGET,
         OBJPROP_TEXT,
         "SESSION: " +
         DoubleToString(
            SessionProfit,
            2
         ) +
         " / " +
         DoubleToString(
            SessionTargetMoney,
            2
         )
      );
   }

   ChartRedraw(0);
}

