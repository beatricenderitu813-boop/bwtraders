//====================================================================
// INITIALIZATION
//====================================================================

int OnInit()
{
   trade.SetExpertMagicNumber(MagicNumber);
   trade.SetDeviationInPoints(SlippagePoints);
   trade.SetAsyncMode(false);

   g_session_start_balance =
      AccountInfoDouble(ACCOUNT_BALANCE);

   g_session_start_equity =
      AccountInfoDouble(ACCOUNT_EQUITY);

   g_session_start_time = TimeCurrent();

   g_peak_basket_profit = 0.0;
   g_current_direction = BWN_NONE;
   g_consecutive_losses = 0;

   CreateBWNPanel();

   if(StartTradingOnAttach)
      StartBWN();
   else
      StopBWN();

   Print("BWN Bot v2.00 initialized.");

   return(INIT_SUCCEEDED);
}

//====================================================================
// DEINITIALIZATION
//====================================================================

void OnDeinit(const int reason)
{
   DeleteBWNPanel();
}

//====================================================================
// TICK
//====================================================================

void OnTick()
{
   UpdateBWNPanel();

   if(!g_trading_enabled)
      return;

   if(g_session_finished)
      return;

   ManageBWN();
}

//====================================================================
// CHART BUTTONS
//====================================================================

void OnChartEvent(const int id,
                  const long &lparam,
                  const double &dparam,
                  const string &sparam)
{
   if(id != CHARTEVENT_OBJECT_CLICK)
      return;

   if(sparam == BTN_START)
      StartBWN();

   if(sparam == BTN_STOP)
      StopBWN();

   if(sparam == BTN_EMERGENCY)
      EmergencyBWN();
}

//====================================================================
// TRADE TRANSACTION
//====================================================================

void OnTradeTransaction(const MqlTradeTransaction &trans,
                        const MqlTradeRequest &request,
                        const MqlTradeResult &result)
{
   if(trans.type != TRADE_TRANSACTION_DEAL_ADD)
      return;

   if(trans.deal == 0)
      return;

   ProcessClosedDeal(trans.deal);
}

//====================================================================
// START
//====================================================================

void StartBWN()
{
   g_trading_enabled = true;
   g_session_finished = false;

   g_session_start_balance =
      AccountInfoDouble(ACCOUNT_BALANCE);

   g_session_start_equity =
      AccountInfoDouble(ACCOUNT_EQUITY);

   g_session_start_time = TimeCurrent();

   g_peak_basket_profit = 0.0;
   g_current_direction = BWN_NONE;
   g_consecutive_losses = 0;

   Print("BWN STARTED.");
}

//====================================================================
// STOP
//====================================================================

void StopBWN()
{
   g_trading_enabled = false;

   Print("BWN STOPPED.");
}

//====================================================================
// EMERGENCY
//====================================================================

void EmergencyBWN()
{
   g_trading_enabled = false;

   CloseAllBWNPositions();

   g_peak_basket_profit = 0.0;
   g_current_direction = BWN_NONE;

   Print("BWN EMERGENCY STOP.");
}

//====================================================================
// MAIN MANAGER
//====================================================================

void ManageBWN()
{
   if(TargetReached())
   {
      CloseAllBWNPositions();

      g_session_finished = true;
      g_trading_enabled = false;

      Print("BWN $",
            DoubleToString(SessionProfitTargetUSD,2),
            " target reached.");

      return;
   }

   if(ProtectionTriggered())
   {
      CloseAllBWNPositions();

      g_trading_enabled = false;

      Print("BWN protection triggered.");

      return;
   }

   if(!IsSpreadOK())
      return;

   int position_count = CountBWNPositions();

   if(position_count > 0)
   {
      ManageBasketProfit();
      CheckReversal();
   }
   else
   {
      ResetBasket();
      CheckNewEntry();
   }
}

