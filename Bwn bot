void UpdateBWNPanel()
{
   double buy = GetBuyStrength();
   double sell = GetSellStrength();

   string direction = "WAIT";

   if(buy >= EntryStrengthPercent && buy > sell)
      direction = "BUY";

   if(sell >= EntryStrengthPercent && sell > buy)
      direction = "SELL";

   string status = "STOPPED";

   if(g_trading_enabled)
      status = "RUNNING";

   if(g_session_finished)
      status = "TARGET STOPPED";

   double basket = GetBWNProfit();
   double session = GetSessionTotalProfit();

   string text =
      "BWN BOT\n"
      "STATUS: " + status + "\n"
      "BUY: " + DoubleToString(buy,1) + "%\n"
      "SELL: " + DoubleToString(sell,1) + "%\n"
      "ENTRY: " + DoubleToString(EntryStrengthPercent,1) + "%\n"
      "REVERSAL: " + DoubleToString(ReversalStrengthPercent,1) + "%\n"
      "DIRECTION: " + direction + "\n"
      "LOT: " + DoubleToString(GetAutomaticLot(),2) + "\n"
      "TRADES: " + IntegerToString(CountBWNPositions()) + "\n"
      "BASKET: $" + DoubleToString(basket,2) + "\n"
      "PEAK: $" + DoubleToString(g_peak_basket_profit,2) + "\n"
      "SESSION: $" + DoubleToString(session,2) + "\n"
      "TARGET: $" + DoubleToString(SessionProfitTargetUSD,2);

   ObjectSetString(0,INFO_LABEL,OBJPROP_TEXT,text);
}//====================================================================
// BUY STRENGTH
//====================================================================

double GetBuyStrength()
{
   MqlRates candle[1];

   if(CopyRates(_Symbol,
                SignalTimeframe,
                0,
                1,
                candle) != 1)
   {
      return 50.0;
   }

   double open_price = candle[0].open;
   double high_price = candle[0].high;
   double low_price  = candle[0].low;

   double bid =
      SymbolInfoDouble(_Symbol,SYMBOL_BID);

   if(open_price <= 0.0)
      return 50.0;

   double range = high_price - low_price;

   if(range <= 0.0)
      return 50.0;

   // Position of live price inside current candle
   double position =
      (bid - low_price) / range;

   if(position < 0.0)
      position = 0.0;

   if(position > 1.0)
      position = 1.0;

   // Movement from candle open
   double movement =
      (bid - open_price) / range;

   if(movement > 1.0)
      movement = 1.0;

   if(movement < -1.0)
      movement = -1.0;

   // Combine live candle position and direction
   double score =
      50.0 +
      (position - 0.5) * 50.0 +
      movement * 25.0;

   if(score < 0.0)
      score = 0.0;

   if(score > 100.0)
      score = 100.0;

   return score;
}

//====================================================================
// SELL STRENGTH
//====================================================================

double GetSellStrength()
{
   return 100.0 - GetBuyStrength();
}

//====================================================================
// SIGNAL DIRECTION
//====================================================================

int GetSignalDirection()
{
   double buy = GetBuyStrength();
   double sell = GetSellStrength();

   if(buy >= EntryStrengthPercent &&
      buy > sell)
   {
      return BWN_BUY;
   }

   if(sell >= EntryStrengthPercent &&
      sell > buy)
   {
      return BWN_SELL;
   }

   return BWN_NONE;
}

//====================================================================
// AUTOMATIC LOT
//====================================================================

double GetAutomaticLot()
{
   if(!UseAutomaticLot)
      return NormalizeLot(ManualLotSize);

   double balance =
      AccountInfoDouble(ACCOUNT_BALANCE);

   if(balance < 0.0)
      balance = 0.0;

   double steps =
      MathFloor(balance / BalanceStepUSD);

   double lot =
      (steps + 1.0) * LotIncreasePerStep;

   if(lot > MaximumLotSize)
      lot = MaximumLotSize;

   return NormalizeLot(lot);
}

//====================================================================
// NORMALIZE LOT
//====================================================================

double NormalizeLot(double lot)
{
   double min_lot =
      SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MIN);

   double max_lot =
      SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MAX);

   double step =
      SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_STEP);

   if(step <= 0.0)
      step = 0.01;

   if(lot < min_lot)
      lot = min_lot;

   if(lot > max_lot)
      lot = max_lot;

   if(lot > MaximumLotSize)
      lot = MaximumLotSize;

   lot =
      MathFloor((lot / step) + 0.0000001) * step;

   int digits = 2;

   if(step >= 1.0)
      digits = 0;
   else if(step >= 0.1)
      digits = 1;
   else if(step >= 0.01)
      digits = 2;
   else
      digits = 3;

   return NormalizeDouble(lot,digits);
}

//====================================================================
// SPREAD CHECK
//====================================================================

bool IsSpreadOK()
{
   double bid =
      SymbolInfoDouble(_Symbol,SYMBOL_BID);

   double ask =
      SymbolInfoDouble(_Symbol,SYMBOL_ASK);

   if(bid <= 0.0 || ask <= 0.0)
      return false;

   double spread_points =
      (ask - bid) / _Point;

   double points_per_pip = 1.0;

   if(_Digits == 3 || _Digits == 5)
      points_per_pip = 10.0;

   double spread_pips =
      spread_points / points_per_pip;

   if(spread_pips > MaximumSpreadPips)
      return false;

   return true;
}

//====================================================================
// COUNT BWN POSITIONS
//====================================================================

int CountBWNPositions()
{
   int count = 0;

   for(int i = PositionsTotal() - 1;
       i >= 0;
       i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      ulong magic =
         (ulong)PositionGetInteger(POSITION_MAGIC);

      string symbol =
         PositionGetString(POSITION_SYMBOL);

      if(magic == MagicNumber &&
         symbol == _Symbol)
      {
         count++;
      }
   }

   return count;
}

//====================================================================
// COUNT BY DIRECTION
//====================================================================

int CountBWNPositionsDirection(int direction)
{
   int count = 0;

   for(int i = PositionsTotal() - 1;
       i >= 0;
       i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      ulong magic =
         (ulong)PositionGetInteger(POSITION_MAGIC);

      string symbol =
         PositionGetString(POSITION_SYMBOL);

      if(magic != MagicNumber ||
         symbol != _Symbol)
         continue;

      ENUM_POSITION_TYPE type =
         (ENUM_POSITION_TYPE)
         PositionGetInteger(POSITION_TYPE);

      if(direction == BWN_BUY &&
         type == POSITION_TYPE_BUY)
      {
         count++;
      }

      if(direction == BWN_SELL &&
         type == POSITION_TYPE_SELL)
      {
         count++;
      }
   }

   return count;
}

//====================================================================
// BASKET PROFIT
//====================================================================

double GetBWNProfit()
{
   double profit = 0.0;

   for(int i = PositionsTotal() - 1;
       i >= 0;
       i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      ulong magic =
         (ulong)PositionGetInteger(POSITION_MAGIC);

      string symbol =
         PositionGetString(POSITION_SYMBOL);

      if(magic != MagicNumber ||
         symbol != _Symbol)
      {
         continue;
      }

      profit +=
         PositionGetDouble(POSITION_PROFIT);

      profit +=
         PositionGetDouble(POSITION_SWAP);
   }

   return profit;
}

//====================================================================
// NETTING DETECTION
//====================================================================

bool IsNettingAccount()
{
   long mode =
      AccountInfoInteger(ACCOUNT_MARGIN_MODE);

   if(mode == ACCOUNT_MARGIN_MODE_RETAIL_NETTING ||
      mode == ACCOUNT_MARGIN_MODE_EXCHANGE)
   {
      return true;
   }

   return false;
}

//====================================================================
// CAN OPEN TRADE
//====================================================================

bool CanOpenTrade(int direction,double lot)
{
   if(lot <= 0.0)
      return false;

   if(CountBWNPositions() >= MaximumOpenTrades)
      return false;

   double equity =
      AccountInfoDouble(ACCOUNT_EQUITY);

   double current_margin =
      AccountInfoDouble(ACCOUNT_MARGIN);

   double free_margin =
      AccountInfoDouble(ACCOUNT_MARGIN_FREE);

   if(equity <= 0.0)
      return false;

   double maximum_allowed_margin =
      equity *
      MaximumMarginPercent /
      100.0;

   if(current_margin >= maximum_allowed_margin)
      return false;

   ENUM_ORDER_TYPE order_type =
      ORDER_TYPE_BUY;

   if(direction == BWN_SELL)
      order_type = ORDER_TYPE_SELL;

   double price =
      SymbolInfoDouble(_Symbol,SYMBOL_ASK);

   if(direction == BWN_SELL)
      price = SymbolInfoDouble(_Symbol,SYMBOL_BID);

   double required_margin = 0.0;

   if(!OrderCalcMargin(order_type,
                       _Symbol,
                       lot,
                       price,
                       required_margin))
   {
      return false;
   }

   if(required_margin <= 0.0)
      return false;

   if(required_margin > free_margin)
      return false;

   if(current_margin +
      required_margin >
      maximum_allowed_margin)
   {
      return false;
   }

   return true;
}

//====================================================================
// OPEN ONE POSITION
//====================================================================

bool OpenBWNPosition(int direction,double lot)
{
   bool result = false;

   if(direction == BWN_BUY)
   {
      result =
         trade.Buy(
            lot,
            _Symbol,
            0.0,
            0.0,
            0.0,
            "BWN BUY"
         );
   }
   else if(direction == BWN_SELL)
   {
      result =
         trade.Sell(
            lot,
            _Symbol,
            0.0,
            0.0,
            0.0,
            "BWN SELL"
         );
   }

   if(!result)
   {
      Print("BWN order failed. Retcode=",
            trade.ResultRetcode(),
            " ",
            trade.ResultRetcodeDescription());

      return false;
   }

   return true;
}

//====================================================================
// OPEN MULTIPLE POSITIONS
//====================================================================

bool OpenBWNMultiple(int direction)
{
   if(direction != BWN_BUY &&
      direction != BWN_SELL)
   {
      return false;
   }

   double lot =
      GetAutomaticLot();

   if(lot <= 0.0)
      return false;

   g_current_direction = direction;

   int before =
      CountBWNPositions();

   int opened = 0;

   // On a netting account, several orders become
   // one net position. Therefore only send one order.
   if(IsNettingAccount())
   {
      if(CanOpenTrade(direction,lot))
      {
         if(OpenBWNPosition(direction,lot))
            opened = 1;
      }

      if(opened > 0)
      {
         g_peak_basket_profit = 0.0;

         Print("BWN opened 1 netting position. Lot=",
               DoubleToString(lot,2));

         return true;
      }

      return false;
   }

   // Hedging account: open multiple separate positions.
   for(int i = 0;
       i < MaximumOpenTrades;
       i++)
   {
      if(CountBWNPositions() >= MaximumOpenTrades)
         break;

      if(!CanOpenTrade(direction,lot))
         break;

      if(!OpenBWNPosition(direction,lot))
         break;

      opened++;
   }

   if(opened > 0)
   {
      g_peak_basket_profit = 0.0;

      Print("BWN opened ",
            opened,
            " position(s). Lot=",
            DoubleToString(lot,2));

      return true;
   }

   return false;
}

//====================================================================
// NEW ENTRY
//====================================================================

void CheckNewEntry()
{
   double buy =
      GetBuyStrength();

   double sell =
      GetSellStrength();

   int direction =
      GetSignalDirection();

   Print("BWN SCANNER BUY=",
         DoubleToString(buy,2),
         "% SELL=",
         DoubleToString(sell,2),
         "%");

   if(direction == BWN_NONE)
      return;

   OpenBWNMultiple(direction);
}//====================================================================
// MANAGE BASKET PROFIT
//====================================================================

void ManageBasketProfit()
{
   double profit =
      GetBWNProfit();

   // Only start protection once basket is profitable.
   if(profit <= 0.0)
      return;

   // Record highest basket profit.
   if(profit > g_peak_basket_profit)
   {
      g_peak_basket_profit = profit;

      Print("BWN new peak basket profit: $",
            DoubleToString(
               g_peak_basket_profit,
               2));
   }

   if(g_peak_basket_profit <= 0.0)
      return;

   double retracement =
      g_peak_basket_profit *
      ProfitRetracePercent /
      100.0;

   double protection_level =
      g_peak_basket_profit -
      retracement;

   if(profit <= protection_level)
   {
      int old_direction =
         g_current_direction;

      Print("BWN profit retracement detected. Peak=$",
            DoubleToString(
               g_peak_basket_profit,
               2),
            " Current=$",
            DoubleToString(
               profit,
               2));

      CloseAllBWNPositions();

      ResetBasket();

      // Immediately scan the CURRENT M1 candle.
      int new_direction =
         GetSignalDirection();

      // If no new qualifying direction yet,
      // wait for the next tick.
      if(new_direction != BWN_NONE)
      {
         OpenBWNMultiple(new_direction);
      }
      else if(old_direction != BWN_NONE)
      {
         // Keep watching rather than forcing
         // a trade when neither side qualifies.
         Print("BWN waiting for next valid direction.");
      }
   }
}

//====================================================================
// STRONG REVERSAL
//====================================================================

void CheckReversal()
{
   if(CountBWNPositions() <= 0)
      return;

   double buy =
      GetBuyStrength();

   double sell =
      GetSellStrength();

   // Existing BUY -> strong SELL
   if(g_current_direction == BWN_BUY &&
      sell >= ReversalStrengthPercent)
   {
      Print("BWN STRONG SELL REVERSAL: ",
            DoubleToString(sell,2),
            "%");

      CloseAllBWNPositions();

      ResetBasket();

      // Re-read live M1 direction.
      double new_buy =
         GetBuyStrength();

      double new_sell =
         GetSellStrength();

      if(new_sell >= ReversalStrengthPercent &&
         new_sell > new_buy)
      {
         OpenBWNMultiple(BWN_SELL);
      }

      return;
   }

   // Existing SELL -> strong BUY
   if(g_current_direction == BWN_SELL &&
      buy >= ReversalStrengthPercent)
   {
      Print("BWN STRONG BUY REVERSAL: ",
            DoubleToString(buy,2),
            "%");

      CloseAllBWNPositions();

      ResetBasket();

      // Re-read live M1 direction.
      double new_buy =
         GetBuyStrength();

      double new_sell =
         GetSellStrength();

      if(new_buy >= ReversalStrengthPercent &&
         new_buy > new_sell)
      {
         OpenBWNMultiple(BWN_BUY);
      }

      return;
   }
}

//====================================================================
// CLOSE ALL BWN POSITIONS
//====================================================================

bool CloseAllBWNPositions()
{
   bool success = true;

   for(int i = PositionsTotal() - 1;
       i >= 0;
       i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      ulong magic =
         (ulong)PositionGetInteger(POSITION_MAGIC);

      string symbol =
         PositionGetString(POSITION_SYMBOL);

      if(magic != MagicNumber ||
         symbol != _Symbol)
      {
         continue;
      }

      if(!trade.PositionClose(ticket))
      {
         success = false;

         Print("BWN close failed ticket ",
               ticket,
               ". Retcode=",
               trade.ResultRetcode(),
               " ",
               trade.ResultRetcodeDescription());
      }
   }

   return success;
}

//====================================================================
// RESET BASKET
//====================================================================

void ResetBasket()
{
   g_peak_basket_profit = 0.0;
   g_current_direction = BWN_NONE;
}

//====================================================================
// SESSION CLOSED PROFIT
//====================================================================

double GetSessionClosedProfit()
{
   if(!HistorySelect(
         g_session_start_time,
         TimeCurrent()))
   {
      return 0.0;
   }

   double total = 0.0;

   int deals =
      HistoryDealsTotal();

   for(int i = 0;
       i < deals;
       i++)
   {
      ulong ticket =
         HistoryDealGetTicket(i);

      if(ticket == 0)
         continue;

      ulong magic =
         (ulong)HistoryDealGetInteger(
            ticket,
            DEAL_MAGIC);

      string symbol =
         HistoryDealGetString(
            ticket,
            DEAL_SYMBOL);

      if(magic != MagicNumber ||
         symbol != _Symbol)
      {
         continue;
      }

      long entry =
         HistoryDealGetInteger(
            ticket,
            DEAL_ENTRY);

      if(entry != DEAL_ENTRY_OUT &&
         entry != DEAL_ENTRY_OUT_BY &&
         entry != DEAL_ENTRY_INOUT)
      {
         continue;
      }

      total +=
         HistoryDealGetDouble(
            ticket,
            DEAL_PROFIT);

      total +=
         HistoryDealGetDouble(
            ticket,
            DEAL_SWAP);

      total +=
         HistoryDealGetDouble(
            ticket,
            DEAL_COMMISSION);
   }

   return total;
}

//====================================================================
// TOTAL SESSION PROFIT
//====================================================================

double GetSessionTotalProfit()
{
   double closed =
      GetSessionClosedProfit();

   double floating =
      GetBWNProfit();

   return closed + floating;
}

//====================================================================
// TARGET CHECK
//====================================================================

bool TargetReached()
{
   double total =
      GetSessionTotalProfit();

   if(total >= SessionProfitTargetUSD)
      return true;

   return false;
}

//====================================================================
// DRAWDOWN
//====================================================================

double GetDrawdownPercent()
{
   double start =
      g_session_start_equity;

   if(start <= 0.0)
      return 0.0;

   double equity =
      AccountInfoDouble(ACCOUNT_EQUITY);

   if(equity >= start)
      return 0.0;

   double loss =
      start - equity;

   return
      (loss / start) * 100.0;
}

//====================================================================
// DAILY LOSS
//====================================================================

double GetDailyLossPercent()
{
   double start =
      g_session_start_equity;

   if(start <= 0.0)
      return 0.0;

   double equity =
      AccountInfoDouble(ACCOUNT_EQUITY);

   if(equity >= start)
      return 0.0;

   double loss =
      start - equity;

   return
      (loss / start) * 100.0;
}

//====================================================================
// PROTECTION
//====================================================================

bool ProtectionTriggered()
{
   double drawdown =
      GetDrawdownPercent();

   if(drawdown >= MaximumDrawdownPercent)
   {
      Print("BWN maximum drawdown reached: ",
            DoubleToString(drawdown,2),
            "%");

      return true;
   }

   double daily_loss =
      GetDailyLossPercent();

   if(daily_loss >= DailyLossLimitPercent)
   {
      Print("BWN loss limit reached: ",
            DoubleToString(daily_loss,2),
            "%");

      return true;
   }

   if(g_consecutive_losses >=
      MaximumConsecutiveLosses)
   {
      Print("BWN consecutive loss protection reached.");

      return true;
   }

   return false;
}

//====================================================================
// PROCESS CLOSED DEAL
//====================================================================

void ProcessClosedDeal(ulong deal_ticket)
{
   if(deal_ticket == 0)
      return;

   if(!HistoryDealSelect(deal_ticket))
      return;

   ulong magic =
      (ulong)HistoryDealGetInteger(
         deal_ticket,
         DEAL_MAGIC);

   string symbol =
      HistoryDealGetString(
         deal_ticket,
         DEAL_SYMBOL);

   if(magic != MagicNumber ||
      symbol != _Symbol)
   {
      return;
   }

   long entry =
      HistoryDealGetInteger(
         deal_ticket,
         DEAL_ENTRY);

   if(entry != DEAL_ENTRY_OUT &&
      entry != DEAL_ENTRY_OUT_BY)
   {
      return;
   }

   double profit =
      HistoryDealGetDouble(
         deal_ticket,
         DEAL_PROFIT);

   if(profit < 0.0)
   {
      g_consecutive_losses++;
   }
   else if(profit > 0.0)
   {
      g_consecutive_losses = 0;
   }
}

