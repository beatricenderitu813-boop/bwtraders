//==================================================================
// ON INIT
//==================================================================

int OnInit()
{
   trade.SetExpertMagicNumber(MagicNumber);
   trade.SetDeviationInPoints(SlippagePoints);

   // Automatically use the symbol's supported filling mode.
   trade.SetTypeFillingBySymbol(_Symbol);

   // Use the account's margin mode.
   trade.SetMarginMode();

   // Load previously saved basket/session state.
   LoadPersistentState();

   // If this is the first installation, initialize session.
   if(SessionStartBalance <= 0.0)
   {
      SessionStartBalance =
         AccountInfoDouble(ACCOUNT_BALANCE);

      SessionStartTime = TimeCurrent();

      BasketPeakProfit = 0.0;

      SavePersistentState();
   }

   BotRunning = false;
   EmergencyMode = false;

   CreateInterface();

   UpdateScanner();
   UpdateInterface();

   EventSetTimer(1);

   Print("======================================");
   Print("BWN BOT V2 INITIALIZED");
   Print("Symbol: ",_Symbol);
   Print("Timeframe: ",
         TimeframeToString(TradingTimeframe));
   Print("Current forming candle is used.");
   Print("======================================");

   return(INIT_SUCCEEDED);
}

//==================================================================
// ON DEINIT
//==================================================================

void OnDeinit(const int reason)
{
   // Save peak/session state before MT5 removes/reinitializes EA.
   SavePersistentState();

   EventKillTimer();

   DeleteInterface();

   Print("BWN Bot V2 deinitialized. Reason: ",reason);
}

//==================================================================
// ON TICK
//==================================================================

void OnTick()
{
   // Always read the current forming candle.
   UpdateScanner();

   if(EmergencyMode)
   {
      UpdateInterface();
      return;
   }

   if(!BotRunning)
   {
      UpdateInterface();
      return;
   }

   // PROFIT PROTECTION FIRST.
   ManageBasket();

   // If basket protection closed everything,
   // do not continue using stale position information.
   if(!BotRunning || EmergencyMode)
   {
      UpdateInterface();
      return;
   }

   CheckSessionTarget();

   if(!BotRunning)
   {
      UpdateInterface();
      return;
   }

   TradingLogic();

   UpdateInterface();
}

//==================================================================
// ON TIMER
//==================================================================

void OnTimer()
{
   UpdateScanner();

   if(BotRunning && !EmergencyMode)
   {
      ManageBasket();

      if(BotRunning)
         CheckSessionTarget();
   }

   UpdateInterface();
}

//==================================================================
// CHART BUTTON EVENTS
//==================================================================

void OnChartEvent(const int id,
                  const long &lparam,
                  const double &dparam,
                  const string &sparam)
{
   if(id != CHARTEVENT_OBJECT_CLICK)
      return;

   //===============================================================
   // START
   //===============================================================

   if(sparam == "BWN_START")
   {
      EmergencyMode = false;
      BotRunning = true;

      // START creates a completely new session.
      SessionStartBalance =
         AccountInfoDouble(ACCOUNT_BALANCE);

      SessionStartTime = TimeCurrent();

      // If there is already a basket, establish its current
      // profit as the starting protection reference if positive.
      double currentBasket = GetBasketProfit();

      if(currentBasket > 0.0)
         BasketPeakProfit = currentBasket;
      else
         BasketPeakProfit = 0.0;

      SavePersistentState();

      UpdateScanner();

      Print("BWN BOT STARTED.");
      Print("Session starting balance: ",
            DoubleToString(SessionStartBalance,2));

      TradingLogic();

      UpdateInterface();

      return;
   }

   //===============================================================
   // STOP
   //===============================================================

   if(sparam == "BWN_STOP")
   {
      BotRunning = false;

      SavePersistentState();

      Print("BWN BOT STOPPED.");
      Print("Existing BWN positions are NOT closed.");

      UpdateInterface();

      return;
   }

   //===============================================================
   // EMERGENCY
   //===============================================================

   if(sparam == "BWN_EMERGENCY")
   {
      EmergencyMode = true;
      BotRunning = false;

      Print("BWN EMERGENCY ACTIVATED.");

      CloseAllBotPositions();

      BasketPeakProfit = 0.0;

      SavePersistentState();

      UpdateInterface();

      return;
   }
}

//==================================================================
// CURRENT FORMING CANDLE SCANNER
//==================================================================

void UpdateScanner()
{
   MqlRates candle[];

   ArraySetAsSeries(candle,true);

   // SHIFT 0 = CURRENT FORMING CANDLE.
   int copied =
      CopyRates(_Symbol,
                TradingTimeframe,
                0,
                1,
                candle);

   if(copied < 1)
   {
      BuyPercent = 50.0;
      SellPercent = 50.0;
      CurrentDirection = 0;
      return;
   }

   double openPrice = candle[0].open;
   double highPrice = candle[0].high;
   double lowPrice  = candle[0].low;

   double bid =
      SymbolInfoDouble(_Symbol,SYMBOL_BID);

   if(bid <= 0.0)
      return;

   double range = highPrice - lowPrice;

   if(range <= 0.0)
   {
      BuyPercent = 50.0;
      SellPercent = 50.0;
      CurrentDirection = 0;
      return;
   }

   // Current price position inside the CURRENT candle.
   double positionPercent =
      ((bid - lowPrice) / range) * 100.0;

   if(positionPercent < 0.0)
      positionPercent = 0.0;

   if(positionPercent > 100.0)
      positionPercent = 100.0;

   //===============================================================
   // CURRENT CANDLE BULLISH
   //===============================================================

   if(bid > openPrice)
   {
      BuyPercent =
         50.0 + (positionPercent * 0.50);

      SellPercent =
         100.0 - BuyPercent;

      CurrentDirection = 1;
   }

   //===============================================================
   // CURRENT CANDLE BEARISH
   //===============================================================

   else if(bid < openPrice)
   {
      SellPercent =
         50.0 + ((100.0 - positionPercent) * 0.50);

      BuyPercent =
         100.0 - SellPercent;

      CurrentDirection = -1;
   }

   //===============================================================
   // CURRENT PRICE AT OPEN
   //===============================================================

   else
   {
      BuyPercent = 50.0;
      SellPercent = 50.0;
      CurrentDirection = 0;
   }

   if(BuyPercent < 0.0)
      BuyPercent = 0.0;

   if(BuyPercent > 100.0)
      BuyPercent = 100.0;

   if(SellPercent < 0.0)
      SellPercent = 0.0;

   if(SellPercent > 100.0)
      SellPercent = 100.0;
}

//==================================================================
// PERSISTENT STATE — PART 1
//==================================================================

string GVName(string suffix)
{
   return GV_PREFIX +
          IntegerToString((int)MagicNumber) +
          "_" +
          _Symbol +
          "_" +
          suffix;
}

//==================================================================
// LOAD STATE
//==================================================================

void LoadPersistentState()
{
   string gvBalance =
      GVName("SESSION_BALANCE");

   string gvTime =
      GVName("SESSION_TIME");

   string gvPeak =
      GVName("BASKET_PEAK");

   if(GlobalVariableCheck(gvBalance))
      SessionStartBalance =
         GlobalVariableGet(gvBalance);

   if(GlobalVariableCheck(gvTime))
      SessionStartTime =
         (datetime)GlobalVariableGet(gvTime);

   if(GlobalVariableCheck(gvPeak))
      BasketPeakProfit =
         GlobalVariableGet(gvPeak);
}

//==================================================================
// SAVE STATE
//==================================================================

void SavePersistentState()
{
   GlobalVariableSet(
      GVName("SESSION_BALANCE"),
      SessionStartBalance);

   GlobalVariableSet(
      GVName("SESSION_TIME"),
      (double)SessionStartTime);

   GlobalVariableSet(
      GVName("BASKET_PEAK"),
      BasketPeakProfit);
}

//==================================================================
// DELETE STATE
//==================================================================

void DeletePersistentState()
{
   GlobalVariableDel(GVName("SESSION_BALANCE"));
   GlobalVariableDel(GVName("SESSION_TIME"));
   GlobalVariableDel(GVName("BASKET_PEAK"));
}

//==================================================================
// END OF PART 1
//==================================================================//==================================================================
// TRADING LOGIC
//==================================================================

void TradingLogic()
{
   if(!BotRunning || EmergencyMode)
      return;

   if(!TradingAllowed())
      return;

   UpdateScanner();

   int totalPositions = CountBotPositions();

   //===============================================================
   // NO POSITIONS
   //===============================================================

   if(totalPositions == 0)
   {
      BasketPeakProfit = 0.0;
      SavePersistentState();

      if(BuyDirectionValid())
      {
         OpenBuy();
         return;
      }

      if(SellDirectionValid())
      {
         OpenSell();
         return;
      }

      return;
   }

   //===============================================================
   // CURRENT POSITION COUNTS
   //===============================================================

   int buyPositions =
      CountBotPositionsByType(POSITION_TYPE_BUY);

   int sellPositions =
      CountBotPositionsByType(POSITION_TYPE_SELL);

   //===============================================================
   // IMMEDIATE SELL REVERSAL
   //===============================================================

   if(buyPositions > 0 &&
      SellPercent >= ReverseStrengthPercent)
   {
      Print("65%+ SELL reversal detected.");

      if(CloseDirection(POSITION_TYPE_BUY))
      {
         if(CountBotPositionsByType(POSITION_TYPE_BUY) == 0)
            OpenSell();
      }

      return;
   }

   //===============================================================
   // IMMEDIATE BUY REVERSAL
   //===============================================================

   if(sellPositions > 0 &&
      BuyPercent >= ReverseStrengthPercent)
   {
      Print("65%+ BUY reversal detected.");

      if(CloseDirection(POSITION_TYPE_SELL))
      {
         if(CountBotPositionsByType(POSITION_TYPE_SELL) == 0)
            OpenBuy();
      }

      return;
   }

   //===============================================================
   // NORMAL SECOND POSITION
   //===============================================================

   if(totalPositions < NormalMaximumPositions)
   {
      if(BuyDirectionValid())
      {
         OpenBuy();
         return;
      }

      if(SellDirectionValid())
      {
         OpenSell();
         return;
      }
   }

   //===============================================================
   // SPECIAL ADDITION RULE
   //
   // Exactly 2 positions.
   // BOTH positions must individually be losing.
   // Then one additional position is allowed.
   //===============================================================

   if(totalPositions == NormalMaximumPositions)
   {
      if(AllTwoPositionsAreLosing())
      {
         if(CurrentDirection == 1 &&
            BuyPercent >= EntryStrengthPercent)
         {
            Print("ADDING ONE BUY: both normal positions are losing.");

            OpenBuy();
            return;
         }

         if(CurrentDirection == -1 &&
            SellPercent >= EntryStrengthPercent)
         {
            Print("ADDING ONE SELL: both normal positions are losing.");

            OpenSell();
            return;
         }
      }
   }

   //===============================================================
   // THREE POSITIONS = ABSOLUTE ADDITION LIMIT
   //===============================================================

   if(totalPositions >= MaximumPositionsWithAdd)
      return;
}

//==================================================================
// BUY DIRECTION VALID
//==================================================================

bool BuyDirectionValid()
{
   if(BuyPercent >= EntryStrengthPercent &&
      BuyPercent >= SellPercent)
      return true;

   return false;
}

//==================================================================
// SELL DIRECTION VALID
//==================================================================

bool SellDirectionValid()
{
   if(SellPercent >= EntryStrengthPercent &&
      SellPercent > BuyPercent)
      return true;

   return false;
}

//==================================================================
// OPEN BUY
//==================================================================

bool OpenBuy()
{
   if(!BotRunning || EmergencyMode)
      return false;

   int total = CountBotPositions();

   if(total >= MaximumPositionsWithAdd)
      return false;

   if(!IsSpreadOK())
      return false;

   double lot = CalculateLotSize();

   if(lot <= 0.0)
      return false;

   if(!HasEnoughMargin(ORDER_TYPE_BUY,lot))
      return false;

   bool result =
      trade.Buy(
         lot,
         _Symbol,
         0.0,
         0.0,
         0.0,
         "BWN BUY");

   if(!result)
   {
      Print("BUY FAILED. Retcode=",
            trade.ResultRetcode(),
            " ",
            trade.ResultRetcodeDescription());

      return false;
   }

   Print("BUY OPENED. Lot=",
         DoubleToString(lot,VolumeDigits()));

   return true;
}

//==================================================================
// OPEN SELL
//==================================================================

bool OpenSell()
{
   if(!BotRunning || EmergencyMode)
      return false;

   int total = CountBotPositions();

   if(total >= MaximumPositionsWithAdd)
      return false;

   if(!IsSpreadOK())
      return false;

   double lot = CalculateLotSize();

   if(lot <= 0.0)
      return false;

   if(!HasEnoughMargin(ORDER_TYPE_SELL,lot))
      return false;

   bool result =
      trade.Sell(
         lot,
         _Symbol,
         0.0,
         0.0,
         0.0,
         "BWN SELL");

   if(!result)
   {
      Print("SELL FAILED. Retcode=",
            trade.ResultRetcode(),
            " ",
            trade.ResultRetcodeDescription());

      return false;
   }

   Print("SELL OPENED. Lot=",
         DoubleToString(lot,VolumeDigits()));

   return true;
}

//==================================================================
// AUTOMATIC LOT SIZE
//==================================================================

double CalculateLotSize()
{
   if(!UseAutomaticLotSizing)
      return NormalizeLot(ManualLotSize);

   double balance =
      AccountInfoDouble(ACCOUNT_BALANCE);

   int tier =
      (int)MathFloor(balance / 10.0);

   double lot =
      0.01 * (tier + 1);

   return NormalizeLot(lot);
}

//==================================================================
// BROKER LOT NORMALIZATION
//==================================================================

double NormalizeLot(double volume)
{
   double minLot =
      SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MIN);

   double maxLot =
      SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MAX);

   double stepLot =
      SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_STEP);

   if(minLot <= 0.0)
      minLot = 0.01;

   if(maxLot <= 0.0)
      maxLot = volume;

   if(stepLot <= 0.0)
      stepLot = minLot;

   if(volume < minLot)
      volume = minLot;

   if(volume > maxLot)
      volume = maxLot;

   double steps =
      MathFloor((volume / stepLot) + 0.0000001);

   volume = steps * stepLot;

   if(volume < minLot)
      volume = minLot;

   if(volume > maxLot)
      volume = maxLot;

   return NormalizeDouble(
      volume,
      VolumeDigits());
}

//==================================================================
// VOLUME DIGITS
//==================================================================

int VolumeDigits()
{
   double step =
      SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_STEP);

   if(step >= 1.0)
      return 0;

   if(step >= 0.1)
      return 1;

   if(step >= 0.01)
      return 2;

   if(step >= 0.001)
      return 3;

   return 4;
}

//==================================================================
// SPREAD
//==================================================================

bool IsSpreadOK()
{
   double ask =
      SymbolInfoDouble(_Symbol,SYMBOL_ASK);

   double bid =
      SymbolInfoDouble(_Symbol,SYMBOL_BID);

   if(ask <= 0.0 || bid <= 0.0)
      return false;

   double spreadPoints =
      (ask - bid) / _Point;

   if(spreadPoints > MaximumSpreadPoints)
   {
      Print("Spread protection. Current=",
            DoubleToString(spreadPoints,1),
            " points.");

      return false;
   }

   return true;
}

//==================================================================
// MARGIN PROTECTION
//==================================================================

bool HasEnoughMargin(ENUM_ORDER_TYPE orderType,
                     double volume)
{
   double price = 0.0;

   if(orderType == ORDER_TYPE_BUY)
      price =
         SymbolInfoDouble(_Symbol,SYMBOL_ASK);
   else
      price =
         SymbolInfoDouble(_Symbol,SYMBOL_BID);

   if(price <= 0.0)
      return false;

   double requiredMargin = 0.0;

   if(!OrderCalcMargin(
         orderType,
         _Symbol,
         volume,
         price,
         requiredMargin))
   {
      Print("OrderCalcMargin failed.");
      return false;
   }

   double freeMargin =
      AccountInfoDouble(ACCOUNT_MARGIN_FREE);

   double equity =
      AccountInfoDouble(ACCOUNT_EQUITY);

   if(equity <= 0.0)
      return false;

   double minimumFree =
      equity *
      (MinimumFreeMarginPercent / 100.0);

   if((freeMargin - requiredMargin) <
      minimumFree)
   {
      Print("Margin protection blocked new trade.");
      return false;
   }

   return true;
}

//==================================================================
// TRADING PERMISSION
//==================================================================

bool TradingAllowed()
{
   if(!TerminalInfoInteger(TERMINAL_CONNECTED))
      return false;

   if(!MQLInfoInteger(MQL_TRADE_ALLOWED))
      return false;

   if(!AccountInfoInteger(ACCOUNT_TRADE_ALLOWED))
      return false;

   long tradeMode =
      SymbolInfoInteger(
         _Symbol,
         SYMBOL_TRADE_MODE);

   if(tradeMode == SYMBOL_TRADE_MODE_DISABLED)
      return false;

   return true;
}

//==================================================================
// COUNT BWN POSITIONS
//==================================================================

int CountBotPositions()
{
   int count = 0;

   int total = PositionsTotal();

   for(int i = total - 1; i >= 0; i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol =
         PositionGetString(POSITION_SYMBOL);

      long magic =
         PositionGetInteger(POSITION_MAGIC);

      if(symbol != _Symbol)
         continue;

      if((ulong)magic != MagicNumber)
         continue;

      count++;
   }

   return count;
}

//==================================================================
// COUNT BY POSITION TYPE
//==================================================================

int CountBotPositionsByType(
   ENUM_POSITION_TYPE positionType)
{
   int count = 0;

   int total = PositionsTotal();

   for(int i = total - 1; i >= 0; i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol =
         PositionGetString(POSITION_SYMBOL);

      long magic =
         PositionGetInteger(POSITION_MAGIC);

      ENUM_POSITION_TYPE type =
         (ENUM_POSITION_TYPE)
         PositionGetInteger(POSITION_TYPE);

      if(symbol != _Symbol)
         continue;

      if((ulong)magic != MagicNumber)
         continue;

      if(type != positionType)
         continue;

      count++;
   }

   return count;
}

//==================================================================
// BOTH NORMAL POSITIONS LOSING
//==================================================================

bool AllTwoPositionsAreLosing()
{
   if(CountBotPositions() !=
      NormalMaximumPositions)
      return false;

   int checked = 0;

   int total = PositionsTotal();

   for(int i = total - 1; i >= 0; i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol =
         PositionGetString(POSITION_SYMBOL);

      long magic =
         PositionGetInteger(POSITION_MAGIC);

      if(symbol != _Symbol)
         continue;

      if((ulong)magic != MagicNumber)
         continue;

      double profit =
         PositionGetDouble(POSITION_PROFIT);

      double swap =
         PositionGetDouble(POSITION_SWAP);

      double combined =
         profit + swap;

      checked++;

      if(combined >= 0.0)
         return false;

      if(checked >= NormalMaximumPositions)
         break;
   }

   return checked ==
          NormalMaximumPositions;
}

//==================================================================
// BASKET PROFIT
//==================================================================

double GetBasketProfit()
{
   double totalProfit = 0.0;

   int total = PositionsTotal();

   for(int i = total - 1; i >= 0; i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol =
         PositionGetString(POSITION_SYMBOL);

      long magic =
         PositionGetInteger(POSITION_MAGIC);

      if(symbol != _Symbol)
         continue;

      if((ulong)magic != MagicNumber)
         continue;

      totalProfit +=
         PositionGetDouble(POSITION_PROFIT);

      totalProfit +=
         PositionGetDouble(POSITION_SWAP);
   }

   return totalProfit;
}

//==================================================================
// END OF PART 2
//==================================================================//==================================================================
// STRICT BASKET PROFIT PROTECTION
//==================================================================

void ManageBasket()
{
   int totalPositions =
      CountBotPositions();

   //===============================================================
   // NO BASKET
   //===============================================================

   if(totalPositions == 0)
   {
      BasketPeakProfit = 0.0;
      SavePersistentState();
      return;
   }

   double basketProfit =
      GetBasketProfit();

   //===============================================================
   // NEW PROFIT PEAK
   //===============================================================

   if(basketProfit > BasketPeakProfit)
   {
      BasketPeakProfit =
         basketProfit;

      // IMPORTANT:
      // Save immediately so an EA reinitialization does not
      // forget that the basket had already reached this profit.
      SavePersistentState();

      Print("NEW BASKET PEAK = $",
            DoubleToString(
               BasketPeakProfit,2));
   }

   //===============================================================
   // ONLY PROTECT AFTER A POSITIVE PEAK EXISTS
   //===============================================================

   if(BasketPeakProfit <= 0.0)
      return;

   //===============================================================
   // 2% RETRACEMENT CALCULATION
   //===============================================================

   double allowedRetracement =
      BasketPeakProfit *
      (BasketRetracePercent / 100.0);

   double protectionLevel =
      BasketPeakProfit -
      allowedRetracement;

   //===============================================================
   // STRICT PROTECTION
   //
   // $10 peak -> $9.80 protection
   // $100 peak -> $98 protection
   //
   // It is based ONLY on the highest basket profit.
   //===============================================================

   if(basketProfit <= protectionLevel)
   {
      Print("======================================");
      Print("BASKET PROFIT PROTECTION TRIGGERED");
      Print("Peak = $",
            DoubleToString(
               BasketPeakProfit,2));

      Print("Current = $",
            DoubleToString(
               basketProfit,2));

      Print("Protection = $",
            DoubleToString(
               protectionLevel,2));

      Print("Closing ENTIRE BASKET.");
      Print("======================================");

      bool closed =
         CloseAllBotPositions();

      if(closed)
      {
         BasketPeakProfit = 0.0;

         SavePersistentState();

         // Immediately read the CURRENT FORMING candle again.
         UpdateScanner();

         // Immediately search for a new basket.
         if(BotRunning &&
            !EmergencyMode)
         {
            TradingLogic();
         }
      }

      return;
   }
}

//==================================================================
// SESSION TARGET
//==================================================================

void CheckSessionTarget()
{
   if(!BotRunning)
      return;

   double balance =
      AccountInfoDouble(ACCOUNT_BALANCE);

   double basketProfit =
      GetBasketProfit();

   double sessionProfit =
      (balance - SessionStartBalance)
      + basketProfit;

   if(sessionProfit >= SessionTargetMoney)
   {
      Print("======================================");
      Print("SESSION TARGET REACHED");
      Print("Session profit = $",
            DoubleToString(
               sessionProfit,2));
      Print("Target = $",
            DoubleToString(
               SessionTargetMoney,2));
      Print("======================================");

      CloseAllBotPositions();

      BotRunning = false;

      BasketPeakProfit = 0.0;

      SavePersistentState();

      Print("BWN BOT STOPPED.");
   }
}

//==================================================================
// CLOSE ALL BWN POSITIONS
//==================================================================

bool CloseAllBotPositions()
{
   bool allClosed = true;

   for(int pass = 0; pass < 5; pass++)
   {
      bool found = false;

      int total = PositionsTotal();

      for(int i = total - 1; i >= 0; i--)
      {
         ulong ticket =
            PositionGetTicket(i);

         if(ticket == 0)
            continue;

         if(!PositionSelectByTicket(ticket))
            continue;

         string symbol =
            PositionGetString(
               POSITION_SYMBOL);

         long magic =
            PositionGetInteger(
               POSITION_MAGIC);

         if(symbol != _Symbol)
            continue;

         if((ulong)magic != MagicNumber)
            continue;

         found = true;

         if(!trade.PositionClose(ticket))
         {
            allClosed = false;

            Print("Failed closing ticket ",
                  ticket,
                  ". Retcode=",
                  trade.ResultRetcode(),
                  " ",
                  trade.ResultRetcodeDescription());
         }
      }

      if(!found)
         break;
   }

   if(CountBotPositions() > 0)
      allClosed = false;

   return allClosed;
}

//==================================================================
// CLOSE ONE DIRECTION
//==================================================================

bool CloseDirection(
   ENUM_POSITION_TYPE positionType)
{
   bool allClosed = true;

   for(int pass = 0; pass < 5; pass++)
   {
      bool found = false;

      int total = PositionsTotal();

      for(int i = total - 1; i >= 0; i--)
      {
         ulong ticket =
            PositionGetTicket(i);

         if(ticket == 0)
            continue;

         if(!PositionSelectByTicket(ticket))
            continue;

         string symbol =
            PositionGetString(
               POSITION_SYMBOL);

         long magic =
            PositionGetInteger(
               POSITION_MAGIC);

         ENUM_POSITION_TYPE type =
            (ENUM_POSITION_TYPE)
            PositionGetInteger(
               POSITION_TYPE);

         if(symbol != _Symbol)
            continue;

         if((ulong)magic != MagicNumber)
            continue;

         if(type != positionType)
            continue;

         found = true;

         if(!trade.PositionClose(ticket))
         {
            allClosed = false;

            Print("Failed closing ticket ",
                  ticket,
                  ". Retcode=",
                  trade.ResultRetcode(),
                  " ",
                  trade.ResultRetcodeDescription());
         }
      }

      if(!found)
         break;
   }

   if(CountBotPositionsByType(
         positionType) > 0)
      allClosed = false;

   return allClosed;
}

