void UpdateInterface()
{
   double basketProfit =
      GetBasketProfit();

   int trades =
      CountBotPositions();

   double balance =
      AccountInfoDouble(
         ACCOUNT_BALANCE);

   double sessionProfit =
      (balance - SessionStartBalance)
      + basketProfit;

   string status;

   if(EmergencyMode)
      status = "STATUS: EMERGENCY";
   else if(BotRunning)
      status = "STATUS: RUNNING";
   else
      status = "STATUS: STOPPED";

   SetLabelText(
      "BWN_BUY",
