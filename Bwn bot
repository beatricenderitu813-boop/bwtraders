}

//====================================================================
// EMERGENCY BUTTON
//====================================================================

void BWNEmergency()
{
   BWN_Running =
      false;

   CloseAllBWNPositions();

   ResetBasket();

   BWN_TargetReached =
      false;

   BWN_ProtectionStop =
      true;

   Print("BWN EMERGENCY STOP ACTIVATED.");
}

//====================================================================
// MAIN MANAGEMENT
//====================================================================

void ManageBWN()
{
   //===============================================================
   // $1,000 TARGET
   //===============================================================

   if(SessionTargetHit())
   {
      Print(
         "BWN SESSION TARGET REACHED: $",
         DoubleToString(
            GetSessionProfit(),
            2));

      CloseAllBWNPositions();

      ResetBasket();

      BWN_TargetReached =
         true;

      BWN_Running =
         false;

      return;
   }

   //===============================================================
   // PROTECTION
   //===============================================================

   if(CheckProtection())
   {
      CloseAllBWNPositions();

      ResetBasket();

      BWN_ProtectionStop =
         true;

      BWN_Running =
         false;

      Print(
         "BWN PROTECTION STOP ACTIVATED.");

      return;
   }

   //===============================================================
   // SPREAD
   //===============================================================

   if(!SpreadOK())
      return;

   //===============================================================
   // NO POSITIONS
   //===============================================================

   if(CountBWNPositions() == 0)
   {
      ResetBasket();

      // IMPORTANT:
      // Scan the CURRENT forming M1 candle immediately.
      ImmediateRescanAndOpen();

      return;
   }

   //===============================================================
   // MANAGE EXISTING BASKET
   //===============================================================

   ManageProfitRetracement();

   if(CountBWNPositions() == 0)
      return;

   ManageStrongReversal();

   if(CountBWNPositions() == 0)
      return;

   MaintainTrades();
}

//====================================================================
// BUY STRENGTH
//
// CURRENT FORMING M1 CANDLE ONLY.
// shift = 0
//====================================================================

double GetBuyStrength()
{
   MqlRates candle[1];

   int copied =
      CopyRates(
         _Symbol,
         PERIOD_M1,
         0,
         1,
         candle);

   if(copied != 1)
   {
      return 50.0;
   }

   double open_price =
      candle[0].open;

   double high_price =
      candle[0].high;

   double low_price =
      candle[0].low;

   double bid =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_BID);

   if(open_price <= 0.0 ||
      bid <= 0.0)
   {
      return 50.0;
   }

   double range =
      high_price - low_price;

   // New candle with almost no movement.
   if(range <= (_Point * 2.0))
   {
      if(bid > open_price)
         return 51.0;

      if(bid < open_price)
         return 49.0;

      return 50.0;
   }

   // Position of CURRENT live price
   // inside CURRENT candle range.
   double position =
      (bid - low_price) / range;

   if(position < 0.0)
      position = 0.0;

   if(position > 1.0)
      position = 1.0;

   // Current candle movement from open.
   double movement =
      (bid - open_price) / range;

   if(movement > 1.0)
      movement = 1.0;

   if(movement < -1.0)
      movement = -1.0;

   // BUY strength.
   double strength =
      50.0
      +
      ((position - 0.5) * 50.0)
      +
      (movement * 25.0);

   if(strength < 0.0)
      strength = 0.0;

   if(strength > 100.0)
      strength = 100.0;

   return strength;
}

//====================================================================
// SELL STRENGTH
//
// CURRENT FORMING M1 CANDLE ONLY.
//====================================================================

double GetSellStrength()
{
   MqlRates candle[1];

   int copied =
      CopyRates(
         _Symbol,
         PERIOD_M1,
         0,
         1,
         candle);

   if(copied != 1)
   {
      return 50.0;
   }

   double open_price =
      candle[0].open;

   double high_price =
      candle[0].high;

   double low_price =
      candle[0].low;

   double bid =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_BID);

   if(open_price <= 0.0 ||
      bid <= 0.0)
   {
      return 50.0;
   }

   double range =
      high_price - low_price;

   if(range <= (_Point * 2.0))
   {
      if(bid < open_price)
         return 51.0;

      if(bid > open_price)
         return 49.0;

      return 50.0;
   }

   // Position inside CURRENT candle.
   double position =
      (bid - low_price) / range;

   if(position < 0.0)
      position = 0.0;

   if(position > 1.0)
      position = 1.0;

   // Bearish movement from candle open.
   double movement =
      (open_price - bid) / range;

   if(movement > 1.0)
      movement = 1.0;

   if(movement < -1.0)
      movement = -1.0;

   // SELL strength.
   double strength =
      50.0
      +
      ((0.5 - position) * 50.0)
      +
      (movement * 25.0);

   if(strength < 0.0)
      strength = 0.0;

   if(strength > 100.0)
      strength = 100.0;

   return strength;
}

//====================================================================
// LIVE DIRECTION
//====================================================================

int GetLiveDirection()
{
   // Both values are calculated from CURRENT M1 candle.
   double buy =
      GetBuyStrength();

   double sell =
      GetSellStrength();

   // BUY signal.
   if(buy >= EntryStrengthPercent &&
      buy > sell)
   {
      return BWN_BUY;
   }

   // SELL signal.
   if(sell >= EntryStrengthPercent &&
      sell > buy)
   {
      return BWN_SELL;
   }

   return BWN_NONE;
}

//====================================================================
// AUTOMATIC LOT
//
// Balance:
// $0 - $9.99       = 0.01
// $10 - $19.99     = 0.02
// $20 - $29.99     = 0.03
// $30 - $39.99     = 0.04
// etc.
//====================================================================

double GetBWNLot()
{
   if(!UseAutomaticLot)
   {
      return NormalizeBWNLot(
         ManualLotSize);
   }

   double balance =
      AccountInfoDouble(
         ACCOUNT_BALANCE);

   if(balance < 0.0)
      balance = 0.0;

   if(BalanceStepUSD <= 0.0)
      return NormalizeBWNLot(
         LotIncreasePerStep);

   int steps =
      (int)MathFloor(
         balance / BalanceStepUSD);

   double lot =
      LotIncreasePerStep *
      (steps + 1);

   if(lot > MaximumLotSize)
      lot = MaximumLotSize;

   return NormalizeBWNLot(lot);
}

//====================================================================
// VOLUME DIGITS
//====================================================================

int GetVolumeDigits()
{
   double step =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_VOLUME_STEP);

   if(step >= 1.0)
      return 0;

   if(step >= 0.1)
      return 1;

   if(step >= 0.01)
      return 2;

   return 3;
}

//====================================================================
// NORMALIZE LOT
//====================================================================

double NormalizeBWNLot(double lot)
{
   double min_lot =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_VOLUME_MIN);

   double max_lot =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_VOLUME_MAX);

   double step =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_VOLUME_STEP);

   if(step <= 0.0)
      step = 0.01;

   if(lot < min_lot)
      lot = min_lot;

   if(lot > max_lot)
      lot = max_lot;

   if(lot > MaximumLotSize)
      lot = MaximumLotSize;

   lot =
      MathFloor(
         lot / step + 0.0000001)
      * step;

   if(lot < min_lot)
      lot = min_lot;

   return NormalizeDouble(
      lot,
      GetVolumeDigits());
}

//====================================================================
// SPREAD CHECK
//====================================================================

bool SpreadOK()
{
   double bid =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_BID);

   double ask =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_ASK);

   if(bid <= 0.0 ||
      ask <= 0.0)
   {
      return false;
   }

   double spread_points =
      (ask - bid) / _Point;

   double points_per_pip =
      1.0;

   if(_Digits == 3 ||
      _Digits == 5)
   {
      points_per_pip = 10.0;
   }

   double spread_pips =
      spread_points /
      points_per_pip;

   if(spread_pips >
      MaximumSpreadPips)
   {
      return false;
   }

   return true;
}

//====================================================================
// HEDGING ACCOUNT CHECK
//====================================================================

bool IsHedgingAccount()
{
   long mode =
      AccountInfoInteger(
         ACCOUNT_MARGIN_MODE);

   if(mode ==
      ACCOUNT_MARGIN_MODE_RETAIL_HEDGING)
   {
      return true;
   }

   return false;
}

//====================================================================
// COUNT BWN POSITIONS
//====================================================================

int CountBWNPositions()
{
   int count = 0;

   for(int i =
       PositionsTotal() - 1;
       i >= 0;
       i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      ulong magic =
         (ulong)PositionGetInteger(
            POSITION_MAGIC);

      string symbol =
         PositionGetString(
            POSITION_SYMBOL);

      if(magic == MagicNumber &&
         symbol == _Symbol)
      {
         count++;
      }
   }

   return count;
}

//====================================================================
// COUNT DIRECTION
//====================================================================

int CountBWNPositionsDirection(
   int direction)
{
   int count = 0;

   for(int i =
       PositionsTotal() - 1;
       i >= 0;
       i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      ulong magic =
         (ulong)PositionGetInteger(
            POSITION_MAGIC);

      string symbol =
         PositionGetString(
            POSITION_SYMBOL);

      if(magic != MagicNumber ||
         symbol != _Symbol)
      {
         continue;
      }

      ENUM_POSITION_TYPE type =
         (ENUM_POSITION_TYPE)
         PositionGetInteger(
            POSITION_TYPE);

      if(direction == BWN_BUY &&
         type == POSITION_TYPE_BUY)
      {
         count++;
      }

      if(direction == BWN_SELL &&
         type == POSITION_TYPE_SELL)
      {
         count++;
      }
   }

   return count;
}

