   BWN_Direction = BWN_NONE;
}

//==================================================================
// SESSION CLOSED PROFIT
//==================================================================

double GetClosedSessionProfit()
{
   if(!HistorySelect(
         BWN_StartTime,
         TimeCurrent()))
   {
      return 0.0;
   }

   double total = 0.0;

   int deals =
      HistoryDealsTotal();

   for(int i = 0;
       i < deals;
       i++)
   {
      ulong ticket =
         HistoryDealGetTicket(i);

      if(ticket == 0)
         continue;

      ulong magic =
         (ulong)HistoryDealGetInteger(
            ticket,
            DEAL_MAGIC);

      string symbol =
         HistoryDealGetString(
            ticket,
            DEAL_SYMBOL);

      if(magic != MagicNumber ||
         symbol != _Symbol)
      {
         continue;
      }

      long entry =
         HistoryDealGetInteger(
            ticket,
            DEAL_ENTRY);

      if(entry != DEAL_ENTRY_OUT &&
         entry != DEAL_ENTRY_OUT_BY)
      {
         continue;
      }

      total +=
         HistoryDealGetDouble(
            ticket,
            DEAL_PROFIT);

      total +=
         HistoryDealGetDouble(
            ticket,
            DEAL_SWAP);

      total +=
         HistoryDealGetDouble(
            ticket,
            DEAL_COMMISSION);
   }

   return total;
}

//==================================================================
// TOTAL SESSION PROFIT
//==================================================================

double GetSessionProfit()
{
   return
      GetClosedSessionProfit()
      +
      GetBWNFloatProfit();
}

//==================================================================
// $1000 TARGET
//==================================================================

bool SessionTargetHit()
{
   if(GetSessionProfit() >=
      SessionTargetUSD)
   {
      return true;
   }

   return false;
}

//==================================================================
// DRAWDOWN
//==================================================================

double GetDrawdownPercent()
{
   if(BWN_StartEquity <= 0.0)
      return 0.0;

   double equity =
      AccountInfoDouble(
         ACCOUNT_EQUITY);

   if(equity >= BWN_StartEquity)
      return 0.0;

   return
      ((BWN_StartEquity - equity)
      / BWN_StartEquity)
      * 100.0;
}

//==================================================================
// LOSS
//==================================================================

double GetLossPercent()
{
   if(BWN_StartEquity <= 0.0)
      return 0.0;

   double equity =
      AccountInfoDouble(
         ACCOUNT_EQUITY);

   if(equity >= BWN_StartEquity)
      return 0.0;

   return
      ((BWN_StartEquity - equity)
      / BWN_StartEquity)
      * 100.0;
}

//==================================================================
// PROTECTION
//==================================================================

bool CheckProtection()
{
   double drawdown =
      GetDrawdownPercent();

   if(drawdown >=
      MaximumDrawdownPercent)
   {
      Print(
         "BWN MAX DRAWDOWN = ",
         DoubleToString(
            drawdown,
            2),
         "%");

      return true;
   }

   double loss =
      GetLossPercent();

   if(loss >=
      DailyLossLimitPercent)
   {
      Print(
         "BWN LOSS LIMIT = ",
         DoubleToString(
            loss,
            2),
         "%");

      return true;
   }

   if(BWN_LossStreak >=
      MaximumConsecutiveLosses)
   {
      Print(
         "BWN CONSECUTIVE LOSS LIMIT.");

      return true;
   }

   return false;
}

