//==================================================================
// INITIALIZATION
//==================================================================

int OnInit()
{
   trade.SetExpertMagicNumber(MagicNumber);
   trade.SetDeviationInPoints(SlippagePoints);
   trade.SetAsyncMode(false);

   BWN_StartBalance =
      AccountInfoDouble(ACCOUNT_BALANCE);

   BWN_StartEquity =
      AccountInfoDouble(ACCOUNT_EQUITY);

   BWN_StartTime = TimeCurrent();

   BWN_PeakProfit = 0.0;
   BWN_Direction  = BWN_NONE;
   BWN_LossStreak = 0;

   CreateBWNInterface();

   if(StartTradingOnAttach)
      BWNStart();
   else
      BWNStop();

   Print("BWN BOT v3.00 loaded successfully.");

   return(INIT_SUCCEEDED);
}

//==================================================================
// DEINITIALIZATION
//==================================================================

void OnDeinit(const int reason)
{
   DeleteBWNInterface();
}

//==================================================================
// EVERY TICK
//==================================================================

void OnTick()
{
   // Live scanner is updated on EVERY tick.
   UpdateBWNInterface();

   if(!BWN_Running)
      return;

   if(BWN_TargetReached)
      return;

   ManageBWN();
}

//==================================================================
// CHART BUTTON EVENTS
//==================================================================

void OnChartEvent(const int id,
                  const long &lparam,
                  const double &dparam,
                  const string &sparam)
{
   if(id != CHARTEVENT_OBJECT_CLICK)
      return;

   if(sparam == OBJ_START)
      BWNStart();

   if(sparam == OBJ_STOP)
      BWNStop();

   if(sparam == OBJ_EMERGENCY)
      BWNEmergency();
}

//==================================================================
// TRADE TRANSACTION
//==================================================================

void OnTradeTransaction(
   const MqlTradeTransaction &trans,
   const MqlTradeRequest &request,
   const MqlTradeResult &result)
{
   if(trans.type != TRADE_TRANSACTION_DEAL_ADD)
      return;

   if(trans.deal == 0)
      return;

   if(!HistoryDealSelect(trans.deal))
      return;

   ulong magic =
      (ulong)HistoryDealGetInteger(
         trans.deal,
         DEAL_MAGIC);

   string symbol =
      HistoryDealGetString(
         trans.deal,
         DEAL_SYMBOL);

   if(magic != MagicNumber ||
      symbol != _Symbol)
      return;

   long entry =
      HistoryDealGetInteger(
         trans.deal,
         DEAL_ENTRY);

   if(entry == DEAL_ENTRY_OUT ||
      entry == DEAL_ENTRY_OUT_BY)
   {
      double profit =
         HistoryDealGetDouble(
            trans.deal,
            DEAL_PROFIT);

      if(profit < 0.0)
         BWN_LossStreak++;
      else if(profit > 0.0)
         BWN_LossStreak = 0;
   }
}

//==================================================================
// START
//==================================================================

void BWNStart()
{
   BWN_Running = true;
   BWN_TargetReached = false;

   BWN_StartBalance =
      AccountInfoDouble(ACCOUNT_BALANCE);

   BWN_StartEquity =
      AccountInfoDouble(ACCOUNT_EQUITY);

   BWN_StartTime = TimeCurrent();

   BWN_PeakProfit = 0.0;
   BWN_LossStreak = 0;

   Print("BWN STARTED.");
}

//==================================================================
// STOP
//==================================================================

void BWNStop()
{
   BWN_Running = false;

   Print("BWN STOPPED. Existing positions are not forcibly closed.");
}

//==================================================================
// EMERGENCY
//==================================================================

void BWNEmergency()
{
   BWN_Running = false;

   CloseAllBWNPositions();

   BWN_PeakProfit = 0.0;
   BWN_Direction = BWN_NONE;

   Print("BWN EMERGENCY STOP ACTIVATED.");
}

//==================================================================
// MAIN MANAGER
//==================================================================

void ManageBWN()
{
   if(SessionTargetHit())
   {
      CloseAllBWNPositions();

      BWN_TargetReached = true;
      BWN_Running = false;

      Print("BWN $1000 SESSION TARGET REACHED.");

      return;
   }

   if(CheckProtection())
   {
      CloseAllBWNPositions();

      BWN_Running = false;

      Print("BWN PROTECTION STOP.");

      return;
   }

   if(!SpreadOK())
      return;

   //==============================================================
   // NO POSITIONS
   //==============================================================

   if(CountBWNPositions() == 0)
   {
      ResetBasket();

      ImmediateRescanAndOpen();

      return;
   }

   //==============================================================
   // POSITIONS EXIST
   //==============================================================

   ManageProfitRetracement();

   if(CountBWNPositions() == 0)
      return;

   ManageStrongReversal();

   if(CountBWNPositions() == 0)
      return;

   MaintainTrades();
}//==================================================================
// LIVE BUY STRENGTH
// IMPORTANT: ONLY CURRENT FORMING M1 CANDLE (SHIFT 0)
//==================================================================

double GetBuyStrength()
{
   MqlRates candle[1];

   // ZERO = CURRENT FORMING CANDLE
   if(CopyRates(
         _Symbol,
         PERIOD_M1,
         0,
         1,
         candle) != 1)
   {
      return 50.0;
   }

   double open_price = candle[0].open;
   double high_price = candle[0].high;
   double low_price  = candle[0].low;

   double bid =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_BID);

   if(open_price <= 0.0)
      return 50.0;

   // Current candle range.
   double range =
      high_price - low_price;

   // At the very beginning of a new candle,
   // there may be virtually no range.
   if(range <= (_Point * 2.0))
   {
      if(bid > open_price)
         return 51.0;

      if(bid < open_price)
         return 49.0;

      return 50.0;
   }

   // Where is LIVE price inside CURRENT candle?
   double position =
      (bid - low_price) / range;

   if(position < 0.0)
      position = 0.0;

   if(position > 1.0)
      position = 1.0;

   // Current candle movement from OPEN.
   double movement =
      (bid - open_price) / range;

   if(movement > 1.0)
      movement = 1.0;

   if(movement < -1.0)
      movement = -1.0;

   // Live directional strength.
   double strength =
      50.0
      +
      ((position - 0.5) * 50.0)
      +
      (movement * 25.0);

   if(strength < 0.0)
      strength = 0.0;

   if(strength > 100.0)
      strength = 100.0;

   return strength;
}

//==================================================================
// LIVE SELL STRENGTH
//==================================================================

double GetSellStrength()
{
   return 100.0 - GetBuyStrength();
}

//==================================================================
// CURRENT M1 DIRECTION
//==================================================================

int GetLiveDirection()
{
   double buy =
      GetBuyStrength();

   double sell =
      GetSellStrength();

   // BUY
   if(buy >= EntryStrengthPercent &&
      buy > sell)
   {
      return BWN_BUY;
   }

   // SELL
   if(sell >= EntryStrengthPercent &&
      sell > buy)
   {
      return BWN_SELL;
   }

   return BWN_NONE;
}

//==================================================================
// AUTOMATIC LOT SIZE
//
// $0 - $9.99     = 0.01
// $10 - $19.99   = 0.02
// $20 - $29.99   = 0.03
// etc.
//==================================================================

double GetBWNLot()
{
   if(!UseAutomaticLot)
      return NormalizeBWNLot(
         ManualLotSize);

   double balance =
      AccountInfoDouble(
         ACCOUNT_BALANCE);

   if(balance < 0.0)
      balance = 0.0;

   int steps =
      (int)MathFloor(
         balance / BalanceStepUSD);

   double lot =
      LotIncreasePerStep *
      (steps + 1);

   if(lot > MaximumLotSize)
      lot = MaximumLotSize;

   return NormalizeBWNLot(lot);
}

//==================================================================
// LOT NORMALIZATION
//==================================================================

double NormalizeBWNLot(double lot)
{
   double min_lot =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_VOLUME_MIN);

   double max_lot =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_VOLUME_MAX);

   double step =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_VOLUME_STEP);

   if(step <= 0.0)
      step = 0.01;

   if(lot < min_lot)
      lot = min_lot;

   if(lot > max_lot)
      lot = max_lot;

   if(lot > MaximumLotSize)
      lot = MaximumLotSize;

   lot =
      MathFloor(
         lot / step + 0.0000001)
      * step;

   if(lot < min_lot)
      lot = min_lot;

   int digits = 2;

   if(step >= 1.0)
      digits = 0;
   else if(step >= 0.1)
      digits = 1;
   else if(step >= 0.01)
      digits = 2;
   else
      digits = 3;

   return NormalizeDouble(
      lot,
      digits);
}

//==================================================================
// SPREAD
//==================================================================

bool SpreadOK()
{
   double bid =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_BID);

   double ask =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_ASK);

   if(bid <= 0.0 ||
      ask <= 0.0)
      return false;

   double spread =
      (ask - bid) / _Point;

   double points_per_pip = 1.0;

   if(_Digits == 3 ||
      _Digits == 5)
   {
      points_per_pip = 10.0;
   }

   double spread_pips =
      spread / points_per_pip;

   return(
      spread_pips <=
      MaximumSpreadPips);
}

//==================================================================
// ACCOUNT TYPE
//==================================================================

bool IsHedgingAccount()
{
   long mode =
      AccountInfoInteger(
         ACCOUNT_MARGIN_MODE);

   if(mode ==
      ACCOUNT_MARGIN_MODE_RETAIL_HEDGING)
   {
      return true;
   }

   return false;
}

//==================================================================
// COUNT BWN POSITIONS
//==================================================================

int CountBWNPositions()
{
   int count = 0;

   for(int i =
       PositionsTotal() - 1;
       i >= 0;
       i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      ulong magic =
         (ulong)PositionGetInteger(
            POSITION_MAGIC);

      string symbol =
         PositionGetString(
            POSITION_SYMBOL);

      if(magic == MagicNumber &&
         symbol == _Symbol)
      {
         count++;
      }
   }

   return count;
}

//==================================================================
// COUNT DIRECTION
//==================================================================

int CountBWNPositionsDirection(
   int direction)
{
   int count = 0;

   for(int i =
       PositionsTotal() - 1;
       i >= 0;
       i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      ulong magic =
         (ulong)PositionGetInteger(
            POSITION_MAGIC);

      string symbol =
         PositionGetString(
            POSITION_SYMBOL);

      if(magic != MagicNumber ||
         symbol != _Symbol)
      {
         continue;
      }

      ENUM_POSITION_TYPE type =
         (ENUM_POSITION_TYPE)
         PositionGetInteger(
            POSITION_TYPE);

      if(direction == BWN_BUY &&
         type == POSITION_TYPE_BUY)
      {
         count++;
      }

      if(direction == BWN_SELL &&
         type == POSITION_TYPE_SELL)
      {
         count++;
      }
   }

   return count;
}

//==================================================================
// FLOATING BASKET PROFIT
//==================================================================

double GetBWNFloatProfit()
{
   double total = 0.0;

   for(int i =
       PositionsTotal() - 1;
       i >= 0;
       i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      ulong magic =
         (ulong)PositionGetInteger(
            POSITION_MAGIC);

      string symbol =
         PositionGetString(
            POSITION_SYMBOL);

      if(magic != MagicNumber ||
         symbol != _Symbol)
      {
         continue;
      }

      total +=
         PositionGetDouble(
            POSITION_PROFIT);

      total +=
         PositionGetDouble(
            POSITION_SWAP);
   }

   return total;
}

//==================================================================
// CAN OPEN
//==================================================================

bool CanOpenTrade(
   int direction,
   double lot)
{
   if(lot <= 0.0)
      return false;

   if(CountBWNPositions() >=
      MaximumOpenTrades)
   {
      return false;
   }

   double equity =
      AccountInfoDouble(
         ACCOUNT_EQUITY);

   double current_margin =
      AccountInfoDouble(
         ACCOUNT_MARGIN);

   double free_margin =
      AccountInfoDouble(
         ACCOUNT_MARGIN_FREE);

   if(equity <= 0.0 ||
      free_margin <= 0.0)
   {
      return false;
   }

   double maximum_margin =
      equity *
      MaximumMarginPercent /
      100.0;

   if(current_margin >=
      maximum_margin)
   {
      return false;
   }

   ENUM_ORDER_TYPE order_type =
      ORDER_TYPE_BUY;

   double price =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_ASK);

   if(direction == BWN_SELL)
   {
      order_type =
         ORDER_TYPE_SELL;

      price =
         SymbolInfoDouble(
            _Symbol,
            SYMBOL_BID);
   }

   double required_margin = 0.0;

   if(!OrderCalcMargin(
         order_type,
         _Symbol,
         lot,
         price,
         required_margin))
   {
      return false;
   }

   if(required_margin <= 0.0)
      return false;

   if(required_margin >
      free_margin)
   {
      return false;
   }

   if(current_margin +
      required_margin >
      maximum_margin)
   {
      return false;
   }

   return true;
}

//==================================================================
// OPEN ONE TRADE
//==================================================================

bool OpenOneTrade(
   int direction,
   double lot)
{
   bool result = false;

   if(direction == BWN_BUY)
   {
      result =
         trade.Buy(
            lot,
            _Symbol,
            0.0,
            0.0,
            0.0,
            "BWN BUY");
   }
   else if(direction == BWN_SELL)
   {
      result =
         trade.Sell(
            lot,
            _Symbol,
            0.0,
            0.0,
            0.0,
            "BWN SELL");
   }

   if(!result)
   {
      Print(
         "BWN ORDER ERROR: ",
         trade.ResultRetcode(),
         " ",
         trade.ResultRetcodeDescription());

      return false;
   }

   return true;
}

//==================================================================
// OPEN MULTIPLE TRADES
//==================================================================

int OpenMultipleTrades(
   int direction)
{
   if(direction != BWN_BUY &&
      direction != BWN_SELL)
   {
      return 0;
   }

   double lot =
      GetBWNLot();

   if(lot <= 0.0)
      return 0;

   int opened = 0;

   BWN_Direction = direction;

   //===============================================================
   // HEDGING ACCOUNT
   // Each order can be a separate position.
   //===============================================================

   if(IsHedgingAccount())
   {
      for(int i = 0;
          i < MaximumOpenTrades;
          i++)
      {
         if(CountBWNPositions() >=
            MaximumOpenTrades)
         {
            break;
         }

         if(!CanOpenTrade(
               direction,
               lot))
         {
            break;
         }

         if(OpenOneTrade(
               direction,
               lot))
         {
            opened++;
         }
         else
         {
            break;
         }
      }
   }
   else
   {
      //============================================================
      // NETTING ACCOUNT
      // Multiple orders are accumulated into one net position.
      //============================================================

      while(opened <
            MaximumOpenTrades)
      {
         if(!CanOpenTrade(
               direction,
               lot))
         {
            break;
         }

         if(OpenOneTrade(
               direction,
               lot))
         {
            opened++;
         }
         else
         {
            break;
         }

         if(CountBWNPositions() >=
            MaximumOpenTrades)
         {
            break;
         }
      }
   }

   if(opened > 0)
   {
      BWN_PeakProfit = 0.0;

      Print(
         "BWN opened ",
         opened,
         " trade(s). Lot=",
         DoubleToString(lot,2));
   }

   return opened;
}

//==================================================================
// IMMEDIATE ENTRY
//==================================================================

void ImmediateRescanAndOpen()
{
   // Read CURRENT forming M1 candle again.
   int direction =
      GetLiveDirection();

   if(direction == BWN_NONE)
      return;

   double buy =
      GetBuyStrength();

   double sell =
      GetSellStrength();

   Print(
      "BWN LIVE ENTRY SCAN | BUY=",
      DoubleToString(buy,2),
      "% | SELL=",
      DoubleToString(sell,2),
      "%");

   OpenMultipleTrades(direction);
}//==================================================================
// PROFIT RETRACEMENT
//==================================================================

void ManageProfitRetracement()
{
   double profit =
      GetBWNFloatProfit();

   // Do nothing while basket is not profitable.
   if(profit <= 0.0)
      return;

   // Record highest profit.
   if(profit > BWN_PeakProfit)
   {
      BWN_PeakProfit = profit;

      Print(
         "BWN PEAK PROFIT = $",
         DoubleToString(
            BWN_PeakProfit,
            2));
   }

   if(BWN_PeakProfit <= 0.0)
      return;

   // Example:
   // Peak = $100
   // 2% retracement = $2
   // Close when profit falls to $98.
   double retracement =
      BWN_PeakProfit *
      ProfitRetracePercent /
      100.0;

   double close_level =
      BWN_PeakProfit -
      retracement;

   if(profit <= close_level)
   {
      Print(
         "BWN 2% PROFIT RETRACEMENT. Peak=$",
         DoubleToString(
            BWN_PeakProfit,
            2),
         " Current=$",
         DoubleToString(
            profit,
            2));

      CloseAllBWNPositions();

      ResetBasket();

      //============================================================
      // IMPORTANT:
      // Immediately scan CURRENT M1 candle.
      // NO CANDLE CLOSE.
      // NO WAITING FOR NEW CANDLE.
      //============================================================

      if(BWN_Running)
      {
         ImmediateRescanAndOpen();
      }
   }
}

//==================================================================
// STRONG REVERSAL
//==================================================================

void ManageStrongReversal()
{
   if(CountBWNPositions() <= 0)
      return;

   double buy =
      GetBuyStrength();

   double sell =
      GetSellStrength();

   //===============================================================
   // BUY -> STRONG SELL
   //===============================================================

   if(BWN_Direction == BWN_BUY &&
      sell >= ReversalStrengthPercent)
   {
      Print(
         "BWN STRONG REVERSAL BUY -> SELL. SELL=",
         DoubleToString(
            sell,
            2),
         "%");

      CloseAllBWNPositions();

      ResetBasket();

      // Immediately read current forming candle.
      double new_buy =
         GetBuyStrength();

      double new_sell =
         GetSellStrength();

      if(new_sell >=
         ReversalStrengthPercent &&
         new_sell > new_buy)
      {
         OpenMultipleTrades(
            BWN_SELL);
      }

      return;
   }

   //===============================================================
   // SELL -> STRONG BUY
   //===============================================================

   if(BWN_Direction == BWN_SELL &&
      buy >= ReversalStrengthPercent)
   {
      Print(
         "BWN STRONG REVERSAL SELL -> BUY. BUY=",
         DoubleToString(
            buy,
            2),
         "%");

      CloseAllBWNPositions();

      ResetBasket();

      // Immediately read current forming candle.
      double new_buy =
         GetBuyStrength();

      double new_sell =
         GetSellStrength();

      if(new_buy >=
         ReversalStrengthPercent &&
         new_buy > new_sell)
      {
         OpenMultipleTrades(
            BWN_BUY);
      }

      return;
   }
}

//==================================================================
// MAINTAIN TRADES
//==================================================================

void MaintainTrades()
{
   if(!BWN_Running)
      return;

   int live_direction =
      GetLiveDirection();

   if(live_direction == BWN_NONE)
      return;

   //===============================================================
   // If direction has changed strongly, reversal manager handles it.
   //===============================================================

   if(BWN_Direction == BWN_BUY &&
      GetSellStrength() >=
      ReversalStrengthPercent)
   {
      return;
   }

   if(BWN_Direction == BWN_SELL &&
      GetBuyStrength() >=
      ReversalStrengthPercent)
   {
      return;
   }

   //===============================================================
   // If some trades closed, immediately attempt replacement.
   //===============================================================

   if(live_direction ==
      BWN_Direction)
   {
      double lot =
         GetBWNLot();

      while(CountBWNPositions() <
            MaximumOpenTrades)
      {
         if(!CanOpenTrade(
               live_direction,
               lot))
         {
            break;
         }

         if(!OpenOneTrade(
               live_direction,
               lot))
         {
            break;
         }

         // Check the LIVE M1 candle again.
         int new_direction =
            GetLiveDirection();

         if(new_direction !=
            live_direction)
         {
            break;
         }
      }
   }
   else
   {
      // If direction changes but is not yet 65%,
      // do not force a reversal.
      // Wait for the 65% strong reversal condition.
   }
}

//==================================================================
// CLOSE ALL BWN POSITIONS
//==================================================================

bool CloseAllBWNPositions()
{
   bool success = true;

   for(int i =
       PositionsTotal() - 1;
       i >= 0;
       i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      ulong magic =
         (ulong)PositionGetInteger(
            POSITION_MAGIC);

      string symbol =
         PositionGetString(
            POSITION_SYMBOL);

      if(magic != MagicNumber ||
         symbol != _Symbol)
      {
         continue;
      }

      if(!trade.PositionClose(
            ticket))
      {
         success = false;

         Print(
            "BWN CLOSE ERROR Ticket=",
            ticket,
            " ",
            trade.ResultRetcodeDescription());
      }
   }

   return success;
}

