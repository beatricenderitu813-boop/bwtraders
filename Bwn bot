void UpdateBWNInterface()
{
   double buy =
      GetBuyStrength();

   double sell =
      GetSellStrength();

   int direction =
      GetLiveDirection();

   string direction_text =
      "WAIT";

   if(direction == BWN_BUY)
      direction_text = "BUY";

   if(direction == BWN_SELL)
      direction_text = "SELL";

   string status =
      "STOPPED";

   if(BWN_Running)
      status = "RUNNING";

   if(BWN_TargetReached)
      status = "TARGET REACHED";

   if(BWN_ProtectionStop)
      status = "PROTECTION STOP";

   double lot =
      GetBWNLot();

   int positions =
      CountBWNPositions();

   double basket =
      GetBWNFloatProfit();

   double session =
      GetSessionProfit();

   double drawdown =
      GetDrawdownPercent();

   string protection_text =
      "OFF";

   if(UseDrawdownProtection ||
      UseDailyLossProtection ||
      UseLossStreakProtection)
   {
      protection_text = "ON";
   }

   string info =
      StringFormat(
         "BWN BOT v6.00\n\n"
         "STATUS: %s\n\n"
         "CURRENT FORMING M1 CANDLE\n"
