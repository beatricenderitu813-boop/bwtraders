//====================================================================
// INITIALIZATION
//====================================================================

int OnInit()
{
   trade.SetExpertMagicNumber(MagicNumber);
   trade.SetDeviationInPoints(SlippagePoints);
   trade.SetAsyncMode(false);

   BWN_StartBalance =
      AccountInfoDouble(ACCOUNT_BALANCE);

   BWN_StartEquity =
      AccountInfoDouble(ACCOUNT_EQUITY);

   BWN_StartTime =
      TimeCurrent();

   BWN_PeakProfit =
      0.0;

   BWN_Direction =
      BWN_NONE;

   BWN_LossStreak =
      0;

   BWN_TargetReached =
      false;

   BWN_ProtectionStop =
      false;

   CreateBWNInterface();

   if(StartTradingOnAttach)
   {
      BWNStart();
   }
   else
   {
      BWNStop();
   }

   Print("========================================");
   Print("BWN BOT v4.00 INITIALIZED");
   Print("Symbol: ",_Symbol);
   Print("Timeframe: M1");
   Print("Entry: ",EntryStrengthPercent,"%");
   Print("Reversal: ",ReversalStrengthPercent,"%");
   Print("Profit retracement: ",ProfitRetracePercent,"%");
   Print("Session target: $",SessionTargetUSD);
   Print("Magic number: ",MagicNumber);
   Print("========================================");

   return(INIT_SUCCEEDED);
}

//====================================================================
// DEINITIALIZATION
//====================================================================

void OnDeinit(const int reason)
{
   DeleteBWNInterface();

   Print("BWN BOT DEINITIALIZED. Reason = ",reason);
}

//====================================================================
// MAIN TICK FUNCTION
//====================================================================

void OnTick()
{
   // Update the panel on EVERY tick.
   // This means BUY/SELL is based on the current live M1 candle.
   UpdateBWNInterface();

   if(!BWN_Running)
      return;

   if(BWN_TargetReached)
      return;

   if(BWN_ProtectionStop)
      return;

   ManageBWN();
}

//====================================================================
// CHART BUTTON EVENTS
//====================================================================

void OnChartEvent(
   const int id,
   const long &lparam,
   const double &dparam,
   const string &sparam)
{
   if(id != CHARTEVENT_OBJECT_CLICK)
      return;

   if(sparam == BWN_START)
   {
      BWNStart();
   }

   if(sparam == BWN_STOP)
   {
      BWNStop();
   }

   if(sparam == BWN_EMERGENCY)
   {
      BWNEmergency();
   }
}

//====================================================================
// TRADE TRANSACTION
//====================================================================

void OnTradeTransaction(
   const MqlTradeTransaction &trans,
   const MqlTradeRequest &request,
   const MqlTradeResult &result)
{
   if(trans.type != TRADE_TRANSACTION_DEAL_ADD)
      return;

   if(trans.deal == 0)
      return;

   if(!HistoryDealSelect(trans.deal))
      return;

   ulong magic =
      (ulong)HistoryDealGetInteger(
         trans.deal,
         DEAL_MAGIC);

   string symbol =
      HistoryDealGetString(
         trans.deal,
         DEAL_SYMBOL);

   if(magic != MagicNumber)
      return;

   if(symbol != _Symbol)
      return;

   long entry =
      HistoryDealGetInteger(
         trans.deal,
         DEAL_ENTRY);

   if(entry == DEAL_ENTRY_OUT ||
      entry == DEAL_ENTRY_OUT_BY)
   {
      double profit =
         HistoryDealGetDouble(
            trans.deal,
            DEAL_PROFIT);

      if(profit < 0.0)
      {
         BWN_LossStreak++;
      }
      else
      {
         if(profit > 0.0)
            BWN_LossStreak = 0;
      }
   }
}

