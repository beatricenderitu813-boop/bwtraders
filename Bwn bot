//====================================================================//====================================================================
// OPEN BUY
//====================================================================

bool OpenBuy()
{
   if(!BotRunning || EmergencyMode)
      return false;

   int total = CountBotPositions();

   // Normal limit is 2.
   // Third position is allowed only through the special losing rule.
   if(total >= MaximumPositionsWithAdd)
      return false;

   if(!IsSpreadOK())
      return false;

   double lot = CalculateLotSize();

   if(lot <= 0.0)
      return false;

   if(!HasEnoughMargin(ORDER_TYPE_BUY,lot))
   {
      Print("BUY rejected: insufficient free margin.");
      return false;
   }

   double ask = SymbolInfoDouble(_Symbol,SYMBOL_ASK);

   if(ask <= 0.0)
      return false;

   bool result = trade.Buy(lot,
                           _Symbol,
                           0.0,
                           0.0,
                           0.0,
                           "BWN BUY");

   if(!result)
   {
      Print("BUY failed. Retcode: ",
            trade.ResultRetcode(),
            " - ",
            trade.ResultRetcodeDescription());

      return false;
   }

   Print("BUY opened. Lot: ",
         DoubleToString(lot,VolumeDigits()),
         " Price: ",
         DoubleToString(ask,_Digits));

   return true;
}

//====================================================================
// OPEN SELL
//====================================================================

bool OpenSell()
{
   if(!BotRunning || EmergencyMode)
      return false;

   int total = CountBotPositions();

   if(total >= MaximumPositionsWithAdd)
      return false;

   if(!IsSpreadOK())
      return false;

   double lot = CalculateLotSize();

   if(lot <= 0.0)
      return false;

   if(!HasEnoughMargin(ORDER_TYPE_SELL,lot))
   {
      Print("SELL rejected: insufficient free margin.");
      return false;
   }

   double bid = SymbolInfoDouble(_Symbol,SYMBOL_BID);

   if(bid <= 0.0)
      return false;

   bool result = trade.Sell(lot,
                            _Symbol,
                            0.0,
                            0.0,
                            0.0,
                            "BWN SELL");

   if(!result)
   {
      Print("SELL failed. Retcode: ",
            trade.ResultRetcode(),
            " - ",
            trade.ResultRetcodeDescription());

      return false;
   }

   Print("SELL opened. Lot: ",
         DoubleToString(lot,VolumeDigits()),
         " Price: ",
         DoubleToString(bid,_Digits));

   return true;
}

//====================================================================
// CALCULATE AUTOMATIC LOT SIZE
//====================================================================

double CalculateLotSize()
{
   double balance = AccountInfoDouble(ACCOUNT_BALANCE);

   double lot;

   if(!UseAutomaticLotSizing)
      lot = ManualLotSize;
   else
   {
      // $0.00 - $9.99  = 0.01
      // $10 - $19.99   = 0.02
      // $20 - $29.99   = 0.03
      // etc.

      int tier = (int)MathFloor(balance / 10.0);

      lot = 0.01 * (tier + 1);
   }

   return NormalizeLot(lot);
}

//====================================================================
// NORMALIZE LOT TO BROKER RULES
//====================================================================

double NormalizeLot(double volume)
{
   double minLot  = SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MIN);
   double maxLot  = SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MAX);
   double stepLot = SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_STEP);

   if(minLot <= 0.0)
      minLot = 0.01;

   if(maxLot <= 0.0)
      maxLot = volume;

   if(stepLot <= 0.0)
      stepLot = minLot;

   if(volume < minLot)
      volume = minLot;

   if(volume > maxLot)
      volume = maxLot;

   double steps = MathFloor((volume / stepLot) + 0.0000001);

   volume = steps * stepLot;

   if(volume < minLot)
      volume = minLot;

   if(volume > maxLot)
      volume = maxLot;

   return NormalizeDouble(volume,VolumeDigits());
}

//====================================================================
// VOLUME DECIMAL PLACES
//====================================================================

int VolumeDigits()
{
   double step = SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_STEP);

   if(step >= 1.0)
      return 0;

   if(step >= 0.1)
      return 1;

   if(step >= 0.01)
      return 2;

   if(step >= 0.001)
      return 3;

   return 4;
}

//====================================================================
// SPREAD CHECK
//====================================================================

bool IsSpreadOK()
{
   double ask = SymbolInfoDouble(_Symbol,SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol,SYMBOL_BID);

   if(ask <= 0.0 || bid <= 0.0)
      return false;

   double spreadPoints = (ask - bid) / _Point;

   if(spreadPoints > MaximumSpreadPoints)
   {
      Print("Spread too high: ",
            DoubleToString(spreadPoints,1),
            " points.");

      return false;
   }

   return true;
}

//====================================================================
// MARGIN CHECK
//====================================================================

bool HasEnoughMargin(ENUM_ORDER_TYPE orderType,double volume)
{
   double price;

   if(orderType == ORDER_TYPE_BUY)
      price = SymbolInfoDouble(_Symbol,SYMBOL_ASK);
   else
      price = SymbolInfoDouble(_Symbol,SYMBOL_BID);

   if(price <= 0.0)
      return false;

   double requiredMargin = 0.0;

   if(!OrderCalcMargin(orderType,
                       _Symbol,
                       volume,
                       price,
                       requiredMargin))
   {
      Print("OrderCalcMargin failed.");
      return false;
   }

   double freeMargin = AccountInfoDouble(ACCOUNT_MARGIN_FREE);
   double equity     = AccountInfoDouble(ACCOUNT_EQUITY);

   if(equity <= 0.0)
      return false;

   double minimumFreeMargin =
      equity * (MinimumFreeMarginPercent / 100.0);

   if((freeMargin - requiredMargin) < minimumFreeMargin)
   {
      Print("Margin protection: new trade rejected.");

      return false;
   }

   return true;
}

//====================================================================
// GENERAL TRADING PERMISSION
//====================================================================

bool TradingAllowed()
{
   if(!TerminalInfoInteger(TERMINAL_CONNECTED))
      return false;

   if(!MQLInfoInteger(MQL_TRADE_ALLOWED))
      return false;

   if(!AccountInfoInteger(ACCOUNT_TRADE_ALLOWED))
      return false;

   if(!SymbolInfoInteger(_Symbol,SYMBOL_TRADE_MODE))
      return false;

   return true;
}

//====================================================================
// COUNT ALL BWN POSITIONS
//====================================================================

int CountBotPositions()
{
   int count = 0;

   int total = PositionsTotal();

   for(int i = total - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol =
         PositionGetString(POSITION_SYMBOL);

      long magic =
         PositionGetInteger(POSITION_MAGIC);

      if(symbol != _Symbol)
         continue;

      if((ulong)magic != MagicNumber)
         continue;

      count++;
   }

   return count;
}

//====================================================================
// COUNT POSITIONS BY DIRECTION
//====================================================================

int CountBotPositionsByType(ENUM_POSITION_TYPE positionType)
{
   int count = 0;

   int total = PositionsTotal();

   for(int i = total - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol =
         PositionGetString(POSITION_SYMBOL);

      long magic =
         PositionGetInteger(POSITION_MAGIC);

      ENUM_POSITION_TYPE type =
         (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);

      if(symbol != _Symbol)
         continue;

      if((ulong)magic != MagicNumber)
         continue;

      if(type != positionType)
         continue;

      count++;
   }

   return count;
}

//====================================================================
// CHECK IF BOTH NORMAL POSITIONS ARE LOSING
//====================================================================

bool AllTwoPositionsAreLosing()
{
   int total = CountBotPositions();

   if(total != NormalMaximumPositions)
      return false;

   int checked = 0;

   int totalPositions = PositionsTotal();

   for(int i = totalPositions - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol =
         PositionGetString(POSITION_SYMBOL);

      long magic =
         PositionGetInteger(POSITION_MAGIC);

      if(symbol != _Symbol)
         continue;

      if((ulong)magic != MagicNumber)
         continue;

      double profit =
         PositionGetDouble(POSITION_PROFIT);

      double swap =
         PositionGetDouble(POSITION_SWAP);

      double totalProfit = profit + swap;

      checked++;

      // Every one of the two must be below zero.
      if(totalProfit >= 0.0)
         return false;

      if(checked >= NormalMaximumPositions)
         break;
   }

   return (checked == NormalMaximumPositions);
}

//====================================================================
// GET TOTAL BASKET PROFIT
//====================================================================

double GetBasketProfit()
{
   double totalProfit = 0.0;

   int total = PositionsTotal();

   for(int i = total - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol =
         PositionGetString(POSITION_SYMBOL);

      long magic =
         PositionGetInteger(POSITION_MAGIC);

      if(symbol != _Symbol)
         continue;

      if((ulong)magic != MagicNumber)
         continue;

      totalProfit +=
         PositionGetDouble(POSITION_PROFIT);

      totalProfit +=
         PositionGetDouble(POSITION_SWAP);
   }

   return totalProfit;
}

//====================================================================
// BASKET MANAGEMENT
//====================================================================

void ManageBasket()
{
   int total = CountBotPositions();

   //===============================================================
   // NO POSITIONS
   //===============================================================

   if(total == 0)
   {
      BasketPeakProfit = 0.0;
      return;
   }

   double basketProfit = GetBasketProfit();

   //===============================================================
   // RECORD HIGHEST POSITIVE BASKET PROFIT
   //===============================================================

   if(basketProfit > 0.0)
   {
      if(basketProfit > BasketPeakProfit)
      {
         BasketPeakProfit = basketProfit;

         Print("New basket peak profit: $",
               DoubleToString(BasketPeakProfit,2));
      }
   }

   //===============================================================
   // 2% PEAK PROFIT RETRACEMENT
   //
   // Example:
   // Peak = $100
   // Allowed retracement = $2
   // Protection level = $98
   //
   // Peak = $10
   // Allowed retracement = $0.20
   // Protection level = $9.80
   //===============================================================

   if(BasketPeakProfit > 0.0)
   {
      double allowedRetracement =
         BasketPeakProfit *
         (BasketRetracePercent / 100.0);

      double protectionLevel =
         BasketPeakProfit -
         allowedRetracement;

      if(basketProfit <= protectionLevel)
      {
         Print("Basket profit retracement triggered.");
         Print("Peak: $",
               DoubleToString(BasketPeakProfit,2),
               " Current: $",
               DoubleToString(basketProfit,2),
               " Protection: $",
               DoubleToString(protectionLevel,2));

         // Close the ENTIRE basket.
         // This is a basket-level protection, not an
         // individual losing-position stop.
         bool closed = CloseAllBotPositions();

         if(closed)
         {
            BasketPeakProfit = 0.0;

            // Immediately rescan CURRENT FORMING candle.
            UpdateScanner();

            // Immediately look for a new entry.
            if(BotRunning &&
               !EmergencyMode)
            {
               TradingLogic();
            }
         }
      }
   }
}

//====================================================================
// SESSION TARGET
//====================================================================

void CheckSessionTarget()
{
   if(!BotRunning)
      return;

   double balance = AccountInfoDouble(ACCOUNT_BALANCE);
   double basketProfit = GetBasketProfit();

   // Includes realized balance growth plus current floating
   // basket profit.
   double sessionProfit =
      (balance - SessionStartBalance) +
      basketProfit;

   if(sessionProfit >= SessionTargetMoney)
   {
      Print("SESSION TARGET REACHED: $",
            DoubleToString(sessionProfit,2));

      CloseAllBotPositions();

      BotRunning = false;
      BasketPeakProfit = 0.0;

      Print("BWN Bot stopped after reaching session target.");
   }
}

//====================================================================
// CLOSE ALL BWN POSITIONS
//====================================================================

bool CloseAllBotPositions()
{
   bool allClosed = true;

   for(int pass = 0; pass < 3; pass++)
   {
      bool found = false;

      int total = PositionsTotal();

      for(int i = total - 1; i >= 0; i--)
      {
         ulong ticket = PositionGetTicket(i);

         if(ticket == 0)
            continue;

         if(!PositionSelectByTicket(ticket))
            continue;

         string symbol =
            PositionGetString(POSITION_SYMBOL);

         long magic =
            PositionGetInteger(POSITION_MAGIC);

         if(symbol != _Symbol)
            continue;

         if((ulong)magic != MagicNumber)
            continue;

         found = true;

         if(!trade.PositionClose(ticket))
         {
            Print("Failed to close ticket ",
                  ticket,
                  ". Retcode: ",
                  trade.ResultRetcode(),
                  " - ",
                  trade.ResultRetcodeDescription());

            allClosed = false;
         }
      }

      if(!found)
         break;
   }

   if(CountBotPositions() > 0)
      allClosed = false;

   return allClosed;
}

//====================================================================
// CLOSE ONE DIRECTION
//====================================================================

bool CloseDirection(ENUM_POSITION_TYPE positionType)
{
   bool allClosed = true;

   for(int pass = 0; pass < 3; pass++)
   {
      bool found = false;

      int total = PositionsTotal();

      for(int i = total - 1; i >= 0; i--)
      {
         ulong ticket = PositionGetTicket(i);

         if(ticket == 0)
            continue;

         if(!PositionSelectByTicket(ticket))
            continue;

         string symbol =
            PositionGetString(POSITION_SYMBOL);

         long magic =
            PositionGetInteger(POSITION_MAGIC);

         ENUM_POSITION_TYPE type =
            (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);

         if(symbol != _Symbol)
            continue;

         if((ulong)magic != MagicNumber)
            continue;

         if(type != positionType)
            continue;

         found = true;

         if(!trade.PositionClose(ticket))
         {
            Print("Failed to close ticket ",
                  ticket,
                  ". Retcode: ",
                  trade.ResultRetcode(),
                  " - ",
                  trade.ResultRetcodeDescription());

            allClosed = false;
         }
      }

      if(!found)
         break;
   }

   if(CountBotPositionsByType(positionType) > 0)
      allClosed = false;

   return allClosed;
}

