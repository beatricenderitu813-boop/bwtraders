   if(ObjectFind(
      0,
      TXT_TRADES) >= 0)
   {
      ObjectSetString(
         0,
         TXT_TRADES,
         OBJPROP_TEXT,
         "TRADES: " +
         IntegerToString(
            CountBotPositions(-1)
         ) +
         " / 2"
      );
