double GetSellStrength()
{
   MqlRates candle[1];

   int copied =
      CopyRates(
         _Symbol,
         PERIOD_M1,
         0,
         1,
         candle);

   if(copied != 1)
      return(50.0);

   double open_price = candle[0].open;
   double high_price = candle[0].high;
   double low_price  = candle[0].low;

   double bid =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_BID);

   if(open_price <= 0.0 ||
      bid <= 0.0)
   {
      return(50.0);
   }

   double range =
      high_price - low_price;

   if(range <= (_Point * 2.0))
   {
      if(bid < open_price)
         return(51.0);

      if(bid > open_price)
         return(49.0);

      return(50.0);
   }

   double position =
      (bid - low_price) / range;

   if(position < 0.0)
      position = 0.0;

   if(position > 1.0)
