      0,
      TXT_BASKET) >= 0)
   {
      ObjectSetString(
         0,
         TXT_BASKET,
         OBJPROP_TEXT,
         "BASKET: $" +
         DoubleToString(
            GetBasketProfit(),
            2
         ) +
         "  PEAK: $" +
         DoubleToString(
            BasketPeakProfit,
            2
         )
      );
   }

   SessionProfit =
      AccountInfoDouble(
