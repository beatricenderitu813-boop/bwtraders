         "LOT SIZE: %.2f\n\n"
         "OPEN TRADES: %d\n\n"
         "BASKET PROFIT: $%.2f\n\n"
         "PEAK PROFIT: $%.2f\n\n"
         "RETRACE: %.1f%%\n\n"
         "SESSION: $%.2f\n\n"
         "TARGET: $%.2f\n\n"
         "PROTECTION: %s\n\n"
         "DRAWDOWN: %.2f%%",
