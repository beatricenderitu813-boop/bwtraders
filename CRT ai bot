      return _Symbol;

   return TradingSymbol;
}

//==================================================================
// NORMALIZE VOLUME
//==================================================================

double NormalizeVolume(
   string symbol,
   double volume)
{
   double minLot =
      SymbolInfoDouble(
         symbol,
         SYMBOL_VOLUME_MIN
      );

   double maxLot =
      SymbolInfoDouble(
         symbol,
         SYMBOL_VOLUME_MAX
      );

   double step =
      SymbolInfoDouble(
         symbol,
         SYMBOL_VOLUME_STEP
      );

   if(step <= 0.0)
      step = minLot;

   if(volume < minLot)
      volume = minLot;

   if(volume > maxLot)
      volume = maxLot;

   volume =
      MathFloor(
         volume / step
      ) * step;

   if(volume < minLot)
      volume = minLot;

   return NormalizeDouble(
      volume,
      2
   );
}

//==================================================================
// DYNAMIC LOT
//==================================================================

double CalculateDynamicLot()
{
   double balance =
      AccountInfoDouble(
         ACCOUNT_BALANCE
      );

   double rawLot =
      balance * LotMultiplier;

   return NormalizeVolume(
      Sym(),
      rawLot
   );
}

//==================================================================
// COUNT EA POSITIONS
//==================================================================

int CountPositions()
{
   int count = 0;

   for(int i = PositionsTotal() - 1;
       i >= 0;
       i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol =
         PositionGetString(
            POSITION_SYMBOL
         );

      long magic =
         PositionGetInteger(
            POSITION_MAGIC
         );

      if(symbol != Sym())
         continue;

      if((ulong)magic != MagicNumber)
         continue;

      count++;
   }

   return count;
}

//==================================================================
// TOTAL EA LOTS
//==================================================================

double TotalLots()
{
   double lots = 0.0;

   for(int i = PositionsTotal() - 1;
       i >= 0;
       i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol =
         PositionGetString(
            POSITION_SYMBOL
         );

      long magic =
         PositionGetInteger(
            POSITION_MAGIC
         );

      if(symbol != Sym())
         continue;

      if((ulong)magic != MagicNumber)
         continue;

      lots +=
         PositionGetDouble(
            POSITION_VOLUME
         );
   }

   return lots;
}

//==================================================================
// BASKET PROFIT
//==================================================================

double BasketProfit()
{
   double profit = 0.0;

   for(int i = PositionsTotal() - 1;
       i >= 0;
       i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol =
         PositionGetString(
            POSITION_SYMBOL
         );

      long magic =
         PositionGetInteger(
            POSITION_MAGIC
         );

      if(symbol != Sym())
         continue;

      if((ulong)magic != MagicNumber)
         continue;

      profit +=
         PositionGetDouble(
            POSITION_PROFIT
         );

      profit +=
         PositionGetDouble(
            POSITION_SWAP
         );
   }

   return profit;
}

//==================================================================
// CLOSE ALL EA POSITIONS
//==================================================================

bool CloseAll(string reason)
{
   bool allClosed = true;

   for(int i = PositionsTotal() - 1;
       i >= 0;
       i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol =
         PositionGetString(
            POSITION_SYMBOL
         );

      long magic =
         PositionGetInteger(
            POSITION_MAGIC
         );

      if(symbol != Sym())
         continue;

      if((ulong)magic != MagicNumber)
         continue;

      if(!trade.PositionClose(
            ticket,
            SlippagePoints))
      {
         allClosed = false;

         Print(
            "CRT AI BOT: Close failed. Ticket=",
            ticket,
            " Error=",
            GetLastError()
         );
      }
   }

   if(allClosed)
   {
      protectionActive = false;
      peakBasketProfit = 0.0;

      Print(
         "CRT AI BOT: Basket closed. Reason=",
         reason
      );
   }

   return allClosed;
}

//==================================================================
// UPDATE DAY
//==================================================================

void UpdateDay()
{
   MqlDateTime tm;

   TimeToStruct(
      TimeCurrent(),
      tm
   );

   int currentDay =
      tm.day_of_year;

   if(savedDay != currentDay)
   {
      savedDay = currentDay;

      dayStartEquity =
         AccountInfoDouble(
            ACCOUNT_EQUITY
         );

      consecutiveLosses = 0;

      tradingLocked = false;

      protectionActive = false;

      peakBasketProfit = 0.0;
   }
}

//==================================================================
// RISK CHECK
//==================================================================

bool RiskOK()
{
   double equity =
      AccountInfoDouble(
         ACCOUNT_EQUITY
      );

   double balance =
      AccountInfoDouble(
         ACCOUNT_BALANCE
      );

   if(balance <= 0.0)
      return false;

   if(dayStartEquity <= 0.0)
      dayStartEquity = equity;

   double dailyLoss =
      dayStartEquity - equity;

   double dailyLossPercent =
      (dailyLoss / dayStartEquity) * 100.0;

   if(dailyLossPercent >=
      DailyLossLimitPercent)
   {
      tradingLocked = true;

      Print(
         "CRT AI BOT: Daily loss limit reached."
      );

      return false;
   }

   double drawdown =
      balance - equity;

   double drawdownPercent =
      (drawdown / balance) * 100.0;

   if(drawdownPercent >=
      MaximumDrawdownPercent)
   {
      tradingLocked = true;

      Print(
         "CRT AI BOT: Maximum drawdown reached."
      );

      return false;
   }

   if(consecutiveLosses >=
      MaximumConsecutiveLosses)
   {
      tradingLocked = true;

      Print(
         "CRT AI BOT: Consecutive loss limit reached."
      );

      return false;
   }

   return true;
}

//==================================================================
// CURRENT FORMING M1 CANDLE DIRECTION
//==================================================================

int CurrentCandleDirection()
{
   MqlRates rates[1];

   if(CopyRates(
         Sym(),
         PERIOD_M1,
         0,
         1,
         rates) != 1)
   {
      return 0;
   }

   double candleOpen =
      rates[0].open;

   double currentPrice =
      SymbolInfoDouble(
         Sym(),
         SYMBOL_BID
      );

   if(currentPrice > candleOpen)
      return 1;

   if(currentPrice < candleOpen)
      return -1;

   return 0;
}//==================================================================
// AUTOMATIC POSITION LIMIT
//==================================================================

int CalculateAutomaticPositionLimit(
   bool buy,
   double volume)
{
   double balance =
      AccountInfoDouble(
         ACCOUNT_BALANCE
      );

   double maximumMargin =
      balance *
      MaximumBalanceMarginPercent /
      100.0;

   if(maximumMargin <= 0.0)
      return 0;

   double price;

   if(buy)
   {
      price =
         SymbolInfoDouble(
            Sym(),
            SYMBOL_ASK
         );
   }
   else
   {
      price =
         SymbolInfoDouble(
            Sym(),
            SYMBOL_BID
         );
   }

   double oneTradeMargin = 0.0;

   if(!OrderCalcMargin(
         buy ? ORDER_TYPE_BUY : ORDER_TYPE_SELL,
         Sym(),
         volume,
         price,
         oneTradeMargin))
   {
      Print(
         "CRT AI BOT: Could not calculate margin. Error=",
         GetLastError()
      );

      return 0;
   }

   if(oneTradeMargin <= 0.0)
      return 0;

   double existingMargin = 0.0;

   for(int i = PositionsTotal() - 1;
       i >= 0;
       i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol =
         PositionGetString(
            POSITION_SYMBOL
         );

      long magic =
         PositionGetInteger(
            POSITION_MAGIC
         );

      if(symbol != Sym())
         continue;

      if((ulong)magic != MagicNumber)
         continue;

      double posVolume =
         PositionGetDouble(
            POSITION_VOLUME
         );

      ENUM_POSITION_TYPE posType =
         (ENUM_POSITION_TYPE)
         PositionGetInteger(
            POSITION_TYPE
         );

      ENUM_ORDER_TYPE orderType;

      if(posType == POSITION_TYPE_BUY)
         orderType = ORDER_TYPE_BUY;
      else
         orderType = ORDER_TYPE_SELL;

      double openPrice =
         PositionGetDouble(
            POSITION_PRICE_OPEN
         );

      double posMargin = 0.0;

      if(OrderCalcMargin(
            orderType,
            Sym(),
            posVolume,
            openPrice,
            posMargin))
      {
         existingMargin += posMargin;
      }
   }

   double remainingMargin =
      maximumMargin -
      existingMargin;

   if(remainingMargin < oneTradeMargin)
      return 0;

   int possible =
      (int)MathFloor(
         remainingMargin /
         oneTradeMargin
      );

   if(possible < 0)
      possible = 0;

   if(MaximumOpenPositions > 0)
   {
      int remainingPositions =
         MaximumOpenPositions -
         CountPositions();

      if(remainingPositions < possible)
         possible = remainingPositions;
   }

   if(OrdersPerSignal > 0 &&
      OrdersPerSignal < possible)
   {
      possible = OrdersPerSignal;
   }

   return possible;
}

//==================================================================
// OPEN ONE TRADE
//==================================================================

bool OpenOne(
   bool buy,
   double volume)
{
   if(volume <= 0.0)
      return false;

   trade.SetExpertMagicNumber(
      MagicNumber
   );

   trade.SetDeviationInPoints(
      SlippagePoints
   );

   bool result = false;

   string comment =
      "CRT AI BOT";

   double sl = 0.0;
   double tp = 0.0;

   double point =
      SymbolInfoDouble(
         Sym(),
         SYMBOL_POINT
      );

   int digits =
      (int)SymbolInfoInteger(
         Sym(),
         SYMBOL_DIGITS
      );

   double pip = point;

   if(digits == 3 || digits == 5)
      pip = point * 10.0;

   double price;

   if(buy)
   {
      price =
         SymbolInfoDouble(
            Sym(),
            SYMBOL_ASK
         );

      if(StopLossPips > 0.0)
         sl =
            NormalizeDouble(
               price -
               StopLossPips * pip,
               digits
            );

      if(TakeProfitPips > 0.0)
         tp =
            NormalizeDouble(
               price +
               TakeProfitPips * pip,
               digits
            );

      result =
         trade.Buy(
            volume,
            Sym(),
            0.0,
            sl,
            tp,
            comment
         );
   }
   else
   {
      price =
         SymbolInfoDouble(
            Sym(),
            SYMBOL_BID
         );

      if(StopLossPips > 0.0)
         sl =
            NormalizeDouble(
               price +
               StopLossPips * pip,
               digits
            );

      if(TakeProfitPips > 0.0)
         tp =
            NormalizeDouble(
               price -
               TakeProfitPips * pip,
               digits
            );

      result =
         trade.Sell(
            volume,
            Sym(),
            0.0,
            sl,
            tp,
            comment
         );
   }

   if(!result)
   {
      Print(
         "CRT AI BOT: Order failed. Retcode=",
         trade.ResultRetcode(),
         " Description=",
         trade.ResultRetcodeDescription()
      );
   }

   return result;
}

//==================================================================
// OPEN CURRENT DIRECTION
//==================================================================

void OpenCurrentDirection(
   int direction)
{
   if(!tradingEnabled)
      return;

   if(tradingLocked)
      return;

   if(direction == 0)
      return;

   if(CountPositions() > 0)
      return;

   double volume =
      CalculateDynamicLot();

   if(volume <= 0.0)
      return;

   if(MaximumEAExposureLots > 0.0 &&
      volume > MaximumEAExposureLots)
   {
      volume =
         MaximumEAExposureLots;
   }

   volume =
      NormalizeVolume(
         Sym(),
         volume
      );

   if(volume <= 0.0)
      return;

   bool buy =
      (direction > 0);

   int numberToOpen =
      CalculateAutomaticPositionLimit(
         buy,
         volume
      );

   if(numberToOpen <= 0)
   {
      Print(
         "CRT AI BOT: No position slots available under margin limit."
      );

      return;
   }

   if(MaximumEAExposureLots > 0.0)
   {
      double remainingExposure =
         MaximumEAExposureLots -
         TotalLots();

      int exposureSlots =
         (int)MathFloor(
            remainingExposure /
            volume
         );

      if(exposureSlots < numberToOpen)
         numberToOpen =
            exposureSlots;
   }

   if(numberToOpen <= 0)
      return;

   int opened = 0;

   for(int i = 0;
       i < numberToOpen;
       i++)
   {
      if(!tradingEnabled)
         break;

      if(tradingLocked)
         break;

      if(MaximumEAExposureLots > 0.0 &&
         TotalLots() + volume >
         MaximumEAExposureLots +
         0.0000001)
      {
         break;
      }

      if(OpenOne(
            buy,
            volume))
      {
         opened++;
      }
      else
      {
         break;
      }
   }

   Print(
      "CRT AI BOT: Basket opened. Direction=",
      buy ? "BUY" : "SELL",
      " Trades=",
      opened,
      " Lot per trade=",
      DoubleToString(volume,2)
   );

   protectionActive = false;
   peakBasketProfit = 0.0;
}

//==================================================================
// PROFIT PROTECTION - 2% RETRACEMENT
//==================================================================

void ManageProfitProtection()
{
   if(!tradingEnabled)
      return;

   if(tradingLocked)
      return;

   int positions =
      CountPositions();

   if(positions <= 0)
   {
      protectionActive = false;
      peakBasketProfit = 0.0;
      return;
   }

   double currentProfit =
      BasketProfit();

   // NEVER close while basket is losing
   if(currentProfit <
      MinimumProfitToProtect)
   {
      protectionActive = false;
      peakBasketProfit = 0.0;
      return;
   }

   // Start protection when minimum profit is reached.
   if(!protectionActive)
   {
      protectionActive = true;
      peakBasketProfit = currentProfit;

      Print(
         "CRT AI BOT: Profit protection activated. Peak profit=$",
         DoubleToString(
            peakBasketProfit,
            2
         )
      );

      return;
   }

   // Update the highest basket profit reached.
   if(currentProfit >
      peakBasketProfit)
   {
      peakBasketProfit =
         currentProfit;
   }

   if(peakBasketProfit <= 0.0)
      return;

   // Calculate the allowed profit give-back.
   double allowedProfit =
      peakBasketProfit *
      (1.0 -
       ProfitRetracementPercent /
       100.0);

   // Close ONLY when:
   // 1. Profit has retraced by the selected percentage.
   // 2. Basket is still profitable.
   if(currentProfit <=
      allowedProfit &&
      currentProfit >=
      MinimumProfitToProtect)
   {
      Print(
         "CRT AI BOT: 2% profit retracement detected. Peak=$",
         DoubleToString(
            peakBasketProfit,
            2
         ),
         " Current=$",
         DoubleToString(
            currentProfit,
            2
         ),
         " Closing basket."
      );

      CloseAll(
         "2% profit retracement"
      );
   }
}

//==================================================================
// FLIPPING / RE-ENTRY
//==================================================================

void ManageFlipping()
{
   if(!tradingEnabled)
      return;

   if(tradingLocked)
      return;

   if(CountPositions() == 0)
   {
      protectionActive = false;
      peakBasketProfit = 0.0;

      int direction =
         CurrentCandleDirection();

      if(direction != 0)
      {
         OpenCurrentDirection(
            direction
         );
      }

      return;
   }

   ManageProfitProtection();
