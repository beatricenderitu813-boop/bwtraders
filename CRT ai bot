//==================================================================

int GetSignalDirection()
{
   if(
      buyStrength >=
      MinimumSignalStrength &&
      buyStrength >
      sellStrength
   )
   {
      return 1;
   }

   if(
      sellStrength >=
      MinimumSignalStrength &&
      sellStrength >
      buyStrength
   )
   {
      return -1;
   }

   return 0;
}

//==================================================================
// AUTOMATIC POSITION LIMIT
//==================================================================

int CalculateAutomaticPositionLimit(
   bool buy,
   double volume
)
{
   if(volume <= 0.0)
      return 0;

   double balance =
      AccountInfoDouble(
         ACCOUNT_BALANCE
      );

   if(balance <= 0.0)
      return 0;

   //---------------------------------------------------------------
   // EXPOSURE LIMIT
   //---------------------------------------------------------------

   int exposureLimit = 1000000;

   if(
      MaximumEAExposureLots >
      0.0
   )
   {
      exposureLimit =
         (int)MathFloor(
            MaximumEAExposureLots /
            volume
         );
   }

   if(exposureLimit < 1)
      return 0;

   //---------------------------------------------------------------
   // MARGIN PER POSITION
   //---------------------------------------------------------------

   double price =
      buy
      ? SymbolInfoDouble(
           Sym(),
           SYMBOL_ASK
        )
      : SymbolInfoDouble(
           Sym(),
           SYMBOL_BID
        );

   ENUM_ORDER_TYPE orderType =
      buy
      ? ORDER_TYPE_BUY
      : ORDER_TYPE_SELL;

   double marginPerPosition = 0.0;

   if(
      !OrderCalcMargin(
         orderType,
         Sym(),
         volume,
         price,
         marginPerPosition
      )
   )
   {
      Print(
         "CRT AI BOT: Margin calculation failed. Error=",
         GetLastError()
      );

      return exposureLimit;
   }

   if(marginPerPosition <= 0.0)
      return exposureLimit;

   //---------------------------------------------------------------
   // 50% BALANCE MARGIN LIMIT
   //---------------------------------------------------------------

   double maximumMargin =
      balance *
      MaximumBalanceMarginPercent /
      100.0;

   int marginLimit =
      (int)MathFloor(
         maximumMargin /
         marginPerPosition
      );

   if(marginLimit < 1)
      return 0;

   int possible =
      MathMin(
         exposureLimit,
         marginLimit
      );

   //---------------------------------------------------------------
   // OPTIONAL MAX POSITION COUNT
   //---------------------------------------------------------------

   if(
      MaximumOpenPositions >
      0
   )
   {
      int remaining =
         MaximumOpenPositions -
         CountPositions();

      if(remaining < possible)
         possible = remaining;
   }

   //---------------------------------------------------------------
   // ORDERS PER SIGNAL
   //---------------------------------------------------------------

   if(
      OrdersPerSignal >
      0 &&
      possible >
      OrdersPerSignal
   )
   {
      possible =
         OrdersPerSignal;
   }

   if(possible < 1)
      return 0;

   return possible;
}

//==================================================================
// OPEN ONE TRADE
//==================================================================

bool OpenOne(
   bool buy,
   double volume,
   string comment
)
{
   if(volume <= 0.0)
      return false;

   if(!tradingEnabled)
      return false;

   if(tradingLocked)
      return false;

   if(!SpreadOK())
      return false;

   trade.SetExpertMagicNumber(
      MagicNumber
   );

   trade.SetDeviationInPoints(
      SlippagePoints
   );

   double price =
      buy
      ? SymbolInfoDouble(
           Sym(),
           SYMBOL_ASK
        )
      : SymbolInfoDouble(
           Sym(),
           SYMBOL_BID
        );

   if(price <= 0.0)
      return false;

   double pip =
      PipSize(
         Sym()
      );

   double sl = 0.0;

   double tp = 0.0;

   //---------------------------------------------------------------
   // OPTIONAL STOP LOSS
   //---------------------------------------------------------------

   if(
      StopLossPips > 0.0 &&
      pip > 0.0
   )
   {
      if(buy)
      {
         sl =
            price -
            StopLossPips *
            pip;
      }
      else
      {
         sl =
            price +
            StopLossPips *
            pip;
      }
   }

   //---------------------------------------------------------------
   // OPTIONAL TAKE PROFIT
   //---------------------------------------------------------------

   if(
      TakeProfitPips > 0.0 &&
      pip > 0.0
   )
   {
      if(buy)
      {
         tp =
            price +
            TakeProfitPips *
            pip;
      }
      else
      {
         tp =
            price -
            TakeProfitPips *
            pip;
      }
   }

   bool result = false;

   //---------------------------------------------------------------
   // BUY
   //---------------------------------------------------------------

   if(buy)
   {
      result =
         trade.Buy(
            volume,
            Sym(),
            0.0,
            sl,
            tp,
            comment
         );
   }

   //---------------------------------------------------------------
   // SELL
   //---------------------------------------------------------------

   else
   {
      result =
         trade.Sell(
            volume,
            Sym(),
            0.0,
            sl,
            tp,
            comment
         );
   }

   if(!result)
   {
      Print(
         "CRT AI BOT: Order failed. ",
         "Retcode=",
         trade.ResultRetcode(),
         " ",
         trade.ResultRetcodeDescription()
      );

      return false;
   }

   Print(
      "CRT AI BOT: ",
      buy ? "BUY" : "SELL",
      " opened | Lot=",
      DoubleToString(
         volume,
         3
      ),
      " | ",
      comment
   );

   return true;
}

//==================================================================
// OPEN CURRENT SIGNAL
//==================================================================

void OpenCurrentDirection(
   int direction
)
{
   if(direction == 0)
      return;

   if(!tradingEnabled)
      return;

   if(tradingLocked)
      return;

   //---------------------------------------------------------------
   // ONLY START A NEW BASKET WHEN OLD BASKET IS GONE
   //---------------------------------------------------------------

   if(CountPositions() > 0)
      return;

   double volume =
      CalculateDynamicLot();

   if(volume <= 0.0)
      return;

   if(
      MaximumEAExposureLots > 0.0 &&
      volume >
      MaximumEAExposureLots
   )
   {
      volume =
         MaximumEAExposureLots;
   }

   volume =
      NormalizeVolume(
         Sym(),
         volume
      );

   if(volume <= 0.0)
      return;

   bool buy =
      direction > 0;

   int positionsAllowed =
      CalculateAutomaticPositionLimit(
         buy,
         volume
      );

   if(positionsAllowed <= 0)
   {
      Print(
         "CRT AI BOT: No positions allowed by 50% margin/exposure limit."
      );

      return;
   }

   int opened = 0;

   for(
      int i = 0;
      i < positionsAllowed;
      i++
   )
   {
      if(!tradingEnabled)
         break;

      if(tradingLocked)
         break;

      if(
         MaximumEAExposureLots > 0.0 &&
         TotalLots() +
         volume >
         MaximumEAExposureLots +
         0.0000001
      )
      {
         break;
      }

      if(
         OpenOne(
            buy,
            volume,
            "CRT AI MAIN"
         )
      )
      {
         opened++;
      }
      else
      {
         break;
      }
   }

   Print(
      "CRT AI BOT: ",
      buy ? "BUY" : "SELL",
      " basket opened. Positions=",
      opened
   );
}

