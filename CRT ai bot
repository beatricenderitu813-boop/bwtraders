#property strict
#property version "6.00"

#include <Trade/Trade.mqh>

CTrade trade;

//==================================================================
// SYMBOL
//==================================================================

input string TradingSymbol = "";     // Blank = chart symbol

//==================================================================
// LOT SIZE
//==================================================================

// Dynamic lot formula:
// $10   = 0.01 lot
// $100  = 0.10 lot
// $1000 = 1.00 lot
// $2000 = 2.00 lot

input double LotMultiplier = 0.001;

// Number of trades opened when a new direction is created.
input int OrdersPerSignal = 1;

// Maximum number of EA positions on this symbol.
input int MaximumOpenPositions = 1;

// Maximum total lots for this EA.
// 0 = disabled.
input double MaximumEAExposureLots = 10.0;

//==================================================================
// FLIPPING / PROFIT PROTECTION
//==================================================================

// Minimum floating profit required before a reversal can close
// the current trade.
//
// Example:
// 0.01 = one cent of account currency.
//
// This prevents the EA from treating an almost-zero floating
// value as meaningful profit.
input double MinimumProfitToProtect = 0.01;

//==================================================================
// EXECUTION
//==================================================================

input int SlippagePoints = 20;

//==================================================================
// OPTIONAL SL / TP
//==================================================================

// 0 = disabled.
// The main exit is the profitable reversal.

input double StopLossPips = 0.0;
input double TakeProfitPips = 0.0;

//==================================================================
// RISK PROTECTION
//==================================================================

input double DailyLossLimitPercent = 2.0;
input double MaximumDrawdownPercent = 5.0;
input int MaximumConsecutiveLosses = 3;

//==================================================================
// MAGIC NUMBER
//==================================================================

input ulong MagicNumber = 26082026;

//==================================================================
// INTERNAL VARIABLES
//==================================================================

bool tradingEnabled = false;
bool tradingLocked = false;

double dayStartEquity = 0.0;

int savedDay = -1;
int consecutiveLosses = 0;

string START_BUTTON = "CRT_START_BUTTON";
string STOP_BUTTON  = "CRT_STOP_BUTTON";
string STATUS_LABEL = "CRT_STATUS_LABEL";

//==================================================================
// RETURN SYMBOL
//==================================================================

string Sym()
{
   if(TradingSymbol == "")
      return _Symbol;

   return TradingSymbol;
}

//==================================================================
// PIP SIZE
//==================================================================

double PipSize(string s)
{
   double point = SymbolInfoDouble(s, SYMBOL_POINT);

   int digits =
      (int)SymbolInfoInteger(
         s,
         SYMBOL_DIGITS
      );

   if(point <= 0)
      return 0;

   if(digits == 3 || digits == 5)
      return point * 10.0;

   return point;
}

//==================================================================
// NORMALIZE LOT
//==================================================================

double NormalizeVolume(string s, double volume)
{
   double minVolume =
      SymbolInfoDouble(
         s,
         SYMBOL_VOLUME_MIN
      );

   double maxVolume =
      SymbolInfoDouble(
         s,
         SYMBOL_VOLUME_MAX
      );

   double step =
      SymbolInfoDouble(
         s,
         SYMBOL_VOLUME_STEP
      );

   if(minVolume <= 0 ||
      maxVolume <= 0)
   {
      return 0;
   }

   if(step <= 0)
      step = minVolume;

   volume =
      MathMax(
         volume,
         minVolume
      );

   volume =
      MathMin(
         volume,
         maxVolume
      );

   volume =
      MathFloor(
         volume / step + 1e-9
      ) * step;

   int digits = 2;

   if(step < 0.01)
      digits = 3;

   if(step < 0.001)
      digits = 4;

   return NormalizeDouble(
      volume,
      digits
   );
}

//==================================================================
// DYNAMIC LOT SIZE
//==================================================================

double CalculateDynamicLot()
{
   string s = Sym();

   double balance =
      AccountInfoDouble(
         ACCOUNT_BALANCE
      );

   double rawLot =
      balance * LotMultiplier;

   double lot =
      NormalizeVolume(
         s,
         rawLot
      );

   return lot;
}

//==================================================================
// COUNT EA POSITIONS
//==================================================================

int CountPositions()
{
   int count = 0;

   string s = Sym();

   for(
      int i = PositionsTotal() - 1;
      i >= 0;
      i--
   )
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      if(
         PositionGetString(
            POSITION_SYMBOL
         ) != s
      )
         continue;

      if(
         (ulong)PositionGetInteger(
            POSITION_MAGIC
         ) != MagicNumber
      )
      {
         continue;
      }

      count++;
   }

   return count;
}

//==================================================================
// TOTAL EA LOTS
//==================================================================

double TotalLots()
{
   double lots = 0;

   string s = Sym();

   for(
      int i = PositionsTotal() - 1;
      i >= 0;
      i--
   )
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      if(
         PositionGetString(
            POSITION_SYMBOL
         ) != s
      )
      {
         continue;
      }

      if(
         (ulong)PositionGetInteger(
            POSITION_MAGIC
         ) != MagicNumber
      )
      {
         continue;
      }

      lots +=
         PositionGetDouble(
            POSITION_VOLUME
         );
   }

   return lots;
}

