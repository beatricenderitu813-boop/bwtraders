//==================================================================

void UpdateStatus()
{
   string status;

   if(tradingLocked)
   {
      status =
         "CRT AI BOT: LOCKED";
   }
   else
   if(tradingEnabled)
   {
      status =
         "CRT AI BOT: RUNNING";
   }
   else
   {
      status =
         "CRT AI BOT: STOPPED";
   }

   status +=
      "\nSignal: " +
      signalText;

   status +=
      "\nBUY: " +
      DoubleToString(
         buyStrength,
         1
      ) +
      "%";

   status +=
      "  SELL: " +
      DoubleToString(
         sellStrength,
         1
      ) +
      "%";

   status +=
      "\nPositions: " +
      IntegerToString(
         CountPositions()
      );

   status +=
      "\nBasket Profit: $" +
      DoubleToString(
         BasketProfit(),
         2
      );

   //---------------------------------------------------------------
   // CREATE STATUS LABEL IF IT DOES NOT EXIST
   //---------------------------------------------------------------

   if(
      ObjectFind(
         0,
         STATUS_LABEL
      ) < 0
   )
   {
      ObjectCreate(
         0,
         STATUS_LABEL,
         OBJ_LABEL,
         0,
         0,
         0
      );

      ObjectSetInteger(
         0,
         STATUS_LABEL,
         OBJPROP_CORNER,
         CORNER_LEFT_UPPER
      );

      ObjectSetInteger(
         0,
         STATUS_LABEL,
         OBJPROP_XDISTANCE,
         10
      );

      ObjectSetInteger(
         0,
         STATUS_LABEL,
         OBJPROP_YDISTANCE,
         60
      );

      ObjectSetInteger(
         0,
         STATUS_LABEL,
         OBJPROP_FONTSIZE,
         10
      );
   }

   ObjectSetString(
      0,
      STATUS_LABEL,
      OBJPROP_TEXT,
      status
   );
}

