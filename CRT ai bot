//==================================================================
// SCAN ONE CANDLE
//==================================================================

void ScanCurrentCandle()
{
   buyStrength =
      CalculateBuyStrength();

   sellStrength =
      CalculateSellStrength();

   if(
      buyStrength >=
      MinimumSignalStrength &&
      buyStrength > sellStrength
   )
   {
      signalText =
         "BUY " +
         DoubleToString(
            buyStrength,
            1
         ) +
         "%";
   }
   else
   if(
      sellStrength >=
      MinimumSignalStrength &&
      sellStrength > buyStrength
   )
   {
      signalText =
         "SELL " +
         DoubleToString(
            sellStrength,
            1
         ) +
         "%";
   }
   else
   {
      signalText =
         "WAIT B:" +
         DoubleToString(
            buyStrength,
            1
         ) +
         " S:" +
         DoubleToString(
            sellStrength,
            1
         );
   }

   Print(
      "CRT AI BOT: M1 scan | BUY=",
      DoubleToString(
         buyStrength,
         1
      ),
      "% SELL=",
      DoubleToString(
         sellStrength,
         1
      ),
      "% | ",
      signalText
   );

   UpdateStatus();
}

//==================================================================
// GET SIGNAL DIRECTION
//==================================================================

int GetSignalDirection()
{
   if(
      buyStrength >=
      MinimumSignalStrength &&
      buyStrength > sellStrength
   )
   {
      return 1;
   }

   if(
      sellStrength >=
      MinimumSignalStrength &&
      sellStrength > buyStrength
   )
   {
      return -1;
   }

   return 0;
}

//==================================================================
// AUTOMATIC POSITION LIMIT
//==================================================================

int CalculateAutomaticPositionLimit(
   bool buy,
   double volume
)
{
   if(volume <= 0.0)
      return 0;

   double balance =
      AccountInfoDouble(
         ACCOUNT_BALANCE
      );

   if(balance <= 0.0)
      return 0;

   // ---------------------------------------------------------------
   // MAXIMUM EA LOT EXPOSURE
   // ---------------------------------------------------------------

   int byExposure =
      (int)MathFloor(
         MaximumEAExposureLots /
         volume
      );

   if(byExposure < 1)
      byExposure = 1;

   // ---------------------------------------------------------------
   // MARGIN LIMIT
   // ---------------------------------------------------------------

   double price =
      buy
      ? SymbolInfoDouble(
           Sym(),
           SYMBOL_ASK
        )
      : SymbolInfoDouble(
           Sym(),
           SYMBOL_BID
        );

   ENUM_ORDER_TYPE type =
      buy
      ? ORDER_TYPE_BUY
      : ORDER_TYPE_SELL;

   double marginOne = 0.0;

   if(!OrderCalcMargin(
         type,
         Sym(),
         volume,
         price,
         marginOne
      ))
   {
      return byExposure;
   }

   if(marginOne <= 0.0)
      return byExposure;

   double maximumMargin =
      balance *
      MaximumBalanceMarginPercent /
      100.0;

   int byMargin =
      (int)MathFloor(
         maximumMargin /
         marginOne
      );

   if(byMargin < 1)
      byMargin = 1;

   int limit =
      MathMin(
         byExposure,
         byMargin
      );

   if(MaximumOpenPositions > 0)
   {
      limit =
         MathMin(
            limit,
            MaximumOpenPositions
         );
   }

   return limit;
}

//==================================================================
// OPEN ONE POSITION
//==================================================================

bool OpenOne(
   bool buy,
   double volume
)
{
   if(!tradingEnabled)
      return false;

   if(tradingLocked)
      return false;

   if(!RiskOK())
      return false;

   trade.SetExpertMagicNumber(
      MagicNumber
   );

   trade.SetDeviationInPoints(
      SlippagePoints
   );

   bool result = false;

   if(buy)
   {
      result =
         trade.Buy(
            volume,
            Sym(),
            0.0,
            0.0,
            0.0,
            "CRT AI BUY"
         );
   }
   else
   {
      result =
         trade.Sell(
            volume,
            Sym(),
            0.0,
            0.0,
            0.0,
            "CRT AI SELL"
         );
   }

   if(!result)
   {
      Print(
         "CRT AI BOT: Order failed. ",
         trade.ResultRetcode(),
         " ",
         trade.ResultRetcodeDescription()
      );

      return false;
   }

   Print(
      "CRT AI BOT: ",
      buy ? "BUY" : "SELL",
      " opened. Lot=",
      DoubleToString(
         volume,
         2
      )
   );

   return true;
}

//==================================================================
// OPEN SIGNAL POSITIONS
//==================================================================

void OpenCurrentDirection(
   int direction
)
{
   if(direction == 0)
      return;

   double volume =
      CalculateDynamicLot();

   if(volume <= 0.0)
      return;

   bool buy =
      direction > 0;

   int limit =
      CalculateAutomaticPositionLimit(
         buy,
         volume
      );

   int current =
      CountPositions();

   int available =
      limit - current;

   if(available <= 0)
      return;

   int orders =
      available;

   if(OrdersPerSignal > 0)
   {
      orders =
         MathMin(
            orders,
            OrdersPerSignal
         );
   }

   for(
      int i = 0;
      i < orders;
      i++
   )
   {
      if(!OpenOne(
            buy,
            volume
         ))
      {
         break;
      }
   }
}

//==================================================================
// 2% PROFIT RETRACEMENT PROTECTION
//==================================================================

void ManageProfitProtection()
{
   int positions =
      CountPositions();

   if(positions <= 0)
   {
      protectionActive = false;
      peakBasketProfit = 0.0;
      return;
   }

   double currentProfit =
      BasketProfit();

   // NEVER close while basket is losing
   if(currentProfit <
      MinimumProfitToProtect)
   {
      return;
   }

   // Activate protection
   if(!protectionActive)
   {
      protectionActive = true;

      peakBasketProfit =
         currentProfit;

      Print(
         "CRT AI BOT: Protection active. Peak profit=$",
         DoubleToString(
            peakBasketProfit,
            2
         )
      );

      return;
   }

   // New profit peak
   if(currentProfit >
      peakBasketProfit)
   {
      peakBasketProfit =
         currentProfit;

      return;
   }

   double retracement =
      peakBasketProfit *
      ProfitRetracementPercent /
      100.0;

   double protectedProfit =
      peakBasketProfit -
      retracement;

   // CLOSE ONLY IF STILL PROFITABLE
   if(
      currentProfit >=
      MinimumProfitToProtect &&
      currentProfit <=
      protectedProfit
   )
   {
      Print(
         "CRT AI BOT: 2% profit retracement reached. ",
         "Peak=$",
         DoubleToString(
            peakBasketProfit,
            2
         ),
         " Current=$",
         DoubleToString(
            currentProfit,
            2
         )
      );

      CloseAll(
         "2% profit retracement"
      );
   }
}
