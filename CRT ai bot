// UPDATE DAY
//==================================================================

void UpdateDay()
{
   MqlDateTime nowStruct;

   TimeToStruct(
      TimeCurrent(),
      nowStruct
   );

   nowStruct.hour = 0;
   nowStruct.min  = 0;
   nowStruct.sec  = 0;

   datetime today =
      StructToTime(
         nowStruct
      );

   if(savedDay != today)
   {
      savedDay =
         today;

      dayStartEquity =
         AccountInfoDouble(
            ACCOUNT_EQUITY
         );

      consecutiveLosses = 0;

      tradingLocked = false;

      peakBasketProfit = 0.0;

      protectionActive = false;

      reentryPending = false;

      basketStartTime = 0;

      Print(
         "CRT AI BOT: New trading day."
      );

      Print(
         "Starting equity: $",
         DoubleToString(
            dayStartEquity,
            2
         )
      );
   }
}

//==================================================================
// RISK CHECK
//
// Risk protection stops NEW trading.
// It does NOT deliberately close a losing basket.
//==================================================================

bool RiskOK()
{
   double equity =
      AccountInfoDouble(
         ACCOUNT_EQUITY
      );

   // Daily loss
   if(dayStartEquity > 0.0)
   {
      double dailyLoss =
         ((dayStartEquity - equity) /
          dayStartEquity) *
         100.0;

      if(
         dailyLoss >=
         DailyLossLimitPercent
      )
      {
         tradingLocked = true;

         Print(
            "CRT AI BOT: Daily loss limit reached: ",
            DoubleToString(
               dailyLoss,
               2
            ),
            "%"
         );

         return false;
      }
   }

   // Maximum drawdown
   double balance =
      AccountInfoDouble(
         ACCOUNT_BALANCE
      );

   if(balance > 0.0)
   {
      double drawdown =
         ((balance - equity) /
          balance) *
         100.0;

      if(
         drawdown >=
         MaximumDrawdownPercent
      )
      {
         tradingLocked = true;

         Print(
            "CRT AI BOT: Maximum drawdown reached: ",
            DoubleToString(
               drawdown,
               2
            ),
            "%"
         );

         return false;
      }
   }

   // Consecutive losses
   if(
      MaximumConsecutiveLosses > 0 &&
      consecutiveLosses >=
      MaximumConsecutiveLosses
   )
   {
      tradingLocked = true;

      Print(
         "CRT AI BOT: Consecutive-loss limit reached."
      );

      return false;
   }

   return true;
}

//==================================================================
// CAPITAL PROTECTION
//
// If basket reaches -2% of account balance,
// close the whole basket.
//==================================================================

void ManageMaximumBasketLoss()
{
   if(closingBasket)
      return;

   if(CountPositions() <= 0)
      return;

   double balance =
      AccountInfoDouble(
         ACCOUNT_BALANCE
      );

   if(balance <= 0.0)
      return;

   double currentProfit =
      BasketProfit();

   double maximumLoss =
      balance *
      MaximumBasketLossPercent /
      100.0;

   if(
      currentProfit <=
      -maximumLoss
   )
   {
      Print(
         "CRT AI BOT: MAXIMUM BASKET LOSS reached. ",
         "Basket = $",
         DoubleToString(
            currentProfit,
            2
         ),
         " | Limit = -$",
         DoubleToString(
            maximumLoss,
            2
         )
      );

      reentryPending = true;

      protectionActive = false;

      peakBasketProfit = 0.0;

      CloseAll(
         "MAXIMUM BASKET LOSS 2%"
      );
   }
}

//==================================================================
// LOSING BASKET TIME PROTECTION
//
// Closes a basket if it has remained losing for the
// maximum permitted number of minutes.
//==================================================================

void ManageLosingBasketTime()
{
   if(closingBasket)
      return;

   if(CountPositions() <= 0)
      return;

   if(basketStartTime <= 0)
   {
      basketStartTime =
         TimeCurrent();

      return;
   }

   double currentProfit =
      BasketProfit();

   if(currentProfit >= 0.0)
      return;

   int secondsAllowed =
      MaximumLosingBasketMinutes *
      60;

   if(secondsAllowed <= 0)
      return;

   int secondsInBasket =
      (int)(
         TimeCurrent() -
         basketStartTime
      );

   if(secondsInBasket >= secondsAllowed)
   {
      Print(
         "CRT AI BOT: Losing basket time limit reached. ",
         "Loss = $",
         DoubleToString(
            currentProfit,
            2
         )
      );

      reentryPending = true;

      protectionActive = false;

      peakBasketProfit = 0.0;

      CloseAll(
         "MAXIMUM LOSING BASKET TIME"
      );
   }
}

//==================================================================
// PROFIT PROTECTION
//
// Tracks the highest basket profit.
// Closes only when:
// 1. Basket is currently profitable.
// 2. Protection has activated.
// 3. Profit retraces 2% from peak profit.
//==================================================================

void ManageProfitProtection()
{
   if(closingBasket)
      return;

   if(CountPositions() <= 0)
   {
      protectionActive = false;

      peakBasketProfit = 0.0;

      basketStartTime = 0;

      return;
   }

   double currentProfit =
      BasketProfit();

   // NEVER close a losing basket using
   // normal profit retracement.
   if(currentProfit <= 0.0)
      return;

   // Activate protection once minimum profit is reached.
   if(
      !protectionActive &&
      currentProfit >=
      MinimumProfitToProtect
   )
   {
      protectionActive = true;

      peakBasketProfit =
         currentProfit;

      Print(
         "CRT AI BOT: Profit protection activated. Peak = $",
         DoubleToString(
            peakBasketProfit,
            2
         )
      );

      return;
   }

   if(!protectionActive)
      return;

   // New profit peak
   if(currentProfit > peakBasketProfit)
   {
      peakBasketProfit =
         currentProfit;

      return;
   }

   if(peakBasketProfit <= 0.0)
      return;

   double retracement =
      peakBasketProfit *
      ProfitRetracePercent /
      100.0;

   double closeLevel =
      peakBasketProfit -
      retracement;

   // Only close while still profitable.
   if(
      currentProfit > 0.0 &&
      currentProfit >=
      MinimumProfitToProtect &&
      currentProfit <= closeLevel
   )
   {
      Print(
         "CRT AI BOT: Profit retracement reached. ",
         "Peak = $",
         DoubleToString(
            peakBasketProfit,
            2
         ),
         " | Current = $",
         DoubleToString(
            currentProfit,
            2
         ),
         " | Close level = $",
         DoubleToString(
            closeLevel,
            2
         )
      );

      // MT5 closing is asynchronous.
      // Re-entry happens only after positions
      // are confirmed closed.
      reentryPending = true;

      CloseAll(
         "2% PROFIT RETRACEMENT"
      );
   }
}

//==================================================================
// REVERSAL PROTECTION
//
// Losing BUY basket + SELL >= 65%
//       -> close BUY basket
//       -> wait for confirmed closure
//       -> open SELL
//
// Losing SELL basket + BUY >= 65%
//       -> close SELL basket
//       -> wait for confirmed closure
//       -> open BUY
//==================================================================

void ManageReversal()
{
   if(closingBasket)
      return;

   if(CountPositions() <= 0)
      return;

   double currentProfit =
      BasketProfit();

   // Reversal is only for a losing basket.
   if(currentProfit >= 0.0)
      return;

   int direction =
      BasketDirection();

   if(direction == 0)
      return;

   double buyStrength;
   double sellStrength;

   if(!GetSignalStrength(
      buyStrength,
      sellStrength
   ))
   {
      return;
   }

   // Existing BUY basket.
   if(direction == 1)
   {
      if(
         sellStrength >=
         ReversalSignalPercent
      )
      {
         Print(
            "CRT AI BOT: BUY basket losing. ",
            "Strong SELL reversal detected: ",
            DoubleToString(
               sellStrength,
               1
            ),
            "%"
         );

         reentryPending = true;

         protectionActive = false;

         peakBasketProfit = 0.0;

         CloseAll(
            "REVERSAL BUY TO SELL"
         );

         return;
      }
   }

   // Existing SELL basket.
   if(direction == -1)
   {
      if(
         buyStrength >=
         ReversalSignalPercent
      )
      {
         Print(
            "CRT AI BOT: SELL basket losing. ",
            "Strong BUY reversal detected: ",
            DoubleToString(
               buyStrength,
               1
            ),
            "%"
         );

         reentryPending = true;

         protectionActive = false;

         peakBasketProfit = 0.0;

         CloseAll(
            "REVERSAL SELL TO BUY"
         );

         return;
      }
   }
}

//==================================================================
// MANAGE FLIPPING / ENTRY
//
// If there is no basket, scan the CURRENT forming M1 candle.
// No candle-close waiting.
//==================================================================

void ManageFlipping()
{
   // Existing basket
   if(CountPositions() > 0)
   {
      // Start timer if necessary
      if(basketStartTime == 0)
      {
         basketStartTime =
            TimeCurrent();
      }

      return;
   }

   // Do not enter if risk protection has locked trading.
   if(tradingLocked)
      return;

   if(!tradingEnabled)
      return;

   if(reentryPending)
   {
      // We are here only after MT5 confirms
      // that the old basket no longer exists.
      reentryPending = false;

      protectionActive = false;

      peakBasketProfit = 0.0;

      basketStartTime = 0;

      Print(
         "CRT AI BOT: Previous basket confirmed closed. ",
         "Rescanning current M1 candle."
      );
   }

   int signal =
      CurrentSignal(
         BuySignalPercent
      );

   if(signal == 1)
   {
      double buyStrength;
      double sellStrength;

      if(GetSignalStrength(
         buyStrength,
         sellStrength
      ))
      {
         if(
            buyStrength >=
            BuySignalPercent
         )
         {
            Print(
               "CRT AI BOT: CURRENT M1 BUY signal = ",
               DoubleToString(
                  buyStrength,
                  1
               ),
               "%"
            );

            OpenBuyBasket();
         }
      }

      return;
   }

   double buyStrength;
   double sellStrength;

   if(!GetSignalStrength(
      buyStrength,
      sellStrength
   ))
   {
      return;
   }

   if(
      sellStrength >=
      SellSignalPercent
   )
   {
      Print(
         "CRT AI BOT: CURRENT M1 SELL signal = ",
         DoubleToString(
            sellStrength,
            1
         ),
         "%"
      );

      OpenSellBasket();
   }
}

//==================================================================
// BUTTON CREATION
//==================================================================

void CreateButton(
   string name,
   string text,
   int x,
   int y
)
{
   if(
      ObjectFind(
         0,
         name
      ) >= 0
   )
   {
      ObjectDelete(
         0,
         name
      );
   }

   ObjectCreate(
      0,
      name,
      OBJ_BUTTON,
      0,
      0,
      0
   );

   ObjectSetInteger(
      0,
      name,
      OBJPROP_XDISTANCE,
      x
   );

   ObjectSetInteger(
      0,
      name,
      OBJPROP_YDISTANCE,
      y
   );

   ObjectSetInteger(
      0,
      name,
      OBJPROP_XSIZE,
      100
   );

   ObjectSetInteger(
      0,
      name,
      OBJPROP_YSIZE,
      30
   );

   ObjectSetString(
      0,
      name,
      OBJPROP_TEXT,
      text
   );

   ObjectSetInteger(
      0,
      name,
      OBJPROP_CORNER,
      CORNER_LEFT_UPPER
   );
}

//==================================================================
// UPDATE STATUS
//==================================================================

void UpdateStatus()
{
   string status =
      "CRT AI BOT\n";

   status +=
      "Trading: ";

   if(tradingEnabled)
      status += "ON\n";
   else
      status += "OFF\n";

   status +=
      "Locked: ";

   if(tradingLocked)
      status += "YES\n";
   else
      status += "NO\n";

   double buyStrength;
   double sellStrength;

   if(GetSignalStrength(
      buyStrength,
      sellStrength
   ))
   {
      status +=
         "M1 BUY: " +
         DoubleToString(
            buyStrength,
            1
         ) +
         "%\n";

      status +=
         "M1 SELL: " +
         DoubleToString(
            sellStrength,
            1
         ) +
         "%\n";
   }

   status +=
      "Positions: " +
      IntegerToString(
         CountPositions()
      ) +
      "\n";

   status +=
      "Basket: $" +
      DoubleToString(
         BasketProfit(),
         2
      );

   Comment(
      status
   );
}

//==================================================================
// INITIALIZATION
//==================================================================

int OnInit()
{
   trade.SetExpertMagicNumber(
      MagicNumber
   );

   trade.SetDeviationInPoints(
      SlippagePoints
   );

   UpdateDay();

   tradingEnabled = false;

   tradingLocked = false;

   reentryPending = false;

   protectionActive = false;

   peakBasketProfit = 0.0;

   basketStartTime = 0;

   closingBasket = false;

   CreateButton(
      "CRT_START",
      "START",
      10,
      20
   );

   CreateButton(
      "CRT_STOP",
      "STOP",
      120,
      20
   );

   UpdateStatus();

   Print(
      "CRT AI BOT: Initialized successfully."
   );

   return INIT_SUCCEEDED;
}

//==================================================================
// DEINITIALIZATION
//==================================================================

void OnDeinit(
   const int reason
)
{
   ObjectDelete(
      0,
      "CRT_START"
   );

   ObjectDelete(
      0,
      "CRT_STOP"
   );

   Comment("");
}

//==================================================================
// MAIN TICK
//==================================================================

void OnTick()
{
   UpdateDay();

   UpdateStatus();

   // Always manage existing positions first.
   // This allows protection to continue even if
   // new trading has been locked.
   if(CountPositions() > 0)
   {
      ManageMaximumBasketLoss();

      if(!closingBasket)
         ManageReversal();

      if(!closingBasket)
         ManageLosingBasketTime();

      if(!closingBasket)
         ManageProfitProtection();
   }

   // No new trades after manual STOP.
   if(!tradingEnabled)
      return;

   // Risk protection prevents NEW trades.
   if(tradingLocked)
      return;

   // Open/re-enter according to CURRENT forming M1 candle.
   if(CountPositions() == 0)
   {
      ManageFlipping();
   }
}

//==================================================================
// CHART BUTTON EVENTS
//==================================================================

void OnChartEvent(
   const int id,
   const long &lparam,
   const double &dparam,
   const string &sparam
)
{
   if(
      id != CHARTEVENT_OBJECT_CLICK
   )
   {
      return;
   }

   //===============================================================
   // START
   //===============================================================

   if(sparam == "CRT_START")
   {
      tradingEnabled = true;

      tradingLocked = false;

      reentryPending = false;

      Print(
         "CRT AI BOT: START pressed."
      );

      Print(
         "CRT AI BOT: Scanning CURRENT forming M1 candle."
      );

      // Immediately scan current candle.
      if(
         CountPositions() == 0
      )
      {
         ManageFlipping();
      }

      return;
   }

   //===============================================================
   // STOP
   //===============================================================

   if(sparam == "CRT_STOP")
   {
      tradingEnabled = false;

      reentryPending = false;

      Print(
         "CRT AI BOT: STOP pressed. ",
         "Closing EA positions."
      );

      if(
         CountPositions() > 0
      )
      {
         CloseAll(
            "MANUAL STOP"
         );
      }

      return;
   }
}

//==================================================================
// TRADE TRANSACTION
//==================================================================

void OnTradeTransaction(
   const MqlTradeTransaction &trans,
   const MqlTradeRequest &request,
   const MqlTradeResult &result
)
{
   // Only process newly added deals.
   if(
      trans.type !=
      TRADE_TRANSACTION_DEAL_ADD
   )
   {
      return;
   }

   if(trans.deal == 0)
      return;

   if(
      !HistoryDealSelect(
         trans.deal
      )
   )
   {
      return;
   }

   // Only process closing deals.
   long entryType =
      HistoryDealGetInteger(
         trans.deal,
         DEAL_ENTRY
      );

   if(
      entryType != DEAL_ENTRY_OUT &&
      entryType != DEAL_ENTRY_OUT_BY
   )
   {
      return;
   }

   string dealSymbol =
      HistoryDealGetString(
         trans.deal,
         DEAL_SYMBOL
      );

   if(
      dealSymbol != Sym()
   )
   {
      return;
   }

   long dealMagic =
      HistoryDealGetInteger(
         trans.deal,
         DEAL_MAGIC
      );

   if(
      dealMagic != MagicNumber
   )
   {
      return;
   }

   double dealProfit =
      HistoryDealGetDouble(
         trans.deal,
         DEAL_PROFIT
      );

   double dealSwap =
      HistoryDealGetDouble(
         trans.deal,
         DEAL_SWAP
      );

   double dealCommission =
      HistoryDealGetDouble(
         trans.deal,
         DEAL_COMMISSION
      );

   double netProfit =
      dealProfit +
      dealSwap +
      dealCommission;

   //===============================================================
   // CONSECUTIVE LOSS TRACKING
   //===============================================================

   if(netProfit < 0.0)
   {
      consecutiveLosses++;

      Print(
         "CRT AI BOT: Losing deal = $",
         DoubleToString(
            netProfit,
            2
         ),
         " | Consecutive losses = ",
         consecutiveLosses
      );

      if(
         MaximumConsecutiveLosses > 0 &&
         consecutiveLosses >=
         MaximumConsecutiveLosses
      )
      {
         tradingLocked = true;

         Print(
            "CRT AI BOT: Maximum consecutive losses reached. ",
            "New trades locked."
         );
      }
   }
   else if(netProfit > 0.0)
   {
      consecutiveLosses = 0;

      Print(
         "CRT AI BOT: Winning deal = $",
         DoubleToString(
            netProfit,
            2
         ),
         " | Consecutive losses reset."
      );
   }

   //===============================================================
   // CONFIRM COMPLETE BASKET CLOSURE
   //===============================================================

   if(
      CountPositions() == 0
   )
   {
      protectionActive = false;

      peakBasketProfit = 0.0;

      basketStartTime = 0;

      if(reentryPending)
      {
         Print(
            "CRT AI BOT: Basket closure confirmed. ",
            "Current forming M1 candle will be rescanned."
         );
      }
   }
}

