//==================================================================
// MAIN TICK
//==================================================================

void OnTick()
{
   UpdateDay();

   UpdateStatus();

   // ---------------------------------------------------------------
   // PROFIT PROTECTION
   // ---------------------------------------------------------------

   ManageProfitProtection();

   ManageFlipping();

   // ---------------------------------------------------------------
   // BOT MUST BE STARTED
   // ---------------------------------------------------------------

   if(!tradingEnabled)
      return;

   // ---------------------------------------------------------------
   // RISK CHECK
   // ---------------------------------------------------------------

   if(!RiskOK())
   {
      UpdateStatus();
      return;
   }

   // ---------------------------------------------------------------
   // IF THERE ARE NO POSITIONS:
   // SCAN THE MARKET FIRST
   // ---------------------------------------------------------------

   if(CountPositions() == 0)
   {
      ScanMarket();

      int direction =
         GetSignalDirection();

      // ------------------------------------------------------------
      // NO HIGH-CONFIDENCE SIGNAL = WAIT
      // ------------------------------------------------------------

      if(direction == 0)
      {
         return;
      }

      // ------------------------------------------------------------
      // HIGH-CONFIDENCE SIGNAL FOUND
      // ------------------------------------------------------------

      OpenCurrentDirection(
         direction
      );

      UpdateStatus();

      return;
   }

   // ---------------------------------------------------------------
   // EXISTING BASKET
   // ---------------------------------------------------------------

   // Do not open opposite positions.
   // Do not close losing positions.
   // Profit protection controls the basket.

   UpdateStatus();
}

//==================================================================
// CHART BUTTON EVENTS
//==================================================================

void OnChartEvent(
   const int id,
   const long &lparam,
   const double &dparam,
   const string &sparam)
{
   if(id != CHARTEVENT_OBJECT_CLICK)
      return;

   // ---------------------------------------------------------------
   // START
   // ---------------------------------------------------------------

   if(sparam == START_BUTTON)
   {
      tradingEnabled = true;
      tradingLocked = false;

      Print(
         "CRT AI BOT: START pressed. Scanning market..."
      );

      // IMPORTANT:
      // START DOES NOT BLINDLY BUY OR SELL.
      // It scans first.

      ScanMarket();

      if(CountPositions() == 0)
      {
         int direction =
            GetSignalDirection();

         if(direction != 0)
         {
            OpenCurrentDirection(
               direction
            );
         }
         else
         {
            Print(
               "CRT AI BOT: No 98% signal. WAIT."
            );
         }
      }

      UpdateStatus();
   }

   // ---------------------------------------------------------------
   // STOP
   // ---------------------------------------------------------------

   if(sparam == STOP_BUTTON)
   {
      tradingEnabled = false;

      Print(
         "CRT AI BOT: STOP pressed."
      );

      // STOP does NOT force-close
      // existing positions.

      UpdateStatus();
   }
}

//==================================================================
// TRADE TRANSACTION
//==================================================================

void OnTradeTransaction(
   const MqlTradeTransaction &trans,
   const MqlTradeRequest &request,
   const MqlTradeResult &result)
{
   if(trans.type !=
      TRADE_TRANSACTION_DEAL_ADD)
   {
      return;
   }

   ulong deal =
      trans.deal;

   if(deal == 0)
      return;

   if(!HistoryDealSelect(
         deal))
   {
      return;
   }

   string symbol =
      HistoryDealGetString(
         deal,
         DEAL_SYMBOL
      );

   long magic =
      HistoryDealGetInteger(
         deal,
         DEAL_MAGIC
      );

   if(symbol != Sym())
      return;

   if((ulong)magic != MagicNumber)
      return;

   long entry =
      HistoryDealGetInteger(
         deal,
         DEAL_ENTRY
      );

   // Only process closing deals
   if(entry != DEAL_ENTRY_OUT &&
      entry != DEAL_ENTRY_OUT_BY)
   {
      return;
   }

   double profit =
      HistoryDealGetDouble(
         deal,
         DEAL_PROFIT
      );

   double swap =
      HistoryDealGetDouble(
         deal,
         DEAL_SWAP
      );

   double commission =
      HistoryDealGetDouble(
         deal,
         DEAL_COMMISSION
      );

   double netResult =
      profit +
      swap +
      commission;

   if(netResult > 0.0)
   {
      consecutiveLosses = 0;

      Print(
         "CRT AI BOT: Profitable trade closed. ",
         "Net=",
         netResult
      );
   }
   else
   if(netResult < 0.0)
   {
      consecutiveLosses++;

      Print(
         "CRT AI BOT: Losing trade closed. ",
         "Net=",
         netResult,
         " Consecutive losses=",
         consecutiveLosses
      );
   }

   protectionActive = false;
   peakBasketProfit = 0.0;

   UpdateStatus();
}
