//==================================================================
// SYMBOL
//==================================================================

string Sym()
{
   if(TradingSymbol == "")
      return _Symbol;

   return TradingSymbol;
}

//==================================================================
// PIP SIZE
//==================================================================

double PipSize(string symbol)
{
   double point = SymbolInfoDouble(symbol,SYMBOL_POINT);
   int digits = (int)SymbolInfoInteger(symbol,SYMBOL_DIGITS);

   if(digits == 3 || digits == 5)
      return point * 10.0;

   return point;
}

//==================================================================
// NORMALIZE VOLUME
//==================================================================

double NormalizeVolume(string symbol,double volume)
{
   double minLot =
      SymbolInfoDouble(symbol,SYMBOL_VOLUME_MIN);

   double maxLot =
      SymbolInfoDouble(symbol,SYMBOL_VOLUME_MAX);

   double step =
      SymbolInfoDouble(symbol,SYMBOL_VOLUME_STEP);

   if(step <= 0.0)
      step = minLot;

   if(volume < minLot)
      volume = minLot;

   if(volume > maxLot)
      volume = maxLot;

   volume =
      MathFloor(volume / step) * step;

   if(volume < minLot)
      volume = minLot;

   return NormalizeDouble(volume,2);
}

//==================================================================
// DYNAMIC LOT
//==================================================================

double CalculateDynamicLot()
{
   double balance =
      AccountInfoDouble(ACCOUNT_BALANCE);

   double rawLot =
      balance * LotMultiplier;

   return NormalizeVolume(
      Sym(),
      rawLot
   );
}

//==================================================================
// COUNT EA POSITIONS
//==================================================================

int CountPositions()
{
   int count = 0;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol =
         PositionGetString(POSITION_SYMBOL);

      long magic =
         PositionGetInteger(POSITION_MAGIC);

      if(symbol != Sym())
         continue;

      if((ulong)magic != MagicNumber)
         continue;

      count++;
   }

   return count;
}

//==================================================================
// TOTAL EA LOTS
//==================================================================

double TotalLots()
{
   double lots = 0.0;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol =
         PositionGetString(POSITION_SYMBOL);

      long magic =
         PositionGetInteger(POSITION_MAGIC);

      if(symbol != Sym())
         continue;

      if((ulong)magic != MagicNumber)
         continue;

      lots +=
         PositionGetDouble(POSITION_VOLUME);
   }

   return lots;
}

//==================================================================
// BASKET PROFIT
//==================================================================

double BasketProfit()
{
   double profit = 0.0;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol =
         PositionGetString(POSITION_SYMBOL);

      long magic =
         PositionGetInteger(POSITION_MAGIC);

      if(symbol != Sym())
         continue;

      if((ulong)magic != MagicNumber)
         continue;

      profit +=
         PositionGetDouble(POSITION_PROFIT);

      profit +=
         PositionGetDouble(POSITION_SWAP);
   }

   return profit;
}

//==================================================================
// CLOSE ALL EA POSITIONS
//==================================================================

bool CloseAll(string reason)
{
   bool allClosed = true;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol =
         PositionGetString(POSITION_SYMBOL);

      long magic =
         PositionGetInteger(POSITION_MAGIC);

      if(symbol != Sym())
         continue;

      if((ulong)magic != MagicNumber)
         continue;

      if(!trade.PositionClose(
            ticket,
            SlippagePoints))
      {
         allClosed = false;
      }
   }

   if(allClosed)
   {
      protectionActive = false;
      peakPrice = 0.0;
   }

   return allClosed;
}

//==================================================================
// UPDATE DAY
//==================================================================

void UpdateDay()
{
   MqlDateTime tm;

   TimeToStruct(
      TimeCurrent(),
      tm
   );

   int currentDay =
      tm.day_of_year;

   if(savedDay != currentDay)
   {
      savedDay = currentDay;

      dayStartEquity =
         AccountInfoDouble(
            ACCOUNT_EQUITY
         );

      consecutiveLosses = 0;

      tradingLocked = false;

      protectionActive = false;

      peakPrice = 0.0;
   }
}

//==================================================================
// RISK CHECK
//==================================================================

bool RiskOK()
{
   double equity =
      AccountInfoDouble(
         ACCOUNT_EQUITY
      );

   double balance =
      AccountInfoDouble(
         ACCOUNT_BALANCE
      );

   if(balance <= 0.0)
      return false;

   if(dayStartEquity <= 0.0)
      dayStartEquity = equity;

   double dailyLoss =
      dayStartEquity - equity;

   double dailyLossPercent =
      (dailyLoss / dayStartEquity) * 100.0;

   if(dailyLossPercent >=
      DailyLossLimitPercent)
   {
      tradingLocked = true;
      return false;
   }

   double drawdown =
      balance - equity;

   double drawdownPercent =
      (drawdown / balance) * 100.0;

   if(drawdownPercent >=
      MaximumDrawdownPercent)
   {
      tradingLocked = true;
      return false;
   }

   if(consecutiveLosses >=
      MaximumConsecutiveLosses)
   {
      tradingLocked = true;
      return false;
   }

   return true;
}

//==================================================================
// CURRENT FORMING M1 CANDLE DIRECTION
//==================================================================

int CurrentCandleDirection()
{
   MqlRates rates[1];

   if(CopyRates(
         Sym(),
         PERIOD_M1,
         0,
         1,
         rates) != 1)
   {
      return 0;
   }

   double open =
      rates[0].open;

   double current =
      rates[0].close;

   if(current > open)
      return 1;

   if(current < open)
      return -1;

   return 0;
}

//==================================================================
// AUTOMATIC POSITION LIMIT
//==================================================================

int CalculateAutomaticPositionLimit(
   bool buy,
   double volume)
{
   double balance =
      AccountInfoDouble(
         ACCOUNT_BALANCE
      );

   double maximumMargin =
      balance *
      MaximumBalanceMarginPercent /
      100.0;

   if(maximumMargin <= 0.0)
      return 0;

   double price;

   if(buy)
   {
      price =
         SymbolInfoDouble(
            Sym(),
            SYMBOL_ASK
         );
   }
   else
   {
      price =
         SymbolInfoDouble(
            Sym(),
            SYMBOL_BID
         );
   }

   double oneLotMargin = 0.0;

   if(!OrderCalcMargin(
         buy ? ORDER_TYPE_BUY : ORDER_TYPE_SELL,
         Sym(),
         volume,
         price,
         oneLotMargin))
   {
      return 1;
   }

   if(oneLotMargin <= 0.0)
      return 1;

   double existingMargin = 0.0;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol =
         PositionGetString(POSITION_SYMBOL);

      long magic =
         PositionGetInteger(POSITION_MAGIC);

      if(symbol != Sym())
         continue;

      if((ulong)magic != MagicNumber)
         continue;

      double posVolume =
         PositionGetDouble(
            POSITION_VOLUME
         );

      ENUM_POSITION_TYPE type =
         (ENUM_POSITION_TYPE)
         PositionGetInteger(
            POSITION_TYPE
         );

      ENUM_ORDER_TYPE orderType;

      if(type == POSITION_TYPE_BUY)
         orderType = ORDER_TYPE_BUY;
      else
         orderType = ORDER_TYPE_SELL;

      double posPrice =
         PositionGetDouble(
            POSITION_PRICE_OPEN
         );

      double posMargin = 0.0;

      if(OrderCalcMargin(
            orderType,
            Sym(),
            posVolume,
            posPrice,
            posMargin))
      {
         existingMargin += posMargin;
      }
   }

   double remainingMargin =
      maximumMargin -
      existingMargin;

   if(remainingMargin < oneLotMargin)
      return 0;

   int possible =
      (int)MathFloor(
         remainingMargin /
         oneLotMargin
      );

   if(possible < 0)
      possible = 0;

   if(MaximumOpenPositions > 0)
   {
      int remainingPositions =
         MaximumOpenPositions -
         CountPositions();

      if(remainingPositions < possible)
         possible = remainingPositions;
   }

   if(OrdersPerSignal > 0 &&
      OrdersPerSignal < possible)
   {
      possible = OrdersPerSignal;
   }

   return possible;
}

//==================================================================
// OPEN ONE TRADE
//==================================================================

bool OpenOne(
   bool buy,
   double volume)
{
   if(volume <= 0.0)
      return false;

   trade.SetExpertMagicNumber(
      MagicNumber
   );

   trade.SetDeviationInPoints(
      SlippagePoints
   );

   string comment =
      "CRT AI BOT";

   bool result;

   if(buy)
   {
      result =
         trade.Buy(
            volume,
            Sym(),
            0.0,
            0.0,
            0.0,
            comment
         );
   }
   else
   {
      result =
         trade.Sell(
            volume,
            Sym(),
            0.0,
            0.0,
            0.0,
            comment
         );
   }

   return result;
}//==================================================================
// OPEN CURRENT CANDLE DIRECTION
//==================================================================

void OpenCurrentDirection(int direction)
{
   if(!tradingEnabled)
      return;

   if(tradingLocked)
      return;

   if(direction == 0)
      return;

   if(CountPositions() > 0)
      return;

   double volume =
      CalculateDynamicLot();

   if(volume <= 0.0)
      return;

   // Never allow total EA exposure above the configured maximum.
   if(volume > MaximumEAExposureLots)
      volume = MaximumEAExposureLots;

   volume =
      NormalizeVolume(
         Sym(),
         volume
      );

   bool buy =
      (direction > 0);

   int numberToOpen =
      CalculateAutomaticPositionLimit(
         buy,
         volume
      );

   if(numberToOpen <= 0)
      return;

   if(MaximumEAExposureLots > 0.0)
   {
      double maxAdditional =
         MaximumEAExposureLots -
         TotalLots();

      int maxByExposure =
         (int)MathFloor(
            maxAdditional / volume
         );

      if(maxByExposure < numberToOpen)
         numberToOpen =
            maxByExposure;
   }

   if(numberToOpen <= 0)
      return;

   for(int i = 0; i < numberToOpen; i++)
   {
      if(!tradingEnabled)
         break;

      if(tradingLocked)
         break;

      if(TotalLots() + volume >
         MaximumEAExposureLots + 0.0000001)
      {
         break;
      }

      if(!OpenOne(buy,volume))
      {
         Print(
            "CRT AI BOT: Trade open failed. Error = ",
            GetLastError()
         );

         break;
      }
   }

   // Reset profit-protection tracking for the new basket.
   protectionActive = false;
   peakPrice = 0.0;
}

//==================================================================
// PROFIT PROTECTION
//
// IMPORTANT:
// 1. Losing baskets are NEVER closed here.
// 2. Protection starts only after basket profit reaches the minimum.
// 3. Once active, the favorable price peak is tracked.
// 4. Basket closes only after a 2-pip retracement from that peak.
//==================================================================

void ManageProfitProtection()
{
   if(!tradingEnabled)
      return;

   if(tradingLocked)
      return;

   int positions =
      CountPositions();

   if(positions <= 0)
   {
      protectionActive = false;
      peakPrice = 0.0;
      return;
   }

   double profit =
      BasketProfit();

   //==============================================================
   // ABSOLUTE RULE:
   // NEVER CLOSE A LOSING BASKET.
   //==============================================================

   if(profit < MinimumProfitToProtect)
   {
      protectionActive = false;
      peakPrice = 0.0;
      return;
   }

   string symbol =
      Sym();

   double pip =
      PipSize(symbol);

   if(pip <= 0.0)
      return;

   //==============================================================
   // Determine whether the basket is BUY or SELL.
   // The EA opens one direction per basket.
   //==============================================================

   bool haveBuy = false;
   bool haveSell = false;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string posSymbol =
         PositionGetString(
            POSITION_SYMBOL
         );

      long magic =
         PositionGetInteger(
            POSITION_MAGIC
         );

      if(posSymbol != symbol)
         continue;

      if((ulong)magic != MagicNumber)
         continue;

      ENUM_POSITION_TYPE type =
         (ENUM_POSITION_TYPE)
         PositionGetInteger(
            POSITION_TYPE
         );

      if(type == POSITION_TYPE_BUY)
         haveBuy = true;

      if(type == POSITION_TYPE_SELL)
         haveSell = true;
   }

   //==============================================================
   // Activate protection only after minimum profit is reached.
   //==============================================================

   if(!protectionActive)
   {
      protectionActive = true;

      if(haveBuy && !haveSell)
      {
         peakPrice =
            SymbolInfoDouble(
               symbol,
               SYMBOL_BID
            );
      }
      else if(haveSell && !haveBuy)
      {
         peakPrice =
            SymbolInfoDouble(
               symbol,
               SYMBOL_ASK
            );
      }
      else
      {
         protectionActive = false;
         peakPrice = 0.0;
         return;
      }

      return;
   }

   //==============================================================
   // BUY BASKET
   // Track the highest BID reached.
   //==============================================================

   if(haveBuy && !haveSell)
   {
      double bid =
         SymbolInfoDouble(
            symbol,
            SYMBOL_BID
         );

      if(bid > peakPrice)
      {
         peakPrice = bid;
         return;
      }

      double retracement =
         peakPrice - bid;

      // Close ONLY after price retraces the configured amount
      // from the favorable peak.
      if(retracement >=
         ProfitRetracementPips * pip)
      {
         // Final safety check:
         // Do not close unless basket is still profitable.
         if(BasketProfit() >=
            MinimumProfitToProtect)
         {
            CloseAll(
               "BUY profit retracement"
            );
         }
      }

      return;
   }

   //==============================================================
   // SELL BASKET
   // Track the lowest ASK reached.
   //==============================================================

   if(haveSell && !haveBuy)
   {
      double ask =
         SymbolInfoDouble(
            symbol,
            SYMBOL_ASK
         );

      if(peakPrice == 0.0 ||
         ask < peakPrice)
      {
         peakPrice = ask;
         return;
      }

      double retracement =
         ask - peakPrice;

      // Close ONLY after price retraces the configured amount
      // from the favorable peak.
      if(retracement >=
         ProfitRetracementPips * pip)
      {
         // Final safety check:
         // Do not close unless basket is still profitable.
         if(BasketProfit() >=
            MinimumProfitToProtect)
         {
            CloseAll(
               "SELL profit retracement"
            );
         }
      }

      return;
   }
}

//==================================================================
// MANAGE CURRENT BASKET
//
// There is NO candle-reversal closing here.
// The basket stays open until profit protection closes it.
//==================================================================

void ManageFlipping()
{
   if(!tradingEnabled)
      return;

   if(tradingLocked)
      return;

   if(CountPositions() == 0)
   {
      protectionActive = false;
      peakPrice = 0.0;

      int direction =
         CurrentCandleDirection();

      if(direction != 0)
      {
         OpenCurrentDirection(
            direction
         );
      }

      return;
   }

   ManageProfitProtection();
}

