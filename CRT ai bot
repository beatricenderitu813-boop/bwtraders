//==================================================================
// CLOSE ALL EA POSITIONS
//==================================================================

bool CloseAll(
   string reason
)
{
   if(closingBasket)
      return false;

   closingBasket = true;

   bool result = true;

   Print(
      "CRT AI BOT: Closing basket. Reason: ",
      reason
   );

   for(
      int i = PositionsTotal() - 1;
      i >= 0;
      i--
   )
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol =
         PositionGetString(
            POSITION_SYMBOL
         );

      long magic =
         PositionGetInteger(
            POSITION_MAGIC
         );

      if(symbol != Sym())
         continue;

      if(magic != MagicNumber)
         continue;

      if(
         !trade.PositionClose(
            ticket
         )
      )
      {
         result = false;

         Print(
            "CRT AI BOT: Failed to close ticket ",
            ticket,
            " | ",
            trade.ResultRetcodeDescription()
         );
      }
   }

   closingBasket = false;

   return result;
}

