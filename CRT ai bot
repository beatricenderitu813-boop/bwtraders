//==================================================================
// BASKET DIRECTION
//
// Returns:
//  1 = BUY basket
// -1 = SELL basket
//  0 = no basket / mixed
//==================================================================

int BasketDirection()
{
   int direction = 0;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol =
         PositionGetString(
            POSITION_SYMBOL
         );

      long magic =
         PositionGetInteger(
            POSITION_MAGIC
         );

      if(symbol != Sym())
         continue;

      if(magic != MagicNumber)
         continue;

      ENUM_POSITION_TYPE type =
         (ENUM_POSITION_TYPE)
         PositionGetInteger(
            POSITION_TYPE
         );

      if(type == POSITION_TYPE_BUY)
      {
         if(direction == 0)
            direction = 1;
         else if(direction != 1)
            return 0;
      }
      else if(type == POSITION_TYPE_SELL)
      {
         if(direction == 0)
            direction = -1;
         else if(direction != -1)
            return 0;
      }
   }

   return direction;
}

//==================================================================
// GET CURRENT M1 CANDLE DATA
//==================================================================

bool GetCurrentM1Candle(
   double &openPrice,
   double &highPrice,
   double &lowPrice,
   double &currentPrice
)
{
   MqlRates rates[];

   ArraySetAsSeries(
      rates,
      true
   );

   int copied =
      CopyRates(
         Sym(),
         PERIOD_M1,
         0,
         1,
         rates
      );

   if(copied < 1)
      return false;

   openPrice =
      rates[0].open;

   highPrice =
      rates[0].high;

   lowPrice =
      rates[0].low;

   currentPrice =
      SymbolInfoDouble(
         Sym(),
         SYMBOL_BID
      );

   return true;
}

//==================================================================
// CALCULATE CURRENT M1 SIGNAL STRENGTH
//
// buyStrength  = 0 to 100
// sellStrength = 0 to 100
//==================================================================

bool GetSignalStrength(
   double &buyStrength,
   double &sellStrength
)
{
   buyStrength  = 0.0;
   sellStrength = 0.0;

   double openPrice;
   double highPrice;
   double lowPrice;
   double currentPrice;

   if(!GetCurrentM1Candle(
      openPrice,
      highPrice,
      lowPrice,
      currentPrice
   ))
   {
      return false;
   }

   double range =
      highPrice - lowPrice;

   if(range <= 0.0)
      return true;

   double position =
      (currentPrice - lowPrice) /
      range;

   if(position < 0.0)
      position = 0.0;

   if(position > 1.0)
      position = 1.0;

   // Current candle is bullish
   if(currentPrice > openPrice)
   {
      buyStrength =
         55.0 +
         (position * 45.0);

      sellStrength =
         0.0;
   }

   // Current candle is bearish
   else if(currentPrice < openPrice)
   {
      sellStrength =
         55.0 +
         ((1.0 - position) * 45.0);

      buyStrength =
         0.0;
   }

   // Candle currently exactly at open
   else
   {
      buyStrength  = 0.0;
      sellStrength = 0.0;
   }

   if(buyStrength > 100.0)
      buyStrength = 100.0;

   if(sellStrength > 100.0)
      sellStrength = 100.0;

   return true;
}

//==================================================================
// SPREAD CHECK
//==================================================================

bool SpreadOK()
{
   double ask =
      SymbolInfoDouble(
         Sym(),
         SYMBOL_ASK
      );

   double bid =
      SymbolInfoDouble(
         Sym(),
         SYMBOL_BID
      );

   double pip =
      PipSize(
         Sym()
      );

   if(pip <= 0.0)
      return false;

   double spreadPips =
      (ask - bid) / pip;

   if(spreadPips >
      MaximumSpreadPips)
   {
      return false;
   }

   return true;
}

//==================================================================
// CURRENT SIGNAL
//
// Returns:
//  1 = BUY
// -1 = SELL
//  0 = no valid signal
//==================================================================

int CurrentSignal(
   double minimumStrength
)
{
   double buyStrength;
   double sellStrength;

   if(!GetSignalStrength(
      buyStrength,
      sellStrength
   ))
   {
      return 0;
   }

   if(
      buyStrength >= minimumStrength &&
      buyStrength > sellStrength
   )
   {
      return 1;
   }

   if(
      sellStrength >= minimumStrength &&
      sellStrength > buyStrength
   )
   {
      return -1;
   }

   return 0;
}

//==================================================================
// CHECK WHETHER A NEW TRADE IS ALLOWED
//==================================================================

bool CanOpenNewTrades()
{
   if(!tradingEnabled)
      return false;

   if(tradingLocked)
      return false;

   if(!SpreadOK())
      return false;

   return true;
}

