//==================================================================
// ACCOUNT MARGIN ALLOWANCE
//==================================================================

double MaximumAllowedMargin()
{
   double balance =
      AccountInfoDouble(
         ACCOUNT_BALANCE
      );

   return
      balance *
      MaximumBalanceMarginPercent /
      100.0;
}

//==================================================================
// MARGIN REQUIRED FOR ONE POSITION
//==================================================================

double MarginRequiredForOneLot()
{
   double price =
      SymbolInfoDouble(
         Sym(),
         SYMBOL_ASK
      );

   if(price <= 0.0)
      return 0.0;

   double margin = 0.0;

   if(
      OrderCalcMargin(
         ORDER_TYPE_BUY,
         Sym(),
         1.0,
         price,
         margin
      )
   )
   {
      return margin;
   }

   return 0.0;
}

//==================================================================
// CALCULATE AUTOMATIC POSITION LIMIT
//==================================================================

int CalculateAutomaticPositionLimit(
   double volume
)
{
   if(volume <= 0.0)
      return 0;

   //---------------------------------------------------------------
   // EXPLICIT POSITION LIMIT
   //---------------------------------------------------------------

   if(MaximumOpenPositions > 0)
   {
      return MaximumOpenPositions;
   }

   //---------------------------------------------------------------
   // EXPLICIT ORDERS PER SIGNAL
   //---------------------------------------------------------------

   if(OrdersPerSignal > 0)
   {
      return OrdersPerSignal;
   }

   //---------------------------------------------------------------
   // CALCULATE BY 50% ACCOUNT MARGIN
   //---------------------------------------------------------------

   double allowedMargin =
      MaximumAllowedMargin();

   double marginPerPosition = 0.0;

   if(
      !OrderCalcMargin(
         ORDER_TYPE_BUY,
         Sym(),
         volume,
         SymbolInfoDouble(
            Sym(),
            SYMBOL_ASK
         ),
         marginPerPosition
      )
   )
   {
      marginPerPosition =
         MarginRequiredForOneLot() *
         volume;
   }

   if(marginPerPosition <= 0.0)
      return 1;

   double freeMargin =
      AccountInfoDouble(
         ACCOUNT_MARGIN_FREE
      );

   double usableMargin =
      MathMin(
         allowedMargin,
         freeMargin
      );

   int possible =
      (int)MathFloor(
         usableMargin /
         marginPerPosition
      );

   if(possible < 1)
      possible = 1;

   //---------------------------------------------------------------
   // MAXIMUM EA EXPOSURE
   //---------------------------------------------------------------

   if(MaximumEAExposureLots > 0.0)
   {
      double currentLots =
         TotalEALots();

      double remainingLots =
         MaximumEAExposureLots -
         currentLots;

      int exposurePositions =
         (int)MathFloor(
            remainingLots /
            volume
         );

      if(
         exposurePositions <
         possible
      )
      {
         possible =
            exposurePositions;
      }
   }

   if(possible < 1)
      return 0;

   return possible;
}

//==================================================================
// DYNAMIC LOT
//==================================================================

double CalculateDynamicLot()
{
   double balance =
      AccountInfoDouble(
         ACCOUNT_BALANCE
      );

   double lot =
      balance *
      LotMultiplier;

   return NormalizeVolume(
      Sym(),
      lot
   );
}
//==================================================================
// OPEN ONE TRADE
//==================================================================

bool OpenOne(
   bool buy,
   double volume
)
{
   if(volume <= 0.0)
      return false;

   double point =
      SymbolInfoDouble(
         Sym(),
         SYMBOL_POINT
      );

   double pip =
      PipSize(
         Sym()
      );

   double price = 0.0;

   if(buy)
   {
      price =
         SymbolInfoDouble(
            Sym(),
            SYMBOL_ASK
         );
   }
   else
   {
      price =
         SymbolInfoDouble(
            Sym(),
            SYMBOL_BID
         );
   }

   if(price <= 0.0)
      return false;

   double sl = 0.0;

   double tp = 0.0;

   //---------------------------------------------------------------
   // STOP LOSS
   //---------------------------------------------------------------

   if(StopLossPips > 0.0)
   {
      if(buy)
         sl = price - StopLossPips * pip;
      else
         sl = price + StopLossPips * pip;
   }

   //---------------------------------------------------------------
   // TAKE PROFIT
   //---------------------------------------------------------------

   if(TakeProfitPips > 0.0)
   {
      if(buy)
         tp = price + TakeProfitPips * pip;
      else
         tp = price - TakeProfitPips * pip;
   }

   //---------------------------------------------------------------
   // NORMALIZE
   //---------------------------------------------------------------

   volume =
      NormalizeVolume(
         Sym(),
         volume
      );

   //---------------------------------------------------------------
   // BUY
   //---------------------------------------------------------------

   if(buy)
   {
      if(
         trade.Buy(
            volume,
            Sym(),
            0.0,
            sl,
            tp,
            "CRT AI BOT BUY"
         )
      )
      {
         return true;
      }
   }

   //---------------------------------------------------------------
   // SELL
   //---------------------------------------------------------------

   else
   {
      if(
         trade.Sell(
            volume,
            Sym(),
            0.0,
            sl,
            tp,
            "CRT AI BOT SELL"
         )
      )
      {
         return true;
      }
   }

   Print(
      "CRT AI BOT: Order failed. Retcode=",
      trade.ResultRetcode(),
      " ",
      trade.ResultRetcodeDescription()
   );

   return false;
}

//==================================================================
// OPEN CURRENT DIRECTION
//
// Opens multiple trades according to the 50% account-margin limit.
//==================================================================

void OpenCurrentDirection(
   int direction
)
{
   if(direction == 0)
      return;

   if(!tradingEnabled)
      return;

   if(tradingLocked)
      return;

   //---------------------------------------------------------------
   // CALCULATE LOT
   //---------------------------------------------------------------

   double volume =
      CalculateDynamicLot();

   if(volume <= 0.0)
   {
      Print(
         "CRT AI BOT: Invalid calculated lot."
      );

      return;
   }

   //---------------------------------------------------------------
   // CALCULATE HOW MANY TRADES ACCOUNT CAN HOLD
   //---------------------------------------------------------------

   int positionsAllowed =
      CalculateAutomaticPositionLimit(
         volume
      );

   if(positionsAllowed <= 0)
   {
      Print(
         "CRT AI BOT: No margin available for new positions."
      );

      return;
   }

   //---------------------------------------------------------------
   // IF USER SET AN EXPLICIT ORDERS PER SIGNAL
   //---------------------------------------------------------------

   if(OrdersPerSignal > 0)
   {
      positionsAllowed =
         OrdersPerSignal;
   }

   //---------------------------------------------------------------
   // IF USER SET MAXIMUM OPEN POSITIONS
   //---------------------------------------------------------------

   if(
      MaximumOpenPositions > 0 &&
      positionsAllowed >
      MaximumOpenPositions
   )
   {
      positionsAllowed =
         MaximumOpenPositions;
   }

   //---------------------------------------------------------------
   // MAXIMUM EA EXPOSURE
   //---------------------------------------------------------------

   if(
      MaximumEAExposureLots > 0.0
   )
   {
      double remaining =
         MaximumEAExposureLots -
         TotalEALots();

      int exposureLimit =
         (int)MathFloor(
            remaining /
            volume
         );

      if(
         exposureLimit <
         positionsAllowed
      )
      {
         positionsAllowed =
            exposureLimit;
      }
   }

   if(positionsAllowed <= 0)
      return;

   //---------------------------------------------------------------
   // OPEN TRADES
   //---------------------------------------------------------------

   bool buy =
      direction > 0;

   int opened = 0;

   for(
      int i = 0;
      i < positionsAllowed;
      i++
   )
   {
      if(
         MaximumEAExposureLots > 0.0 &&
         TotalEALots() + volume >
         MaximumEAExposureLots + 0.0000001
      )
      {
         break;
      }

      if(
         OpenOne(
            buy,
            volume
         )
      )
      {
         opened++;

         Print(
            "CRT AI BOT: ",
            buy ? "BUY" : "SELL",
            " opened. ",
            "Trade ",
            opened,
            "/",
            positionsAllowed,
            " | Lot=",
            DoubleToString(
               volume,
               3
            )
         );
      }
      else
      {
         break;
      }
   }

   if(opened > 0)
   {
      reentryPending = false;

      Print(
         "CRT AI BOT: ",
         opened,
         " position(s) opened."
      );
   }
}

//==================================================================
// BUY STRENGTH
//
// CURRENT FORMING M1 CANDLE
//==================================================================

double CalculateBuyStrength()
{
   MqlRates rates[];

   ArraySetAsSeries(
      rates,
      true
   );

   int copied =
      CopyRates(
         Sym(),
         PERIOD_M1,
         0,
         1,
         rates
      );

   if(copied < 1)
      return 0.0;

   double open =
      rates[0].open;

   double bid =
      SymbolInfoDouble(
         Sym(),
         SYMBOL_BID
      );

   double high =
      rates[0].high;

   double low =
      rates[0].low;

   double range =
      high - low;

   if(range <= 0.0)
      range =
         SymbolInfoDouble(
            Sym(),
            SYMBOL_POINT
         );

   //---------------------------------------------------------------
   // CURRENT PRICE POSITION INSIDE CURRENT CANDLE
   //---------------------------------------------------------------

   double position =
      (bid - low) /
      range;

   if(position < 0.0)
      position = 0.0;

   if(position > 1.0)
      position = 1.0;

   //---------------------------------------------------------------
   // BUY DIRECTION
   //---------------------------------------------------------------

   double strength = 0.0;

   if(bid > open)
   {
      strength += 55.0;

      strength +=
         position *
         45.0;
   }
   else
   if(bid == open)
   {
      strength = 0.0;
   }

   if(strength > 100.0)
      strength = 100.0;

   return strength;
}

//==================================================================
// SELL STRENGTH
//
// CURRENT FORMING M1 CANDLE
//==================================================================

double CalculateSellStrength()
{
   MqlRates rates[];

   ArraySetAsSeries(
      rates,
      true
   );

   int copied =
      CopyRates(
         Sym(),
         PERIOD_M1,
         0,
         1,
         rates
      );

   if(copied < 1)
      return 0.0;

   double open =
      rates[0].open;

   double bid =
      SymbolInfoDouble(
         Sym(),
         SYMBOL_BID
      );

   double high =
      rates[0].high;

   double low =
      rates[0].low;

   double range =
      high - low;

   if(range <= 0.0)
      range =
         SymbolInfoDouble(
            Sym(),
            SYMBOL_POINT
         );

   //---------------------------------------------------------------
   // CURRENT PRICE POSITION
   //---------------------------------------------------------------

   double position =
      (bid - low) /
      range;

   if(position < 0.0)
      position = 0.0;

   if(position > 1.0)
      position = 1.0;

   //---------------------------------------------------------------
   // SELL DIRECTION
   //---------------------------------------------------------------

   double strength = 0.0;

   if(bid < open)
   {
      strength += 55.0;

      strength +=
         (1.0 - position) *
         45.0;
   }
   else
   if(bid == open)
   {
      strength = 0.0;
   }

   if(strength > 100.0)
      strength = 100.0;

   return strength;
}

//==================================================================
// SCAN CURRENT FORMING M1 CANDLE
//==================================================================

void ScanCurrentCandle()
{
   buyStrength =
      CalculateBuyStrength();

   sellStrength =
      CalculateSellStrength();

   //---------------------------------------------------------------
   // BUY ≥ 55%
   //---------------------------------------------------------------

   if(
      buyStrength >=
      MinimumSignalStrength &&
      buyStrength >
      sellStrength
   )
   {
      signalText =
         "BUY SIGNAL";
   }

   //---------------------------------------------------------------
   // SELL ≥ 55%
   //---------------------------------------------------------------

   else
   if(
      sellStrength >=
      MinimumSignalStrength &&
      sellStrength >
      buyStrength
   )
   {
      signalText =
         "SELL SIGNAL";
   }

   //---------------------------------------------------------------
   // BOTH QUALIFY
   //---------------------------------------------------------------

   else
   if(
      buyStrength >=
      MinimumSignalStrength &&
      sellStrength >=
      MinimumSignalStrength
   )
   {
      if(buyStrength >= sellStrength)
         signalText = "BUY SIGNAL";
      else
         signalText = "SELL SIGNAL";
   }

   //---------------------------------------------------------------
   // NO SIGNAL
   //---------------------------------------------------------------

   else
   {
      signalText =
         "WAIT";
   }
}

//==================================================================
// GET SIGNAL DIRECTION
//==================================================================

int GetSignalDirection()
{
   if(
      buyStrength >=
      MinimumSignalStrength &&
      buyStrength >=
      sellStrength
   )
   {
      return 1;
   }

   if(
      sellStrength >=
      MinimumSignalStrength &&
      sellStrength >
      buyStrength
   )
   {
      return -1;
   }

   return 0;
}

//==================================================================
// CLOSE ALL EA POSITIONS
//==================================================================

bool CloseAll(
   string reason
)
{
   if(closingBasket)
      return false;

   closingBasket = true;

   bool result = true;

   Print(
      "CRT AI BOT: Closing basket. Reason: ",
      reason
   );

   for(
      int i = PositionsTotal() - 1;
      i >= 0;
      i--
   )
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol =
         PositionGetString(
            POSITION_SYMBOL
         );

      long magic =
         PositionGetInteger(
            POSITION_MAGIC
         );

      if(symbol != Sym())
         continue;

      if((ulong)magic != MagicNumber)
         continue;

      if(
         !trade.PositionClose(
            ticket
         )
      )
      {
         result = false;

         Print(
            "CRT AI BOT: Failed to close ticket ",
            ticket,
            " | ",
            trade.ResultRetcodeDescription()
         );
      }
   }

   closingBasket = false;

   return result;
}

//==================================================================
// UPDATE DAY
//==================================================================

void UpdateDay()
{
   MqlDateTime nowStruct;

   TimeToStruct(
      TimeCurrent(),
      nowStruct
   );

   nowStruct.hour = 0;
   nowStruct.min = 0;
   nowStruct.sec = 0;

   datetime today =
      StructToTime(
         nowStruct
      );

   if(
      savedDay !=
      today
   )
   {
      savedDay =
         today;

      dayStartEquity =
         AccountInfoDouble(
            ACCOUNT_EQUITY
         );

      consecutiveLosses = 0;

      tradingLocked = false;

      peakBasketProfit = 0.0;

      protectionActive = false;

      reentryPending = false;

      Print(
         "CRT AI BOT: New trading day."
      );

      Print(
         "Starting equity: $",
         DoubleToString(
            dayStartEquity,
            2
         )
      );
   }
}
//==================================================================
// RISK CHECK
//
// Risk protection stops NEW trading.
// It does NOT deliberately close a losing basket.
//==================================================================

bool RiskOK()
{
   if(tradingLocked)
      return false;

   double equity =
      AccountInfoDouble(
         ACCOUNT_EQUITY
      );

   double balance =
      AccountInfoDouble(
         ACCOUNT_BALANCE
      );

   //---------------------------------------------------------------
   // DAILY LOSS
   //---------------------------------------------------------------

   if(
      DailyLossLimitPercent > 0.0 &&
      dayStartEquity > 0.0
   )
   {
      double loss =
         dayStartEquity -
         equity;

      double lossPercent =
         (
            loss /
            dayStartEquity
         ) *
         100.0;

      if(
         lossPercent >=
         DailyLossLimitPercent
      )
      {
         tradingLocked = true;

         Print(
            "CRT AI BOT: DAILY LOSS LIMIT REACHED."
         );

         Print(
            "CRT AI BOT: NEW TRADING LOCKED."
         );

         Print(
            "CRT AI BOT: Existing basket NOT automatically closed."
         );

         return false;
      }
   }

   //---------------------------------------------------------------
   // MAXIMUM DRAWDOWN
   //---------------------------------------------------------------

   if(
      MaximumDrawdownPercent > 0.0 &&
      balance > 0.0
   )
   {
      double drawdown =
         balance -
         equity;

      double drawdownPercent =
         (
            drawdown /
            balance
         ) *
         100.0;

      if(
         drawdownPercent >=
         MaximumDrawdownPercent
      )
      {
         tradingLocked = true;

         Print(
            "CRT AI BOT: MAXIMUM DRAWDOWN REACHED."
         );

         Print(
            "CRT AI BOT: NEW TRADING LOCKED."
         );

         Print(
            "CRT AI BOT: Existing basket NOT automatically closed."
         );

         return false;
      }
   }

   //---------------------------------------------------------------
   // CONSECUTIVE LOSSES
   //---------------------------------------------------------------

   if(
      MaximumConsecutiveLosses > 0 &&
      consecutiveLosses >=
      MaximumConsecutiveLosses
   )
   {
      tradingLocked = true;

      Print(
         "CRT AI BOT: MAXIMUM CONSECUTIVE LOSSES REACHED."
      );

      Print(
         "CRT AI BOT: NEW TRADING LOCKED."
      );

      Print(
         "CRT AI BOT: Existing basket NOT automatically closed."
      );

      return false;
   }

   return true;
}

//==================================================================
// PROFIT PROTECTION
//
// IMPORTANT:
// The 2% retracement is measured from the HIGHEST basket profit.
//
// Example:
// Peak = $10.00
// 2% retracement = $0.20
// Close trigger = $9.80
//
// It will NOT trigger while basket profit is negative.
//==================================================================

void ManageProfitProtection()
{
   int positions =
      CountPositions();

   //---------------------------------------------------------------
   // NO POSITIONS
   //---------------------------------------------------------------

   if(positions <= 0)
   {
      protectionActive = false;

      peakBasketProfit = 0.0;

      //------------------------------------------------------------
      // WAIT FOR MT5 TO CONFIRM PREVIOUS BASKET IS CLOSED
      //------------------------------------------------------------

      if(
         reentryPending &&
         tradingEnabled &&
         !tradingLocked
      )
      {
         Print(
            "CRT AI BOT: PROFITABLE BASKET FULLY CLOSED."
         );

         Print(
            "CRT AI BOT: IMMEDIATE RE-ENTRY SCAN."
         );

         reentryPending = false;

         ScanCurrentCandle();

         int direction =
            GetSignalDirection();

         if(direction != 0)
         {
            OpenCurrentDirection(
               direction
            );
         }
         else
         {
            Print(
               "CRT AI BOT: Current M1 candle has no >=55% signal."
            );
         }
      }

      return;
   }

   //---------------------------------------------------------------
   // CURRENT PROFIT
   //---------------------------------------------------------------

   double currentProfit =
      BasketProfit();

   //---------------------------------------------------------------
   // NEVER ACTIVATE PROFIT CLOSE WHILE LOSING
   //---------------------------------------------------------------

   if(currentProfit <= 0.0)
   {
      return;
   }

   //---------------------------------------------------------------
   // FIRST PROFIT
   //---------------------------------------------------------------

   if(!protectionActive)
   {
      protectionActive = true;

      peakBasketProfit =
         currentProfit;

      Print(
         "CRT AI BOT: PROFIT PROTECTION ACTIVATED."
      );

      Print(
         "CRT AI BOT: Initial peak profit=$",
         DoubleToString(
            peakBasketProfit,
            2
         )
      );

      return;
   }

   //---------------------------------------------------------------
   // NEW PEAK
   //---------------------------------------------------------------

   if(
      currentProfit >
      peakBasketProfit
   )
   {
      peakBasketProfit =
         currentProfit;

      return;
   }

   //---------------------------------------------------------------
   // RETRACEMENT AMOUNT
   //---------------------------------------------------------------

   double retracementAmount =
      peakBasketProfit *
      ProfitRetracementPercent /
      100.0;

   //---------------------------------------------------------------
   // CLOSE LEVEL
   //---------------------------------------------------------------

   double closeLevel =
      peakBasketProfit -
      retracementAmount;

   //---------------------------------------------------------------
   // 2% PROFIT RETRACEMENT
   //
   // MUST STILL BE PROFITABLE.
   //---------------------------------------------------------------

   if(
      currentProfit > 0.0 &&
      currentProfit >=
      MinimumProfitToProtect &&
      currentProfit <=
      closeLevel
   )
   {
      Print(
         "=================================================="
      );

      Print(
         "CRT AI BOT: 2% PROFIT RETRACEMENT DETECTED."
      );

      Print(
         "Peak profit=$",
         DoubleToString(
            peakBasketProfit,
            2
         )
      );

      Print(
         "Current profit=$",
         DoubleToString(
            currentProfit,
            2
         )
      );

      Print(
         "Close level=$",
         DoubleToString(
            closeLevel,
            2
         )
      );

      Print(
         "CRT AI BOT: CLOSING PROFITABLE BASKET."
      );

      Print(
         "=================================================="
      );

      //------------------------------------------------------------
      // IMPORTANT:
      // SET THIS BEFORE CLOSING.
      //------------------------------------------------------------

      reentryPending = true;

      if(
         !CloseAll(
            "2% PROFIT RETRACEMENT"
         )
      )
      {
         reentryPending = false;

         Print(
            "CRT AI BOT: Close request was not accepted."
         );
      }

      return;
   }
}

//==================================================================
// MAIN FLIPPING ENGINE
//==================================================================

void ManageFlipping()
{
   if(!tradingEnabled)
      return;

   if(closingBasket)
      return;

   //---------------------------------------------------------------
   // EXISTING POSITIONS
   //---------------------------------------------------------------

   if(
      CountPositions() > 0
   )
   {
      ManageProfitProtection();

      return;
   }

   //---------------------------------------------------------------
   // NO POSITIONS
   //---------------------------------------------------------------

   if(
      tradingLocked
   )
   {
      return;
   }

   //---------------------------------------------------------------
   // PREVIOUS PROFITABLE BASKET JUST CLOSED
   //---------------------------------------------------------------

   if(reentryPending)
   {
      Print(
         "CRT AI BOT: ZERO POSITIONS CONFIRMED."
      );

      Print(
         "CRT AI BOT: RESCANNING CURRENT FORMING M1 CANDLE."
      );

      reentryPending = false;

      ScanCurrentCandle();

      int direction =
         GetSignalDirection();

      if(direction != 0)
      {
         OpenCurrentDirection(
            direction
         );
      }
      else
      {
         Print(
            "CRT AI BOT: No >=55% signal after basket closure."
         );
      }

      return;
   }

   //---------------------------------------------------------------
   // NORMAL ENTRY
   //---------------------------------------------------------------

   ScanCurrentCandle();

   int direction =
      GetSignalDirection();

   if(direction != 0)
   {
      OpenCurrentDirection(
         direction
      );
   }
}

//==================================================================
// CREATE BUTTON
//==================================================================

void CreateButton(
   string name,
   string text,
   int x,
   int y
)
{
   if(
      ObjectFind(
         0,
         name
      ) >= 0
   )
   {
      ObjectDelete(
         0,
         name
      );
   }

   if(
      !ObjectCreate(
         0,
         name,
         OBJ_BUTTON,
         0,
         0,
         0
      )
   )
   {
      Print(
         "CRT AI BOT: Could not create button ",
         name
      );

      return;
   }

   ObjectSetInteger(
      0,
      name,
      OBJPROP_CORNER,
      CORNER_LEFT_UPPER
   );

   ObjectSetInteger(
      0,
      name,
      OBJPROP_XDISTANCE,
      x
   );

   ObjectSetInteger(
      0,
      name,
      OBJPROP_YDISTANCE,
      y
   );

   ObjectSetInteger(
      0,
      name,
      OBJPROP_XSIZE,
      80
   );

   ObjectSetInteger(
      0,
      name,
      OBJPROP_YSIZE,
      30
   );

   ObjectSetString(
      0,
      name,
      OBJPROP_TEXT,
      text
   );

   ObjectSetInteger(
      0,
      name,
      OBJPROP_FONTSIZE,
      10
   );

   ObjectSetInteger(
      0,
      name,
      OBJPROP_SELECTABLE,
      false
   );

   ObjectSetInteger(
      0,
      name,
      OBJPROP_HIDDEN,
      false
   );
}

//==================================================================
// UPDATE STATUS
//==================================================================

void UpdateStatus()
{
   string status;

   if(tradingLocked)
   {
      status =
         "CRT AI BOT: LOCKED";
   }
   else
   if(tradingEnabled)
   {
      status =
         "CRT AI BOT: RUNNING";
   }
   else
   {
      status =
         "CRT AI BOT: STOPPED";
   }

   status +=
      "\nSignal: " +
      signalText;

   status +=
      "\nBUY: " +
      DoubleToString(
         buyStrength,
         1
      ) +
      "%";

   status +=
      "  SELL: " +
      DoubleToString(
         sellStrength,
         1
      ) +
      "%";

   status +=
      "\nPositions: " +
      IntegerToString(
         CountPositions()
      );

   status +=
      "\nBasket Profit: $" +
      DoubleToString(
         BasketProfit(),
         2
      );

   status +=
      "\nPeak Profit: $" +
      DoubleToString(
         peakBasketProfit,
         2
      );

   status +=
      "\nRetrace: " +
      DoubleToString(
         ProfitRetracementPercent,
         1
      ) +
      "%";

   status +=
      "\nMargin Limit: " +
      DoubleToString(
         MaximumBalanceMarginPercent,
         1
      ) +
      "%";

   //---------------------------------------------------------------
   // CREATE STATUS LABEL
   //---------------------------------------------------------------

   if(
      ObjectFind(
         0,
         STATUS_LABEL
      ) < 0
   )
   {
      ObjectCreate(
         0,
         STATUS_LABEL,
         OBJ_LABEL,
         0,
         0,
         0
      );

      ObjectSetInteger(
         0,
         STATUS_LABEL,
         OBJPROP_CORNER,
         CORNER_LEFT_UPPER
      );

      ObjectSetInteger(
         0,
         STATUS_LABEL,
         OBJPROP_XDISTANCE,
         10
      );

      ObjectSetInteger(
         0,
         STATUS_LABEL,
         OBJPROP_YDISTANCE,
         60
      );

      ObjectSetInteger(
         0,
         STATUS_LABEL,
         OBJPROP_FONTSIZE,
         10
      );
   }

   ObjectSetString(
      0,
      STATUS_LABEL,
      OBJPROP_TEXT,
      status
   );
}

//==================================================================
// INITIALIZATION
//==================================================================

int OnInit()
{
   //---------------------------------------------------------------
   // SELECT SYMBOL
   //---------------------------------------------------------------

   if(
      !SymbolSelect(
         Sym(),
         true
      )
   )
   {
      Print(
         "CRT AI BOT: Cannot select symbol ",
         Sym()
      );

      return INIT_FAILED;
   }

   //---------------------------------------------------------------
   // TRADE SETTINGS
   //---------------------------------------------------------------

   trade.SetExpertMagicNumber(
      MagicNumber
   );

   trade.SetDeviationInPoints(
      SlippagePoints
   );

   //---------------------------------------------------------------
   // INITIAL DAY
   //---------------------------------------------------------------

   UpdateDay();

   //---------------------------------------------------------------
   // RESET
   //---------------------------------------------------------------

   tradingEnabled = false;

   tradingLocked = false;

   protectionActive = false;

   closingBasket = false;

   reentryPending = false;

   peakBasketProfit = 0.0;

   buyStrength = 0.0;

   sellStrength = 0.0;

   signalText = "WAIT";

   lastProcessedCandle = 0;

   //---------------------------------------------------------------
   // START BUTTON
   //---------------------------------------------------------------

   CreateButton(
      START_BUTTON,
      "START",
      10,
      20
   );

   //---------------------------------------------------------------
   // STOP BUTTON
   //---------------------------------------------------------------

   CreateButton(
      STOP_BUTTON,
      "STOP",
      100,
      20
   );

   //---------------------------------------------------------------
   // STATUS
   //---------------------------------------------------------------

   UpdateStatus();

   Print(
      "=================================================="
   );

   Print(
      "CRT AI BOT v10.00"
   );

   Print(
      "CURRENT M1 CANDLE FLIPPING"
   );

   Print(
      "Symbol: ",
      Sym()
   );

   Print(
      "Minimum signal: ",
      DoubleToString(
         MinimumSignalStrength,
         1
      ),
      "%"
   );

   Print(
      "Account margin limit: ",
      DoubleToString(
         MaximumBalanceMarginPercent,
         1
      ),
      "%"
   );

   Print(
      "Profit retracement: ",
      DoubleToString(
         ProfitRetracementPercent,
         2
      ),
      "%"
   );

   Print(
      "Trading mode: CONTINUOUS UNTIL STOP"
   );

   Print(
      "=================================================="
   );

   return INIT_SUCCEEDED;
}

