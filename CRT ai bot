         );

      consecutiveLosses = 0;

      tradingLocked = false;

      protectionActive = false;

      peakBasketProfit = 0.0;
   }
}

//==================================================================
// RISK CHECK
//==================================================================

bool RiskOK()
{
   double equity =
      AccountInfoDouble(
         ACCOUNT_EQUITY
      );

   double balance =
      AccountInfoDouble(
         ACCOUNT_BALANCE
      );

   if(balance <= 0.0)
      return false;

   if(dayStartEquity <= 0.0)
      dayStartEquity = equity;

   double dailyLoss =
      dayStartEquity - equity;

   double dailyLossPercent =
      (dailyLoss /
       dayStartEquity) * 100.0;

   if(dailyLossPercent >=
      DailyLossLimitPercent)
   {
      tradingLocked = true;

      Print(
         "CRT AI BOT: Daily loss limit reached."
      );

      return false;
   }

   double drawdown =
      balance - equity;

   double drawdownPercent =
      (drawdown /
       balance) * 100.0;

   if(drawdownPercent >=
      MaximumDrawdownPercent)
   {
      tradingLocked = true;

      Print(
         "CRT AI BOT: Maximum drawdown reached."
      );

      return false;
   }

   if(consecutiveLosses >=
      MaximumConsecutiveLosses)
   {
      tradingLocked = true;

      Print(
         "CRT AI BOT: Consecutive loss limit reached."
      );

      return false;
   }

   return true;
}//==================================================================
// AUTOMATIC POSITION LIMIT
//==================================================================

int CalculateAutomaticPositionLimit(
   bool buy,
   double volume)
{
   if(volume <= 0.0)
      return 0;

   double balance =
      AccountInfoDouble(
         ACCOUNT_BALANCE
      );

   if(balance <= 0.0)
      return 0;

   // Maximum lot exposure allowed by this EA
   double maxLots =
      MaximumEAExposureLots;

   // Maximum number of positions based on lot size
   int byExposure =
      (int)MathFloor(
         maxLots / volume
      );

   if(byExposure < 1)
      byExposure = 1;

   // Margin protection
   double price =
      buy
      ? SymbolInfoDouble(
           Sym(),
           SYMBOL_ASK
        )
      : SymbolInfoDouble(
           Sym(),
           SYMBOL_BID
        );

   ENUM_ORDER_TYPE orderType =
      buy
      ? ORDER_TYPE_BUY
      : ORDER_TYPE_SELL;

   double marginOne = 0.0;

   if(!OrderCalcMargin(
         orderType,
         Sym(),
         volume,
         price,
         marginOne))
   {
      return byExposure;
   }

   if(marginOne <= 0.0)
      return byExposure;

   double maximumMargin =
      balance *
      MaximumBalanceMarginPercent /
      100.0;

   int byMargin =
      (int)MathFloor(
         maximumMargin / marginOne
      );

   if(byMargin < 1)
      byMargin = 1;

   int limit =
      MathMin(
         byExposure,
         byMargin
      );

   if(MaximumOpenPositions > 0)
   {
      limit =
         MathMin(
            limit,
            MaximumOpenPositions
         );
   }

   return limit;
}

//==================================================================
// OPEN ONE POSITION
//==================================================================

bool OpenOne(
   bool buy,
   double volume)
{
   if(!tradingEnabled)
      return false;

   if(tradingLocked)
      return false;

   if(!RiskOK())
      return false;

   string symbol = Sym();

   trade.SetExpertMagicNumber(
      MagicNumber
   );

   trade.SetDeviationInPoints(
      SlippagePoints
   );

   bool result = false;

   if(buy)
   {
      result =
         trade.Buy(
            volume,
            symbol,
            0.0,
            0.0,
            0.0,
            "CRT AI BUY"
         );
   }
   else
   {
      result =
         trade.Sell(
            volume,
            symbol,
            0.0,
            0.0,
            0.0,
            "CRT AI SELL"
         );
   }

   if(!result)
   {
      Print(
         "CRT AI BOT: Order failed. ",
         trade.ResultRetcode(),
         " ",
         trade.ResultRetcodeDescription()
      );

      return false;
   }

   Print(
      "CRT AI BOT: ",
      buy ? "BUY" : "SELL",
      " opened. Lot=",
      volume
   );

   return true;
}

//==================================================================
// OPEN CURRENT HIGH-CONFIDENCE DIRECTION
//==================================================================

void OpenCurrentDirection(
   int direction)
{
   if(direction == 0)
      return;

   if(!tradingEnabled)
      return;

   if(tradingLocked)
      return;

   double volume =
      CalculateDynamicLot();

   if(volume <= 0.0)
      return;

   bool buy =
      direction > 0;

   int maximumPositions =
      CalculateAutomaticPositionLimit(
         buy,
         volume
      );

   if(maximumPositions <= 0)
      return;

   int currentPositions =
      CountPositions();

   int available =
      maximumPositions -
      currentPositions;

   if(available <= 0)
      return;

   int ordersToOpen =
      available;

   if(OrdersPerSignal > 0)
   {
      ordersToOpen =
         MathMin(
            ordersToOpen,
            OrdersPerSignal
         );
   }

   for(int i = 0;
       i < ordersToOpen;
       i++)
   {
      if(!RiskOK())
         break;

      if(!OpenOne(
            buy,
            volume))
      {
         break;
      }
   }
}

//==================================================================
// PROFIT PROTECTION
//==================================================================

void ManageProfitProtection()
{
   int positions =
      CountPositions();

   if(positions <= 0)
   {
      protectionActive = false;
      peakBasketProfit = 0.0;
      return;
   }

   double currentProfit =
      BasketProfit();

   // NEVER close a losing basket
   if(currentProfit < MinimumProfitToProtect)
   {
      return;
   }

   // Activate protection once minimum profit is reached
   if(!protectionActive)
   {
      protectionActive = true;

      peakBasketProfit =
         currentProfit;

      Print(
         "CRT AI BOT: Profit protection activated. Peak=",
         peakBasketProfit
      );

      return;
   }

   // Update peak basket profit
   if(currentProfit > peakBasketProfit)
   {
      peakBasketProfit =
         currentProfit;

      return;
   }

   if(peakBasketProfit <= 0.0)
      return;

   // 2% retracement from peak profit
   double retracement =
      peakBasketProfit *
      ProfitRetracementPercent /
      100.0;

   double protectedProfit =
      peakBasketProfit -
      retracement;

   // Close ONLY while still profitable
   if(currentProfit >=
      MinimumProfitToProtect &&
      currentProfit <=
      protectedProfit)
   {
      Print(
         "CRT AI BOT: Profit retracement detected. ",
         "Peak=",
         peakBasketProfit,
         " Current=",
         currentProfit,
         " Protected=",
         protectedProfit
      );

      CloseAll(
         "2% profit retracement"
      );
   }
}

//==================================================================
// MARKET FLIPPING PROTECTION
//==================================================================

void ManageFlipping()
{
   // This function intentionally does NOT close
   // positions simply because the candle changes direction.
   //
   // The bot waits for the basket to reach its
   // profit-protection condition.

   if(CountPositions() <= 0)
      return;

   double profit =
      BasketProfit();

   if(profit < MinimumProfitToProtect)
      return;

   // Profit protection is handled by
   // ManageProfitProtection().
}

//==================================================================
// MARKET SCAN - PLACEHOLDER FOR PART 3 ENGINE
//==================================================================

void ScanMarket()
{
   buyScore = CalculateBuyScore();
   sellScore = CalculateSellScore();

   if(buyScore >= MinimumSignalScore &&
      buyScore > sellScore)
   {
      signalText = "BUY " +
                    DoubleToString(
                       buyScore,
                       1
                    ) +
                    "%";
   }
   else
   if(sellScore >= MinimumSignalScore &&
      sellScore > buyScore)
   {
      signalText = "SELL " +
                    DoubleToString(
                       sellScore,
                       1
                    ) +
                    "%";
   }
   else
   {
      signalText =
         "WAIT  B:" +
         DoubleToString(
            buyScore,
            1
         ) +
         " S:" +
         DoubleToString(
            sellScore,
            1
         );
   }

   lastScanTime =
      TimeCurrent();

   UpdateStatus();
}

//==================================================================
// GET SIGNAL DIRECTION
//==================================================================

int GetSignalDirection()
{
   if(buyScore >= MinimumSignalScore &&
      buyScore > sellScore)
   {
      return 1;
   }

   if(sellScore >= MinimumSignalScore &&
      sellScore > buyScore)
   {
      return -1;
   }

   return 0;
}//==================================================================
// CURRENT M1 CANDLE DIRECTION
//==================================================================

int CurrentCandleDirection()
{
   MqlRates rates[1];

   if(CopyRates(
         Sym(),
         PERIOD_M1,
         0,
         1,
         rates) != 1)
   {
      return 0;
   }

   double candleOpen =
      rates[0].open;

   double currentPrice =
      SymbolInfoDouble(
         Sym(),
         SYMBOL_BID
      );

   if(currentPrice > candleOpen)
      return 1;

   if(currentPrice < candleOpen)
      return -1;

   return 0;
}

//==================================================================
// BUY SCORE
//==================================================================

double CalculateBuyScore()
{
   MqlRates rates[];

   ArraySetAsSeries(
      rates,
      true
   );

   int copied =
      CopyRates(
         Sym(),
         PERIOD_M1,
         0,
         ScanCandles,
         rates
      );

   if(copied < ScanCandles)
      return 0.0;

   double score = 0.0;

   // ---------------------------------------------------------------
   // 1. CURRENT CANDLE DIRECTION
   // ---------------------------------------------------------------

   int currentDirection =
      CurrentCandleDirection();

   if(currentDirection == 1)
      score += 25.0;

   // ---------------------------------------------------------------
   // 2. RECENT CANDLE DIRECTION
   // ---------------------------------------------------------------

   int bullish = 0;

   for(int i = 1;
       i < ScanCandles;
       i++)
   {
      if(rates[i].close >
         rates[i].open)
      {
         bullish++;
      }
   }

   double bullishRatio =
      (double)bullish /
      (double)(ScanCandles - 1);

   if(bullishRatio >= 0.60)
      score += 20.0;
   else
   if(bullishRatio >= 0.50)
      score += 10.0;

   // ---------------------------------------------------------------
   // 3. RECENT MOMENTUM
   // ---------------------------------------------------------------

   int momentumBullish = 0;

   int momentumCount =
      MathMin(
         MomentumCandles,
         ScanCandles - 1
      );

   for(int i = 1;
       i <= momentumCount;
       i++)
   {
      if(rates[i].close >
         rates[i].open)
      {
         momentumBullish++;
      }
   }

   if(momentumCount > 0)
   {
      double momentumRatio =
         (double)momentumBullish /
         (double)momentumCount;

      if(momentumRatio >= 0.80)
         score += 20.0;
      else
      if(momentumRatio >= 0.60)
         score += 10.0;
   }

   // ---------------------------------------------------------------
   // 4. PRICE STRUCTURE
   // ---------------------------------------------------------------

   double recentHigh =
      rates[1].high;

   double recentLow =
      rates[1].low;

   for(int i = 2;
       i < ScanCandles;
       i++)
   {
      if(rates[i].high >
         recentHigh)
      {
         recentHigh =
            rates[i].high;
      }

      if(rates[i].low <
         recentLow)
      {
         recentLow =
            rates[i].low;
      }
   }

   double bid =
      SymbolInfoDouble(
         Sym(),
         SYMBOL_BID
      );

   if(bid >= recentHigh)
      score += 20.0;
   else
   if(bid >
      (recentHigh + recentLow) / 2.0)
   {
      score += 10.0;
   }

   // ---------------------------------------------------------------
   // 5. SHORT-TERM PRICE POSITION
   // ---------------------------------------------------------------

   double firstPrice =
      rates[momentumCount].close;

   double latestPrice =
      rates[0].close;

   if(latestPrice > firstPrice)
      score += 15.0;

   if(score > 100.0)
      score = 100.0;

   return score;
}

