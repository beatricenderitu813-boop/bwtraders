//==================================================================
// CLOSE ALL EA POSITIONS
//==================================================================

bool CloseAll(
   string reason
)
{
   bool allClosed = true;

   for(
      int i = PositionsTotal() - 1;
      i >= 0;
      i--
   )
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol =
         PositionGetString(
            POSITION_SYMBOL
         );

      long magic =
         PositionGetInteger(
            POSITION_MAGIC
         );

      if(symbol != Sym())
         continue;

      if((ulong)magic != MagicNumber)
         continue;

      if(!trade.PositionClose(
            ticket,
            SlippagePoints
         ))
      {
         allClosed = false;

         Print(
            "CRT AI BOT: Close failed. Ticket=",
            ticket,
            " Error=",
            GetLastError()
         );
      }
   }

   if(allClosed)
   {
      protectionActive = false;
      peakBasketProfit = 0.0;

      Print(
         "CRT AI BOT: Basket closed. Reason=",
         reason
      );
   }

   return allClosed;
}

//==================================================================
// UPDATE DAY
//==================================================================

void UpdateDay()
{
   MqlDateTime tm;

   TimeToStruct(
      TimeCurrent(),
      tm
   );

   int currentDay =
      tm.day_of_year;

   if(savedDay != currentDay)
   {
      savedDay = currentDay;

      dayStartEquity =
         AccountInfoDouble(
            ACCOUNT_EQUITY
         );

      consecutiveLosses = 0;

      tradingLocked = false;

      protectionActive = false;

      peakBasketProfit = 0.0;
   }
}

//==================================================================
// RISK CHECK
//==================================================================

bool RiskOK()
{
   double equity =
      AccountInfoDouble(
         ACCOUNT_EQUITY
      );

   double balance =
      AccountInfoDouble(
         ACCOUNT_BALANCE
      );

   if(balance <= 0.0)
      return false;

   if(dayStartEquity <= 0.0)
      dayStartEquity = equity;

   double dailyLoss =
      dayStartEquity - equity;

   double dailyLossPercent =
      (dailyLoss /
       dayStartEquity) * 100.0;

   if(dailyLossPercent >=
      DailyLossLimitPercent)
   {
      tradingLocked = true;

      Print(
         "CRT AI BOT: Daily loss limit reached."
      );

      return false;
   }

   double drawdown =
      balance - equity;

   double drawdownPercent =
      (drawdown /
       balance) * 100.0;

   if(drawdownPercent >=
      MaximumDrawdownPercent)
   {
      tradingLocked = true;

      Print(
         "CRT AI BOT: Maximum drawdown reached."
      );

      return false;
   }

   if(consecutiveLosses >=
      MaximumConsecutiveLosses)
   {
      tradingLocked = true;

      Print(
         "CRT AI BOT: Consecutive loss limit reached."
      );

      return false;
   }

   return true;
}
//==================================================================
// CHECK FOR A NEW M1 CANDLE
//==================================================================

bool IsNewM1Candle()
{
   MqlRates rates[2];

   ArraySetAsSeries(
      rates,
      true
   );

   if(CopyRates(
         Sym(),
         PERIOD_M1,
         0,
         2,
         rates) < 2)
   {
      return false;
   }

   datetime currentCandle =
      rates[0].time;

   if(lastProcessedCandle == 0)
   {
      lastProcessedCandle =
         currentCandle;

      return true;
   }

   if(currentCandle !=
      lastProcessedCandle)
   {
      lastProcessedCandle =
         currentCandle;

      return true;
   }

   return false;
}

//==================================================================
// CURRENT CANDLE DIRECTION
//==================================================================

int CurrentCandleDirection()
{
   MqlRates rates[1];

   ArraySetAsSeries(
      rates,
      true
   );

   if(CopyRates(
         Sym(),
         PERIOD_M1,
         0,
         1,
         rates) != 1)
   {
      return 0;
   }

   double bid =
      SymbolInfoDouble(
         Sym(),
         SYMBOL_BID
      );

   if(bid > rates[0].open)
      return 1;

   if(bid < rates[0].open)
      return -1;

   return 0;
}

//==================================================================
// BUY STRENGTH
//==================================================================

double CalculateBuyStrength()
{
   MqlRates rates[];

   ArraySetAsSeries(
      rates,
      true
   );

   int candles =
      MathMax(
         ScanCandles,
         2
      );

   int copied =
      CopyRates(
         Sym(),
         PERIOD_M1,
         0,
         candles,
         rates
      );

   if(copied < candles)
      return 0.0;

   double score = 0.0;

   // ---------------------------------------------------------------
   // 1. PREVIOUS CLOSED CANDLE
   // ---------------------------------------------------------------

   if(rates[1].close >
      rates[1].open)
   {
      score += 30.0;
   }

   // ---------------------------------------------------------------
   // 2. CURRENT CANDLE DIRECTION
   // ---------------------------------------------------------------

   int currentDirection =
      CurrentCandleDirection();

   if(currentDirection == 1)
      score += 20.0;

   // ---------------------------------------------------------------
   // 3. RECENT CANDLE BALANCE
   // ---------------------------------------------------------------

   int bullish = 0;

   int checked =
      MathMin(
         candles - 1,
         4
      );

   for(
      int i = 1;
      i <= checked;
      i++
   )
   {
      if(rates[i].close >
         rates[i].open)
      {
         bullish++;
      }
   }

   if(checked > 0)
   {
      double ratio =
         (double)bullish /
         (double)checked;

      score +=
         ratio * 25.0;
   }

   // ---------------------------------------------------------------
   // 4. MOMENTUM
   // ---------------------------------------------------------------

   if(rates[1].close >
      rates[2].close)
   {
      score += 15.0;
   }

   // ---------------------------------------------------------------
   // 5. PRICE POSITION
   // ---------------------------------------------------------------

   double highest =
      rates[1].high;

   double lowest =
      rates[1].low;

   for(
      int i = 2;
      i < candles;
      i++
   )
   {
      if(rates[i].high >
         highest)
      {
         highest =
            rates[i].high;
      }

      if(rates[i].low <
         lowest)
      {
         lowest =
            rates[i].low;
      }
   }

   double bid =
      SymbolInfoDouble(
         Sym(),
         SYMBOL_BID
      );

   double range =
      highest - lowest;

   if(range > 0.0)
   {
      double position =
         (bid - lowest) /
         range;

      if(position >= 0.70)
         score += 10.0;
      else
      if(position >= 0.50)
         score += 5.0;
   }

   if(score > 100.0)
      score = 100.0;

   return score;
}

