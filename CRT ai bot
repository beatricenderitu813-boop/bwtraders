//==================================================================
// SPREAD CHECK
//==================================================================

bool SpreadOK()
{
   if(MaximumSpreadPips <= 0.0)
      return true;

   double ask =
      SymbolInfoDouble(
         Sym(),
         SYMBOL_ASK
      );

   double bid =
      SymbolInfoDouble(
         Sym(),
         SYMBOL_BID
      );

   double pip =
      PipSize(
         Sym()
      );

   if(
      ask <= 0.0 ||
      bid <= 0.0 ||
      pip <= 0.0
   )
   {
      return false;
   }

   double spreadPips =
      (ask - bid) / pip;

   if(
      spreadPips >
      MaximumSpreadPips
   )
   {
      Print(
         "CRT AI BOT: Spread too high. ",
         "Spread=",
         DoubleToString(
            spreadPips,
            2
         ),
         " pips"
      );

      return false;
   }

   return true;
}

