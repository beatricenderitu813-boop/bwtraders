// PROFIT PROTECTION
//==================================================================

void ManageProfitProtection()
{
   int positions =
      CountPositions();

   if(positions <= 0)
   {
      protectionActive = false;

      peakBasketProfit = 0.0;

      return;
   }

   double currentProfit =
      BasketProfit();

   //---------------------------------------------------------------
   // LOSING BASKET IS NEVER CLOSED BY PROFIT PROTECTION
   //---------------------------------------------------------------

   if(
      currentProfit <
      MinimumProfitToProtect
   )
   {
      return;
   }

   //---------------------------------------------------------------
   // FIRST PROFIT
   //---------------------------------------------------------------

   if(!protectionActive)
   {
      protectionActive = true;

      peakBasketProfit =
         currentProfit;

      Print(
         "CRT AI BOT: Profit protection ACTIVE. Peak=$",
         DoubleToString(
            peakBasketProfit,
            2
         )
      );

      return;
   }

   //---------------------------------------------------------------
   // NEW PROFIT HIGH
   //---------------------------------------------------------------

   if(
      currentProfit >
      peakBasketProfit
   )
   {
      peakBasketProfit =
         currentProfit;

      Print(
         "CRT AI BOT: New basket profit peak=$",
         DoubleToString(
            peakBasketProfit,
            2
         )
      );

      return;
   }

   //---------------------------------------------------------------
   // 2% RETRACEMENT
   //---------------------------------------------------------------

   double retracement =
      peakBasketProfit *
      ProfitRetracementPercent /
      100.0;

   double protectionLevel =
      peakBasketProfit -
      retracement;

   //---------------------------------------------------------------
   // CLOSE ONLY AT PROFIT
   //---------------------------------------------------------------

   if(
      currentProfit >=
      MinimumProfitToProtect &&
      currentProfit <=
      protectionLevel
   )
   {
      Print(
         "CRT AI BOT: 2% PROFIT RETRACEMENT. ",
         "Peak=$",
         DoubleToString(
            peakBasketProfit,
            2
         ),
         " Current=$",
         DoubleToString(
            currentProfit,
            2
         )
      );

      if(
         CloseAll(
            "2% PROFIT RETRACEMENT"
         )
      )
      {
         reentryPending = true;

         //--------------------------------------------------------
         // IMMEDIATE RE-ENTRY
         //--------------------------------------------------------

         if(
            tradingEnabled &&
            !tradingLocked &&
            CountPositions() == 0
         )
         {
            ScanCurrentCandle();

            int direction =
               GetSignalDirection();

            if(direction != 0)
            {
               OpenCurrentDirection(
                  direction
               );

               reentryPending = false;
            }
         }
      }
   }
}

//==================================================================
// CAPITAL PROTECTION
//
// IMPORTANT:
// This does NOT close the losing basket.
// Instead, it opens the OPPOSITE direction as a hedge.
//==================================================================

void ManageCapitalProtection()
{
   if(!tradingEnabled)
      return;

   if(tradingLocked)
      return;

   if(
      CapitalProtectionPercent <= 0.0
   )
   {
      return;
   }

   if(
      MaximumProtectionFlips <= 0
   )
   {
      return;
   }

   if(
      protectionFlips >=
      MaximumProtectionFlips
   )
   {
      return;
   }

   if(
      capitalProtectionTriggered
   )
   {
      return;
   }

   int positions =
      CountPositions();

   if(positions <= 0)
      return;

   if(dayStartEquity <= 0.0)
      return;

   double currentProfit =
      BasketProfit();

   //---------------------------------------------------------------
   // CAPITAL PROTECTION LOSS LEVEL
   //---------------------------------------------------------------

   double protectionLoss =
      dayStartEquity *
      CapitalProtectionPercent /
      100.0;

   //---------------------------------------------------------------
   // DO NOTHING WHILE BASKET IS ABOVE THE PROTECTION LEVEL
   //---------------------------------------------------------------

   if(
      currentProfit >
      -protectionLoss
   )
   {
      return;
   }

   //---------------------------------------------------------------
   // DETERMINE CURRENT MAIN DIRECTION
   //---------------------------------------------------------------

   int mainDirection = 0;

   double buyLots = 0.0;

   double sellLots = 0.0;

   for(
      int i = PositionsTotal() - 1;
      i >= 0;
      i--
   )
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(
         !PositionSelectByTicket(
            ticket
         )
      )
      {
         continue;
      }

      string symbol =
         PositionGetString(
            POSITION_SYMBOL
         );

      long magic =
         PositionGetInteger(
            POSITION_MAGIC
         );

      if(symbol != Sym())
         continue;

      if(
         (ulong)magic !=
         MagicNumber
      )
      {
         continue;
      }

      ENUM_POSITION_TYPE type =
         (ENUM_POSITION_TYPE)
         PositionGetInteger(
            POSITION_TYPE
         );

      double volume =
         PositionGetDouble(
            POSITION_VOLUME
         );

      if(
         type ==
         POSITION_TYPE_BUY
      )
      {
         buyLots += volume;
      }
      else
      if(
         type ==
         POSITION_TYPE_SELL
      )
      {
         sellLots += volume;
      }
   }

   if(
      buyLots >
      sellLots
   )
   {
      mainDirection = 1;
   }
   else
   if(
      sellLots >
      buyLots
   )
   {
      mainDirection = -1;
   }
   else
   {
      //------------------------------------------------------------
      // If equal, use current M1 direction.
      //------------------------------------------------------------

      mainDirection =
         CurrentCandleDirection();
   }

   if(mainDirection == 0)
      return;

   //---------------------------------------------------------------
   // OPPOSITE DIRECTION
   //---------------------------------------------------------------

   int oppositeDirection =
      -mainDirection;

   bool oppositeBuy =
      oppositeDirection > 0;

   double volume =
      CalculateDynamicLot();

   if(volume <= 0.0)
      return;

   volume =
      NormalizeVolume(
         Sym(),
         volume
      );

   if(volume <= 0.0)
      return;

   //---------------------------------------------------------------
   // RESPECT TOTAL EXPOSURE
   //---------------------------------------------------------------

   if(
      MaximumEAExposureLots > 0.0 &&
      TotalLots() +
      volume >
      MaximumEAExposureLots +
      0.0000001
   )
   {
      Print(
         "CRT AI BOT: Capital protection wanted to hedge, ",
         "but maximum exposure would be exceeded."
      );

      return;
   }

   //---------------------------------------------------------------
   // CHECK REMAINING MARGIN ALLOWANCE
   //---------------------------------------------------------------

   int allowed =
      CalculateAutomaticPositionLimit(
         oppositeBuy,
         volume
      );

   if(allowed <= 0)
   {
      Print(
         "CRT AI BOT: Capital protection hedge blocked ",
         "by 50% margin limit."
      );

      return;
   }

   //---------------------------------------------------------------
   // OPEN ONE OPPOSITE PROTECTION TRADE
   //---------------------------------------------------------------

   if(
      OpenOne(
         oppositeBuy,
         volume,
         "CRT AI CAPITAL PROTECTION"
      )
   )
   {
      protectionFlips++;

      capitalProtectionTriggered = true;

      Print(
         "CRT AI BOT: CAPITAL PROTECTION ACTIVATED. ",
         "Opposite trade opened. Flip #",
         protectionFlips
      );
   }
}

//==================================================================
// NEW M1 CANDLE CHECK
//==================================================================

bool IsNewM1Candle()
{
   MqlRates rates[];

   ArraySetAsSeries(
      rates,
      true
   );

   if(
      CopyRates(
         Sym(),
         PERIOD_M1,
         0,
         1,
         rates
      ) != 1
   )
   {
      return false;
   }

   datetime currentCandle =
      rates[0].time;

   if(
      lastProcessedCandle == 0
   )
   {
      lastProcessedCandle =
         currentCandle;

      return true;
   }

   if(
      currentCandle !=
      lastProcessedCandle
   )
   {
      lastProcessedCandle =
         currentCandle;

      return true;
   }

   return false;
}

//==================================================================
// FLIPPING MANAGER
//==================================================================

void ManageFlipping()
{
   if(!tradingEnabled)
      return;

   if(tradingLocked)
      return;

   if(closingBasket)
      return;

   //---------------------------------------------------------------
   // NO POSITIONS
   //---------------------------------------------------------------

   if(
      CountPositions() == 0
   )
   {
      protectionActive = false;

      peakBasketProfit = 0.0;

      protectionFlips = 0;

      capitalProtectionTriggered = false;

      ScanCurrentCandle();

      int direction =
         GetSignalDirection();

      if(direction != 0)
      {
         OpenCurrentDirection(
            direction
         );
      }

      return;
   }

   //---------------------------------------------------------------
   // CAPITAL PROTECTION FIRST
   //---------------------------------------------------------------

   ManageCapitalProtection();

   //---------------------------------------------------------------
   // THEN PROFIT PROTECTION
   //---------------------------------------------------------------

   ManageProfitProtection();
}

