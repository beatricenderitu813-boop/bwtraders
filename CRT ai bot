// CALCULATE DYNAMIC LOT
//==================================================================

double CalculateDynamicLot()
{
   double balance =
      AccountInfoDouble(
         ACCOUNT_BALANCE
      );

   double lot =
      balance *
      LotMultiplier;

   return NormalizeVolume(
      Sym(),
      lot
   );
}

//==================================================================
// CALCULATE LOT TO USE
//==================================================================

double GetTradeLot()
{
   double lot = ManualLotSize;

   if(UseAutoLot)
   {
      lot = CalculateDynamicLot();
   }

   return NormalizeVolume(
      Sym(),
      lot
   );
}

//==================================================================
// ESTIMATE MARGIN FOR ONE TRADE
//==================================================================

double EstimateTradeMargin(
   ENUM_ORDER_TYPE orderType,
   double volume
)
{
   double price;

   if(orderType == ORDER_TYPE_BUY)
   {
      price =
         SymbolInfoDouble(
            Sym(),
            SYMBOL_ASK
         );
   }
   else
   {
      price =
         SymbolInfoDouble(
            Sym(),
            SYMBOL_BID
         );
   }

   double margin = 0.0;

   if(
      !OrderCalcMargin(
         orderType,
         Sym(),
         volume,
         price,
         margin
      )
   )
   {
      return 0.0;
   }

   return margin;
}

//==================================================================
// CALCULATE HOW MANY POSITIONS CAN BE OPENED
//
// Maximum margin allowance = 50% of account balance.
// Also respects MaximumOpenPositions and
// MaximumEAExposureLots.
//==================================================================

int CalculateMaximumTrades(
   ENUM_ORDER_TYPE orderType,
   double lot
)
{
   if(lot <= 0.0)
      return 0;

   double balance =
      AccountInfoDouble(
         ACCOUNT_BALANCE
      );

   double allowedMargin =
      balance *
      MaximumBalanceMarginPercent /
      100.0;

   double currentMargin =
      AccountInfoDouble(
         ACCOUNT_MARGIN
      );

   double remainingMargin =
      allowedMargin -
      currentMargin;

   if(remainingMargin <= 0.0)
      return 0;

   double oneTradeMargin =
      EstimateTradeMargin(
         orderType,
         lot
      );

   if(oneTradeMargin <= 0.0)
      return 0;

   int possible =
      (int)MathFloor(
         remainingMargin /
         oneTradeMargin
      );

   // Respect maximum position count
   if(MaximumOpenPositions > 0)
   {
      int remainingPositions =
         MaximumOpenPositions -
         CountPositions();

      if(remainingPositions < possible)
         possible =
            remainingPositions;
   }

   // Respect maximum EA exposure in lots
   if(MaximumEAExposureLots > 0.0)
   {
      double currentLots =
         TotalEALots();

      double remainingLots =
         MaximumEAExposureLots -
         currentLots;

      int exposurePositions =
         (int)MathFloor(
            remainingLots /
            lot
         );

      if(exposurePositions < possible)
         possible =
            exposurePositions;
   }

   // Respect OrdersPerSignal when it is greater than zero
   if(OrdersPerSignal > 0 &&
      OrdersPerSignal < possible)
   {
      possible =
         OrdersPerSignal;
   }

   if(possible < 1)
      return 0;

   return possible;
}

//==================================================================
// CHECK MARGIN BEFORE TRADE
//==================================================================

bool EnoughMargin(
   ENUM_ORDER_TYPE orderType,
   double lot
)
{
   double balance =
      AccountInfoDouble(
         ACCOUNT_BALANCE
      );

   double allowedMargin =
      balance *
      MaximumBalanceMarginPercent /
      100.0;

   double currentMargin =
      AccountInfoDouble(
         ACCOUNT_MARGIN
      );

   double requiredMargin =
      EstimateTradeMargin(
         orderType,
         lot
      );

   if(requiredMargin <= 0.0)
      return false;

   if(
      currentMargin +
      requiredMargin >
      allowedMargin
   )
   {
      return false;
   }

   return true;
}

//==================================================================
// OPEN ONE BUY TRADE
//==================================================================

bool OpenBuy()
{
   if(!CanOpenNewTrades())
      return false;

   double lot =
      GetTradeLot();

   if(lot <= 0.0)
      return false;

   if(!EnoughMargin(
      ORDER_TYPE_BUY,
      lot
   ))
   {
      Print(
         "CRT AI BOT: Not enough margin allowance for BUY."
      );

      return false;
   }

   double ask =
      SymbolInfoDouble(
         Sym(),
         SYMBOL_ASK
      );

   double pip =
      PipSize(
         Sym()
      );

   double sl = 0.0;
   double tp = 0.0;

   if(
      EmergencyStopLossPips > 0.0 &&
      pip > 0.0
   )
   {
      sl =
         NormalizePrice(
            Sym(),
            ask -
            EmergencyStopLossPips *
            pip
         );
   }

   if(
      TakeProfitPips > 0.0 &&
      pip > 0.0
   )
   {
      tp =
         NormalizePrice(
            Sym(),
            ask +
            TakeProfitPips *
            pip
         );
   }

   bool result =
      trade.Buy(
         lot,
         Sym(),
         0.0,
         sl,
         tp,
         "CRT AI BOT BUY"
      );

   if(!result)
   {
      Print(
         "CRT AI BOT: BUY failed | ",
         trade.ResultRetcodeDescription()
      );

      return false;
   }

   Print(
      "CRT AI BOT: BUY opened | Lot = ",
      DoubleToString(
         lot,
         2
      )
   );

   return true;
}

