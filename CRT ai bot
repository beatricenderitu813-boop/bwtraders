//==================================================================
// STATUS
//==================================================================

void UpdateStatus()
{
   string status;

   if(tradingLocked)
      status = "CRT AI BOT: LOCKED";
   else if(tradingEnabled)
      status = "CRT AI BOT: RUNNING";
   else
      status = "CRT AI BOT: STOPPED";

   status +=
      "\nPositions: " +
      IntegerToString(
         CountPositions()
      );

   status +=
      "\nBasket Profit: " +
      DoubleToString(
         BasketProfit(),
         2
      );

   if(protectionActive)
      status +=
         "\nProtection: ACTIVE";
   else
      status +=
         "\nProtection: WAITING FOR PROFIT";

   if(ObjectFind(
         0,
         STATUS_LABEL) < 0)
   {
      ObjectCreate(
         0,
         STATUS_LABEL,
         OBJ_LABEL,
         0,
         0,
         0
      );

      ObjectSetInteger(
         0,
         STATUS_LABEL,
         OBJPROP_XDISTANCE,
         10
      );

      ObjectSetInteger(
         0,
         STATUS_LABEL,
         OBJPROP_YDISTANCE,
         80
      );
   }

   ObjectSetString(
      0,
      STATUS_LABEL,
      OBJPROP_TEXT,
      status
   );
}

