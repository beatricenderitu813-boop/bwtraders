   const int reason
)
{
   ObjectDelete(
      0,
      START_BUTTON
   );

   ObjectDelete(
      0,
      STOP_BUTTON
   );

   ObjectDelete(
      0,
      STATUS_LABEL
   );
}

//==================================================================
// MAIN TICK
//==================================================================

void OnTick()
{
   UpdateDay();

   if(!tradingEnabled)
      return;

   if(tradingLocked)
      return;

   if(!RiskOK())
      return;

   ManageFlipping();
}

//==================================================================
// START / STOP BUTTON EVENTS
//==================================================================

void OnChartEvent(
   const int id,
   const long &lparam,
   const double &dparam,
   const string &sparam
)
{
   if(
      id != CHARTEVENT_OBJECT_CLICK
   )
   {
      return;
   }

   //--------------------------------------------------------------
   // START
   //--------------------------------------------------------------

   if(
      sparam ==
      START_BUTTON
   )
   {
      if(tradingLocked)
      {
         Print(
            "START blocked: risk protection is active."
         );

         return;
      }

      tradingEnabled = true;

      UpdateStatus();

      Print(
         "CRT AI BOT STARTED"
      );

      //-----------------------------------------------------------
      // OPEN IMMEDIATELY USING CURRENT FORMING M1 CANDLE
      //-----------------------------------------------------------

      int direction =
         CurrentCandleDirection();

      if(direction != 0)
      {
         OpenCurrentDirection(
            direction
         );
      }
   }

   //--------------------------------------------------------------
   // STOP
   //--------------------------------------------------------------

   if(
      sparam ==
      STOP_BUTTON
   )
   {
      tradingEnabled = false;

      UpdateStatus();

      CloseAll(
         "MANUAL STOP"
      );

      Print(
         "CRT AI BOT STOPPED"
      );
   }
}

//==================================================================
// TRADE TRANSACTION
//==================================================================

void OnTradeTransaction(
   const MqlTradeTransaction &trans,
   const MqlTradeRequest &request,
   const MqlTradeResult &result
)
{
   if(
      trans.type !=
      TRADE_TRANSACTION_DEAL_ADD
   )
   {
      return;
   }

   if(trans.deal == 0)
      return;

   if(
      !HistoryDealSelect(
         trans.deal
      )
   )
   {
      return;
   }

   long entry =
      HistoryDealGetInteger(
         trans.deal,
         DEAL_ENTRY
      );

   if(
      entry != DEAL_ENTRY_OUT &&
      entry != DEAL_ENTRY_OUT_BY
   )
   {
      return;
   }

   long magic =
      HistoryDealGetInteger(
         trans.deal,
         DEAL_MAGIC
      );

   string symbol =
      HistoryDealGetString(
         trans.deal,
         DEAL_SYMBOL
      );

   if(
      (ulong)magic != MagicNumber ||
      symbol != Sym()
   )
   {
      return;
   }

   double profit =
      HistoryDealGetDouble(
         trans.deal,
         DEAL_PROFIT
      );

   double swap =
      HistoryDealGetDouble(
         trans.deal,
         DEAL_SWAP
      );

   double commission =
      HistoryDealGetDouble(
         trans.deal,
         DEAL_COMMISSION
      );

   double netProfit =
      profit +
      swap +
      commission;

   if(netProfit < 0)
   {
      consecutiveLosses++;
   }
   else if(netProfit > 0)
   {
      consecutiveLosses = 0;
   }

   //--------------------------------------------------------------
   // MAXIMUM CONSECUTIVE LOSSES
   //--------------------------------------------------------------

   if(
      MaximumConsecutiveLosses > 0 &&
      consecutiveLosses >=
      MaximumConsecutiveLosses
   )
   {
      tradingLocked = true;
      tradingEnabled = false;

      CloseAll(
         "MAXIMUM CONSECUTIVE LOSSES"
      );

      UpdateStatus();

      Print(
         "CRT AI BOT LOCKED BY RISK PROTECTION"
      );

      return;
   }

   //--------------------------------------------------------------
   // IMMEDIATE RE-ENTRY
   //
   // IMPORTANT:
   // Only re-enter when ALL EA positions have actually closed.
   // This prevents one closing deal in a multi-position basket
   // from creating an unwanted extra trade.
   //--------------------------------------------------------------

   if(
      tradingEnabled &&
      !tradingLocked &&
      CountPositions() == 0
   )
   {
      if(!RiskOK())
         return;

      //-----------------------------------------------------------
      // Use CURRENT FORMING M1 candle.
      // No candle-close confirmation.
      //-----------------------------------------------------------

      int direction =
         CurrentCandleDirection();

      if(direction != 0)
      {
         Print(
            "IMMEDIATE RE-ENTRY: CURRENT M1 DIRECTION = ",
            direction == 1 ? "BUY" : "SELL"
         );

         OpenCurrentDirection(
            direction
         );
      }
   }
}

