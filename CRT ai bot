   }

   return 0;
}

//==================================================================
// AUTOMATIC POSITION LIMIT
//==================================================================

int CalculateAutomaticPositionLimit(
   bool buy,
   double volume
)
{
   if(volume <= 0.0)
      return 0;

   double balance =
      AccountInfoDouble(
         ACCOUNT_BALANCE
      );

   if(balance <= 0.0)
      return 0;

   //---------------------------------------------------------------
   // EXPOSURE LIMIT
   //---------------------------------------------------------------

   int exposureLimit = 1000000;

   if(
      MaximumEAExposureLots >
      0.0
   )
   {
      exposureLimit =
         (int)MathFloor(
            MaximumEAExposureLots /
            volume
         );
   }

   if(exposureLimit < 1)
      return 0;

   //---------------------------------------------------------------
   // MARGIN LIMIT
   //---------------------------------------------------------------

   double price =
      buy
      ? SymbolInfoDouble(
           Sym(),
           SYMBOL_ASK
        )
      : SymbolInfoDouble(
           Sym(),
           SYMBOL_BID
        );

   ENUM_ORDER_TYPE orderType =
      buy
      ? ORDER_TYPE_BUY
      : ORDER_TYPE_SELL;

   double marginPerPosition =
      0.0;

   if(
      !OrderCalcMargin(
         orderType,
         Sym(),
         volume,
         price,
         marginPerPosition
      )
   )
   {
      Print(
         "CRT AI BOT: Margin calculation failed. Error=",
         GetLastError()
      );

      return exposureLimit;
   }

   if(marginPerPosition <= 0.0)
      return exposureLimit;

   double maximumMargin =
      balance *
      MaximumBalanceMarginPercent /
      100.0;

   int marginLimit =
      (int)MathFloor(
         maximumMargin /
         marginPerPosition
      );

   if(marginLimit < 1)
      return 0;

   int limit =
      MathMin(
         exposureLimit,
         marginLimit
      );

   //---------------------------------------------------------------
   // OPTIONAL POSITION LIMIT
   //---------------------------------------------------------------

   if(
      MaximumOpenPositions >
      0
   )
   {
      int remaining =
         MaximumOpenPositions -
         CountPositions();

      limit =
         MathMin(
            limit,
            remaining
         );
   }

   //---------------------------------------------------------------
   // ORDERS PER SIGNAL
   //---------------------------------------------------------------

   if(
      OrdersPerSignal >
      0
   )
   {
      limit =
         MathMin(
            limit,
            OrdersPerSignal
         );
   }

   return limit;
}

//==================================================================
// OPEN ONE TRADE
//==================================================================

bool OpenOne(
   bool buy,
   double volume
)
{
   if(volume <= 0.0)
      return false;

   if(!tradingEnabled)
      return false;

   if(tradingLocked)
      return false;

   trade.SetExpertMagicNumber(
      MagicNumber
   );

   trade.SetDeviationInPoints(
      SlippagePoints
   );

   double pip =
      PipSize(
         Sym()
      );

   double price =
      buy
      ? SymbolInfoDouble(
           Sym(),
           SYMBOL_ASK
        )
      : SymbolInfoDouble(
           Sym(),
           SYMBOL_BID
        );

   double sl = 0.0;
   double tp = 0.0;

   //---------------------------------------------------------------
   // OPTIONAL STOP LOSS
   //---------------------------------------------------------------

   if(
      StopLossPips > 0.0 &&
      pip > 0.0
   )
   {
      if(buy)
         sl =
            price -
            StopLossPips *
            pip;
      else
         sl =
            price +
            StopLossPips *
            pip;
   }

   //---------------------------------------------------------------
   // OPTIONAL TAKE PROFIT
   //---------------------------------------------------------------

   if(
      TakeProfitPips > 0.0 &&
      pip > 0.0
   )
   {
      if(buy)
         tp =
            price +
            TakeProfitPips *
            pip;
      else
         tp =
            price -
            TakeProfitPips *
            pip;
   }

   bool result = false;

   //---------------------------------------------------------------
   // BUY
   //---------------------------------------------------------------

   if(buy)
   {
      result =
         trade.Buy(
            volume,
            Sym(),
            0.0,
            sl,
            tp,
            "CRT AI BUY"
         );
   }

   //---------------------------------------------------------------
   // SELL
   //---------------------------------------------------------------

   else
   {
      result =
         trade.Sell(
            volume,
            Sym(),
            0.0,
            sl,
            tp,
            "CRT AI SELL"
         );
   }

   if(!result)
   {
      Print(
         "CRT AI BOT: Order failed. Retcode=",
         trade.ResultRetcode(),
         " ",
         trade.ResultRetcodeDescription()
      );

      return false;
   }

   Print(
      "CRT AI BOT: ",
      buy ? "BUY" : "SELL",
      " opened | Lot=",
      DoubleToString(
         volume,
         3
      )
   );

   return true;
}

//==================================================================
// OPEN CURRENT SIGNAL
//==================================================================

void OpenCurrentDirection(
   int direction
)
{
   if(direction == 0)
      return;

   if(!tradingEnabled)
      return;

   if(tradingLocked)
      return;

   //---------------------------------------------------------------
   // DO NOT OPEN WHILE AN OLD BASKET EXISTS
   //---------------------------------------------------------------

   if(CountPositions() > 0)
      return;

   double volume =
      CalculateDynamicLot();

   if(volume <= 0.0)
      return;

   //---------------------------------------------------------------
   // APPLY EXPOSURE LIMIT
   //---------------------------------------------------------------

   if(
      MaximumEAExposureLots >
      0.0 &&
      volume >
      MaximumEAExposureLots
   )
   {
      volume =
         MaximumEAExposureLots;
   }

   volume =
      NormalizeVolume(
         Sym(),
         volume
      );

   if(volume <= 0.0)
      return;

   bool buy =
      direction > 0;

   //---------------------------------------------------------------
   // CALCULATE HOW MANY POSITIONS
   // CAN BE HELD USING 50% MARGIN LIMIT
   //---------------------------------------------------------------

   int positionsAllowed =
      CalculateAutomaticPositionLimit(
         buy,
         volume
      );

   if(positionsAllowed <= 0)
   {
      Print(
         "CRT AI BOT: No positions allowed by margin/exposure limits."
      );

      return;
   }

   int opened = 0;

   for(
      int i = 0;
      i < positionsAllowed;
      i++
   )
   {
      if(!tradingEnabled)
         break;

      if(tradingLocked)
         break;

      if(
         MaximumEAExposureLots >
         0.0 &&
         TotalLots() +
         volume >
         MaximumEAExposureLots +
         0.0000001
      )
      {
         break;
      }

      if(
         OpenOne(
            buy,
            volume
         )
      )
      {
         opened++;
      }
      else
      {
         break;
      }
   }

   Print(
      "CRT AI BOT: ",
      buy ? "BUY" : "SELL",
      " basket opened. Positions=",
      opened
   );
}

//==================================================================
// PROFIT PROTECTION
//==================================================================

void ManageProfitProtection()
{
   int positions =
      CountPositions();

   //---------------------------------------------------------------
   // NO POSITIONS
   //---------------------------------------------------------------

   if(positions <= 0)
   {
      protectionActive = false;

      peakBasketProfit = 0.0;

      return;
   }

   double currentProfit =
      BasketProfit();

   //---------------------------------------------------------------
   // NEVER PROTECT A LOSING BASKET
   //---------------------------------------------------------------

   if(
      currentProfit <
      MinimumProfitToProtect
   )
   {
      return;
   }

   //---------------------------------------------------------------
   // FIRST PROFIT
   //---------------------------------------------------------------

   if(!protectionActive)
   {
      protectionActive = true;

      peakBasketProfit =
         currentProfit;

      Print(
         "CRT AI BOT: Profit protection activated. Peak=$",
         DoubleToString(
            peakBasketProfit,
            2
         )
      );

      return;
   }

   //---------------------------------------------------------------
   // NEW PROFIT HIGH
   //---------------------------------------------------------------

   if(
      currentProfit >
      peakBasketProfit
   )
   {
      peakBasketProfit =
         currentProfit;

      return;
   }

   //---------------------------------------------------------------
   // CALCULATE 2% RETRACEMENT
   //---------------------------------------------------------------

   double retracement =
      peakBasketProfit *
      ProfitRetracementPercent /
      100.0;

   double protectionLevel =
      peakBasketProfit -
      retracement;

   //---------------------------------------------------------------
   // CLOSE ONLY AFTER PROFIT RETRACES 2%
   //---------------------------------------------------------------

   if(
      currentProfit >=
      MinimumProfitToProtect &&
      currentProfit <=
      protectionLevel
   )
   {
      Print(
         "CRT AI BOT: 2% PROFIT RETRACEMENT DETECTED. ",
         "Peak=$",
         DoubleToString(
            peakBasketProfit,
            2
         ),
         " Current=$",
         DoubleToString(
            currentProfit,
            2
         )
      );

      if(
         CloseAll(
            "2% PROFIT RETRACEMENT"
         )
      )
      {
         //--------------------------------------------------------
         // AFTER PROFITABLE CLOSE, IMMEDIATELY SCAN
         // THE CURRENT FORMING M1 CANDLE.
         //--------------------------------------------------------

         if(
            tradingEnabled &&
            !tradingLocked &&
            CountPositions() == 0
         )
         {
            ScanCurrentCandle();

            int direction =
               GetSignalDirection();

            if(direction != 0)
            {
               OpenCurrentDirection(
                  direction
               );
            }
         }
      }
   }
}

//==================================================================
// NEW M1 CANDLE CHECK
//==================================================================

bool IsNewM1Candle()
{
   MqlRates rates[];

   ArraySetAsSeries(
      rates,
      true
   );

   if(
      CopyRates(
         Sym(),
         PERIOD_M1,
         0,
         1,
         rates
      ) != 1
   )
   {
      return false;
   }

   datetime currentCandle =
      rates[0].time;

   if(
      lastProcessedCandle == 0
   )
   {
      lastProcessedCandle =
         currentCandle;

      return true;
   }

   if(
      currentCandle !=
      lastProcessedCandle
   )
   {
      lastProcessedCandle =
         currentCandle;

      return true;
   }

   return false;
}

//==================================================================
// FLIPPING MANAGER
//==================================================================

void ManageFlipping()
{
   if(!tradingEnabled)
      return;

   if(tradingLocked)
      return;

   if(closingBasket)
      return;

   //---------------------------------------------------------------
   // NO POSITION = SCAN CURRENT CANDLE
   //---------------------------------------------------------------

   if(CountPositions() == 0)
   {
      ScanCurrentCandle();

      int direction =
         GetSignalDirection();

      if(direction != 0)
      {
         OpenCurrentDirection(
            direction
         );
      }

      return;
   }

   //---------------------------------------------------------------
   // EXISTING POSITION = PROFIT PROTECTION
   //---------------------------------------------------------------

   ManageProfitProtection();
}
