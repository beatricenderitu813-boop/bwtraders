//==================================================================
// CLOSE ALL EA POSITIONS
//==================================================================

bool CloseAll(string reason)
{
   Print(
      "CRT AI BOT closing positions: ",
      reason
   );

   bool allClosed = true;

   string s = Sym();

   for(
      int i = PositionsTotal() - 1;
      i >= 0;
      i--
   )
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      if(
         PositionGetString(
            POSITION_SYMBOL
         ) != s
      )
      {
         continue;
      }

      if(
         (ulong)PositionGetInteger(
            POSITION_MAGIC
         ) != MagicNumber
      )
      {
         continue;
      }

      if(
         !trade.PositionClose(ticket)
      )
      {
         allClosed = false;

         Print(
            "Close failed #",
            ticket,
            " ",
            trade.ResultRetcodeDescription()
         );
      }
   }

   return allClosed;
}

//==================================================================
// UPDATE DAY
//==================================================================

void UpdateDay()
{
   MqlDateTime tm;

   TimeToStruct(
      TimeCurrent(),
      tm
   );

   if(savedDay != tm.day)
   {
      savedDay = tm.day;

      dayStartEquity =
         AccountInfoDouble(
            ACCOUNT_EQUITY
         );

      consecutiveLosses = 0;

      tradingLocked = false;
   }
}

//==================================================================
// RISK CHECK
//==================================================================

bool RiskOK()
{
   UpdateDay();

   if(tradingLocked)
      return false;

   double equity =
      AccountInfoDouble(
         ACCOUNT_EQUITY
      );

   double balance =
      AccountInfoDouble(
         ACCOUNT_BALANCE
      );

   //--------------------------------------------------------------
   // DAILY LOSS
   //--------------------------------------------------------------

   if(
      DailyLossLimitPercent > 0 &&
      dayStartEquity > 0
   )
   {
      double lossPercent =
         (
            dayStartEquity - equity
         )
         /
         dayStartEquity
         *
         100.0;

      if(
         lossPercent >=
         DailyLossLimitPercent
      )
      {
         tradingLocked = true;

         CloseAll(
            "DAILY LOSS LIMIT"
         );

         UpdateStatus();

         return false;
      }
   }

   //--------------------------------------------------------------
   // DRAWDOWN
   //--------------------------------------------------------------

   if(
      MaximumDrawdownPercent > 0 &&
      balance > 0
   )
   {
      double drawdown =
         (
            balance - equity
         )
         /
         balance
         *
         100.0;

      if(
         drawdown >=
         MaximumDrawdownPercent
      )
      {
         tradingLocked = true;

         CloseAll(
            "MAXIMUM DRAWDOWN"
         );

         UpdateStatus();

         return false;
      }
   }

   //--------------------------------------------------------------
   // CONSECUTIVE LOSSES
   //--------------------------------------------------------------

   if(
      MaximumConsecutiveLosses > 0 &&
      consecutiveLosses >=
      MaximumConsecutiveLosses
   )
   {
      tradingLocked = true;

      UpdateStatus();

      return false;
   }

   return true;
}

//==================================================================
// CURRENT M1 CANDLE DIRECTION
//==================================================================

// Returns:
//  1 = bullish
// -1 = bearish
//  0 = doji

int CurrentCandleDirection()
{
   string s = Sym();

   MqlRates rates[];

   ArraySetAsSeries(
      rates,
      true
   );

   if(
      CopyRates(
         s,
         PERIOD_M1,
         0,
         1,
         rates
      ) < 1
   )
   {
      return 0;
   }

   // rates[0] is the CURRENT FORMING M1 candle.

   if(
      rates[0].close >
      rates[0].open
   )
   {
      return 1;
   }

   if(
      rates[0].close <
      rates[0].open
   )
   {
      return -1;
   }

   return 0;
}

//==================================================================
// CALCULATE AUTOMATIC POSITION CAP
//==================================================================

// Calculates how many lots/positions can be opened while using
// no more than MaximumBalanceMarginPercent of account balance
// as estimated margin.
//
// The calculation uses the broker's actual OrderCalcMargin()
// function for the current symbol and direction.

int CalculateAutomaticPositionLimit(
   bool buy,
   double volume
)
{
   if(volume <= 0)
      return 0;

   string s = Sym();

   double balance =
      AccountInfoDouble(
         ACCOUNT_BALANCE
      );

   if(balance <= 0)
      return 0;

   double allowedMargin =
      balance *
      MaximumBalanceMarginPercent /
      100.0;

   if(allowedMargin <= 0)
      return 0;

   double price;

   if(buy)
   {
      price =
         SymbolInfoDouble(
            s,
            SYMBOL_ASK
         );
   }
   else
   {
      price =
         SymbolInfoDouble(
            s,
            SYMBOL_BID
         );
   }

   if(price <= 0)
      return 0;

   double marginOneTrade = 0;

   ENUM_ORDER_TYPE orderType;

   if(buy)
      orderType = ORDER_TYPE_BUY;
   else
      orderType = ORDER_TYPE_SELL;

   if(
      !OrderCalcMargin(
         orderType,
         s,
         volume,
         price,
         marginOneTrade
      )
   )
   {
      Print(
         "OrderCalcMargin failed. Error = ",
         GetLastError()
      );

      return 0;
   }

   if(marginOneTrade <= 0)
      return 0;

   //--------------------------------------------------------------
   // Account margin already being used by this EA is included
   // through the remaining balance available for this allocation.
   //--------------------------------------------------------------

   double existingMargin = 0;

   for(
      int i = PositionsTotal() - 1;
      i >= 0;
      i--
   )
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      if(
         PositionGetString(
            POSITION_SYMBOL
         ) != s
      )
      {
         continue;
      }

      if(
         (ulong)PositionGetInteger(
            POSITION_MAGIC
         ) != MagicNumber
      )
      {
         continue;
      }

      existingMargin +=
         PositionGetDouble(
            POSITION_MARGIN
         );
   }

   //--------------------------------------------------------------
   // Some MT5 environments may not provide POSITION_MARGIN.
   // If unavailable/zero, estimate existing margin from volume.
   //--------------------------------------------------------------

   if(existingMargin < 0)
      existingMargin = 0;

   double remainingMargin =
      allowedMargin -
      existingMargin;

   if(remainingMargin <= 0)
      return 0;

   int possible =
      (int)MathFloor(
         remainingMargin /
         marginOneTrade
      );

   //--------------------------------------------------------------
   // Apply the EA's maximum lot exposure.
   //--------------------------------------------------------------

   if(MaximumEAExposureLots > 0)
   {
      double existingLots =
         TotalLots();

      double remainingLots =
         MaximumEAExposureLots -
         existingLots;

      if(remainingLots <= 0)
         return 0;

      int byLots =
         (int)MathFloor(
            remainingLots /
            volume
         );

      possible =
         MathMin(
            possible,
            byLots
         );
   }

   return MathMax(
      possible,
      0
   );
}

//==================================================================
// OPEN ONE TRADE
//==================================================================

bool OpenOne(
   bool buy,
   double volume
)
{
   string s = Sym();

   double ask =
      SymbolInfoDouble(
         s,
         SYMBOL_ASK
      );

   double bid =
      SymbolInfoDouble(
         s,
         SYMBOL_BID
      );

   double pip =
      PipSize(s);

   int digits =
      (int)SymbolInfoInteger(
         s,
         SYMBOL_DIGITS
      );

   if(
      ask <= 0 ||
      bid <= 0
   )
   {
      return false;
   }

   double sl = 0;
   double tp = 0;

   //--------------------------------------------------------------
   // STOP LOSS
   //--------------------------------------------------------------

   if(
      StopLossPips > 0 &&
      pip > 0
   )
   {
      if(buy)
      {
         sl =
            NormalizeDouble(
               ask -
               StopLossPips * pip,
               digits
            );
      }
      else
      {
         sl =
            NormalizeDouble(
               bid +
               StopLossPips * pip,
               digits
            );
      }
   }

   //--------------------------------------------------------------
   // TAKE PROFIT
   //--------------------------------------------------------------

   if(
      TakeProfitPips > 0 &&
      pip > 0
   )
   {
      if(buy)
      {
         tp =
            NormalizeDouble(
               ask +
               TakeProfitPips * pip,
               digits
            );
      }
      else
      {
         tp =
            NormalizeDouble(
               bid -
               TakeProfitPips * pip,
               digits
            );
      }
   }

   //--------------------------------------------------------------
   // TRADE SETTINGS
   //--------------------------------------------------------------

   trade.SetExpertMagicNumber(
      MagicNumber
   );

   trade.SetDeviationInPoints(
      SlippagePoints
   );

   bool result = false;

   //--------------------------------------------------------------
   // BUY
   //--------------------------------------------------------------

   if(buy)
   {
      result =
         trade.Buy(
            volume,
            s,
            0,
            sl,
            tp,
            "CRT M1 FLIP BUY"
         );
   }

   //--------------------------------------------------------------
   // SELL
   //--------------------------------------------------------------

   else
   {
      result =
         trade.Sell(
            volume,
            s,
            0,
            sl,
            tp,
            "CRT M1 FLIP SELL"
         );
   }

   //--------------------------------------------------------------
   // RESULT
   //--------------------------------------------------------------

   if(!result)
   {
      Print(
         "Order failed: ",
         trade.ResultRetcode(),
         " ",
         trade.ResultRetcodeDescription()
      );

      return false;
   }

   Print(
      "CRT AI BOT opened ",
      buy ? "BUY" : "SELL",
      " | Lot = ",
      DoubleToString(
         volume,
         2
      )
   );

   return true;//==================================================================
// OPEN CURRENT DIRECTION
//==================================================================

void OpenCurrentDirection(
   int direction
)
{
   if(direction == 0)
      return;

   if(!tradingEnabled)
      return;

   if(!RiskOK())
      return;

   string s = Sym();

   if(!SymbolSelect(s,true))
   {
      Print(
         "Cannot select symbol ",
         s
      );

      return;
   }

   //--------------------------------------------------------------
   // CALCULATE DYNAMIC LOT
   //--------------------------------------------------------------

   double volume =
      CalculateDynamicLot();

   if(volume <= 0)
   {
      Print(
         "Dynamic lot calculation returned 0."
      );

      return;
   }

   //--------------------------------------------------------------
   // BUY / SELL
   //--------------------------------------------------------------

   bool buy =
      direction == 1;

   //--------------------------------------------------------------
   // AUTOMATIC POSITION CALCULATION
   //--------------------------------------------------------------

   int automaticPositions =
      CalculateAutomaticPositionLimit(
         buy,
         volume
      );

   if(automaticPositions <= 0)
   {
      Print(
         "No position available within the 50% balance margin limit."
      );

      return;
   }

   //--------------------------------------------------------------
   // EXISTING POSITIONS
   //--------------------------------------------------------------

   int currentPositions =
      CountPositions();

   //--------------------------------------------------------------
   // MAXIMUM OPEN POSITION LIMIT
   //
   // If MaximumOpenPositions = 0,
   // use the automatically calculated limit.
   //--------------------------------------------------------------

   int maximumPositions =
      automaticPositions;

   if(MaximumOpenPositions > 0)
   {
      maximumPositions =
         MathMin(
            MaximumOpenPositions,
            automaticPositions
         );
   }

   if(
      currentPositions >=
      maximumPositions
   )
   {
      return;
   }

   //--------------------------------------------------------------
   // AVAILABLE SLOTS
   //--------------------------------------------------------------

   int availableSlots =
      maximumPositions -
      currentPositions;

   //--------------------------------------------------------------
   // ORDERS PER SIGNAL
   //
   // If OrdersPerSignal = 0,
   // fill all available automatic slots.
   //--------------------------------------------------------------

   int orders;

   if(OrdersPerSignal <= 0)
   {
      orders = availableSlots;
   }
   else
   {
      orders =
         MathMin(
            OrdersPerSignal,
            availableSlots
         );
   }

   if(orders <= 0)
      return;

   //--------------------------------------------------------------
   // OPEN MULTIPLE POSITIONS
   //--------------------------------------------------------------

   for(
      int i = 0;
      i < orders;
      i++
   )
   {
      if(!tradingEnabled)
         break;

      if(!RiskOK())
         break;

      //-----------------------------------------------------------
      // Recalculate automatic capacity before every order.
      //-----------------------------------------------------------

      int remainingCapacity =
         CalculateAutomaticPositionLimit(
            buy,
            volume
         );

      if(remainingCapacity <= 0)
      {
         Print(
            "50% balance margin allocation reached."
         );

         break;
      }

      //-----------------------------------------------------------
      // Maximum EA exposure
      //-----------------------------------------------------------

      if(
         MaximumEAExposureLots > 0 &&
         TotalLots() +
         volume >
         MaximumEAExposureLots +
         1e-9
      )
      {
         Print(
            "EA exposure limit reached."
         );

         break;
      }

      //-----------------------------------------------------------
      // Open trade
      //-----------------------------------------------------------

      OpenOne(
         buy,
         volume
      );
   }
}

//==================================================================
// MANAGE FLIPPING
//==================================================================

void ManageFlipping()
{
   if(!tradingEnabled)
      return;

   if(tradingLocked)
      return;

   int direction =
      CurrentCandleDirection();

   //--------------------------------------------------------------
   // DOJI / NO CLEAR DIRECTION
   //--------------------------------------------------------------

   if(direction == 0)
      return;

   //--------------------------------------------------------------
   // NO POSITION
   //--------------------------------------------------------------

   if(CountPositions() == 0)
   {
      OpenCurrentDirection(
         direction
      );

      return;
   }

   //--------------------------------------------------------------
   // CHECK EXISTING POSITIONS
   //--------------------------------------------------------------

   string s = Sym();

   bool oppositeDetected = false;
   bool profitableTradeDetected = false;

   for(
      int i = PositionsTotal() - 1;
      i >= 0;
      i--
   )
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      if(
         PositionGetString(
            POSITION_SYMBOL
         ) != s
      )
      {
         continue;
      }

      if(
         (ulong)PositionGetInteger(
            POSITION_MAGIC
         ) != MagicNumber
      )
      {
         continue;
      }

      //-----------------------------------------------------------
      // POSITION DIRECTION
      //-----------------------------------------------------------

      long positionType =
         PositionGetInteger(
            POSITION_TYPE
         );

      bool positionBuy =
         positionType ==
         POSITION_TYPE_BUY;

      //-----------------------------------------------------------
      // POSITION PROFIT
      //-----------------------------------------------------------

      double profit =
         PositionGetDouble(
            POSITION_PROFIT
         );

      profit +=
         PositionGetDouble(
            POSITION_SWAP
         );

      //-----------------------------------------------------------
      // CHECK PROFIT
      //-----------------------------------------------------------

      if(
         profit >=
         MinimumProfitToProtect
      )
      {
         profitableTradeDetected = true;

         //--------------------------------------------------------
         // CURRENT CANDLE OPPOSITE?
         //--------------------------------------------------------

         if(
            positionBuy &&
            direction == -1
         )
         {
            oppositeDetected = true;
         }

         if(
            !positionBuy &&
            direction == 1
         )
         {
            oppositeDetected = true;
         }
      }
   }

   //--------------------------------------------------------------
   // FLIP WHEN PROFITABLE REVERSAL IS DETECTED
   //--------------------------------------------------------------

   if(
      profitableTradeDetected &&
      oppositeDetected
   )
   {
      Print(
         "PROFITABLE M1 REVERSAL DETECTED"
      );

      bool closed =
         CloseAll(
            "PROFITABLE M1 REVERSAL"
         );

      if(closed)
      {
         //---------------------------------------------------------
         // IMMEDIATE RE-ENTRY
         //
         // No waiting for candle close.
         // The CURRENT forming M1 candle direction is used.
         //---------------------------------------------------------

         if(
            CountPositions() == 0 &&
            tradingEnabled &&
            RiskOK()
         )
         {
            int currentDirection =
               CurrentCandleDirection();

            if(currentDirection != 0)
            {
               OpenCurrentDirection(
                  currentDirection
               );
            }
         }
      }
   }
}

//==================================================================
// UPDATE STATUS
//==================================================================

void UpdateStatus()
{
   string status;

   if(tradingLocked)
   {
      status = "LOCKED";
   }
   else if(tradingEnabled)
   {
      status = "RUNNING";
   }
   else
   {
      status = "STOPPED";
   }

   if(ObjectFind(0,STATUS_LABEL) >= 0)
   {
      ObjectSetString(
         0,
         STATUS_LABEL,
         OBJPROP_TEXT,
         "CRT AI BOT: " + status
      );
   }
}

//==================================================================
// CREATE START / STOP BUTTON
//==================================================================

void CreateButton(
   string name,
   string text,
   int x,
   int y
)
{
   if(ObjectFind(0,name) >= 0)
      ObjectDelete(0,name);

   ObjectCreate(
      0,
      name,
      OBJ_BUTTON,
      0,
      0,
      0
   );

   ObjectSetInteger(
      0,
      name,
      OBJPROP_CORNER,
      CORNER_LEFT_UPPER
   );

   ObjectSetInteger(
      0,
      name,
      OBJPROP_XDISTANCE,
      x
   );

   ObjectSetInteger(
      0,
      name,
      OBJPROP_YDISTANCE,
      y
   );

   ObjectSetInteger(
      0,
      name,
      OBJPROP_XSIZE,
      80
   );

   ObjectSetInteger(
      0,
      name,
      OBJPROP_YSIZE,
      30
   );

   ObjectSetString(
      0,
      name,
      OBJPROP_TEXT,
      text
   );

   ObjectSetInteger(
      0,
      name,
      OBJPROP_FONTSIZE,
      10
   );
}

//==================================================================
// INITIALIZATION
//==================================================================

int OnInit()
{
   if(!SymbolSelect(Sym(),true))
   {
      Print(
         "Cannot select symbol ",
         Sym()
      );

      return INIT_FAILED;
   }

   trade.SetExpertMagicNumber(
      MagicNumber
   );

   trade.SetDeviationInPoints(
      SlippagePoints
   );

   UpdateDay();

   CreateButton(
      START_BUTTON,
      "START",
      10,
      20
   );

   CreateButton(
      STOP_BUTTON,
      "STOP",
      100,
      20
