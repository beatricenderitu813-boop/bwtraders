//==================================================================
// CHART BUTTON EVENTS
//==================================================================

void OnChartEvent(
   const int id,
   const long &lparam,
   const double &dparam,
   const string &sparam
)
{
   if(
      id !=
      CHARTEVENT_OBJECT_CLICK
   )
   {
      return;
   }

   //---------------------------------------------------------------
   // START
   //---------------------------------------------------------------

   if(
      sparam ==
      START_BUTTON
   )
   {
      if(tradingLocked)
      {
         Print(
            "CRT AI BOT: START blocked. ",
            "Risk protection is active."
         );

         return;
      }

      tradingEnabled = true;

      reentryPending = false;

      Print(
         "CRT AI BOT: START PRESSED."
      );

      //------------------------------------------------------------
      // IMMEDIATE CURRENT M1 SCAN
      //------------------------------------------------------------

      ScanCurrentCandle();

      int direction =
         GetSignalDirection();

      if(
         direction != 0 &&
         CountPositions() == 0
      )
      {
         OpenCurrentDirection(
            direction
         );
      }
      else
      {
         Print(
            "CRT AI BOT: STARTED but no qualifying ",
            "55%+ signal at this tick."
         );
      }

      UpdateStatus();

      return;
   }

   //---------------------------------------------------------------
   // STOP
   //---------------------------------------------------------------

   if(
      sparam ==
      STOP_BUTTON
   )
   {
      tradingEnabled = false;

      Print(
         "CRT AI BOT: STOP PRESSED."
      );

      CloseAll(
         "MANUAL STOP"
      );

      UpdateStatus();

      return;
   }
}

//==================================================================
// TRADE TRANSACTION
//==================================================================

void OnTradeTransaction(
   const MqlTradeTransaction &trans,
   const MqlTradeRequest &request,
   const MqlTradeResult &result
)
{
   if(
      trans.type !=
      TRADE_TRANSACTION_DEAL_ADD
   )
   {
      return;
   }

   if(trans.deal == 0)
      return;

   if(
      !HistoryDealSelect(
         trans.deal
      )
   )
   {
      return;
   }

   //---------------------------------------------------------------
   // ONLY EXIT DEALS
   //---------------------------------------------------------------

   long entry =
      HistoryDealGetInteger(
         trans.deal,
         DEAL_ENTRY
      );

   if(
      entry != DEAL_ENTRY_OUT &&
      entry != DEAL_ENTRY_OUT_BY
   )
   {
      return;
   }

   //---------------------------------------------------------------
   // MAGIC
   //---------------------------------------------------------------

   long magic =
      HistoryDealGetInteger(
         trans.deal,
         DEAL_MAGIC
      );

   if(
      (ulong)magic !=
      MagicNumber
   )
   {
      return;
   }

   //---------------------------------------------------------------
   // SYMBOL
   //---------------------------------------------------------------

   string symbol =
      HistoryDealGetString(
         trans.deal,
         DEAL_SYMBOL
      );

   if(
      symbol !=
      Sym()
   )
   {
      return;
   }

   //---------------------------------------------------------------
   // NET RESULT
   //---------------------------------------------------------------

   double profit =
      HistoryDealGetDouble(
         trans.deal,
         DEAL_PROFIT
      );

   double swap =
      HistoryDealGetDouble(
         trans.deal,
         DEAL_SWAP
      );

   double commission =
      HistoryDealGetDouble(
         trans.deal,
         DEAL_COMMISSION
      );

   double netProfit =
      profit +
      swap +
      commission;

   //---------------------------------------------------------------
   // LOSS
   //---------------------------------------------------------------

   if(netProfit < 0.0)
   {
      consecutiveLosses++;

      Print(
         "CRT AI BOT: Losing deal. ",
         "Consecutive losses=",
         consecutiveLosses
      );
   }

   //---------------------------------------------------------------
   // PROFIT
   //---------------------------------------------------------------

   else
   if(netProfit > 0.0)
   {
      consecutiveLosses = 0;

      Print(
         "CRT AI BOT: Profitable deal. ",
         "Consecutive losses reset."
      );
   }

   //---------------------------------------------------------------
   // MAX CONSECUTIVE LOSSES
   //---------------------------------------------------------------

   if(
      MaximumConsecutiveLosses > 0 &&
      consecutiveLosses >=
      MaximumConsecutiveLosses
   )
   {
      tradingLocked = true;

      tradingEnabled = false;

      CloseAll(
         "MAXIMUM CONSECUTIVE LOSSES"
      );

      Print(
         "CRT AI BOT: LOCKED BY MAXIMUM ",
         "CONSECUTIVE LOSSES."
      );
   }
}

