//==================================================================
// CLOSE ALL
//==================================================================

bool CloseAll(string reason)
{
   Print(
      "CRT AI BOT closing basket: ",
      reason
   );

   closingBasket = true;

   bool allClosed = true;

   string s = Sym();

   for(
      int i = PositionsTotal() - 1;
      i >= 0;
      i--
   )
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      if(
         PositionGetString(
            POSITION_SYMBOL
         ) != s
      )
      {
         continue;
      }

      if(
         (ulong)PositionGetInteger(
            POSITION_MAGIC
         ) != MagicNumber
      )
      {
         continue;
      }

      if(
         !trade.PositionClose(ticket)
      )
      {
         allClosed = false;

         Print(
            "Close failed #",
            ticket,
            " ",
            trade.ResultRetcodeDescription()
         );
      }
   }

   if(CountPositions() == 0)
   {
      protectionActive = false;
      peakPrice = 0.0;
   }

   return allClosed;
}

//==================================================================
// UPDATE DAY
//==================================================================

void UpdateDay()
{
   MqlDateTime tm;

   TimeToStruct(
      TimeCurrent(),
      tm
   );

   if(savedDay != tm.day)
   {
      savedDay = tm.day;

      dayStartEquity =
         AccountInfoDouble(
            ACCOUNT_EQUITY
         );

      consecutiveLosses = 0;

      tradingLocked = false;

      protectionActive = false;

      peakPrice = 0.0;
   }
}

//==================================================================
// STATUS
//==================================================================

void UpdateStatus()
{
   if(ObjectFind(0,STATUS_LABEL) < 0)
      return;

   string status;

   if(tradingLocked)
      status = "LOCKED";
   else if(tradingEnabled)
      status = "RUNNING";
   else
      status = "STOPPED";

   ObjectSetString(
      0,
      STATUS_LABEL,
      OBJPROP_TEXT,
      "CRT AI BOT: " + status
   );
}

//==================================================================
// RISK CHECK
//==================================================================

bool RiskOK()
{
   UpdateDay();

   if(tradingLocked)
      return false;

   double equity =
      AccountInfoDouble(
         ACCOUNT_EQUITY
      );

   double balance =
      AccountInfoDouble(
         ACCOUNT_BALANCE
      );

   //--------------------------------------------------------------
   // DAILY LOSS
   //--------------------------------------------------------------

   if(
      DailyLossLimitPercent > 0 &&
      dayStartEquity > 0
   )
   {
      double lossPercent =
         (
            dayStartEquity - equity
         )
         /
         dayStartEquity
         *
         100.0;

      if(
         lossPercent >=
         DailyLossLimitPercent
      )
      {
         tradingLocked = true;

         CloseAll(
            "DAILY LOSS LIMIT"
         );

         UpdateStatus();

         return false;
      }
   }

   //--------------------------------------------------------------
   // DRAWDOWN
   //--------------------------------------------------------------

   if(
      MaximumDrawdownPercent > 0 &&
      balance > 0
   )
   {
      double drawdown =
         (
            balance - equity
         )
         /
         balance
         *
         100.0;

      if(
         drawdown >=
         MaximumDrawdownPercent
      )
      {
         tradingLocked = true;

         CloseAll(
            "MAXIMUM DRAWDOWN"
         );

         UpdateStatus();

         return false;
      }
   }

   //--------------------------------------------------------------
   // CONSECUTIVE LOSSES
   //--------------------------------------------------------------

   if(
      MaximumConsecutiveLosses > 0 &&
      consecutiveLosses >=
      MaximumConsecutiveLosses
   )
   {
      tradingLocked = true;

      UpdateStatus();

      return false;
   }

   return true;
}

//==================================================================
// CURRENT FORMING M1 CANDLE
//==================================================================

int CurrentCandleDirection()
{
   string s = Sym();

   MqlRates rates[];

   ArraySetAsSeries(
      rates,
      true
   );

   if(
      CopyRates(
         s,
         PERIOD_M1,
         0,
         1,
         rates
      ) < 1
   )
   {
      return 0;
   }

   // IMPORTANT:
   // rates[0] is the CURRENT FORMING M1 candle.
   // No candle-close waiting.

   if(
      rates[0].close >
      rates[0].open
   )
   {
      return 1;
   }

   if(
      rates[0].close <
      rates[0].open
   )
   {
      return -1;
   }

   return 0;
}

//==================================================================
// AUTOMATIC POSITION CALCULATION
//==================================================================

int CalculateAutomaticPositionLimit(
   bool buy,
   double volume
)
{
   if(volume <= 0)
      return 0;

   string s = Sym();

   double balance =
      AccountInfoDouble(
         ACCOUNT_BALANCE
      );

   if(balance <= 0)
      return 0;

   double allowedMargin =
      balance *
      MaximumBalanceMarginPercent /
      100.0;

   if(allowedMargin <= 0)
      return 0;

   double price;

   if(buy)
   {
      price =
         SymbolInfoDouble(
            s,
            SYMBOL_ASK
         );
   }
   else
   {
      price =
         SymbolInfoDouble(
            s,
            SYMBOL_BID
         );
   }

   if(price <= 0)
      return 0;

   double marginOne =
      0.0;

   ENUM_ORDER_TYPE orderType;

   if(buy)
      orderType = ORDER_TYPE_BUY;
   else
      orderType = ORDER_TYPE_SELL;

   if(
      !OrderCalcMargin(
         orderType,
         s,
         volume,
         price,
         marginOne
      )
   )
   {
      Print(
         "OrderCalcMargin failed. Error=",
         GetLastError()
      );

      return 0;
   }

   if(marginOne <= 0)
      return 0;

   //--------------------------------------------------------------
   // Calculate margin currently used by this EA.
   //--------------------------------------------------------------

   double existingMargin = 0.0;

   for(
      int i = PositionsTotal() - 1;
      i >= 0;
      i--
   )
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      if(
         PositionGetString(
            POSITION_SYMBOL
         ) != s
      )
      {
         continue;
      }

      if(
         (ulong)PositionGetInteger(
            POSITION_MAGIC
         ) != MagicNumber
      )
      {
         continue;
      }

      long type =
         PositionGetInteger(
            POSITION_TYPE
         );

      double posVolume =
         PositionGetDouble(
            POSITION_VOLUME
         );

      ENUM_ORDER_TYPE posOrder;

      if(type == POSITION_TYPE_BUY)
         posOrder = ORDER_TYPE_BUY;
      else
         posOrder = ORDER_TYPE_SELL;

      double posPrice;

      if(type == POSITION_TYPE_BUY)
      {
         posPrice =
            SymbolInfoDouble(
               s,
               SYMBOL_ASK
            );
      }
      else
      {
         posPrice =
            SymbolInfoDouble(
               s,
               SYMBOL_BID
            );
      }

      double posMargin = 0.0;

      if(
         OrderCalcMargin(
            posOrder,
            s,
            posVolume,
            posPrice,
            posMargin
         )
      )
      {
         existingMargin += posMargin;
      }
   }

   double remainingMargin =
      allowedMargin -
      existingMargin;

   if(remainingMargin <= 0)
      return 0;

   int possible =
      (int)MathFloor(
         remainingMargin /
         marginOne
      );

   //--------------------------------------------------------------
   // Apply maximum EA lot exposure.
   //--------------------------------------------------------------

   if(MaximumEAExposureLots > 0)
   {
      double existingLots =
         TotalLots();

      double remainingLots =
         MaximumEAExposureLots -
         existingLots;

      if(remainingLots <= 0)
         return 0;

      int byLots =
         (int)MathFloor(
            remainingLots /
            volume
         );

      possible =
         MathMin(
            possible,
            byLots
         );
   }

   return MathMax(
      possible,
      0
   );
}

//==================================================================
// OPEN ONE
//==================================================================

bool OpenOne(
   bool buy,
   double volume
)
{
   string s = Sym();

   double ask =
      SymbolInfoDouble(
         s,
         SYMBOL_ASK
      );

   double bid =
      SymbolInfoDouble(
         s,
         SYMBOL_BID
      );

   double pip =
      PipSize(s);

   int digits =
      (int)SymbolInfoInteger(
         s,
         SYMBOL_DIGITS
      );

   if(
      ask <= 0 ||
      bid <= 0
   )
   {
      return false;
   }

   double sl = 0;
   double tp = 0;

   //--------------------------------------------------------------
   // SL
   //--------------------------------------------------------------

   if(
      StopLossPips > 0 &&
      pip > 0
   )
   {
      if(buy)
      {
         sl =
            NormalizeDouble(
               ask -
               StopLossPips * pip,
               digits
            );
      }
      else
      {
         sl =
            NormalizeDouble(
               bid +
               StopLossPips * pip,
               digits
            );
      }
   }

   //--------------------------------------------------------------
   // TP
   //--------------------------------------------------------------

   if(
      TakeProfitPips > 0 &&
      pip > 0
   )
   {
      if(buy)
      {
         tp =
            NormalizeDouble(
               ask +
               TakeProfitPips * pip,
               digits
            );
      }
      else
      {
         tp =
            NormalizeDouble(
               bid -
               TakeProfitPips * pip,
               digits
            );
      }
   }

   trade.SetExpertMagicNumber(
      MagicNumber
   );

   trade.SetDeviationInPoints(
      SlippagePoints
   );

   bool result = false;

   if(buy)
   {
      result =
         trade.Buy(
            volume,
            s,
            0,
            sl,
            tp,
            "CRT M1 FLIP BUY"
         );
   }
   else
   {
      result =
         trade.Sell(
            volume,
            s,
            0,
            sl,
            tp,
            "CRT M1 FLIP SELL"
         );
   }

   if(!result)
   {
      Print(
         "Order failed: ",
         trade.ResultRetcode(),
         " ",
         trade.ResultRetcodeDescription()
      );

      return false;
   }

   Print(
      "CRT AI BOT OPENED ",
      buy ? "BUY" : "SELL",
      " | Lot=",
      DoubleToString(
         volume,
         2
      )
   );

   return true;
}//==================================================================
// OPEN CURRENT DIRECTION
//==================================================================

void OpenCurrentDirection(
   int direction
)
{
   if(direction == 0)
      return;

   if(!tradingEnabled)
      return;

   if(tradingLocked)
      return;

   if(!RiskOK())
      return;

   string s = Sym();

   if(!SymbolSelect(s,true))
   {
      Print(
         "Cannot select symbol ",
         s
      );

      return;
   }

   //--------------------------------------------------------------
   // CALCULATE DYNAMIC LOT
   //--------------------------------------------------------------

   double volume =
      CalculateDynamicLot();

   if(volume <= 0)
   {
      Print(
         "Dynamic lot calculation returned 0."
      );

      return;
   }

   bool buy =
      direction == 1;

   //--------------------------------------------------------------
   // AUTOMATIC POSITION CAP
   //--------------------------------------------------------------

   int automaticLimit =
      CalculateAutomaticPositionLimit(
         buy,
         volume
      );

   if(automaticLimit <= 0)
   {
      Print(
         "No available position within the ",
         DoubleToString(
            MaximumBalanceMarginPercent,
            1
         ),
         "% balance margin allocation."
      );

      return;
   }

   //--------------------------------------------------------------
   // CURRENT POSITIONS
   //--------------------------------------------------------------

   int currentPositions =
      CountPositions();

   //--------------------------------------------------------------
   // MAXIMUM POSITION LIMIT
   //--------------------------------------------------------------

   int maximumPositions =
      automaticLimit;

   if(MaximumOpenPositions > 0)
   {
      maximumPositions =
         MathMin(
            MaximumOpenPositions,
            automaticLimit
         );
   }

   if(
      currentPositions >=
      maximumPositions
   )
   {
      return;
   }

   //--------------------------------------------------------------
   // AVAILABLE SLOTS
   //--------------------------------------------------------------

   int availableSlots =
      maximumPositions -
      currentPositions;

   //--------------------------------------------------------------
   // ORDERS PER SIGNAL
   //
   // 0 = fill all available slots.
   //--------------------------------------------------------------

   int orders;

   if(OrdersPerSignal <= 0)
   {
      orders = availableSlots;
   }
   else
   {
      orders =
         MathMin(
            OrdersPerSignal,
            availableSlots
         );
   }

   if(orders <= 0)
      return;

   //--------------------------------------------------------------
   // OPEN POSITIONS
   //--------------------------------------------------------------

   int successfulOrders = 0;

   for(
      int i = 0;
      i < orders;
      i++
   )
   {
      if(!tradingEnabled)
         break;

      if(tradingLocked)
         break;

      if(!RiskOK())
         break;

      //-----------------------------------------------------------
      // Recalculate remaining capacity before each order.
      //-----------------------------------------------------------

      int remainingCapacity =
         CalculateAutomaticPositionLimit(
            buy,
            volume
         );

      if(remainingCapacity <= 0)
      {
         Print(
            "50% balance margin allocation reached."
         );

         break;
      }

      //-----------------------------------------------------------
      // Maximum EA exposure
      //-----------------------------------------------------------

      if(
         MaximumEAExposureLots > 0 &&
         TotalLots() +
         volume >
         MaximumEAExposureLots +
         1e-9
      )
      {
         Print(
            "Maximum EA exposure reached."
         );

         break;
      }

      //-----------------------------------------------------------
      // OPEN
      //-----------------------------------------------------------

      if(
         OpenOne(
            buy,
            volume
         )
      )
      {
         successfulOrders++;
      }
   }

   if(successfulOrders > 0)
   {
      //-----------------------------------------------------------
      // Start profit protection from the current market price.
      //-----------------------------------------------------------

      protectionActive = false;
      peakPrice = 0.0;

      Print(
         "CRT AI BOT opened ",
         successfulOrders,
         " ",
         buy ? "BUY" : "SELL",
         " positions."
      );
   }
}

//==================================================================
// MANAGE PROFIT PROTECTION
//==================================================================

void ManageProfitProtection()
{
   if(!tradingEnabled)
      return;

   if(tradingLocked)
      return;

   if(closingBasket)
      return;

   if(CountPositions() <= 0)
   {
      protectionActive = false;
      peakPrice = 0.0;

      return;
   }

   string s = Sym();

   //--------------------------------------------------------------
   // Determine the basket direction.
   //--------------------------------------------------------------

   bool basketBuy = false;
   bool basketSell = false;

   for(
      int i = PositionsTotal() - 1;
      i >= 0;
      i--
   )
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      if(
         PositionGetString(
            POSITION_SYMBOL
         ) != s
      )
      {
         continue;
      }

      if(
         (ulong)PositionGetInteger(
            POSITION_MAGIC
         ) != MagicNumber
      )
      {
         continue;
      }

      long type =
         PositionGetInteger(
            POSITION_TYPE
         );

      if(type == POSITION_TYPE_BUY)
         basketBuy = true;

      if(type == POSITION_TYPE_SELL)
         basketSell = true;
   }

   //--------------------------------------------------------------
   // Mixed-direction basket.
   //--------------------------------------------------------------

   if(
      basketBuy &&
      basketSell
   )
   {
      protectionActive = false;
      peakPrice = 0.0;

      return;
   }

   //--------------------------------------------------------------
   // Basket must have a direction.
   //--------------------------------------------------------------

   if(
      !basketBuy &&
      !basketSell
   )
   {
      protectionActive = false;
      peakPrice = 0.0;

      return;
   }

   //--------------------------------------------------------------
   // Basket profit.
   //--------------------------------------------------------------

   double profit =
      BasketProfit();

   //--------------------------------------------------------------
   // Protection only activates once the basket is profitable.
   //--------------------------------------------------------------

   if(
      profit <
      MinimumProfitToProtect
   )
   {
      return;
   }

   double pip =
      PipSize(s);

   if(pip <= 0)
      return;

   //--------------------------------------------------------------
   // BUY BASKET
   //
   // Track the highest BID reached after profit protection
   // becomes active.
   //--------------------------------------------------------------

   if(basketBuy)
   {
      double bid =
         SymbolInfoDouble(
            s,
            SYMBOL_BID
         );

      if(bid <= 0)
         return;

      if(!protectionActive)
      {
         protectionActive = true;
         peakPrice = bid;

         Print(
            "Profit protection ACTIVATED for BUY basket."
         );

         return;
      }

      //-----------------------------------------------------------
      // New favorable peak.
      //-----------------------------------------------------------

      if(bid > peakPrice)
      {
         peakPrice = bid;
      }

      //-----------------------------------------------------------
      // 2 PIP RETRACEMENT
      //-----------------------------------------------------------

      double retracement =
         peakPrice -
         bid;

      if(
         retracement >=
         ProfitRetracementPips * pip
      )
      {
         Print(
            "2 PIP PROFIT RETRACEMENT detected on BUY basket."
         );

         bool closed =
            CloseAll(
               "2 PIP PROFIT RETRACEMENT"
            );

         if(closed)
         {
            protectionActive = false;
            peakPrice = 0.0;
            closingBasket = false;

            //-----------------------------------------------------
            // IMMEDIATE RE-ENTRY.
            //
            // Uses CURRENT forming M1 candle.
            // Does NOT wait for candle close.
            //-----------------------------------------------------

            if(
               tradingEnabled &&
               !tradingLocked &&
               CountPositions() == 0
            )
            {
               int direction =
                  CurrentCandleDirection();

               if(direction != 0)
               {
                  OpenCurrentDirection(
                     direction
                  );
               }
            }
         }

         return;
      }
   }

   //--------------------------------------------------------------
   // SELL BASKET
   //
   // Track the lowest ASK reached after profit protection
   // becomes active.
   //--------------------------------------------------------------

   if(basketSell)
   {
      double ask =
         SymbolInfoDouble(
            s,
            SYMBOL_ASK
         );

      if(ask <= 0)
         return;

      if(!protectionActive)
      {
         protectionActive = true;
         peakPrice = ask;

         Print(
            "Profit protection ACTIVATED for SELL basket."
         );

         return;
      }

      //-----------------------------------------------------------
      // New favorable peak for SELL = lower price.
      //-----------------------------------------------------------

      if(ask < peakPrice)
      {
         peakPrice = ask;
      }

      //-----------------------------------------------------------
      // 2 PIP RETRACEMENT
      //-----------------------------------------------------------

      double retracement =
         ask -
         peakPrice;

      if(
         retracement >=
         ProfitRetracementPips * pip
      )
      {
         Print(
            "2 PIP PROFIT RETRACEMENT detected on SELL basket."
         );

         bool closed =
            CloseAll(
               "2 PIP PROFIT RETRACEMENT"
            );

         if(closed)
         {
            protectionActive = false;
            peakPrice = 0.0;
            closingBasket = false;

            //-----------------------------------------------------
            // IMMEDIATE RE-ENTRY.
            //
            // Uses CURRENT forming M1 candle.
            //-----------------------------------------------------

            if(
               tradingEnabled &&
               !tradingLocked &&
               CountPositions() == 0
            )
            {
               int direction =
                  CurrentCandleDirection();

               if(direction != 0)
               {
                  OpenCurrentDirection(
                     direction
                  );
               }
            }
         }

         return;
      }
   }
}

//==================================================================
// MANAGE FLIPPING
//==================================================================

void ManageFlipping()
{
   if(!tradingEnabled)
      return;

   if(tradingLocked)
      return;

   if(closingBasket)
      return;

   //--------------------------------------------------------------
   // If there are no positions, immediately use the current
   // forming M1 candle.
   //--------------------------------------------------------------

   if(CountPositions() == 0)
   {
      int direction =
         CurrentCandleDirection();

      if(direction != 0)
      {
         OpenCurrentDirection(
            direction
         );
      }

      return;
   }

   //--------------------------------------------------------------
   // Profit protection is checked on EVERY incoming tick.
   //
   // Therefore there is NO candle-close waiting.
   //--------------------------------------------------------------

   ManageProfitProtection();
}

