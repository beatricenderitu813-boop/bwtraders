//==================================================================
// OPEN MULTIPLE BUY TRADES
//==================================================================

void OpenBuyBasket()
{
   if(!CanOpenNewTrades())
      return;

   double lot =
      GetTradeLot();

   if(lot <= 0.0)
      return;

   int numberOfTrades =
      CalculateMaximumTrades(
         ORDER_TYPE_BUY,
         lot
      );

   if(numberOfTrades < 1)
   {
      Print(
         "CRT AI BOT: No BUY trades allowed by margin/exposure limits."
      );

      return;
   }

   Print(
      "CRT AI BOT: Opening BUY basket. Trades = ",
      numberOfTrades,
      " | Lot each = ",
      DoubleToString(
         lot,
         2
      )
   );

   for(
      int i = 0;
      i < numberOfTrades;
      i++
   )
   {
      if(!CanOpenNewTrades())
         break;

      if(!EnoughMargin(
         ORDER_TYPE_BUY,
         lot
      ))
      {
         break;
      }

      if(!OpenBuy())
         break;
   }

   if(CountPositions() > 0)
   {
      if(basketStartTime == 0)
      {
         basketStartTime =
            TimeCurrent();
      }
   }
}

