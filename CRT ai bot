//+------------------------------------------------------------------+
//| CRT_AI_BOT_v5_Broker_Determined_Demo_Live.mq5                   |
//| Broker-independent multi-position trading EA                    |
//| DEMO/REAL is determined by the MT5 account currently connected. |
//+------------------------------------------------------------------+
#property strict
#property version "5.00"

#include <Trade/Trade.mqh>
CTrade trade;

//---------------- SYMBOL / SIGNAL -----------------
input string TradingSymbol = ""; // blank = chart symbol

// Select timeframe directly from MT5 Inputs.
input ENUM_TIMEFRAMES SignalTimeframe = PERIOD_H1;

// Examples:
// PERIOD_M1
// PERIOD_M5
// PERIOD_M15
// PERIOD_M30
// PERIOD_H1
// PERIOD_H4
// PERIOD_D1
// PERIOD_W1
// PERIOD_MN1

// One completed candle on the selected timeframe creates one cycle.
input int OrdersPerSignal = 5;
input double LotSizePerOrder = 0.01;
input int MaximumOpenPositions = 20;
input double MaximumTotalLots = 1.00;
input bool AutomaticReEntry = true;

//---------------- EXECUTION -----------------------
input double MaximumSpreadPips = 5.0;
input int SlippagePoints = 20;

//---------------- EXIT -----------------------------
// 0 = disabled.
input double BasketProfitTarget = 0.0;
input double BasketLossLimit = 0.0;
input double StopLossPips = 0.0;
input double TakeProfitPips = 0.0;

//---------------- RISK -----------------------------
input double DailyLossLimitPercent = 2.0;
input double MaximumDrawdownPercent = 5.0;
input int MaximumConsecutiveLosses = 3;
input double MaximumEAExposureLots = 10.0;

//---------------- ID -------------------------------
input ulong MagicNumber = 26082026;

datetime lastClosedBar = 0;
double dayStartEquity = 0.0;
int savedDay = -1;
int consecutiveLosses = 0;
bool tradingLocked = false;

//+------------------------------------------------------------------+
//| Return trading symbol                                            |
//+------------------------------------------------------------------+
string Sym()
{
   if(TradingSymbol == "")
      return _Symbol;

   return TradingSymbol;
}

//+------------------------------------------------------------------+
//| Pip size                                                         |
//+------------------------------------------------------------------+
double PipSize(string s)
{
   double point = SymbolInfoDouble(s, SYMBOL_POINT);
   int digits = (int)SymbolInfoInteger(s, SYMBOL_DIGITS);

   if(point <= 0)
      return 0;

   if(digits == 3 || digits == 5)
      return point * 10.0;

   return point;
}

//+------------------------------------------------------------------+
//| Normalize volume                                                 |
//+------------------------------------------------------------------+
double NormalizeVolume(string s, double v)
{
   double minv = SymbolInfoDouble(s, SYMBOL_VOLUME_MIN);
   double maxv = SymbolInfoDouble(s, SYMBOL_VOLUME_MAX);
   double step = SymbolInfoDouble(s, SYMBOL_VOLUME_STEP);

   if(minv <= 0 || maxv <= 0)
      return 0;

   if(step <= 0)
      step = minv;

   v = MathMax(v, minv);
   v = MathMin(v, maxv);

   v = MathFloor(v / step + 1e-9) * step;

   int digits = 2;

   if(step < 0.01)
      digits = 3;

   if(step < 0.001)
      digits = 4;

   return NormalizeDouble(v, digits);
}

//+------------------------------------------------------------------+
//| Current spread in pips                                           |
//+------------------------------------------------------------------+
double SpreadPips(string s)
{
   double ask = SymbolInfoDouble(s, SYMBOL_ASK);
   double bid = SymbolInfoDouble(s, SYMBOL_BID);
   double pip = PipSize(s);

   if(ask <= 0 || bid <= 0 || pip <= 0)
      return 999999;

   return (ask - bid) / pip;
}

//+------------------------------------------------------------------+
//| Count EA positions                                               |
//+------------------------------------------------------------------+
int CountPositions()
{
   int n = 0;
   string s = Sym();

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      if(PositionGetString(POSITION_SYMBOL) != s)
         continue;

      if((ulong)PositionGetInteger(POSITION_MAGIC) != MagicNumber)
         continue;

      n++;
   }

   return n;
}

//+------------------------------------------------------------------+
//| Total EA lots                                                    |
//+------------------------------------------------------------------+
double TotalLots()
{
   double lots = 0;
   string s = Sym();

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      if(PositionGetString(POSITION_SYMBOL) != s)
         continue;

      if((ulong)PositionGetInteger(POSITION_MAGIC) != MagicNumber)
         continue;

      lots += PositionGetDouble(POSITION_VOLUME);
   }

   return lots;
}

//+------------------------------------------------------------------+
//| Basket profit                                                    |
//+------------------------------------------------------------------+
double BasketProfit()
{
   double p = 0;
   string s = Sym();

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      if(PositionGetString(POSITION_SYMBOL) != s)
         continue;

      if((ulong)PositionGetInteger(POSITION_MAGIC) != MagicNumber)
         continue;

      p += PositionGetDouble(POSITION_PROFIT);
      p += PositionGetDouble(POSITION_SWAP);
   }

   return p;
}

//+------------------------------------------------------------------+
//| Close all EA positions                                           |
//+------------------------------------------------------------------+
void CloseAll(string reason)
{
   Print("Closing CRT basket: ", reason);

   string s = Sym();

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      if(PositionGetString(POSITION_SYMBOL) != s)
         continue;

      if((ulong)PositionGetInteger(POSITION_MAGIC) != MagicNumber)
         continue;

      if(!trade.PositionClose(ticket))
      {
         Print(
            "Close failed #",
            ticket,
            " ",
            trade.ResultRetcodeDescription()
         );
      }
   }
}

//+------------------------------------------------------------------+
//| Update daily information                                         |
//+------------------------------------------------------------------+
void UpdateDay()
{
   MqlDateTime tm;

   TimeToStruct(TimeCurrent(), tm);

   if(savedDay != tm.day)
   {
      savedDay = tm.day;

      dayStartEquity =
         AccountInfoDouble(ACCOUNT_EQUITY);

      consecutiveLosses = 0;
      tradingLocked = false;
   }
}

//+------------------------------------------------------------------+
//| Determine account currently connected to MT5                     |
//+------------------------------------------------------------------+
bool AccountOK()
{
   long mode =
      AccountInfoInteger(ACCOUNT_TRADE_MODE);

   // DEMO or REAL is determined automatically by the
   // account currently connected to this MT5 terminal.

   if(mode == ACCOUNT_TRADE_MODE_REAL)
   {
      Print(
         "MT5 account type: REAL. ",
         "Using connected REAL account."
      );

      return true;
   }

   if(mode == ACCOUNT_TRADE_MODE_DEMO)
   {
      Print(
         "MT5 account type: DEMO. ",
         "Using connected DEMO account."
      );

      return true;
   }

   Print(
      "SAFETY STOP: MT5 account type ",
      "could not be identified."
   );

   return false;
}

//+------------------------------------------------------------------+
//| Risk checks                                                      |
//+------------------------------------------------------------------+
bool RiskOK()
{
   UpdateDay();

   if(tradingLocked)
      return false;

   double equity =
      AccountInfoDouble(ACCOUNT_EQUITY);

   double balance =
      AccountInfoDouble(ACCOUNT_BALANCE);

   // Daily loss protection
   if(DailyLossLimitPercent > 0 &&
      dayStartEquity > 0)
   {
      double loss =
         (dayStartEquity - equity)
         / dayStartEquity * 100.0;

      if(loss >= DailyLossLimitPercent)
      {
         tradingLocked = true;

         CloseAll("daily loss limit");

         return false;
      }
   }

   // Drawdown protection
   if(MaximumDrawdownPercent > 0 &&
      balance > 0)
   {
      double dd =
         (balance - equity)
         / balance * 100.0;

      if(dd >= MaximumDrawdownPercent)
      {
         tradingLocked = true;

         CloseAll("maximum drawdown");

         return false;
      }
   }

   // Consecutive loss protection
   if(MaximumConsecutiveLosses > 0 &&
      consecutiveLosses >= MaximumConsecutiveLosses)
   {
      tradingLocked = true;

      return false;
   }

   return true;
}

//+------------------------------------------------------------------+
//| Read last completed candle                                       |
//+------------------------------------------------------------------+
int ClosedCandleSignal(datetime &barTime)
{
   MqlRates r[2];

   ArraySetAsSeries(r, true);

   if(
      CopyRates(
         Sym(),
         SignalTimeframe,
         0,
         2,
         r
      ) < 2
   )
   {
      return 0;
   }

   // r[1] = last completed candle
   barTime = r[1].time;

   if(r[1].close > r[1].open)
      return 1;

   if(r[1].close < r[1].open)
      return -1;

   // Doji
   return 0;
}

//+------------------------------------------------------------------+
//| Open one trade                                                   |
//+------------------------------------------------------------------+
bool OpenOne(bool buy, double volume)
{
   string s = Sym();

   double ask =
      SymbolInfoDouble(
         s,
         SYMBOL_ASK
      );

   double bid =
      SymbolInfoDouble(
         s,
         SYMBOL_BID
      );

   double pip =
      PipSize(s);

   int digits =
      (int)SymbolInfoInteger(
         s,
         SYMBOL_DIGITS
      );

   if(ask <= 0 || bid <= 0)
      return false;

   double sl = 0;
   double tp = 0;

   if(StopLossPips > 0 && pip > 0)
   {
      if(buy)
      {
         sl =
            NormalizeDouble(
               ask - StopLossPips * pip,
               digits
            );
      }
      else
      {
         sl =
            NormalizeDouble(
               bid + StopLossPips * pip,
               digits
            );
      }
   }

   if(TakeProfitPips > 0 && pip > 0)
   {
      if(buy)
      {
         tp =
            NormalizeDouble(
               ask + TakeProfitPips * pip,
               digits
            );
      }
      else
      {
         tp =
            NormalizeDouble(
               bid - TakeProfitPips * pip,
               digits
            );
      }
   }

   trade.SetExpertMagicNumber(MagicNumber);

   trade.SetDeviationInPoints(
      SlippagePoints
   );

   bool ok;

   if(buy)
   {
      ok =
         trade.Buy(
            volume,
            s,
            0,
            sl,
            tp,
            "CRT BUY"
         );
   }
   else
   {
      ok =
         trade.Sell(
            volume,
            s,
            0,
            sl,
            tp,
            "CRT SELL"
         );
   }

   if(!ok)
   {
      Print(
         "Order failed: ",
         trade.ResultRetcode(),
         " ",
         trade.ResultRetcodeDescription()
      );

      return false;
   }

   Print(
      "Opened ",
      buy ? "BUY" : "SELL",
      " lot=",
      DoubleToString(volume,2),
      " order=",
      trade.ResultOrder()
   );

   return true;
}

//+------------------------------------------------------------------+
//| Start new trading cycle                                          |
//+------------------------------------------------------------------+
void StartCycle(bool buy, datetime barTime)
{
   if(!AccountOK())
      return;

   if(!RiskOK())
      return;

   string s = Sym();

   if(!SymbolSelect(s,true))
   {
      Print(
         "Cannot select symbol ",
         s
      );

      return;
   }

   double spread =
      SpreadPips(s);

   if(spread > MaximumSpreadPips)
   {
      Print(
         "Spread too high: ",
         DoubleToString(spread,2),
         " pips"
      );

      return;
   }

   int current =
      CountPositions();

   if(current >= MaximumOpenPositions)
      return;

   double volume =
      NormalizeVolume(
         s,
         LotSizePerOrder
      );

   if(volume <= 0)
      return;

   double availableLots =
      MaximumEAExposureLots -
      TotalLots();

   if(availableLots <= 0)
      return;

   int slotsByExposure =
      (int)MathFloor(
         availableLots / volume + 1e-9
      );

   int slotsByTotal =
      (int)MathFloor(
         MaximumTotalLots / volume + 1e-9
      );

   int slots =
      MathMin(
         OrdersPerSignal,
         MathMin(
            MaximumOpenPositions - current,
            MathMin(
               slotsByExposure,
               slotsByTotal
            )
         )
      );

   if(slots <= 0)
      return;

   Print(
      "NEW ",
      EnumToString(SignalTimeframe),
      " CYCLE ",
      TimeToString(barTime),
      " Direction=",
      buy ? "BUY" : "SELL",
      " Orders=",
      slots,
      " Lot=",
      DoubleToString(volume,2)
   );

   for(int i = 0; i < slots; i++)
   {
      if(!AccountOK())
         break;

      if(!RiskOK())
         break;

      if(
         TotalLots() + volume >
         MaximumEAExposureLots + 1e-9
      )
      {
         break;
      }

      OpenOne(
         buy,
         volume
      );
   }
}

//+------------------------------------------------------------------+
//| Detect new completed candle                                      |
//+------------------------------------------------------------------+
void CheckNewBar()
{
   datetime t = 0;

   int signal =
      ClosedCandleSignal(t);

   if(t == 0)
      return;

   if(lastClosedBar == 0)
   {
      lastClosedBar = t;
      return;
   }

   if(t == lastClosedBar)
      return;

   lastClosedBar = t;

   if(
      !AutomaticReEntry &&
      CountPositions() > 0
   )
   {
      return;
   }

   if(signal == 1)
   {
      StartCycle(
         true,
         t
      );
   }
   else if(signal == -1)
   {
      StartCycle(
         false,
         t
      );
   }
   else
   {
      Print(
         EnumToString(SignalTimeframe),
         " DOJI - no new cycle."
      );
   }
}

//+------------------------------------------------------------------+
//| Manage basket                                                     |
//+------------------------------------------------------------------+
void ManageBasket()
{
   if(CountPositions() <= 0)
      return;

   double p =
      BasketProfit();

   if(
      BasketProfitTarget > 0 &&
      p >= BasketProfitTarget
   )
   {
      CloseAll(
         "basket profit target"
      );

      return;
   }

   if(
      BasketLossLimit > 0 &&
      p <= -MathAbs(BasketLossLimit)
   )
   {
      CloseAll(
         "basket loss limit"
      );

      return;
   }
}

//+------------------------------------------------------------------+
//| Initialization                                                   |
//+------------------------------------------------------------------+
int OnInit()
{
   if(!SymbolSelect(Sym(),true))
   {
      Print(
         "Cannot select ",
         Sym()
      );

      return INIT_FAILED;
   }

   trade.SetExpertMagicNumber(
      MagicNumber
   );

   trade.SetDeviationInPoints(
      SlippagePoints
   );

   UpdateDay();

   Print(
      "=========================================="
   );

   Print(
      "CRT_AI_BOT v5.00"
   );

   Print(
      "Broker/company: ",
      AccountInfoString(
         ACCOUNT_COMPANY
      )
   );

   Print(
      "MT5 server: ",
      AccountInfoString(
         ACCOUNT_SERVER
      )
   );

   Print(
      "Account: ",
      AccountInfoInteger(
         ACCOUNT_LOGIN
      )
   );

   if(
      AccountInfoInteger(
         ACCOUNT_TRADE_MODE
      ) == ACCOUNT_TRADE_MODE_REAL
   )
   {
      Print(
         "Account type: REAL"
      );
   }
   else
   {
      Print(
         "Account type: DEMO"
      );
   }

   Print(
      "Symbol: ",
      Sym()
   );

   Print(
      "Selected timeframe: ",
      EnumToString(
         SignalTimeframe
      )
   );

   Print(
      "=========================================="
   );

   if(
      AccountInfoInteger(
         ACCOUNT_MARGIN_MODE
      ) ==
      ACCOUNT_MARGIN_MODE_RETAIL_NETTING
   )
   {
      Print(
         "WARNING: NETTING account. ",
         "Separate independent positions ",
         "are not supported."
      );
   }
   else
   {
      Print(
         "HEDGING-style account detected."
      );
   }

   return INIT_SUCCEEDED;
}

//+------------------------------------------------------------------+
//| Main tick                                                        |
//+------------------------------------------------------------------+
void OnTick()
{
   UpdateDay();

   ManageBasket();

   CheckNewBar();
}

//+------------------------------------------------------------------+
//| Trade transaction                                                |
//+------------------------------------------------------------------+
void OnTradeTransaction(
   const MqlTradeTransaction &trans,
   const MqlTradeRequest &request,
   const MqlTradeResult &result
)
{
   if(
      trans.type !=
      TRADE_TRANSACTION_DEAL_ADD
   )
   {
      return;
   }

   if(trans.deal == 0)
      return;

   if(!HistoryDealSelect(trans.deal))
      return;

   long entry =
      HistoryDealGetInteger(
         trans.deal,
         DEAL_ENTRY
      );

   if(
      entry != DEAL_ENTRY_OUT &&
      entry != DEAL_ENTRY_OUT_BY
   )
   {
      return;
   }

   long magic =
      HistoryDealGetInteger(
         trans.deal,
         DEAL_MAGIC
      );

   string symbol =
      HistoryDealGetString(
         trans.deal,
         DEAL_SYMBOL
      );

   if(
      (ulong)magic != MagicNumber ||
      symbol != Sym()
   )
   {
      return;
   }

   double p =
      HistoryDealGetDouble(
         trans.deal,
         DEAL_PROFIT
      )
      +
      HistoryDealGetDouble(
         trans.deal,
         DEAL_SWAP
      )
      +
      HistoryDealGetDouble(
         trans.deal,
         DEAL_COMMISSION
      );

   if(p < 0)
      consecutiveLosses++;
   else if(p > 0)
      consecutiveLosses = 0;
}

