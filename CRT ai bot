         10
      );

      ObjectSetInteger(
         0,
         STATUS_LABEL,
         OBJPROP_YDISTANCE,
         60
      );
   }

   ObjectSetString(
      0,
      STATUS_LABEL,
      OBJPROP_TEXT,
      text
   );

   ChartRedraw();
}

//==================================================================
// INITIALIZATION
//==================================================================

int OnInit()
{
   trade.SetExpertMagicNumber(
      MagicNumber
   );

   trade.SetDeviationInPoints(
      SlippagePoints
   );

   UpdateDay();

   lastProcessedCandle = 0;

   buyStrength = 0.0;
   sellStrength = 0.0;

   signalText = "WAIT";

   CreateButton(
      START_BUTTON,
      "START",
      10,
      10
   );

   CreateButton(
      STOP_BUTTON,
      "STOP",
      120,
      10
   );

   UpdateStatus();

   Print(
      "CRT AI BOT: M1 55% Candle Scanner initialized."
   );

   return INIT_SUCCEEDED;
}

