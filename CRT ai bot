//==================================================================
// MAIN TICK
//==================================================================

void OnTick()
{
   UpdateDay();

   UpdateStatus();

   if(!tradingEnabled)
      return;

   if(tradingLocked)
      return;

   if(!RiskOK())
      return;

   // If there is no basket, immediately use
   // the current forming M1 candle direction.
   if(CountPositions() == 0)
   {
      protectionActive = false;
      peakBasketProfit = 0.0;

      int direction =
         CurrentCandleDirection();

      if(direction != 0)
      {
         OpenCurrentDirection(
            direction
         );
      }

      return;
   }

   // Manage an existing basket.
   // It will NEVER close while losing.
   ManageProfitProtection();

   UpdateStatus();
}

//==================================================================
// START / STOP BUTTONS
//==================================================================

void OnChartEvent(
   const int id,
   const long &lparam,
   const double &dparam,
   const string &sparam)
{
   if(id != CHARTEVENT_OBJECT_CLICK)
      return;

   //===============================================================
   // START
   //===============================================================

   if(sparam == START_BUTTON)
   {
      UpdateDay();

      if(!RiskOK())
      {
         tradingEnabled = false;

         Print(
            "CRT AI BOT: START rejected because a risk limit is active."
         );

         UpdateStatus();

         return;
      }

      tradingLocked = false;
      tradingEnabled = true;

      protectionActive = false;
      peakBasketProfit = 0.0;

      Print(
         "CRT AI BOT: STARTED."
      );

      // Immediately check the current forming M1 candle.
      if(CountPositions() == 0)
      {
         int direction =
            CurrentCandleDirection();

         if(direction != 0)
         {
            OpenCurrentDirection(
               direction
            );
         }
      }

      UpdateStatus();

      return;
   }

   //===============================================================
   // STOP
   //===============================================================

   if(sparam == STOP_BUTTON)
   {
      tradingEnabled = false;

      Print(
         "CRT AI BOT: STOPPED. Existing positions were NOT force-closed."
      );

      UpdateStatus();

      return;
   }
}

//==================================================================
// TRADE TRANSACTION
//==================================================================

void OnTradeTransaction(
   const MqlTradeTransaction &trans,
   const MqlTradeRequest &request,
   const MqlTradeResult &result)
{
   if(trans.type !=
      TRADE_TRANSACTION_DEAL_ADD)
   {
      return;
   }

   ulong dealTicket =
      trans.deal;

   if(dealTicket == 0)
      return;

   if(!HistoryDealSelect(
         dealTicket))
   {
      return;
   }

   string symbol =
      HistoryDealGetString(
         dealTicket,
         DEAL_SYMBOL
      );

   long magic =
      HistoryDealGetInteger(
         dealTicket,
         DEAL_MAGIC
      );

   if(symbol != Sym())
      return;

   if((ulong)magic != MagicNumber)
      return;

   long entry =
      HistoryDealGetInteger(
         dealTicket,
         DEAL_ENTRY
      );

   // We only count completed exit deals.
   if(entry != DEAL_ENTRY_OUT &&
      entry != DEAL_ENTRY_OUT_BY)
   {
      return;
   }

   double profit =
      HistoryDealGetDouble(
         dealTicket,
         DEAL_PROFIT
      );

   double swap =
      HistoryDealGetDouble(
         dealTicket,
         DEAL_SWAP
      );

   double commission =
      HistoryDealGetDouble(
         dealTicket,
         DEAL_COMMISSION
      );

   double netResult =
      profit +
      swap +
      commission;

   if(netResult < 0.0)
   {
      consecutiveLosses++;

      Print(
         "CRT AI BOT: Losing trade/basket recorded. Consecutive losses=",
         consecutiveLosses
      );
   }
   else
   if(netResult > 0.0)
   {
      consecutiveLosses = 0;

      Print(
         "CRT AI BOT: Profitable trade/basket recorded."
      );
   }

   // If the complete basket has now closed,
   // reset protection so the next basket starts fresh.
   if(CountPositions() == 0)
   {
      protectionActive = false;
      peakBasketProfit = 0.0;

      Print(
         "CRT AI BOT: Basket completely closed."
      );
   }
}

