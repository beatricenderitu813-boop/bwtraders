//==================================================================
// CLOSE ALL EA POSITIONS
//==================================================================

bool CloseAll(
   string reason
)
{
   closingBasket = true;

   bool allClosed = true;

   Print(
      "CRT AI BOT: Closing basket. Reason = ",
      reason
   );

   for(
      int i = PositionsTotal() - 1;
      i >= 0;
      i--
   )
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(
         !PositionSelectByTicket(
            ticket
         )
      )
      {
         continue;
      }

      string symbol =
         PositionGetString(
            POSITION_SYMBOL
         );

      long magic =
         PositionGetInteger(
            POSITION_MAGIC
         );

      if(symbol != Sym())
         continue;

      if(
         (ulong)magic !=
         MagicNumber
      )
      {
         continue;
      }

      if(
         !trade.PositionClose(
            ticket,
            SlippagePoints
         )
      )
      {
         allClosed = false;

         Print(
            "CRT AI BOT: Close failed. Ticket=",
            ticket,
            " Retcode=",
            trade.ResultRetcode(),
            " ",
            trade.ResultRetcodeDescription()
         );
      }
   }

   if(allClosed)
   {
      protectionActive = false;

      peakBasketProfit = 0.0;
   }

   closingBasket = false;

   return allClosed;
}

//==================================================================
// UPDATE DAY
//==================================================================

void UpdateDay()
{
   MqlDateTime tm;

   TimeToStruct(
      TimeCurrent(),
      tm
   );

   int currentDay =
      tm.day_of_year;

   if(
      savedDay !=
      currentDay
   )
   {
      savedDay =
         currentDay;

      dayStartEquity =
         AccountInfoDouble(
            ACCOUNT_EQUITY
         );

      consecutiveLosses = 0;

      tradingLocked = false;

      protectionActive = false;

      peakBasketProfit = 0.0;
   }
}

//==================================================================
// RISK CHECK
//==================================================================

bool RiskOK()
{
   if(tradingLocked)
      return false;

   double equity =
      AccountInfoDouble(
         ACCOUNT_EQUITY
      );

   double balance =
      AccountInfoDouble(
         ACCOUNT_BALANCE
      );

   if(
      balance <= 0.0 ||
      dayStartEquity <= 0.0
   )
   {
      return false;
   }

   //--------------------------------------------------------------
   // DAILY LOSS
   //--------------------------------------------------------------

   if(
      DailyLossLimitPercent > 0.0
   )
   {
      double loss =
         dayStartEquity -
         equity;

      double lossPercent =
         (
            loss /
            dayStartEquity
         ) * 100.0;

      if(
         lossPercent >=
         DailyLossLimitPercent
      )
      {
         tradingLocked = true;

         CloseAll(
            "DAILY LOSS LIMIT"
         );

         return false;
      }
   }

   //--------------------------------------------------------------
   // MAXIMUM DRAWDOWN
   //--------------------------------------------------------------

   if(
      MaximumDrawdownPercent > 0.0
   )
   {
      double drawdown =
         balance -
         equity;

      double drawdownPercent =
         (
            drawdown /
            balance
         ) * 100.0;

      if(
         drawdownPercent >=
         MaximumDrawdownPercent
      )
      {
         tradingLocked = true;

         CloseAll(
            "MAXIMUM DRAWDOWN"
         );

         return false;
      }
   }

   //--------------------------------------------------------------
   // CONSECUTIVE LOSSES
   //--------------------------------------------------------------

   if(
      MaximumConsecutiveLosses > 0 &&
      consecutiveLosses >=
      MaximumConsecutiveLosses
   )
   {
      tradingLocked = true;

      CloseAll(
         "MAXIMUM CONSECUTIVE LOSSES"
      );

      return false;
   }

   return true;
}

//==================================================================
// CURRENT FORMING M1 CANDLE DIRECTION
//==================================================================

int CurrentCandleDirection()
{
   MqlRates rates[];

   ArraySetAsSeries(
      rates,
      true
   );

   if(
      CopyRates(
         Sym(),
         PERIOD_M1,
         0,
         1,
         rates
      ) != 1
   )
   {
      return 0;
   }

   double currentPrice =
      SymbolInfoDouble(
         Sym(),
         SYMBOL_BID
      );

   if(
      currentPrice >
      rates[0].open
   )
   {
      return 1;
   }

   if(
      currentPrice <
      rates[0].open
   )
   {
      return -1;
   }

   return 0;
}
//==================================================================
// BUY STRENGTH — CURRENT M1 CANDLE
//==================================================================

double CalculateBuyStrength()
{
   MqlRates rates[];

   ArraySetAsSeries(
      rates,
      true
   );

   if(
      CopyRates(
         Sym(),
         PERIOD_M1,
         0,
         1,
         rates
      ) != 1
   )
   {
      return 0.0;
   }

   double openPrice =
      rates[0].open;

   double highPrice =
      rates[0].high;

   double lowPrice =
      rates[0].low;

   double bid =
      SymbolInfoDouble(
         Sym(),
         SYMBOL_BID
      );

   if(
      openPrice <= 0.0 ||
      highPrice <= 0.0 ||
      lowPrice <= 0.0 ||
      bid <= 0.0
   )
   {
      return 0.0;
   }

   double range =
      highPrice -
      lowPrice;

   if(range <= 0.0)
   {
      return 0.0;
   }

   // Position of current price inside the
   // CURRENT FORMING candle.
   double position =
      (
         bid -
         lowPrice
      ) / range;

   if(position < 0.0)
      position = 0.0;

   if(position > 1.0)
      position = 1.0;

   double strength = 0.0;

   // ---------------------------------------------------------------
   // CURRENT CANDLE BULLISH DIRECTION
   // ---------------------------------------------------------------

   if(bid > openPrice)
   {
      strength += 55.0;
   }

   // ---------------------------------------------------------------
   // PRICE LOCATION
   // ---------------------------------------------------------------

   strength +=
      position * 45.0;

   if(strength > 100.0)
      strength = 100.0;

   return strength;
}

//==================================================================
// SELL STRENGTH — CURRENT M1 CANDLE
//==================================================================

double CalculateSellStrength()
{
   MqlRates rates[];

   ArraySetAsSeries(
      rates,
      true
   );

   if(
      CopyRates(
         Sym(),
         PERIOD_M1,
         0,
         1,
         rates
      ) != 1
   )
   {
      return 0.0;
   }

   double openPrice =
      rates[0].open;

   double highPrice =
      rates[0].high;

   double lowPrice =
      rates[0].low;

   double bid =
      SymbolInfoDouble(
         Sym(),
         SYMBOL_BID
      );

   if(
      openPrice <= 0.0 ||
      highPrice <= 0.0 ||
      lowPrice <= 0.0 ||
      bid <= 0.0
   )
   {
      return 0.0;
   }

   double range =
      highPrice -
      lowPrice;

   if(range <= 0.0)
   {
      return 0.0;
   }

   double position =
      (
         bid -
         lowPrice
      ) / range;

   if(position < 0.0)
      position = 0.0;

   if(position > 1.0)
      position = 1.0;

   double strength = 0.0;

   // ---------------------------------------------------------------
   // CURRENT CANDLE BEARISH DIRECTION
   // ---------------------------------------------------------------

   if(bid < openPrice)
   {
      strength += 55.0;
   }

   // ---------------------------------------------------------------
   // PRICE LOCATION
   // ---------------------------------------------------------------

   strength +=
      (1.0 - position) *
      45.0;

   if(strength > 100.0)
      strength = 100.0;

   return strength;
}

