//==================================================================
// ON TICK
//
// Runs on EVERY incoming market tick.
// No candle-close waiting.
//==================================================================

void OnTick()
{
   UpdateDay();

   //---------------------------------------------------------------
   // ALWAYS KEEP STATUS UPDATED
   //---------------------------------------------------------------

   UpdateStatus();

   //---------------------------------------------------------------
   // BOT STOPPED
   //---------------------------------------------------------------

   if(!tradingEnabled)
      return;

   //---------------------------------------------------------------
   // RISK LOCK
   //---------------------------------------------------------------

   if(tradingLocked)
      return;

   //---------------------------------------------------------------
   // RISK CHECK
   //---------------------------------------------------------------

   if(!RiskOK())
      return;

   //---------------------------------------------------------------
   // MAIN FLIPPING ENGINE
   //---------------------------------------------------------------

   ManageFlipping();
}

//==================================================================
// CHART EVENTS — START / STOP BUTTONS
//==================================================================

void OnChartEvent(
   const int id,
   const long &lparam,
   const double &dparam,
   const string &sparam
)
{
   //---------------------------------------------------------------
   // ONLY PROCESS BUTTON CLICKS
   //---------------------------------------------------------------

   if(
      id !=
      CHARTEVENT_OBJECT_CLICK
   )
   {
      return;
   }

   //---------------------------------------------------------------
   // START BUTTON
   //---------------------------------------------------------------

   if(
      sparam ==
      START_BUTTON
   )
   {
      if(tradingLocked)
      {
         Print(
            "CRT AI BOT: START blocked. Risk protection is active."
         );

         return;
      }

      tradingEnabled = true;

      Print(
         "CRT AI BOT STARTED"
      );

      //------------------------------------------------------------
      // IMMEDIATELY SCAN THE CURRENT FORMING M1 CANDLE.
      // THERE IS NO WAIT FOR CANDLE CLOSE.
      //------------------------------------------------------------

      ScanCurrentCandle();

      int direction =
         GetSignalDirection();

      if(
         direction != 0 &&
         CountPositions() == 0
      )
      {
         OpenCurrentDirection(
            direction
         );
      }

      UpdateStatus();

      return;
   }

   //---------------------------------------------------------------
   // STOP BUTTON
   //---------------------------------------------------------------

   if(
      sparam ==
      STOP_BUTTON
   )
   {
      tradingEnabled = false;

      CloseAll(
         "MANUAL STOP"
      );

      Print(
         "CRT AI BOT STOPPED"
      );

      UpdateStatus();

      return;
   }
}

//==================================================================
// TRADE TRANSACTION
//
// Tracks closed EA trades for consecutive-loss protection.
//==================================================================

void OnTradeTransaction(
   const MqlTradeTransaction &trans,
   const MqlTradeRequest &request,
   const MqlTradeResult &result
)
{
   //---------------------------------------------------------------
   // ONLY DEAL ADD EVENTS
   //---------------------------------------------------------------

   if(
      trans.type !=
      TRADE_TRANSACTION_DEAL_ADD
   )
   {
      return;
   }

   if(
      trans.deal == 0
   )
   {
      return;
   }

   //---------------------------------------------------------------
   // SELECT DEAL
   //---------------------------------------------------------------

   if(
      !HistoryDealSelect(
         trans.deal
      )
   )
   {
      return;
   }

   //---------------------------------------------------------------
   // ONLY PROCESS EXIT DEALS
   //---------------------------------------------------------------

   long entry =
      HistoryDealGetInteger(
         trans.deal,
         DEAL_ENTRY
      );

   if(
      entry !=
      DEAL_ENTRY_OUT &&
      entry !=
      DEAL_ENTRY_OUT_BY
   )
   {
      return;
   }

   //---------------------------------------------------------------
   // CHECK MAGIC NUMBER
   //---------------------------------------------------------------

   long magic =
      HistoryDealGetInteger(
         trans.deal,
         DEAL_MAGIC
      );

   //---------------------------------------------------------------
   // CHECK SYMBOL
   //---------------------------------------------------------------

   string symbol =
      HistoryDealGetString(
         trans.deal,
         DEAL_SYMBOL
      );

   if(
      (ulong)magic !=
      MagicNumber
   )
   {
      return;
   }

   if(
      symbol !=
      Sym()
   )
   {
      return;
   }

   //---------------------------------------------------------------
   // CALCULATE NET RESULT
   //---------------------------------------------------------------

   double profit =
      HistoryDealGetDouble(
         trans.deal,
         DEAL_PROFIT
      );

   double swap =
      HistoryDealGetDouble(
         trans.deal,
         DEAL_SWAP
      );

   double commission =
      HistoryDealGetDouble(
         trans.deal,
         DEAL_COMMISSION
      );

   double netProfit =
      profit +
      swap +
      commission;

   //---------------------------------------------------------------
   // LOSS
   //---------------------------------------------------------------

   if(
      netProfit < 0.0
   )
   {
      consecutiveLosses++;

      Print(
         "CRT AI BOT: Losing trade. ",
         "Consecutive losses=",
         consecutiveLosses
      );
   }

   //---------------------------------------------------------------
   // PROFIT
   //---------------------------------------------------------------

   else
   if(
      netProfit > 0.0
   )
   {
      consecutiveLosses = 0;

      Print(
         "CRT AI BOT: Profitable trade. ",
         "Consecutive losses reset."
      );
   }

   //---------------------------------------------------------------
   // MAXIMUM CONSECUTIVE LOSSES
   //---------------------------------------------------------------

   if(
      MaximumConsecutiveLosses > 0 &&
      consecutiveLosses >=
      MaximumConsecutiveLosses
   )
   {
      tradingLocked = true;

      tradingEnabled = false;

      CloseAll(
         "MAXIMUM CONSECUTIVE LOSSES"
      );

      Print(
         "CRT AI BOT LOCKED BY RISK PROTECTION"
      );
   }
}

