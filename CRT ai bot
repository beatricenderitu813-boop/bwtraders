//==================================================================
// MAIN TICK
//==================================================================

void OnTick()
{
   UpdateDay();

   if(!tradingEnabled)
      return;

   if(tradingLocked)
      return;

   if(!RiskOK())
      return;

   //==============================================================
   // AUTOMATIC RE-ENTRY
   // If the previous basket has completely closed,
   // immediately allow a new basket.
   //
   // IMPORTANT:
   // CurrentCandleDirection() uses the CURRENT FORMING M1 candle.
   // There is NO waiting for the candle to close.
   //==============================================================

   if(CountPositions() == 0)
   {
      closingBasket = false;
      protectionActive = false;
      peakPrice = 0.0;

      int direction =
         CurrentCandleDirection();

      if(direction != 0)
      {
         OpenCurrentDirection(
            direction
         );
      }

      return;
   }

   //==============================================================
   // MANAGE CURRENT BASKET
   //==============================================================

   ManageFlipping();
}

//==================================================================
// START / STOP BUTTON EVENTS
//==================================================================

void OnChartEvent(
   const int id,
   const long &lparam,
   const double &dparam,
   const string &sparam
)
{
   if(
      id !=
      CHARTEVENT_OBJECT_CLICK
   )
   {
      return;
   }

   //--------------------------------------------------------------
   // START
   //--------------------------------------------------------------

   if(
      sparam ==
      START_BUTTON
   )
   {
      if(tradingLocked)
      {
         Print(
            "START blocked: risk protection is active."
         );

         return;
      }

      tradingEnabled = true;
      closingBasket = false;

      UpdateStatus();

      Print(
         "CRT AI BOT STARTED"
      );

      //-----------------------------------------------------------
      // OPEN IMMEDIATELY USING CURRENT FORMING M1 CANDLE.
      //-----------------------------------------------------------

      int direction =
         CurrentCandleDirection();

      if(direction != 0)
      {
         OpenCurrentDirection(
            direction
         );
      }
   }

   //--------------------------------------------------------------
   // STOP
   //--------------------------------------------------------------

   if(
      sparam ==
      STOP_BUTTON
   )
   {
      tradingEnabled = false;

      UpdateStatus();

      CloseAll(
         "MANUAL STOP"
      );

      closingBasket = false;

      Print(
         "CRT AI BOT STOPPED"
      );
   }
}

//==================================================================
// TRADE TRANSACTION
//==================================================================

void OnTradeTransaction(
   const MqlTradeTransaction &trans,
   const MqlTradeRequest &request,
   const MqlTradeResult &result
)
{
   if(
      trans.type !=
      TRADE_TRANSACTION_DEAL_ADD
   )
   {
      return;
   }

   if(trans.deal == 0)
      return;

   if(
      !HistoryDealSelect(
         trans.deal
      )
   )
   {
      return;
   }

   long entry =
      HistoryDealGetInteger(
         trans.deal,
         DEAL_ENTRY
      );

   if(
      entry != DEAL_ENTRY_OUT &&
      entry != DEAL_ENTRY_OUT_BY
   )
   {
      return;
   }

   long magic =
      HistoryDealGetInteger(
         trans.deal,
         DEAL_MAGIC
      );

   string symbol =
      HistoryDealGetString(
         trans.deal,
         DEAL_SYMBOL
      );

   if(
      (ulong)magic != MagicNumber ||
      symbol != Sym()
   )
   {
      return;
   }

   double profit =
      HistoryDealGetDouble(
         trans.deal,
         DEAL_PROFIT
      );

   double swap =
      HistoryDealGetDouble(
         trans.deal,
         DEAL_SWAP
      );

   double commission =
      HistoryDealGetDouble(
         trans.deal,
         DEAL_COMMISSION
      );

   double netProfit =
      profit +
      swap +
      commission;

   //--------------------------------------------------------------
   // LOSS TRACKING
   //--------------------------------------------------------------

   if(netProfit < 0)
   {
      consecutiveLosses++;
   }
   else if(netProfit > 0)
   {
      consecutiveLosses = 0;
   }

   //--------------------------------------------------------------
   // CONSECUTIVE LOSS PROTECTION
   //-----------------
if(
      MaximumConsecutiveLosses > 0 &&
      consecutiveLosses >=
      MaximumConsecutiveLosses
   )
   {
      tradingLocked = true;
      tradingEnabled = false;

      CloseAll(
         "MAXIMUM CONSECUTIVE LOSSES"
      );

      UpdateStatus();

      Print(
         "CRT AI BOT LOCKED BY RISK PROTECTION"
      );

      return;
   }

   //--------------------------------------------------------------
   // IMPORTANT:
   // We do NOT use this transaction event to wait for a candle.
   //
   // Re-entry is handled by OnTick() immediately after the basket
   // is completely closed, using the CURRENT forming M1 candle.
   //--------------------------------------------------------------

   if(
      CountPositions() == 0 &&
      tradingEnabled &&
      !tradingLocked &&
      !closingBasket
   )
   {
      protectionActive = false;
      peakPrice = 0.0;

      int direction =
         CurrentCandleDirection();

      if(direction != 0)
      {
         OpenCurrentDirection(
            direction
         );
      }
   }
}

