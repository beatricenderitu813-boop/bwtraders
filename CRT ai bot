void UpdateDay()
{
   MqlDateTime tm;

   TimeToStruct(
      TimeCurrent(),
      tm
   );

   int currentDay =
      tm.day_of_year;

   if(savedDay != currentDay)
   {
      savedDay = currentDay;

      dayStartEquity =
         AccountInfoDouble(
