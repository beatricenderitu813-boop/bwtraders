string Sym()
{
   if(TradingSymbol == "")
      return _Symbol;

   return TradingSymbol;
}

//==================================================================
// PIP SIZE
//==================================================================

double PipSize(string s)
{
   double point =
      SymbolInfoDouble(
         s,
         SYMBOL_POINT
      );

   int digits =
      (int)SymbolInfoInteger(
         s,
         SYMBOL_DIGITS
      );

   if(point <= 0)
      return 0;

   if(digits == 3 || digits == 5)
      return point * 10.0;

   return point;
}

//==================================================================
// NORMALIZE LOT
//==================================================================

double NormalizeVolume(
   string s,
   double volume
)
{
   double minVolume =
      SymbolInfoDouble(
         s,
         SYMBOL_VOLUME_MIN
      );

   double maxVolume =
      SymbolInfoDouble(
         s,
         SYMBOL_VOLUME_MAX
      );

   double step =
      SymbolInfoDouble(
         s,
         SYMBOL_VOLUME_STEP
      );

   if(
      minVolume <= 0 ||
      maxVolume <= 0
   )
   {
      return 0;
   }

   if(step <= 0)
      step = minVolume;

   volume =
      MathMax(
         volume,
         minVolume
      );

   volume =
      MathMin(
         volume,
         maxVolume
      );

   volume =
      MathFloor(
         volume / step + 1e-9
      ) * step;

   int digits = 2;

   if(step < 0.01)
      digits = 3;

   if(step < 0.001)
      digits = 4;

   return NormalizeDouble(
      volume,
      digits
   );
}

//==================================================================
// DYNAMIC LOT
//==================================================================

double CalculateDynamicLot()
{
   double balance =
      AccountInfoDouble(
         ACCOUNT_BALANCE
      );

   double rawLot =
      balance * LotMultiplier;

   return NormalizeVolume(
      Sym(),
      rawLot
   );
}

//==================================================================
// COUNT EA POSITIONS
//==================================================================

int CountPositions()
{
   int count = 0;

   string s = Sym();

   for(
      int i = PositionsTotal() - 1;
      i >= 0;
      i--
   )
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      if(
         PositionGetString(
            POSITION_SYMBOL
         ) != s
      )
      {
         continue;
      }

      if(
         (ulong)PositionGetInteger(
            POSITION_MAGIC
         ) != MagicNumber
      )
      {
         continue;
      }

      count++;
   }

   return count;
}

//==================================================================
