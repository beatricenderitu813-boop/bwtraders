import asyncio
import ccxt.pro as ccxt
import os

# --- CONFIGURATION ---
EXCHANGE_ID = 'binance' 
SYMBOL = 'SOL/USDT'          # Target trading pair
POSITION_SIZE = 10           # Amount of quote currency (USDT) per position
MAX_POSITIONS = 5            # Max simultaneous open positions
TRAILING_DROP = 0.02         # 2% drop from peak profit triggers close
# ---------------------

# Initialize Exchange (Uses environment variables for security)
exchange = getattr(ccxt, EXCHANGE_ID)({
    'apiKey': os.getenv('EXCHANGE_API_KEY'),
    'secret': os.getenv('EXCHANGE_SECRET_KEY'),
    'options': {'defaultType': 'future'}, # Set to 'spot' or 'future'
})

# Track our "Flipping" Positions
# Format: {'id': {'open_price': float, 'highest_price': float, 'side': str}}
open_positions = {}

async def get_current_price():
    """Fetches the latest ticker price."""
    ticker = await exchange.fetch_ticker(SYMBOL)
    return ticker['last']

async def open_new_positions():
    """Frequently opens new positions if we have available slots."""
    while len(open_positions) < MAX_POSITIONS:
        try:
            current_price = await get_current_price()
            
            # Simple alternating flip logic (Buy vs Sell)
            # You can replace this side selection with your own indicator (e.g., RSI, EMA)
            side = 'buy' if len(open_positions) % 2 == 0 else 'sell'
            
            print(f"🚀 Opening frequent position: {side.upper()} at {current_price}")
            
            # Execute Market Order
            # order = await exchange.create_market_order(SYMBOL, side, POSITION_SIZE)
            
            # Mocking order ID for demonstration; replace with order['id'] in live trading
            mock_id = f"order_{asyncio.get_event_loop().time()}"
            
            open_positions[mock_id] = {
                'open_price': current_price,
                'highest_price': current_price,
                'lowest_price': current_price, # For short positions
                'side': side
            }
            
        except Exception as e:
            print(f"❌ Error opening trade: {e}")
            break

async def monitor_and_close_positions():
    """Monitors profits and closes trades instantly when a 2% drop occurs."""
    if not open_positions:
        return

    try:
        current_price = await get_current_price()
        closed_ids = []

        for trade_id, data in open_positions.items():
            entry = data['open_price']
            side = data['side']

            if side == 'buy':
                # Track peak price reached during profit
                if current_price > data['highest_price']:
                    open_positions[trade_id]['highest_price'] = current_price
                
                peak = open_positions[trade_id]['highest_price']
                profit_pct = (current_price - entry) / entry
                drop_from_peak = (peak - current_price) / peak

                # Core Rule: Must be in profit, and drop 2% from the highest peak
                if profit_pct > 0 and drop_from_peak >= TRAILING_DROP:
                    print(f"💰 Take Profit Triggered for BUY! Closing trade at {current_price}. (Peak: {peak})")
                    # await exchange.create_market_order(SYMBOL, 'sell', POSITION_SIZE)
                    closed_ids.append(trade_id)

            elif side == 'sell':
                # Track lowest price reached during profit for Shorts
                if current_price < data['lowest_price']:
                    open_positions[trade_id]['lowest_price'] = current_price
                
                trough = open_positions[trade_id]['lowest_price']
                profit_pct = (entry - current_price) / entry
                rise_from_trough = (current_price - trough) / trough

                # Core Rule: Must be in profit, and rise 2% from the absolute bottom
                if profit_pct > 0 and rise_from_trough >= TRAILING_DROP:
                    print(f"💰 Take Profit Triggered for SELL! Closing trade at {current_price}. (Trough: {trough})")
                    # await exchange.create_market_order(SYMBOL, 'buy', POSITION_SIZE)
                    closed_ids.append(trade_id)

        # Remove closed positions from tracking to free up slots for automatic reopening
        for t_id in closed_ids:
            del open_positions[t_id]

    except Exception as e:
        print(f"❌ Error monitoring trades: {e}")

async def main_loop():
    """Main asynchronous engine loop."""
    print("🤖 Flipping AI Engine Active...")
    try:
        while True:
            # 1. Frequently try to fill up available position slots
            await open_new_positions()
            
            # 2. Check current open trades against the 2% trailing take-profit rule
            await monitor_and_close_positions()
            
            # 3. Frequency interval: Checks market every 1 second
            await asyncio.sleep(1)
            
    except KeyboardInterrupt:
        print("🛑 Engine stopped safely.")
    finally:
        await exchange.close()

# Run the Bot
if __name__ == "__main__":
    asyncio.run(main_loop())
