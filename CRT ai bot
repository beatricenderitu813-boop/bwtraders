         10
      );

      ObjectSetInteger(
         0,
         STATUS_LABEL,
         OBJPROP_YDISTANCE,
         80
      );
   }

   ObjectSetString(
      0,
      STATUS_LABEL,
      OBJPROP_TEXT,
      text
   );

   ChartRedraw();
}

