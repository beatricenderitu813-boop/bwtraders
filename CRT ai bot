// ON TICK
//
// This runs on every incoming market tick.
// There is NO waiting for M1 candle close.
//==================================================================

void OnTick()
{
   UpdateDay();

   UpdateStatus();

   if(!tradingEnabled)
      return;

   if(tradingLocked)
      return;

   if(!RiskOK())
      return;

   //==============================================================
   // NO OPEN POSITIONS
   //
   // Immediately use the CURRENT FORMING M1 candle.
   // No candle-close confirmation.
   //==============================================================

   if(CountPositions() == 0)
   {
      protectionActive = false;
      peakPrice = 0.0;

      int direction =
         CurrentCandleDirection();

      if(direction != 0)
      {
         OpenCurrentDirection(
            direction
         );
      }

      return;
   }

   //==============================================================
   // OPEN BASKET EXISTS
   //
   // Only profit protection is managed.
   //==============================================================

   ManageProfitProtection();

   UpdateStatus();
}

//==================================================================
// CHART BUTTON EVENTS
//==================================================================

void OnChartEvent(
   const int id,
   const long &lparam,
   const double &dparam,
   const string &sparam)
{
   if(id != CHARTEVENT_OBJECT_CLICK)
      return;

   //==============================================================
   // START
   //==============================================================

   if(sparam == START_BUTTON)
   {
      tradingEnabled = true;
      tradingLocked = false;

      protectionActive = false;
      peakPrice = 0.0;

      UpdateDay();

      Print(
         "CRT AI BOT STARTED."
      );

      // Immediately check the current forming M1 candle.
      if(CountPositions() == 0 &&
         RiskOK())
      {
         int direction =
            CurrentCandleDirection();

         if(direction != 0)
         {
            OpenCurrentDirection(
               direction
            );
         }
      }

      UpdateStatus();
   }

   //==============================================================
   // STOP
   //
   // STOP does not force-close an existing basket.
   //==============================================================

   if(sparam == STOP_BUTTON)
   {
      tradingEnabled = false;

      Print(
         "CRT AI BOT STOPPED."
      );

      UpdateStatus();
   }
}

//==================================================================
// TRADE TRANSACTION
//
// Tracks completed losing trades.
// It does NOT automatically close losing baskets.
//==================================================================

void OnTradeTransaction(
   const MqlTradeTransaction &trans,
   const MqlTradeRequest &request,
   const MqlTradeResult &result)
{
   if(trans.type !=
      TRADE_TRANSACTION_DEAL_ADD)
   {
      return;
   }

   if(trans.deal == 0)
      return;

   if(!HistoryDealSelect(
         trans.deal))
   {
      return;
   }

   string symbol =
      HistoryDealGetString(
         trans.deal,
         DEAL_SYMBOL
      );

   long magic =
      HistoryDealGetInteger(
         trans.deal,
         DEAL_MAGIC
      );

   if(symbol != Sym())
      return;

   if((ulong)magic != MagicNumber)
      return;

   long entry =
      HistoryDealGetInteger(
         trans.deal,
         DEAL_ENTRY
      );

   // Only count completed exits.
   if(entry != DEAL_ENTRY_OUT &&
      entry != DEAL_ENTRY_OUT_BY)
   {
      return;
   }

   double profit =
      HistoryDealGetDouble(
         trans.deal,
         DEAL_PROFIT
      );

   double swap =
      HistoryDealGetDouble(
         trans.deal,
         DEAL_SWAP
      );

   double commission =
      HistoryDealGetDouble(
         trans.deal,
         DEAL_COMMISSION
      );

   double netResult =
      profit +
      swap +
      commission;

   if(netResult < 0.0)
      consecutiveLosses++;
   else if(netResult > 0.0)
      consecutiveLosses = 0;

   //==============================================================
   // When the basket is completely closed, reset protection.
   // The next tick immediately checks the current M1 direction.
   //==============================================================

   if(CountPositions() == 0)
   {
      protectionActive = false;
      peakPrice = 0.0;
   }

   UpdateStatus();
}
