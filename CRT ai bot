//==================================================================
// SYMBOL
//==================================================================

string Sym()
{
   if(TradingSymbol == "")
      return _Symbol;

   return TradingSymbol;
}

//==================================================================
// POINT / PIP SIZE
//==================================================================

double PipSize(string symbol)
{
   double point =
      SymbolInfoDouble(
         symbol,
         SYMBOL_POINT
      );

   int digits =
      (int)SymbolInfoInteger(
         symbol,
         SYMBOL_DIGITS
      );

   if(digits == 3 || digits == 5)
      return point * 10.0;

   return point;
}

//==================================================================
// NORMALIZE VOLUME
//==================================================================

double NormalizeVolume(
   string symbol,
   double volume
)
{
   double minVolume =
      SymbolInfoDouble(
         symbol,
         SYMBOL_VOLUME_MIN
      );

   double maxVolume =
      SymbolInfoDouble(
         symbol,
         SYMBOL_VOLUME_MAX
      );

   double stepVolume =
      SymbolInfoDouble(
         symbol,
         SYMBOL_VOLUME_STEP
      );

   if(stepVolume <= 0.0)
      stepVolume = minVolume;

   if(volume < minVolume)
      volume = minVolume;

   if(volume > maxVolume)
      volume = maxVolume;

   volume =
      MathFloor(
         volume / stepVolume
      ) * stepVolume;

   int digits = 2;

   if(stepVolume < 0.01)
      digits = 3;

   if(stepVolume < 0.001)
      digits = 4;

   return NormalizeDouble(
      volume,
      digits
   );
}

//==================================================================
// COUNT EA POSITIONS
//==================================================================

int CountPositions()
{
   int count = 0;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol =
         PositionGetString(
            POSITION_SYMBOL
         );

      long magic =
         PositionGetInteger(
            POSITION_MAGIC
         );

      if(symbol != Sym())
         continue;

      if((ulong)magic != MagicNumber)
         continue;

      count++;
   }

   return count;
}

//==================================================================
// TOTAL EA LOTS
//==================================================================

double TotalEALots()
{
   double total = 0.0;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string symbol =
         PositionGetString(
            POSITION_SYMBOL
         );

      long magic =
         PositionGetInteger(
            POSITION_MAGIC
         );

      if(symbol != Sym())
         continue;

      if((ulong)magic != MagicNumber)
         continue;

      total +=
         PositionGetDouble(
            POSITION_VOLUME
         );
   }

   return total;
}

//==================================================================
// BASKET PROFIT
//==================================================================

double BasketProfit()
{
   double total = 0.0;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
