//==================================================================
// ON TICK
//==================================================================

void OnTick()
{
   //---------------------------------------------------------------
   // NEW DAY CHECK
   //---------------------------------------------------------------

   UpdateDay();

   //---------------------------------------------------------------
   // ALWAYS UPDATE DISPLAY
   //---------------------------------------------------------------

   UpdateStatus();

   //---------------------------------------------------------------
   // BOT STOPPED BY USER
   //---------------------------------------------------------------

   if(!tradingEnabled)
      return;

   //---------------------------------------------------------------
   // IMPORTANT:
   // Manage an existing basket even if risk protection has locked
   // NEW ENTRIES. Profit protection itself will only close when
   // basket profit is positive.
   //---------------------------------------------------------------

   if(
      CountPositions() > 0
   )
   {
      ManageProfitProtection();

      return;
   }

   //---------------------------------------------------------------
   // RISK CHECK BEFORE NEW ENTRY
   //---------------------------------------------------------------

   if(
      !RiskOK()
   )
   {
      return;
   }

   //---------------------------------------------------------------
   // FLIPPING / ENTRY ENGINE
   //---------------------------------------------------------------

   ManageFlipping();
}

//==================================================================
// CHART EVENTS
//==================================================================

void OnChartEvent(
   const int id,
   const long &lparam,
   const double &dparam,
   const string &sparam
)
{
   //---------------------------------------------------------------
   // ONLY BUTTON CLICKS
   //---------------------------------------------------------------

   if(
      id !=
      CHARTEVENT_OBJECT_CLICK
   )
   {
      return;
   }

   //---------------------------------------------------------------
   // START
   //---------------------------------------------------------------

   if(
      sparam ==
      START_BUTTON
   )
   {
      if(tradingLocked)
      {
         Print(
            "CRT AI BOT: START blocked. Risk protection is active."
         );

         return;
      }

      tradingEnabled = true;

      Print(
         "CRT AI BOT STARTED"
      );

      //------------------------------------------------------------
      // IMMEDIATE CURRENT M1 SCAN
      //------------------------------------------------------------

      ScanCurrentCandle();

      int direction =
         GetSignalDirection();

      if(
         direction != 0 &&
         CountPositions() == 0
      )
      {
         OpenCurrentDirection(
            direction
         );
      }

      UpdateStatus();

      return;
   }

   //---------------------------------------------------------------
   // STOP
   //---------------------------------------------------------------

   if(
      sparam ==
      STOP_BUTTON
   )
   {
      tradingEnabled = false;

      //------------------------------------------------------------
      // MANUAL STOP CLOSES CURRENT EA POSITIONS
      //------------------------------------------------------------

      CloseAll(
         "MANUAL STOP"
      );

      reentryPending = false;

      protectionActive = false;

      peakBasketProfit = 0.0;

      Print(
         "CRT AI BOT STOPPED BY USER."
      );

      UpdateStatus();

      return;
   }
}

