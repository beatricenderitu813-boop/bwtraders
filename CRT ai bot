   );
}

//==================================================================
// MAIN TICK
//==================================================================

void OnTick()
{
   UpdateDay();

   // Always manage existing basket
   ManageProfitProtection();

   UpdateStatus();

   if(!tradingEnabled)
      return;

   if(tradingLocked)
      return;

   if(!RiskOK())
      return;

   // ---------------------------------------------------------------
   // ONLY SCAN ONCE FOR EACH NEW M1 CANDLE
   // ---------------------------------------------------------------

   if(!IsNewM1Candle())
      return;

   // ---------------------------------------------------------------
   // SCAN THE NEW CANDLE ENVIRONMENT
   // ---------------------------------------------------------------

   ScanCurrentCandle();

   int direction =
      GetSignalDirection();

   // ---------------------------------------------------------------
   // 55% NOT REACHED
   // ---------------------------------------------------------------

   if(direction == 0)
   {
      Print(
         "CRT AI BOT: No side reached 55%. WAIT."
      );

      return;
   }

   // ---------------------------------------------------------------
   // IF THERE IS ALREADY A BASKET,
   // DO NOT OPEN OPPOSITE TRADES.
   // ---------------------------------------------------------------

   if(CountPositions() > 0)
      return;

   // ---------------------------------------------------------------
   // OPEN THE STRONGER SIDE
   // ---------------------------------------------------------------

   OpenCurrentDirection(
      direction
   );

   UpdateStatus();
}

//==================================================================
// CHART EVENTS
//==================================================================

void OnChartEvent(
   const int id,
   const long &lparam,
   const double &dparam,
   const string &sparam
)
{
   if(id != CHARTEVENT_OBJECT_CLICK)
      return;

   // ---------------------------------------------------------------
   // START BUTTON
   // ---------------------------------------------------------------

   if(sparam == START_BUTTON)
   {
      tradingEnabled = true;
      tradingLocked = false;

      Print(
         "CRT AI BOT: START pressed."
      );

      // Do not blindly open a trade.
      // Reset candle tracking so the next M1 candle
      // will receive a fresh scan.

      lastProcessedCandle = 0;

      signalText = "WAIT";

      UpdateStatus();
   }

   // ---------------------------------------------------------------
   // STOP BUTTON
   // ---------------------------------------------------------------

   if(sparam == STOP_BUTTON)
   {
      tradingEnabled = false;

      Print(
         "CRT AI BOT: STOP pressed."
      );

      // STOP DOES NOT CLOSE EXISTING POSITIONS.

      UpdateStatus();
   }
}

//==================================================================
// TRADE TRANSACTION
//==================================================================

void OnTradeTransaction(
   const MqlTradeTransaction &trans,
   const MqlTradeRequest &request,
   const MqlTradeResult &result
)
{
   if(trans.type !=
      TRADE_TRANSACTION_DEAL_ADD)
      return;

   ulong deal =
      trans.deal;

   if(deal == 0)
      return;

   if(!HistoryDealSelect(
         deal
      ))
      return;

   string symbol =
      HistoryDealGetString(
         deal,
         DEAL_SYMBOL
      );

   long magic =
      HistoryDealGetInteger(
         deal,
         DEAL_MAGIC
      );

   if(symbol != Sym())
      return;

   if((ulong)magic != MagicNumber)
      return;

   long entry =
      HistoryDealGetInteger(
         deal,
         DEAL_ENTRY
      );

   // Only process closing deals
   if(
      entry != DEAL_ENTRY_OUT &&
      entry != DEAL_ENTRY_OUT_BY
   )
   {
      return;
   }

   double profit =
      HistoryDealGetDouble(
         deal,
         DEAL_PROFIT
      );

   double swap =
      HistoryDealGetDouble(
         deal,
         DEAL_SWAP
      );

   double commission =
      HistoryDealGetDouble(
         deal,
         DEAL_COMMISSION
      );

   double netResult =
      profit +
      swap +
      commission;

   if(netResult > 0.0)
   {
      consecutiveLosses = 0;

      Print(
         "CRT AI BOT: Profitable trade closed. Net=$",
         DoubleToString(
            netResult,
            2
         )
      );
   }
   else
   if(netResult < 0.0)
   {
      consecutiveLosses++;

      Print(
         "CRT AI BOT: Losing trade closed. Net=$",
         DoubleToString(
            netResult,
            2
         ),
         " Consecutive losses=",
         consecutiveLosses
      );
   }

   protectionActive = false;
   peakBasketProfit = 0.0;

   UpdateStatus();
}
