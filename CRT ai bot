// CLOSE ALL EA POSITIONS
//==================================================================

bool CloseAll(
   string reason
)
{
   closingBasket = true;

   bool result = true;

   Print(
      "CRT AI BOT: Closing basket. Reason = ",
      reason
   );

   for(
      int i = PositionsTotal() - 1;
      i >= 0;
      i--
   )
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(
         !PositionSelectByTicket(
            ticket
         )
      )
      {
         continue;
      }

      string symbol =
         PositionGetString(
            POSITION_SYMBOL
         );

      long magic =
         PositionGetInteger(
            POSITION_MAGIC
         );

      if(symbol != Sym())
         continue;

      if(
         (ulong)magic !=
         MagicNumber
      )
      {
         continue;
      }

      if(
         !trade.PositionClose(
            ticket,
            SlippagePoints
         )
      )
      {
         result = false;

         Print(
            "CRT AI BOT: Failed to close ticket ",
            ticket,
            " | ",
            trade.ResultRetcodeDescription()
         );
      }
   }

   if(result)
   {
      protectionActive = false;
      peakBasketProfit = 0.0;
      protectionFlips = 0;
      capitalProtectionTriggered = false;
   }

   closingBasket = false;

   return result;
}

//==================================================================
// UPDATE DAY
//==================================================================

void UpdateDay()
{
   MqlDateTime nowStruct;

   TimeToStruct(
      TimeCurrent(),
      nowStruct
   );

   nowStruct.hour = 0;
   nowStruct.min = 0;
   nowStruct.sec = 0;

   datetime today =
      StructToTime(
         nowStruct
      );

   if(
      savedDay !=
      (int)today
   )
   {
      savedDay =
         (int)today;

      dayStartEquity =
         AccountInfoDouble(
            ACCOUNT_EQUITY
         );

      consecutiveLosses = 0;

      tradingLocked = false;

      protectionActive = false;

      peakBasketProfit = 0.0;

      protectionFlips = 0;

      capitalProtectionTriggered = false;

      reentryPending = false;

      Print(
         "CRT AI BOT: New trading day."
      );

      Print(
         "Starting equity: $",
         DoubleToString(
            dayStartEquity,
            2
         )
      );
   }
}

//==================================================================
// RISK CHECK
//
// Daily loss and maximum drawdown are emergency protections.
// They may close positions because they are account-safety limits.
// Normal profit protection NEVER closes a losing basket.
//==================================================================

bool RiskOK()
{
   if(tradingLocked)
      return false;

   double equity =
      AccountInfoDouble(
         ACCOUNT_EQUITY
      );

   double balance =
      AccountInfoDouble(
         ACCOUNT_BALANCE
      );

   if(
      balance <= 0.0 ||
      dayStartEquity <= 0.0
   )
   {
      return false;
   }

   //---------------------------------------------------------------
   // DAILY LOSS
   //---------------------------------------------------------------

   if(
      DailyLossLimitPercent > 0.0
   )
   {
      double loss =
         dayStartEquity -
         equity;

      double lossPercent =
         (
            loss /
            dayStartEquity
         ) * 100.0;

      if(
         lossPercent >=
         DailyLossLimitPercent
      )
      {
         tradingLocked = true;

         tradingEnabled = false;

         CloseAll(
            "DAILY LOSS LIMIT"
         );

         return false;
      }
   }

   //---------------------------------------------------------------
   // MAXIMUM DRAWDOWN
   //---------------------------------------------------------------

   if(
      MaximumDrawdownPercent > 0.0
   )
   {
      double drawdown =
         balance -
         equity;

      double drawdownPercent =
         (
            drawdown /
            balance
         ) * 100.0;

      if(
         drawdownPercent >=
         MaximumDrawdownPercent
      )
      {
         tradingLocked = true;

         tradingEnabled = false;

         CloseAll(
            "MAXIMUM DRAWDOWN"
         );

         return false;
      }
   }

   //---------------------------------------------------------------
   // CONSECUTIVE LOSSES
   //---------------------------------------------------------------

   if(
      MaximumConsecutiveLosses > 0 &&
      consecutiveLosses >=
      MaximumConsecutiveLosses
   )
   {
      tradingLocked = true;

      tradingEnabled = false;

      CloseAll(
         "MAXIMUM CONSECUTIVE LOSSES"
      );

      return false;
   }

   return true;
}

//==================================================================
// CURRENT FORMING M1 CANDLE DIRECTION
//==================================================================

int CurrentCandleDirection()
{
   MqlRates rates[];

   ArraySetAsSeries(
      rates,
      true
   );

   if(
      CopyRates(
         Sym(),
         PERIOD_M1,
         0,
         1,
         rates
      ) != 1
   )
   {
      return 0;
   }

   double currentPrice =
      SymbolInfoDouble(
         Sym(),
         SYMBOL_BID
      );

   if(
      currentPrice >
      rates[0].open
   )
   {
      return 1;
   }

   if(
      currentPrice <
      rates[0].open
   )
   {
      return -1;
   }

   return 0;
}

//==================================================================
// BUY STRENGTH
//==================================================================

double CalculateBuyStrength()
{
   MqlRates rates[];

   ArraySetAsSeries(
      rates,
      true
   );

   if(
      CopyRates(
         Sym(),
         PERIOD_M1,
         0,
         1,
         rates
      ) != 1
   )
   {
      return 0.0;
   }

   double openPrice =
      rates[0].open;

   double highPrice =
      rates[0].high;

   double lowPrice =
      rates[0].low;

   double bid =
      SymbolInfoDouble(
         Sym(),
         SYMBOL_BID
      );

   if(
      openPrice <= 0.0 ||
      highPrice <= 0.0 ||
      lowPrice <= 0.0 ||
      bid <= 0.0
   )
   {
      return 0.0;
   }

   double range =
      highPrice -
      lowPrice;

   if(range <= 0.0)
      return 0.0;

   double position =
      (
         bid -
         lowPrice
      ) / range;

   if(position < 0.0)
      position = 0.0;

   if(position > 1.0)
      position = 1.0;

   double strength = 0.0;

   if(bid > openPrice)
      strength += 55.0;

   strength +=
      position * 45.0;

   if(strength > 100.0)
      strength = 100.0;

   return strength;
}

//==================================================================
// SELL STRENGTH
//==================================================================

double CalculateSellStrength()
{
   MqlRates rates[];

   ArraySetAsSeries(
      rates,
      true
   );

   if(
      CopyRates(
         Sym(),
         PERIOD_M1,
         0,
         1,
         rates
      ) != 1
   )
   {
      return 0.0;
   }

   double openPrice =
      rates[0].open;

   double highPrice =
      rates[0].high;

   double lowPrice =
      rates[0].low;

   double bid =
      SymbolInfoDouble(
         Sym(),
         SYMBOL_BID
      );

   if(
      openPrice <= 0.0 ||
      highPrice <= 0.0 ||
      lowPrice <= 0.0 ||
      bid <= 0.0
   )
   {
      return 0.0;
   }

   double range =
      highPrice -
      lowPrice;

   if(range <= 0.0)
      return 0.0;

   double position =
      (
         bid -
         lowPrice
      ) / range;

   if(position < 0.0)
      position = 0.0;

   if(position > 1.0)
      position = 1.0;

   double strength = 0.0;

   if(bid < openPrice)
      strength += 55.0;

   strength +=
      (1.0 - position) *
      45.0;

   if(strength > 100.0)
      strength = 100.0;

   return strength;
}

//==================================================================
// SCAN CURRENT FORMING M1 CANDLE
//==================================================================

void ScanCurrentCandle()
{
   buyStrength =
      CalculateBuyStrength();

   sellStrength =
      CalculateSellStrength();

   //---------------------------------------------------------------
   // BUY >= MINIMUM
   //---------------------------------------------------------------

   if(
      buyStrength >=
      MinimumSignalStrength &&
      buyStrength >
      sellStrength
   )
   {
      signalText =
         "BUY " +
         DoubleToString(
            buyStrength,
            1
         ) +
         "%";
   }

   //---------------------------------------------------------------
   // SELL >= MINIMUM
   //---------------------------------------------------------------

   else
   if(
      sellStrength >=
      MinimumSignalStrength &&
      sellStrength >
      buyStrength
   )
   {
      signalText =
         "SELL " +
         DoubleToString(
            sellStrength,
            1
         ) +
         "%";
   }

   //---------------------------------------------------------------
   // WAIT
   //---------------------------------------------------------------

   else
   {
      signalText =
         "WAIT B:" +
         DoubleToString(
            buyStrength,
            1
         ) +
         " S:" +
         DoubleToString(
            sellStrength,
            1
         );
   }

   Print(
      "CRT AI BOT: M1 CURRENT | BUY=",
      DoubleToString(
         buyStrength,
         1
      ),
      "% | SELL=",
      DoubleToString(
         sellStrength,
         1
      ),
      "%"
   );

   UpdateStatus();
}

//==================================================================
