//==================================================================
// CLOSE ALL EA POSITIONS
//==================================================================

bool CloseAll(string reason)
{
   Print(
      "CRT AI BOT closing positions: ",
      reason
   );

   bool allClosed = true;

   string s = Sym();

   for(
      int i = PositionsTotal() - 1;
      i >= 0;
      i--
   )
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      if(
         PositionGetString(
            POSITION_SYMBOL
         ) != s
      )
      {
         continue;
      }

      if(
         (ulong)PositionGetInteger(
            POSITION_MAGIC
         ) != MagicNumber
      )
      {
         continue;
      }

      if(
         !trade.PositionClose(ticket)
      )
      {
         allClosed = false;

         Print(
            "Close failed #",
            ticket,
            " ",
            trade.ResultRetcodeDescription()
         );
      }
   }

   return allClosed;
}

//==================================================================
// UPDATE DAY
//==================================================================

void UpdateDay()
{
   MqlDateTime tm;

   TimeToStruct(
      TimeCurrent(),
      tm
   );

   if(savedDay != tm.day)
   {
      savedDay = tm.day;

      dayStartEquity =
         AccountInfoDouble(
            ACCOUNT_EQUITY
         );

      consecutiveLosses = 0;

      tradingLocked = false;
   }
}

//==================================================================
// RISK CHECK
//==================================================================

bool RiskOK()
{
   UpdateDay();

   if(tradingLocked)
      return false;

   double equity =
      AccountInfoDouble(
         ACCOUNT_EQUITY
      );

   double balance =
      AccountInfoDouble(
         ACCOUNT_BALANCE
      );

   //--------------------------------------------------------------
   // DAILY LOSS
   //--------------------------------------------------------------

   if(
      DailyLossLimitPercent > 0 &&
      dayStartEquity > 0
   )
   {
      double lossPercent =
         (
            dayStartEquity - equity
         )
         /
         dayStartEquity
         *
         100.0;

      if(
         lossPercent >=
         DailyLossLimitPercent
      )
      {
         tradingLocked = true;

         CloseAll(
            "DAILY LOSS LIMIT"
         );

         UpdateStatus();

         return false;
      }
   }

   //--------------------------------------------------------------
   // DRAWDOWN
   //--------------------------------------------------------------

   if(
      MaximumDrawdownPercent > 0 &&
      balance > 0
   )
   {
      double drawdown =
         (
            balance - equity
         )
         /
         balance
         *
         100.0;

      if(
         drawdown >=
         MaximumDrawdownPercent
      )
      {
         tradingLocked = true;

         CloseAll(
            "MAXIMUM DRAWDOWN"
         );

         UpdateStatus();

         return false;
      }
   }

   //--------------------------------------------------------------
   // CONSECUTIVE LOSSES
   //--------------------------------------------------------------

   if(
      MaximumConsecutiveLosses > 0 &&
      consecutiveLosses >=
      MaximumConsecutiveLosses
   )
   {
      tradingLocked = true;

      UpdateStatus();

      return false;
   }

   return true;
}

//==================================================================
// CURRENT M1 CANDLE DIRECTION
//==================================================================

// Returns:
//  1 = bullish
// -1 = bearish
//  0 = doji

int CurrentCandleDirection()
{
   string s = Sym();

   MqlRates rates[];

   ArraySetAsSeries(
      rates,
      true
   );

   if(
      CopyRates(
         s,
         PERIOD_M1,
         0,
         1,
         rates
      ) < 1
   )
   {
      return 0;
   }

   // rates[0] is the CURRENT FORMING M1 candle.

   if(
      rates[0].close >
      rates[0].open
   )
   {
      return 1;
   }

   if(
      rates[0].close <
      rates[0].open
   )
   {
      return -1;
   }

   return 0;
}

//==================================================================
// OPEN ONE TRADE
//==================================================================

bool OpenOne(
   bool buy,
   double volume
)
{
   string s = Sym();

   double ask =
      SymbolInfoDouble(
         s,
         SYMBOL_ASK
      );

   double bid =
      SymbolInfoDouble(
         s,
         SYMBOL_BID
      );

   double pip =
      PipSize(s);

   int digits =
      (int)SymbolInfoInteger(
         s,
         SYMBOL_DIGITS
      );

   if(
      ask <= 0 ||
      bid <= 0
   )
   {
      return false;
   }

   double sl = 0;
   double tp = 0;

   //--------------------------------------------------------------
   // STOP LOSS
   //--------------------------------------------------------------

   if(
      StopLossPips > 0 &&
      pip > 0
   )
   {
      if(buy)
      {
         sl =
            NormalizeDouble(
               ask -
               StopLossPips * pip,
               digits
            );
      }
      else
      {
         sl =
            NormalizeDouble(
               bid +
               StopLossPips * pip,
               digits
            );
      }
   }

   //--------------------------------------------------------------
   // TAKE PROFIT
   //--------------------------------------------------------------

   if(
      TakeProfitPips > 0 &&
      pip > 0
   )
   {
      if(buy)
      {
         tp =
            NormalizeDouble(
               ask +
               TakeProfitPips * pip,
               digits
            );
      }
      else
      {
         tp =
            NormalizeDouble(
               bid -
               TakeProfitPips * pip,
               digits
            );
      }
   }

   //--------------------------------------------------------------
   // TRADE SETTINGS
   //--------------------------------------------------------------

   trade.SetExpertMagicNumber(
      MagicNumber
   );

   trade.SetDeviationInPoints(
      SlippagePoints
   );

   bool result = false;

   //--------------------------------------------------------------
   // BUY
   //--------------------------------------------------------------

   if(buy)
   {
      result =
         trade.Buy(
            volume,
            s,
            0,
            sl,
            tp,
            "CRT M1 FLIP BUY"
         );
   }

   //--------------------------------------------------------------
   // SELL
   //--------------------------------------------------------------

   else
   {
      result =
         trade.Sell(
            volume,
            s,
            0,
            sl,
            tp,
            "CRT M1 FLIP SELL"
         );
   }

   //--------------------------------------------------------------
   // RESULT
   //--------------------------------------------------------------

   if(!result)
   {
      Print(
         "Order failed: ",
         trade.ResultRetcode(),
         " ",
         trade.ResultRetcodeDescription()
      );

      return false;
   }

   Print(
      "CRT AI BOT opened ",
      buy ? "BUY" : "SELL",
      " | Lot = ",
      DoubleToString(
         volume,
         2
      )
   );

   return true;
}

//==================================================================
// OPEN CURRENT DIRECTION
//==================================================================

void OpenCurrentDirection(
   int direction
)
{
   if(direction == 0)
      return;

   if(!tradingEnabled)
      return;

   if(!RiskOK())
      return;

   string s = Sym();

   if(!SymbolSelect(s,true))
   {
      Print(
         "Cannot select symbol ",
         s
      );

      return;
   }

   //--------------------------------------------------------------
   // CHECK POSITION LIMIT
   //--------------------------------------------------------------

   int currentPositions =
      CountPositions();

   if(
      currentPositions >=
      MaximumOpenPositions
   )
   {
      return;
   }

   //--------------------------------------------------------------
   // CALCULATE DYNAMIC LOT
   //--------------------------------------------------------------

   double volume =
      CalculateDynamicLot();

   if(volume <= 0)
   {
      Print(
         "Dynamic lot calculation returned 0."
      );

      return;
   }

   //--------------------------------------------------------------
   // EXPOSURE LIMIT
   //--------------------------------------------------------------

   if(
      MaximumEAExposureLots > 0
   )
   {
      if(
         TotalLots() +
         volume >
         MaximumEAExposureLots +
         1e-9
      )
      {
         Print(
            "EA exposure limit reached."
         );

         return;
      }
   }

   //--------------------------------------------------------------
   // OPEN
   //--------------------------------------------------------------

   bool buy =
      direction == 1;

   int availableSlots =
      MaximumOpenPositions -
      currentPositions;

   int orders =
      MathMin(
         OrdersPerSignal,
         availableSlots
      );

   if(orders <= 0)
      return;

   for(
      int i = 0;
      i < orders;
      i++
   )
   {
      if(!tradingEnabled)
         break;

      if(!RiskOK())
         break;

      if(
         MaximumEAExposureLots > 0 &&
         TotalLots() +
         volume >
         MaximumEAExposureLots +
         1e-9
      )
      {
         break;
      }

      OpenOne(
         buy,
         volume
      );
   }
}

