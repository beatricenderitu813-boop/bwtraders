void LogStatusIfNeeded()
{
   datetime now = TimeCurrent();

   if(LastStatusTime != 0 &&
      now - LastStatusTime < StatusIntervalSeconds)
      return;

   LastStatusTime = now;

   double equity =
      AccountInfoDouble(ACCOUNT_EQUITY);

   double balance =
      AccountInfoDouble(ACCOUNT_BALANCE);

   double basket =
      GetBasketProfit();

   int positions =
      CountOurPositions();

   double lots =
      GetTotalOurLots();

   Print("AXIOM STATUS | ",
         TradingEnabled ? "RUNNING" : "STOPPED",
         " | Positions=",
         positions,
         " | Lots=",
         DoubleToString(lots,2),
         " | Basket=$",
         DoubleToString(basket,2),
         " | Balance=$",
         DoubleToString(balance,2),
         " | Equity=$",
         DoubleToString(equity,2),
         " | LossStreak=",
         ConsecutiveLosses);
}

//=========================== DEAL TRACKING =========================

void OnTradeTransaction(const MqlTradeTransaction &trans,
                        const MqlTradeRequest &request,
                        const MqlTradeResult &result)
{
   if(trans.type != TRADE_TRANSACTION_DEAL_ADD)
      return;

   ulong dealTicket = trans.deal;

   if(dealTicket == 0)
      return;

   if(!HistoryDealSelect(dealTicket))
      return;

   string symbol =
      HistoryDealGetString(dealTicket,
                           DEAL_SYMBOL);

   if(symbol != _Symbol)
      return;

   long magic =
      HistoryDealGetInteger(dealTicket,
                            DEAL_MAGIC);

   if(magic != MagicNumber)
      return;

   long entryType =
      HistoryDealGetInteger(dealTicket,
                            DEAL_ENTRY);

   //--- only count completed exits
   if(entryType != DEAL_ENTRY_OUT &&
      entryType != DEAL_ENTRY_OUT_BY)
      return;

   double profit =
      HistoryDealGetDouble(dealTicket,
                           DEAL_PROFIT);

   double swap =
      HistoryDealGetDouble(dealTicket,
                           DEAL_SWAP);

   double commission =
      HistoryDealGetDouble(dealTicket,
                           DEAL_COMMISSION);

   double netResult =
      profit + swap + commission;

   if(netResult < 0.0)
   {
      ConsecutiveLosses++;

      Print("AXIOM LOSS | Net=$",
            DoubleToString(netResult,2),
            " | Consecutive losses=",
            ConsecutiveLosses);

      if(ConsecutiveLosses >= MaximumConsecutiveLosses)
      {
         ProtectionLocked = true;

         Print("AXIOM PROTECTION: Maximum consecutive losses reached.");
      }
   }
   else if(netResult > 0.0)
   {
      ConsecutiveLosses = 0;

      Print("AXIOM WIN | Net=$",
            DoubleToString(netResult,2),
            " | Loss streak reset.");
   }
}

